// ---------------------------------------------------------------------------
// Tools for the compiler's tests. Only *_test.ode files import this, so it is
// never part of the compiler itself.
//
// Most tests call the phases in-process: a test runs in a process of its
// own, so the compiler's global state is fresh for it, and checking a snippet
// costs no more than compiling it.
//
//   test "a return of the wrong type" {
//     let found: *List<Diagnostic> = problemsIn("fn main(): i32 { return true; }");
//     assertEq(found.count, 1);
//     assertEq(found.at(0).problem, Problem.WrongReturnType);
//     assertEq(found.at(0).column, 25);
//   }
//
// A test asks which problem was found, where, and about what -- never how
// it was worded, which describe() is free to change.
//
// The few that must run what they build -- does the program print what it
// should -- compile in a child process and link with clang; see outputOf.
// ---------------------------------------------------------------------------

import { exit } from "std/c";
import { alloc, release } from "std/mem";
import { List } from "std/list";
import { readFile, writeFile } from "std/fs";
import { Builder, contains } from "std/text";
import { STDOUT } from "./support/libc";
import { Problem } from "./support/problems";
import { writeBuilder } from "./support/text";
import {
  SOURCE_PATH, Diagnostic, DIAGS, FAILED, hasErrors, resetDiagnostics,
  formatDiagnostics,
} from "./support/diagnostics";
import {
  TextList, StderrMode, runCommand, runInChild, environment, changeDirectory,
  joinPath, parentDirectory, makeDirectories, removeTree, makeTempDirectory,
} from "./support/system";
import { TokenKind, TokenList } from "./syntax/token";
import { NO_NODE, NodeKind, Ast } from "./syntax/ast";
import { tokenize } from "./syntax/lexer";
import { Parser, parseDeclaredType } from "./syntax/parser";
import { parseExpr } from "./syntax/expressions";
import { parseStatementRecovering } from "./syntax/statements";
import { TypeKind, Type } from "./semantics/types";
import { SymbolKind } from "./semantics/symbols";
import {
  resetModules, STD_DIRECTORY, rewriteNodeNames, SymbolList, declareImports,
} from "./semantics/modules";
import { Analyzer, analyzerParseType, analyze } from "./semantics/analyzer";
import { checkExpr } from "./semantics/expressions";
import { analyzeRecovering } from "./semantics/statements";
import { declareInstances } from "./semantics/generics";
import { Emitter } from "./codegen/emitter";
import { genProgram } from "./codegen/program";
import { loadProgram, buildExecutable } from "./pipeline";

// A snippet's file name, which a failed check in a program it builds names.
let SNIPPET: *i8 = "test.ode";

// The problems checking `source` finds, in the order found: each with its
// Problem, where it is, and the Facts it was about. Lexing, parsing and
// checking all run, as far as each gets: a file that does not lex is not
// parsed, nor one that does not parse checked.
//
//   let found: *List<Diagnostic> = problemsIn("fn main(): i32 { return true; }");
//   assertEq(found.count, 1);
//   assertEq(found.at(0).problem, Problem.WrongReturnType);
export fn problemsIn(source: *i8): *List<Diagnostic> {
  let program: Loaded = load(SNIPPET, source);
  analyzeLoaded(program);
  return DIAGS.items;
}

// problemsIn, for the program entered at `entry` among `files`.
export fn problemsInFiles(files: *Files, entry: *i8): *List<Diagnostic> {
  changeDirectory(files.directory);
  let source: *i8 = readFile(entry);
  assert(source != null, "no such file among the test's files");
  let program: Loaded = load(entry, source);
  analyzeLoaded(program);
  return DIAGS.items;
}

// The type checking gives `expression`, in a function whose body starts
// with `setup`. A snippet that does not check gives TypeKind.None.
export fn typeOf(setup: *i8, expression: *i8): Type {
  let source: *Builder = Builder.new();
  source.add("fn main(): i32 {\n");
  source.add(setup);
  source.add("\n(");
  source.add(expression);
  source.add(");\nreturn 0;\n}\n");

  let program: Loaded = load(SNIPPET, source.data);
  analyzeLoaded(program);
  if (hasErrors()) {
    return Type.make(TypeKind.None, 0);
  }

  // The probe is the one expression statement in main's body.
  for (node in 0..program.ast.count) {
    if (program.ast.nodes[node].kind == NodeKind.ExprStmt) {
      return program.an.types[program.ast.nodes[node].a];
    }
  }
  return Type.make(TypeKind.None, 0);
}

// The LLVM IR a clean snippet compiles to, or "" when it does not check.
export fn irOf(source: *i8): *i8 {
  let program: Loaded = load(SNIPPET, source);
  analyzeLoaded(program);
  if (hasErrors()) {
    return "";
  }
  return genProgram(Emitter.new(program.ast, program.an), program.root);
}

// The tree `source` parses to, for looking at its nodes.
export fn parse(source: *i8): Parsed {
  let program: Loaded = load(SNIPPET, source);
  return Parsed { ast: program.ast, root: program.root };
}

export struct Parsed {
  ast: *Ast,
  root: i32,

  // The `index`th item at the top of the file.
  fn item(self: Parsed, index: i32): i32 {
    return self.ast.nodes[self.root].items[index];
  }

  fn kind(self: Parsed, node: i32): NodeKind {
    return self.ast.nodes[node].kind;
  }
}

// ---------------------------------------------------------------------------
// Checking a fragment: an expression, or a few statements, in a scope a test
// sets up -- declarations at the top, locals of given types -- with no
// program around it.
// ---------------------------------------------------------------------------

struct ScopeLocal {
  name: *i8,
  type: *i8,
}

export struct Scope {
  declarations: *Builder,
  locals: *List<ScopeLocal>,
  returns: *i8,

  fn new(): *Scope {
    let scope: *Scope = alloc<Scope>(1);
    scope.declarations = Builder.new();
    scope.locals = List<ScopeLocal>.new();
    scope.returns = "void";
    return scope;
  }

  // Top-level declarations the fragment can use: structs, enums, functions.
  fn declare(self: *Scope, source: *i8): *Scope {
    self.declarations.add(source);
    self.declarations.push('\n');
    return self;
  }

  // A local variable, its type written as in a declaration: "i64", "*Point".
  fn local(self: *Scope, name: *i8, type: *i8): *Scope {
    self.locals.push(ScopeLocal { name: name, type: type });
    return self;
  }

  // The return type of the function the fragment is in; "void" by default.
  fn returning(self: *Scope, type: *i8): *Scope {
    self.returns = type;
    return self;
  }

  // The problems in the scope's declarations alone.
  fn problems(self: *Scope): *List<Diagnostic> {
    enter(self);
    return DIAGS.items;
  }

  // The problems in `expression`, and the type it has when it has none.
  fn check(self: *Scope, expression: *i8): Checked {
    let fragment: Fragment = enter(self);
    if (hasErrors()) {
      return Checked { problems: DIAGS.items, type: Type.make(TypeKind.None, 0) };
    }

    let parser: *Parser = fragmentParser(fragment, expression);
    let node: i32 = parseExpr(parser);
    if (!FAILED && parser.kind() != TokenKind.End) {
      parser.fail("end of the expression");
    }
    if (hasErrors()) {
      return Checked { problems: DIAGS.items, type: Type.make(TypeKind.None, 0) };
    }

    resolveNames(fragment);
    let type: Type = checkExpr(fragment.an, node);
    return Checked { problems: DIAGS.items, type: type };
  }

  // The problems in `statements`, checked as a function body is.
  fn run(self: *Scope, statements: *i8): *List<Diagnostic> {
    let fragment: Fragment = enter(self);
    if (hasErrors()) {
      return DIAGS.items;
    }

    let parser: *Parser = fragmentParser(fragment, statements);
    parser.atTopLevel = false;
    let body: *List<i32> = List<i32>.new();
    while (parser.kind() != TokenKind.End) {
      let statement: i32 = parseStatementRecovering(parser);
      if (statement != NO_NODE) {
        body.push(statement);
      }
    }
    if (hasErrors()) {
      return DIAGS.items;
    }

    resolveNames(fragment);
    for (index in 0..body.count) {
      analyzeRecovering(fragment.an, body.at(index));
    }
    return DIAGS.items;
  }
}

// What checking an expression found.
export struct Checked {
  problems: *List<Diagnostic>,
  // The expression's type; TypeKind.None when it has problems.
  type: Type,

  fn clean(self: Checked): bool {
    return self.problems.count == 0;
  }

  // The first problem found. Only to be asked of a fragment that has one.
  fn problem(self: Checked): Problem {
    assert(self.problems.count > 0, "the fragment has no problem");
    return self.problems.at(0).problem;
  }
}

// A scope, entered: its declarations checked, and its locals declared, in the
// body of a function returning what the scope says.
struct Fragment {
  an: *Analyzer,
  root: i32,
  // Where the fragment's own nodes start, for resolving their names.
  firstNode: i32,
}

fn enter(scope: *Scope): Fragment {
  let program: Loaded = load(SNIPPET, scope.declarations.data);
  program.an.requireMain = false;
  analyzeLoaded(program);
  let an: *Analyzer = program.an;

  // What the file declares, as its own functions see it.
  an.symbols.enterScope();
  let own: SymbolList = an.moduleSymbols[0];
  for (symbol in 0..own.count) {
    an.symbols.push(own.items[symbol]);
  }
  declareImports(an, program.root, 0);
  declareInstances(an, program.root, 0);

  let firstNode: i32 = program.ast.count;
  an.symbols.enterScope();
  an.inFunction = true;
  an.currentReturnType = typeFromText(an, program.root, scope.returns);
  for (index in 0..scope.locals.count) {
    let local: ScopeLocal = scope.locals.at(index);
    an.symbols.declare(local.name, SymbolKind.Var,
                       typeFromText(an, program.root, local.type), null, 0, 0, 0);
  }

  return Fragment { an: an, root: program.root, firstNode: firstNode };
}

// A type written as in a declaration, resolved the way one would be there.
fn typeFromText(an: *Analyzer, root: i32, text: *i8): Type {
  let parser: *Parser = Parser.new(tokenize(text), an.ast);
  let node: i32 = parseDeclaredType(parser);
  an.growNodeArrays();
  rewriteNodeNames(an, root, node, null);
  return analyzerParseType(an, node);
}

fn fragmentParser(fragment: Fragment, text: *i8): *Parser {
  let tokens: *TokenList = tokenize(text);
  fragment.an.ast.currentModule = 0;
  return Parser.new(tokens, fragment.an.ast);
}

// Points the fragment's struct and enum names at their declarations, as
// linking does for a file's.
fn resolveNames(fragment: Fragment): void {
  fragment.an.growNodeArrays();
  for (node in fragment.firstNode..fragment.an.ast.count) {
    rewriteNodeNames(fragment.an, fragment.root, node, null);
  }
}

// Whether `text` holds `part`, for checking a piece of a long output.
export fn mentions(text: *i8, part: *i8): bool {
  return contains(text, part);
}

// ---------------------------------------------------------------------------
// In-process compiling.
// ---------------------------------------------------------------------------

struct Loaded {
  ast: *Ast,
  an: *Analyzer,
  root: i32,
}

fn load(path: *i8, source: *i8): Loaded {
  resetModules();
  resetDiagnostics();
  STD_DIRECTORY = environment("ODE_STD");
  SOURCE_PATH = path;

  let ast: *Ast = Ast.new();
  let root: i32 = ast.add(NodeKind.Program, 0, 0);
  loadProgram(ast, root, path, source);
  return Loaded { ast: ast, an: Analyzer.new(ast), root: root };
}

fn analyzeLoaded(program: Loaded): void {
  if (!hasErrors()) {
    analyze(program.an, program.root);
  }
}

// ---------------------------------------------------------------------------
// Programs of several files, in a scratch directory.
// ---------------------------------------------------------------------------

export struct Files {
  directory: *i8,

  fn new(): *Files {
    let files: *Files = alloc<Files>(1);
    files.directory = makeTempDirectory("ode-testkit");
    assert(files.directory != null, "cannot make a scratch directory");
    return files;
  }

  fn add(self: *Files, name: *i8, source: *i8): *Files {
    let path: *i8 = joinPath(self.directory, name);
    makeDirectories(parentDirectory(path));
    assert(writeFile(path, source), "cannot write a scratch file");
    return self;
  }

  fn release(self: *Files): void {
    removeTree(self.directory);
  }
}

// ---------------------------------------------------------------------------
// Building and running, in a child process.
// ---------------------------------------------------------------------------

// What `source` prints when it is built and run, stdout and stderr together,
// followed by `exit N` when it does not exit with 0. One that does not
// compile gives its diagnostics instead, which no expected output matches,
// and which show what went wrong.
export fn outputOf(source: *i8): *i8 {
  let files: *Files = Files.new().add(SNIPPET, source);
  let output: *i8 = outputOfFiles(files, SNIPPET);
  files.release();
  return output;
}

// outputOf, for the program entered at `entry` among `files`.
export fn outputOfFiles(files: *Files, entry: *i8): *i8 {
  JOB_DIRECTORY = files.directory;
  JOB_ENTRY = entry;
  let out: *Builder = Builder.new();
  if (runInChild(buildJob, out) != 0) {
    return out.take();
  }

  let run: *TextList = TextList.new().add(joinPath(files.directory, "program"));
  let status: i32 = runCommand(run, files.directory, out, StderrMode.Merge);
  if (status != 0) {
    out.add("exit ");
    out.addInt(status as i64);
    out.push('\n');
  }
  return out.take();
}

// What the child builds. Fork hands it a copy of these, set just before.
let JOB_DIRECTORY: *i8 = null;
let JOB_ENTRY: *i8 = null;

fn buildJob(): void {
  changeDirectory(JOB_DIRECTORY);
  let source: *i8 = readFile(JOB_ENTRY);
  let program: Loaded = load(JOB_ENTRY, source);
  analyzeLoaded(program);
  if (hasErrors()) {
    writeBuilder(STDOUT, formatDiagnostics(false));
    exit(1);
  }

  let module: *i8 = genProgram(Emitter.new(program.ast, program.an),
                               program.root);
  buildExecutable(module, "program", false);
}
