// ---------------------------------------------------------------------------
// The operating system: running programs, files and directories.
//
// Everything here goes through libc by `extern`, and nothing through a shell:
// a program is run from an argument vector, so a path with a space or a `$`
// in it arrives exactly as written. Where libc would need a struct whose
// layout differs between platforms -- `stat`, `dirent` -- the job is handed
// to a standard tool instead (`ls`, `cp`, `rm`), still without a shell.
// ---------------------------------------------------------------------------

import {
  malloc, free, strlen, fopen, fclose, fread, fwrite, fseek, ftell, SEEK_SET,
  SEEK_END,
} from "./libc";
import { List } from "./list";
import { Buf, textSlice } from "./text";
import { realpath } from "../semantics/modules";

extern fn fork(): i32;
extern fn execvp(file: *i8, argv: **i8): i32;
extern fn waitpid(pid: i32, status: *i32, options: i32): i32;
extern fn _exit(code: i32): void;
extern fn getenv(name: *i8): *i8;
extern fn setenv(name: *i8, value: *i8, overwrite: i32): i32;
extern fn access(path: *i8, mode: i32): i32;
extern fn chdir(path: *i8): i32;
extern fn getcwd(buffer: *i8, size: i64): *i8;
extern fn pipe(fds: *i32): i32;
extern fn dup2(from: i32, to: i32): i32;
extern fn close(fd: i32): i32;
extern fn read(fd: i32, buffer: *i8, count: i64): i64;
extern fn mkdir(path: *i8, mode: i32): i32;
extern fn mkdtemp(template: *i8): *i8;
extern fn rename(from: *i8, to: *i8): i32;
extern fn isatty(fd: i32): i32;
extern fn fileno(stream: *i8): i32;
export extern fn memcmp(a: *i8, b: *i8, count: i64): i32;

// `access` modes.
let EXISTS: i32 = 0;
let EXECUTABLE: i32 = 1;

// ---------------------------------------------------------------------------
// Lists of text: argument vectors, and the lines of a program's output.
// ---------------------------------------------------------------------------

export struct TextList {
  texts: *List<*i8>,

  fn new(): *TextList {
    let list: *TextList = malloc(sizeof(TextList)) as *TextList;
    list.texts = List<*i8>.new();

    return list;
  }

  // Returns the list, so that a command line can be written as one chain.
  fn add(self: *TextList, text: *i8): *TextList {
    self.texts.push(text);
    return self;
  }

  fn at(self: *TextList, index: i32): *i8 {
    return self.texts.at(index);
  }

  fn size(self: *TextList): i32 {
    return self.texts.count;
  }

  // The list as execvp wants it, ending in a null that is not one of its
  // texts.
  fn argv(self: *TextList): **i8 {
    self.texts.push(null);
    self.texts.count = self.texts.count - 1;
    return self.texts.items;
  }
}

// ---------------------------------------------------------------------------
// Running programs.
// ---------------------------------------------------------------------------

// What happens to a child's stderr.
export enum StderrMode {
  Inherit,
  // Collected with its stdout, in the order the two were written.
  Merge,
  Discard,
}
// What happens to a child's stderr.

// Runs `command` and returns its exit status, or -1 if it could not be run
// or died on a signal.
//
// `dir`, when not null, is the directory it runs in. When `out` is not null
// the child's stdout is collected into it instead of going to ours, and so is
// its stderr under STDERR_MERGE.
export fn runCommand(command: *TextList, dir: *i8, out: *Buf,
                     stderrMode: StderrMode): i32 {
  let capturing: bool = out != null;
  let fds: *i32 = malloc(sizeof(i32) * 2) as *i32;
  if (capturing) {
    pipe(fds);
  }

  let devNull: *i8 = null;
  if (stderrMode == StderrMode.Discard) {
    devNull = fopen("/dev/null", "w");
  }

  let argv: **i8 = command.argv();
  let pid: i32 = fork();

  if (pid == 0) {
    if (capturing) {
      dup2(fds[1], 1);
      if (stderrMode == StderrMode.Merge) {
        dup2(fds[1], 2);
      }
      close(fds[0]);
      close(fds[1]);
    }
    if (devNull != null) {
      dup2(fileno(devNull), 2);
    }
    if (dir != null && chdir(dir) != 0) {
      _exit(127);
    }

    execvp(argv[0], argv);
    // Only reached when exec failed. The child must not return into the
    // parent's code, and must not flush the parent's buffers on the way out.
    _exit(127);
  }

  // Read to the end before waiting: a child whose output fills the pipe
  // would otherwise block forever on a parent that is waiting for it.
  if (capturing) {
    close(fds[1]);
    let chunk: *i8 = malloc(4096);
    while (pid > 0) {
      let count: i64 = read(fds[0], chunk, 4096);
      if (count <= 0) {
        break;
      }
      out.addBytes(chunk, count);
    }
    free(chunk);
    close(fds[0]);
  }

  if (devNull != null) {
    fclose(devNull);
  }

  if (pid < 0) {
    return -1;
  }

  let status: *i32 = malloc(sizeof(i32)) as *i32;
  waitpid(pid, status, 0);

  // WIFEXITED and WEXITSTATUS are macros in C, so they are written out here.
  if ((*status & 127) != 0) {
    return -1;
  }

  return (*status >> 8) & 255;
}

// ---------------------------------------------------------------------------
// The environment.
// ---------------------------------------------------------------------------

// The variable's value, or null when it is unset or empty.
export fn environment(name: *i8): *i8 {
  let value: *i8 = getenv(name);
  if (value == null || value[0] == 0) {
    return null;
  }

  return value;
}

export fn setEnvironment(name: *i8, value: *i8): void {
  setenv(name, value, 1);
}

export fn currentDirectory(): *i8 {
  let buffer: *i8 = malloc(4096);
  if (getcwd(buffer, 4096) == null) {
    return null;
  }

  return buffer;
}

export fn isTerminal(fd: i32): bool {
  return isatty(fd) != 0;
}

// ---------------------------------------------------------------------------
// Paths and files.
// ---------------------------------------------------------------------------

export fn joinPath(directory: *i8, name: *i8): *i8 {
  let out: *Buf = Buf.new();
  out.add(directory);
  if (strlen(directory) > 0 &&
      directory[strlen(directory) - 1] != '/') {
    out.push('/');
  }
  out.add(name);

  return out.take();
}

// `path` without its directory and extension, which is what a bare `ode foo.ode`
// names its output.
export fn stemOf(path: *i8): *i8 {
  let length: i64 = strlen(path);
  let start: i64 = 0;
  let end: i64 = length;

  for (index in 0..length) {
    if (path[index] == '/') {
      start = index + 1;
    }
    if (path[index] == '.') {
      end = index;
    }
  }

  if (end <= start) {
    end = length;
  }

  return textSlice(path, start, end - start);
}

export fn withSuffix(base: *i8, suffix: *i8): *i8 {
  let out: *Buf = Buf.new();
  out.add(base);
  out.add(suffix);

  return out.take();
}

// The directory holding `path`, without a trailing `/`: `/` for something at
// the root, and `.` for a bare name.
export fn parentDirectory(path: *i8): *i8 {
  let last: i64 = -1;
  let index: i64 = 0;

  while (path[index] != 0) {
    if (path[index] == '/') {
      last = index;
    }
    index = index + 1;
  }

  if (last < 0) {
    return ".";
  }
  if (last == 0) {
    return "/";
  }

  return textSlice(path, 0, last);
}

export fn fileExists(path: *i8): bool {
  return access(path, EXISTS) == 0;
}

export fn isExecutable(path: *i8): bool {
  return access(path, EXECUTABLE) == 0;
}

export fn absolutePath(path: *i8): *i8 {
  return realpath(path, null);
}

// A file's bytes, NULs included, or a null Buf if it cannot be read.
export fn readBytes(path: *i8): *Buf {
  let stream: *i8 = fopen(path, "rb");
  if (stream == null) {
    return null;
  }

  let out: *Buf = Buf.new();
  let chunk: *i8 = malloc(65536);
  while (true) {
    let count: i64 = fread(chunk, 1, 65536, stream);
    if (count <= 0) {
      break;
    }
    out.addBytes(chunk, count);
  }
  free(chunk);
  fclose(stream);

  return out;
}

export fn writeBytes(path: *i8, data: *Buf): bool {
  let stream: *i8 = fopen(path, "wb");
  if (stream == null) {
    return false;
  }

  let written: i64 = fwrite(data.data, 1, data.length, stream);
  fclose(stream);

  return written == data.length;
}

export fn sameBytes(a: *Buf, b: *Buf): bool {
  if (a.length != b.length) {
    return false;
  }

  return memcmp(a.data, b.data, a.length) == 0;
}

// Creates `path` and any directory above it that is missing.
export fn makeDirectories(path: *i8): bool {
  let length: i64 = strlen(path);
  let index: i64 = 1;

  while (index <= length) {
    if (index == length || path[index] == '/') {
      mkdir(textSlice(path, 0, index), 493);
    }
    index = index + 1;
  }

  return fileExists(path);
}

export fn removeTree(path: *i8): void {
  runCommand(TextList.new().add("rm").add("-rf").add(path), null,
             null, StderrMode.Inherit);
}

// Copies what is inside `from` into `to`, which must exist.
export fn copyTree(from: *i8, to: *i8): bool {
  let contents: *i8 = joinPath(from, ".");
  return runCommand(TextList.new().add("cp").add("-R").add(contents).add(to),
                    null, null, StderrMode.Inherit) == 0;
}

export fn moveFile(from: *i8, to: *i8): bool {
  return rename(from, to) == 0;
}

// The names in a directory, sorted, without `.` and `..`.
export fn listDirectory(path: *i8): *TextList {
  let output: *Buf = Buf.new();
  runCommand(TextList.new().add("ls").add("-1").add(path), null, output,
             StderrMode.Discard);

  return splitLines(output);
}

export fn splitLines(text: *Buf): *TextList {
  let lines: *TextList = TextList.new();
  let start: i64 = 0;
  let index: i64 = 0;

  while (index < text.length) {
    if (text.data[index] == '\n') {
      lines.add(textSlice(text.data, start, index - start));
      start = index + 1;
    }
    index = index + 1;
  }
  if (start < text.length) {
    lines.add(textSlice(text.data, start, text.length - start));
  }

  return lines;
}

// A fresh, empty directory under $TMPDIR, or /tmp without one.
export fn makeTempDirectory(prefix: *i8): *i8 {
  let base: *i8 = environment("TMPDIR");
  if (base == null) {
    base = "/tmp";
  }

  let template: *Buf = Buf.new();
  template.add(joinPath(base, prefix));
  template.add(".XXXXXX");

  return mkdtemp(template.take());
}

// ---------------------------------------------------------------------------
// Files.
// ---------------------------------------------------------------------------

export fn readFile(path: *i8): *i8 {
  let stream: *i8 = fopen(path, "r");
  if (stream == null) {
    return null;
  }

  fseek(stream, 0, SEEK_END);
  let size: i64 = ftell(stream);
  fseek(stream, 0, SEEK_SET);

  let text: *i8 = malloc(size + 1);
  let count: i64 = fread(text, 1, size, stream);
  fclose(stream);
  text[count] = 0;

  return text;
}

export fn writeFile(path: *i8, text: *i8): bool {
  let stream: *i8 = fopen(path, "w");
  if (stream == null) {
    return false;
  }

  let count: i64 = strlen(text);
  let written: i64 = fwrite(text, 1, count, stream);
  fclose(stream);

  return written == count;
}
