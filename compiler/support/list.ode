// ---------------------------------------------------------------------------
// List<T>: a growable array.
//
// The compiler is mostly lists -- of symbols, locals, names, arguments,
// scopes, modules -- and each used to be written out again for its element
// type: a pointer, a count, a capacity, and the same doubling realloc. This
// is that, once.
// ---------------------------------------------------------------------------

import { malloc, realloc } from "./libc";

export struct List<T> {
  items: *T,
  count: i32,
  capacity: i32,

  fn new(): *List<T> {
    let list: *List<T> = malloc(sizeof(List<T>)) as *List<T>;
    list.capacity = 8;
    list.count = 0;
    list.items = malloc(sizeof(T) * list.capacity as i64) as *T;

    return list;
  }

  // Returns the list, so that one can be built in a single chain.
  fn push(self: *List<T>, item: T): *List<T> {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = realloc(self.items as *i8,
                           sizeof(T) * self.capacity as i64) as *T;
    }

    self.items[self.count] = item;
    self.count = self.count + 1;

    return self;
  }

  fn at(self: *List<T>, index: i32): T {
    return self.items[index];
  }

  fn last(self: *List<T>): T {
    return self.items[self.count - 1];
  }

  fn pop(self: *List<T>): T {
    self.count = self.count - 1;
    return self.items[self.count];
  }

  // Drops every item from `count` on.
  fn truncate(self: *List<T>, count: i32): void {
    if (count < self.count) {
      self.count = count;
    }
  }
}
