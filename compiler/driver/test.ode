// ---------------------------------------------------------------------------
// `ode test <input.ode | directory> [filter]`: builds the program with its
// tests and a runner for its `main`, in a scratch directory, and runs it.
// The exit status is the runner's: 0 when every test that ran passed.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { readFile } from "std/fs";
import { Analyzer, analyze } from "../check/analyzer";
import { TEST_MODE, RUNNER_MODULE, runnerSource } from "../check/testing";
import { Emitter } from "../codegen/emitter";
import { genProgram } from "../codegen/program";
import { Problem } from "../diagnostics/problems";
import { printDiagnostics } from "../diagnostics/render";
import {
  SOURCE_PATH, Diagnostics, DIAGS, hasErrors, fail,
} from "../diagnostics/report";
import {
  USAGE, TestRunOptions, parseTestOptions, argumentsFrom,
} from "./options";
import {
  loadModule, loadProgram, loadFiles, buildExecutable, chooseTarget,
} from "./pipeline";
import { STD_DIRECTORY } from "../link/modules";
import {
  joinPath, parentDirectory, removeTree, isDirectory, findSources,
  makeTempDirectory,
} from "../os/files";
import { STDERR, writeText } from "../os/output";
import {
  TextList, StderrMode, runCommand, setEnvironment,
} from "../os/process";
import { NodeKind, Ast, Program } from "../syntax/ast";
import { exists } from "std/fs";
import { TARGET, targetsWasm, runsOnHost } from "../codegen/target";
import { TEST_PANIC } from "../codegen/testing";
import { Facts } from "../diagnostics/problems";
import { failAbout } from "../diagnostics/report";
import { executablePath } from "./library";
import { line } from "./options";

// Ode's runner for tests built for wasm32, beside the standard library.
let WASM_TEST_RUNNER: *i8 = "runners/wasm-test.mjs";

export fn testMain(argc: i32, argv: **i8): i32 {
  let options: TestRunOptions =
      parseTestOptions(argumentsFrom(argc, argv, 2)) catch (e) {
        writeText(STDERR, USAGE);
        return 2;
      };
  let path: *i8 = options.input;

  TEST_MODE = true;
  // The tests run elsewhere -- some compile programs of their own -- and
  // need this run's standard library too.
  if (STD_DIRECTORY != null) {
    setEnvironment("ODE_STD", STD_DIRECTORY);
  }
  SOURCE_PATH = path;
  DIAGS = Diagnostics.new();
  chooseTarget(options.build);

  let ast: *Ast = Ast.new();
  let root: i32 = ast.add(NodeKind.Program, 0, 0, Program { items: List<i32>.new() });

  // A directory is tested whole: every file in it, at any depth, and what
  // they import.
  if (isDirectory(path)) {
    let files: *TextList = findSources(path);
    if (files.size() == 0) {
      fail(Problem.NothingToTest);
    }
    loadFiles(ast, root, files);
  } else {
    let source: *i8 = readFile(path) catch (e) {
      fail(Problem.CannotOpenInput);
      return 1;
    };
    loadProgram(ast, root, path, source);
  }
  // On wasm32 the host runs the tests, not a main of the program's own.
  if (!targetsWasm()) {
    RUNNER_MODULE = loadModule(ast, root, "ode:testing", "ode:testing",
                               runnerSource());
  }
  SOURCE_PATH = path;

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  let an: *Analyzer = Analyzer.new(ast);
  analyze(an, root);

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }
  // A failed check tells the runner why, unless the program says itself.
  if (targetsWasm() && an.panicHandler == null) {
    an.panicHandler = TEST_PANIC;
  }

  // Found before building, so that a missing one is said at once.
  let run: *TextList = testRunner(options);
  let module: *i8 = genProgram(Emitter.new(ast, an), root);

  let directory: *i8 = makeTempDirectory("ode-test") catch (e) {
    fail(Problem.CannotMakeScratchDirectory);
    return 1;
  };
  let program: *i8 = joinPath(directory, "tests");
  if (targetsWasm()) {
    program = joinPath(directory, "tests.wasm");
    options.build.link.exports.push("ode_test_count");
    options.build.link.exports.push("ode_test_name");
    options.build.link.exports.push("ode_test_run");
  }
  buildExecutable(module, program, false, options.build.link);

  run.add(program);
  if (options.filter != null) {
    run.add(options.filter);
  }
  // A runner that crashed has not said how the tests went: that is a
  // failure.
  let status: i32 = runCommand(run, null, null, StderrMode.Inherit) ?? 1;

  removeTree(directory);
  return status;
}

// What runs the test program: --runner, split into words; Node with Ode's
// runner for a wasm32 module; nothing for a program this machine runs
// itself. A program for another machine with no runner is not built at
// all, since it could not be run.
fn testRunner(options: TestRunOptions): *TextList {
  let run: *TextList = TextList.new();
  if (options.runner != null) {
    let words: *List<*i8> = line(options.runner);
    for (index in 0..words.count) {
      run.add(words.at(index));
    }
    return run;
  }

  if (targetsWasm()) {
    let node: *i8 = executablePath("node");
    if (node == null) {
      failAbout(Problem.NoTestRunner, Facts.about(TARGET.triple()));
    }
    let script: *i8 = null;
    if (STD_DIRECTORY != null) {
      script = joinPath(parentDirectory(STD_DIRECTORY), WASM_TEST_RUNNER);
    }
    if (script == null || !exists(script)) {
      failAbout(Problem.WasmRunnerNotFound, Facts.about(WASM_TEST_RUNNER));
    }
    return run.add(node).add(script);
  }

  if (!runsOnHost()) {
    failAbout(Problem.NoTestRunner, Facts.about(TARGET.triple()));
  }
  return run;
}
