// ---------------------------------------------------------------------------
// The command line: what `ode` and `ode test` were asked to do.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { equals, slice, startsWith } from "std/text";
import { LinkInputs } from "../codegen/toolchain";
import { dumpTokens } from "../syntax/dump";

export let USAGE: *i8 = `
  usage: ode [-o <path>] [--keep-intermediates] [--emit-llvm | --emit-object] [--dump-tokens | --dump-ast | --dump-types]
             [--release] [--target <arch-os[-abi]>] [--sysroot <dir>] [-l <lib>] [-L <dir>] [-framework <name>] <input.ode>
         ode test [--release] [-l <lib>] [-L <dir>] [-framework <name>] <input.ode | directory> [filter]
                                                     runs the tests in a program, or in every file under a directory
         ode build [step] [options]   builds what build.ode declares, or this compiler in its repository (ode build --help)
`;

export error enum UsageError {
  // A flag `ode` does not know.
  UnknownFlag,
  // A flag that takes a value, last on the line.
  MissingValue,
  // No input file, or no directory to test.
  NoInput,
  // A second input, where one is taken.
  TooManyInputs,
}

// How a program is built and linked, which `ode` and `ode test` share.
export struct BuildFlags {
  // `arch-os[-abi]`, as given; null for the C compiler's default.
  target: *i8,
  // The target's headers and libraries; null for the SDK xcrun knows, or
  // for none.
  sysroot: *i8,
  link: *LinkInputs,
  // Optimise: clang's -O2 rather than none.
  release: bool,

  fn new(): BuildFlags {
    return BuildFlags {
      target: null, sysroot: null, link: LinkInputs.new(), release: false,
    };
  }
}

// What `ode <input.ode>` was asked to do.
export struct CompileOptions {
  input: *i8,
  // Where the executable goes; null for beside the working directory,
  // named after the input.
  output: *i8,
  dumpTokens: bool,
  dumpAst: bool,
  dumpTypes: bool,
  emitLlvm: bool,
  // Stop at the object file: what building for a target with no sysroot to
  // link against can still give.
  emitObject: bool,
  keepIntermediates: bool,
  build: BuildFlags,
}

// The value of the flag at `*index`, written after it (`-L dir`) or, for a
// one-letter flag, joined to it (`-Ldir`). Leaves `*index` on the last
// argument it used.
fn flagValue(arguments: *List<*i8>, index: *i64, flag: *i8): *i8 | UsageError {
  let argument: *i8 = arguments.at(*index);
  if (!equals(argument, flag)) {
    return argument + 2;
  }
  *index = *index + 1;
  if (*index >= arguments.count) {
    return UsageError.MissingValue;
  }
  return arguments.at(*index);
}

// Takes the flag at `*index` into `flags` if it is one of theirs, and says
// whether it was.
fn parseBuildFlag(arguments: *List<*i8>, index: *i64,
                  flags: *BuildFlags): bool | UsageError {
  let argument: *i8 = arguments.at(*index);
  if (equals(argument, "--release")) {
    flags.release = true;
  } else if (equals(argument, "--target")) {
    flags.target = try flagValue(arguments, index, argument);
  } else if (equals(argument, "--sysroot")) {
    flags.sysroot = try flagValue(arguments, index, argument);
  } else if (equals(argument, "-framework")) {
    flags.link.frameworks.push(try flagValue(arguments, index, argument));
  } else if (startsWith(argument, "-l")) {
    flags.link.libraries.push(try flagValue(arguments, index, "-l"));
  } else if (startsWith(argument, "-L")) {
    flags.link.paths.push(try flagValue(arguments, index, "-L"));
  } else {
    return false;
  }
  return true;
}

// `arguments` are the command line after the program's name.
export fn parseCompileOptions(arguments: *List<*i8>): CompileOptions | UsageError {
  let options: CompileOptions = CompileOptions {
    input: null, output: null, dumpTokens: false, dumpAst: false,
    dumpTypes: false, emitLlvm: false, emitObject: false,
    keepIntermediates: false, build: BuildFlags.new(),
  };

  let index: i64 = 0;
  while (index < arguments.count) {
    let argument: *i8 = arguments.at(index);
    if (try parseBuildFlag(arguments, &index, &options.build)) {
      // Taken.
    } else if (equals(argument, "--dump-tokens")) {
      options.dumpTokens = true;
    } else if (equals(argument, "--dump-ast")) {
      options.dumpAst = true;
    } else if (equals(argument, "--dump-types")) {
      options.dumpTypes = true;
    } else if (equals(argument, "--emit-llvm")) {
      options.emitLlvm = true;
    } else if (equals(argument, "--emit-object")) {
      options.emitObject = true;
    } else if (equals(argument, "--keep-intermediates")) {
      options.keepIntermediates = true;
    } else if (equals(argument, "-o")) {
      index = index + 1;
      if (index >= arguments.count) {
        return UsageError.MissingValue;
      }
      options.output = arguments.at(index);
    } else if (argument[0] == '-') {
      return UsageError.UnknownFlag;
    } else if (options.input != null) {
      return UsageError.TooManyInputs;
    } else {
      options.input = argument;
    }
    index = index + 1;
  }

  if (options.input == null) {
    return UsageError.NoInput;
  }
  return options;
}

// What `ode test <path> [filter]` was asked to do.
export struct TestRunOptions {
  // A file, or a directory whose every .ode file is tested.
  input: *i8,
  // Only tests whose name holds this run; null for all of them.
  filter: *i8,
  // What the tests link against. Never a target: they run here.
  build: BuildFlags,
}

// `arguments` are the command line after `ode test`.
export fn parseTestOptions(arguments: *List<*i8>): TestRunOptions | UsageError {
  let options: TestRunOptions = TestRunOptions {
    input: null, filter: null, build: BuildFlags.new(),
  };

  let index: i64 = 0;
  while (index < arguments.count) {
    let argument: *i8 = arguments.at(index);
    if (try parseBuildFlag(arguments, &index, &options.build)) {
      if (options.build.target != null) {
        return UsageError.UnknownFlag;
      }
    } else if (argument[0] == '-') {
      return UsageError.UnknownFlag;
    } else if (options.input == null) {
      options.input = argument;
    } else if (options.filter == null) {
      options.filter = argument;
    } else {
      return UsageError.TooManyInputs;
    }
    index = index + 1;
  }

  if (options.input == null) {
    return UsageError.NoInput;
  }
  return options;
}

// argv from `first` on, as a list.
export fn argumentsFrom(argc: i32, argv: **i8, first: i32): *List<*i8> {
  let list: *List<*i8> = List<*i8>.new();
  for (index in first..argc) {
    list.push(argv[index]);
  }
  return list;
}

export fn line(text: *i8): *List<*i8> {
  let list: *List<*i8> = List<*i8>.new();
  let start: i64 = 0;
  let index: i64 = 0;
  while (true) {
    if (text[index] == ' ' || text[index] == '\0') {
      if (index > start) {
        list.push(slice(text, start, index - start));
      }
      if (text[index] == '\0') {
        return list;
      }
      start = index + 1;
    }
    index = index + 1;
  }
  return list;
}

test "a compile takes flags in any order, and one input" {
  let options: CompileOptions =
      parseCompileOptions(line("--emit-llvm main.ode -o out/prog")) catch (e) {
        assert(false, "a valid command line was rejected");
        return;
      };
  assertEq(options.input, "main.ode");
  assertEq(options.output, "out/prog");
  assert(options.emitLlvm);
  assert(!options.keepIntermediates);
}

test "a compile rejects what it cannot make sense of" {
  assertEq(parseCompileOptions(line("")), UsageError.NoInput);
  assertEq(parseCompileOptions(line("--emit-llvm")), UsageError.NoInput);
  assertEq(parseCompileOptions(line("main.ode -o")), UsageError.MissingValue);
  assertEq(parseCompileOptions(line("main.ode --fast")), UsageError.UnknownFlag);
  assertEq(parseCompileOptions(line("a.ode b.ode")), UsageError.TooManyInputs);
}

test "a compile takes what to build for and what to link" {
  let options: CompileOptions = parseCompileOptions(line(
      "--target x86_64-linux-musl -lraylib -L vendor/lib -framework Cocoa -l m main.ode"))
      catch (e) {
        assert(false, "a valid command line was rejected");
        return;
      };
  assertEq(options.input, "main.ode");
  assertEq(options.build.target, "x86_64-linux-musl");
  assertEq(options.build.link.libraries.count, 2);
  assertEq(options.build.link.libraries.at(0), "raylib");
  assertEq(options.build.link.libraries.at(1), "m");
  assertEq(options.build.link.paths.at(0), "vendor/lib");
  assertEq(options.build.link.frameworks.at(0), "Cocoa");
  assert(!options.build.release);
  assert((parseCompileOptions(line("--release main.ode")) ?? options).build.release);
  assertEq(parseCompileOptions(line("main.ode -framework")), UsageError.MissingValue);
  assertEq(parseCompileOptions(line("main.ode --target")), UsageError.MissingValue);
}

test "a test run takes an input and, maybe, a filter" {
  let options: TestRunOptions = parseTestOptions(line("compiler lexer")) catch (e) {
    assert(false, "a valid command line was rejected");
    return;
  };
  assertEq(options.input, "compiler");
  assertEq(options.filter, "lexer");
  assertEq((parseTestOptions(line("math.ode")) ?? options).filter, null);
}

test "a test run rejects what it cannot make sense of" {
  assertEq(parseTestOptions(line("")), UsageError.NoInput);
  assertEq(parseTestOptions(line("a b c")), UsageError.TooManyInputs);
  assertEq(parseTestOptions(line("--all")), UsageError.UnknownFlag);
  assertEq(parseTestOptions(line("--target x86_64-linux a.ode")), UsageError.UnknownFlag);
}

test "a test run links what it is told to" {
  let options: TestRunOptions = parseTestOptions(line("-lraylib src gui")) catch (e) {
    assert(false, "a valid command line was rejected");
    return;
  };
  assertEq(options.input, "src");
  assertEq(options.filter, "gui");
  assertEq(options.build.link.libraries.at(0), "raylib");
}
