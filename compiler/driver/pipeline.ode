// ---------------------------------------------------------------------------
// The pipeline: loading a program and the files it imports, and turning
// emitted IR into an executable. The driver runs it from the command line,
// and the test harness runs it on snippets.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { readFile, writeFile, removeFile } from "std/fs";
import { equals } from "std/text";
import { before } from "../check/analyzer";
import { parseTarget, TARGET } from "../codegen/target";
import { LibcError, bundledLibc, muslLinkCommand } from "../codegen/libc";
import {
  targetsWasm, targetModuleSource, TARGET_IMPORT, TARGET_MODULE,
} from "../codegen/target";
import { wasmLinkCommand } from "../codegen/wasm";
import {
  ccCommand, linkCommand, chooseSysroot, linksWithoutLibraries,
  usesBundledLibc, LinkInputs, RELEASE,
} from "../codegen/toolchain";
import { Problem, Facts } from "../diagnostics/problems";
import { BuildFlags } from "./options";
import { registerSource } from "../diagnostics/render";
import {
  SOURCE_PATH, DIAGS, FAILED, report, hasErrors, fail, failAbout,
} from "../diagnostics/report";
import {
  moduleAdd, moduleDisplayPath, moduleFind, modulePath, STD_DIRECTORY,
  isPathImport, isStdImport, resolveImportPath,
} from "../link/modules";
import { joinPath, withSuffix, realpath } from "../os/files";
import { TextList, StderrMode, runCommand, ran } from "../os/process";
import {
  NodeKind, Ast, importModule, itemAt, itemCount, nodeName, setImportModule,
} from "../syntax/ast";
import { tokenize } from "../syntax/lexer";
import { Parser } from "../syntax/parser";
import { parseModuleInto } from "../syntax/statements";
import { TokenList } from "../syntax/token";

// Reads, lexes and parses one file onto the end of `program`. The lexer stops
// the compile at its first error, so a file that cannot be lexed ends the run
// here.
export fn loadModule(ast: *Ast, program: i32, path: *i8, real: *i8,
              source: *i8): i32 {
  let module: i32 = moduleAdd(path, real);
  SOURCE_PATH = moduleDisplayPath(module);
  registerSource(SOURCE_PATH, source);

  // A file that did not lex is not parsed: the parser would only report the
  // holes the lexer left.
  let before: i32 = DIAGS.total;
  let tokens: *TokenList = tokenize(source);
  ast.currentModule = module;
  if (DIAGS.total == before) {
    parseModuleInto(Parser.new(tokens, ast), program);
  }

  return module;
}

// `std/target`, which is written for the build rather than read from a file,
// and loaded the first time any file asks.
fn loadTargetModule(ast: *Ast, program: i32, item: i32): void {
  if (TARGET_MODULE < 0) {
    let path: *i8 = "std/target.ode";
    if (STD_DIRECTORY != null) {
      path = joinPath(STD_DIRECTORY, "target.ode");
    }
    TARGET_MODULE = loadModule(ast, program, path, "ode:target",
                               targetModuleSource());
  }
  setImportModule(ast, item, TARGET_MODULE);
}

// Files an editor has open, by their real paths, with what it holds for
// them: an import reads one of these rather than the file on disk, which
// may not have been saved. Only the language server sets any.
struct EditedFile {
  real: *i8,
  source: *i8,
}

let EDITED: *List<EditedFile> = null;

// What the editor holds for the file at `real`, until it is set again;
// null forgets it.
export fn setEditedSource(real: *i8, source: *i8): void {
  if (EDITED == null) {
    EDITED = List<EditedFile>.new();
  }
  for (index in 0..EDITED.count) {
    if (equals(EDITED.at(index).real, real)) {
      if (source == null) {
        EDITED.set(index, EDITED.last());
        EDITED.pop();
      } else {
        EDITED.set(index, EditedFile { real: real, source: source });
      }
      return;
    }
  }
  if (source != null) {
    EDITED.push(EditedFile { real: real, source: source });
  }
}

fn editedSource(real: *i8): *i8 {
  if (EDITED == null) {
    return null;
  }
  for (index in 0..EDITED.count) {
    if (equals(EDITED.at(index).real, real)) {
      return EDITED.at(index).source;
    }
  }
  return null;
}

// Finds the file an import names, loading it the first time any file asks.
fn loadImport(ast: *Ast, program: i32, item: i32): void {
  let importer: *i8 = modulePath(ast.nodes[item].module);
  let spec: *i8 = nodeName(ast, item);
  if (equals(spec, TARGET_IMPORT)) {
    loadTargetModule(ast, program, item);
    return;
  }
  let path: *i8 = resolveImportPath(importer, spec);
  let real: *i8 = null;
  if (path != null) {
    real = realpath(path, null);
  }
  let source: *i8 = null;

  if (real != null) {
    let loaded: i32 = moduleFind(real);
    if (loaded >= 0) {
      setImportModule(ast, item, loaded);
      return;
    }
    // A file that cannot be read is reported below as one that is missing.
    source = editedSource(real);
    if (source == null) {
      source = readFile(path) ?? null;
    }
  }

  if (source == null) {
    // Why, when it is not just a missing file.
    let problem: Problem = Problem.ModuleNotFound;
    if (!isPathImport(spec) && !isStdImport(spec)) {
      problem = Problem.ImportNotAPath;
    } else if (!isPathImport(spec) && STD_DIRECTORY == null) {
      problem = Problem.LibraryNotFound;
    }
    SOURCE_PATH = moduleDisplayPath(ast.nodes[item].module);
    report(problem, ast.nodes[item].line, ast.nodes[item].column,
           Facts.about(spec));
    FAILED = false;
    // Tried, and reported: not to be tried again.
    setImportModule(ast, item, -2);
    return;
  }

  setImportModule(ast, item, loadModule(ast, program, path, real, source));
}

// Parses the file at `path`, whose tokens are `tokens`, and every file it
// imports, onto `root`. Imports are followed breadth first: a loaded file's
// declarations land on the end of the program's list, so walking the list to
// its end reaches every file's imports, and a file asked for twice is found
// by its real path.
export fn loadProgram(ast: *Ast, root: i32, path: *i8, source: *i8): void {
  let real: *i8 = realpath(path, null);
  if (real == null) {
    real = path;
  }
  // Named as every diagnostic about it names it: a library file, entered
  // directly, is `std/<name>.ode` like any other.
  let shown: *i8 = moduleDisplayPath(moduleAdd(path, real));
  registerSource(shown, source);
  SOURCE_PATH = shown;
  let tokens: *TokenList = tokenize(source);
  // Tokens from a file that did not lex would only parse into more errors.
  if (hasErrors()) {
    SOURCE_PATH = shown;
    return;
  }
  parseModuleInto(Parser.new(tokens, ast), root);

  loadImports(ast, root);
  SOURCE_PATH = shown;
}

// Loads every file in `paths` onto `root`, with what they import, as one
// program -- which is how `ode test` tests a directory. A file another one
// imported first is loaded once.
export fn loadFiles(ast: *Ast, root: i32, paths: *TextList): void {
  for (index in 0..paths.size()) {
    let path: *i8 = paths.at(index);
    let real: *i8 = realpath(path, null);
    if (real != null && moduleFind(real) >= 0) {
      continue;
    }
    if (real == null) {
      real = path;
    }

    let source: *i8 = readFile(path) catch (e) {
      SOURCE_PATH = path;
      report(Problem.CannotOpenInput, 0, 0, Facts.none());
      FAILED = false;
      continue;
    };
    loadModule(ast, root, path, real, source);
    loadImports(ast, root);
  }
  SOURCE_PATH = paths.at(0);
}

// Follows the imports of everything on `root` so far. Imports are followed
// breadth first: a loaded file's declarations land on the end of the
// program's list, so walking the list to its end reaches every file's.
fn loadImports(ast: *Ast, root: i32): void {
  let item: i32 = 0;
  while (item < itemCount(ast, root)) {
    let statement: i32 = itemAt(ast, root, item);
    if (ast.nodes[statement].kind == NodeKind.Import &&
        importModule(ast, statement) < 0) {
      loadImport(ast, root, statement);
    }
    item = item + 1;
  }
}

// Sets what this run builds for, and whether it optimises, before anything
// is emitted: the IR names
// the target, and every run of the C compiler is told it.
export fn chooseTarget(flags: BuildFlags): void {
  RELEASE = flags.release;
  if (flags.sysroot != null) {
    chooseSysroot(flags.sysroot);
  }
  if (flags.target == null) {
    return;
  }
  TARGET = parseTarget(flags.target) catch (e) {
    failAbout(Problem.UnknownTarget, Facts.about(flags.target));
    return;
  };
}

// Writes `module` to `<base>.ll` and assembles it into `<base>.o`, which it
// returns.
export fn buildObject(module: *i8, base: *i8, keepIntermediates: bool): *i8 {
  let irPath: *i8 = withSuffix(base, ".ll");
  writeFile(irPath, module) catch (e) {
    fail(Problem.CannotWriteIr);
  };

  let objectPath: *i8 = withSuffix(base, ".o");
  let assemble: *TextList = ccCommand();
  assemble.add("-c").add(irPath).add("-o").add(objectPath);
  assemble.add("-Wno-override-module");
  if (RELEASE) {
    assemble.add("-O2");
  }
  if (!ran(runCommand(assemble, null, null, StderrMode.Inherit))) {
    fail(Problem.AssemblingFailed);
  }

  if (!keepIntermediates) {
    // Leaving it behind is untidy, not wrong.
    removeFile(irPath) catch (e) {};
  }
  return objectPath;
}

// Turns `module` into the executable `output`, linked against `inputs`.
// Assembling and linking are two runs of the C compiler, which is what
// leaves a `.o` beside the `.ll` -- the two things worth looking at when
// codegen misbehaves.
export fn buildExecutable(module: *i8, output: *i8, keepIntermediates: bool,
                          inputs: *LinkInputs): void {
  let objectPath: *i8 = buildObject(module, output, keepIntermediates);

  let link: *TextList = linkCommand();
  if (targetsWasm()) {
    wasmLinkCommand(link, objectPath, output, inputs);
  } else if (usesBundledLibc()) {
    let libc: *i8 = bundledLibc(*TARGET) catch (e) {
      failAbout(match (e) {
        .NoSources => Problem.LibcSourcesNotFound,
        .NoArchiver => Problem.LibcNeedsArchiver,
        .NoCache => Problem.LibcCacheUnusable,
        .BuildFailed => Problem.LibcBuildFailed,
      }, Facts.about(TARGET.triple()));
      return;
    };
    muslLinkCommand(link, libc, objectPath, output, inputs);
  } else {
    link.add(objectPath).add("-o").add(output);
    inputs.addTo(link);
  }
  if (!ran(runCommand(link, null, null, StderrMode.Inherit))) {
    if (linksWithoutLibraries()) {
      failAbout(Problem.LinkingNeedsSysroot, Facts.about(TARGET.triple()));
    }
    fail(Problem.LinkingFailed);
  }

  if (!keepIntermediates) {
    removeFile(objectPath) catch (e) {};
  }
}
