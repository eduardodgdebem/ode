// ---------------------------------------------------------------------------
// Imports and exports: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../support/problems";
import { Diagnostic } from "../support/diagnostics";
import { Scope } from "../testkit";

test "import bare name" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        import { List } from "collections/list";
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ImportNotAPath);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "collections/list");
}

test "import unknown std module" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        import { Missing } from "std/missing";
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ModuleNotFound);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "std/missing");
}
