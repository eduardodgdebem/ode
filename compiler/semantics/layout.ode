// ---------------------------------------------------------------------------
// Sizes and alignment.
//
// The sizes have to agree with what LLVM computes for the target, because
// `sizeof` and pointer arithmetic are built on them. These are the rules LLVM
// uses for a non-packed struct: every field starts at its own alignment, and
// the whole is rounded up to the widest field's. They live with the types
// rather than in codegen because `sizeof` is also folded into constants.
// ---------------------------------------------------------------------------

import { TypeKind, Type, StructTable } from "./types";
import { valueOf } from "./errors";

fn alignOf(structs: *StructTable, type: Type): i32 {
  if (type.isPointer() || type.isFunction()) {
    return 8;
  }
  // A union is laid out as { i32 code, value }.
  if (type.isUnion()) {
    let value: i32 = alignOf(structs, valueOf(type));
    if (value > 4) {
      return value;
    }
    return 4;
  }

  if (type.kind == TypeKind.Struct) {
    let structIndex: i32 = structs.indexOf(type.structName);
    let widest: i32 = 1;

    for (index in 0..structs.items[structIndex].count) {
      let fieldAlign: i32 =
          alignOf(structs, structs.items[structIndex].fields[index].type);
      if (fieldAlign > widest) {
        widest = fieldAlign;
      }
    }

    return widest;
  }

  if (type.kind == TypeKind.Bool) { return 1; }

  let bits: i32 = type.bitWidth();
  if (bits == 0) {
    return 1;
  }

  return bits / 8;
}

fn alignUp(value: i32, alignment: i32): i32 {
  let remainder: i32 = value % alignment;
  if (remainder == 0) {
    return value;
  }

  return value + alignment - remainder;
}

export fn sizeOf(structs: *StructTable, type: Type): i32 {
  if (type.isPointer() || type.isFunction()) {
    return 8;
  }
  if (type.isUnion()) {
    let value: Type = valueOf(type);
    if (value.isVoid()) {
      return 4;
    }
    let offset: i32 = alignUp(4, alignOf(structs, value));
    return alignUp(offset + sizeOf(structs, value), alignOf(structs, type));
  }

  if (type.kind == TypeKind.Struct) {
    let structIndex: i32 = structs.indexOf(type.structName);
    let offset: i32 = 0;

    for (index in 0..structs.items[structIndex].count) {
      let fieldType: Type = structs.items[structIndex].fields[index].type;
      offset = alignUp(offset, alignOf(structs, fieldType));
      offset = offset + sizeOf(structs, fieldType);
    }

    return alignUp(offset, alignOf(structs, type));
  }

  // An i1 occupies a whole byte once it is stored.
  if (type.kind == TypeKind.Bool) { return 1; }
  if (type.kind == TypeKind.Void) { return 0; }

  return type.bitWidth() / 8;
}
