// ---------------------------------------------------------------------------
// Declarations -- structs, externs, the program as a whole: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../support/problems";
import { Diagnostic } from "../support/diagnostics";
import { Scope } from "../testkit";

test "duplicate declaration" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: i32 = 1;
        let value: i32 = 2;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AlreadyDeclared);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "value");
}

test "duplicate struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }

        struct Point {
          y: i32,
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicateStruct);
  assertEq(found.at(0).line, 5);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "Point");
}

test "duplicate struct field" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
          x: i32,
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicateField);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "Point");
  assertEq(found.at(0).facts.other, "x");
}

test "extern returns struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }

        extern fn origin(): Point;
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ExternReturnsStruct);
  assertEq(found.at(0).line, 5);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "origin");
}

test "extern takes struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }

        extern fn plot(point: Point): void;
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ExternTakesStruct);
  assertEq(found.at(0).line, 5);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "plot");
}

test "function type unknown struct" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let f: fn(Missing): i32 = null;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnknownType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "Missing");
}

test "method body errors" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,

          fn first(self: Point): bool {
            return self.x;
          }

          fn second(self: Point): i32 {
            return self.missing;
          }

          fn third(self: Point): Unknown {
            return self.x;
          }
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 4);
  assertEq(found.at(0).problem, Problem.UnknownType);
  assertEq(found.at(0).line, 12);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Unknown");
  assertEq(found.at(1).problem, Problem.WrongReturnType);
  assertEq(found.at(1).line, 5);
  assertEq(found.at(1).column, 12);
  assertEq(found.at(2).problem, Problem.NoSuchField);
  assertEq(found.at(2).line, 9);
  assertEq(found.at(2).column, 17);
  assertEq(found.at(2).facts.name, "Point");
  assertEq(found.at(2).facts.other, "missing");
  assertEq(found.at(3).problem, Problem.WrongReturnType);
  assertEq(found.at(3).line, 13);
  assertEq(found.at(3).column, 12);
}

test "recursive struct by value" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Node {
          next: Node,
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.RecursiveStruct);
  assertEq(found.at(0).facts.name, "Node");
}

