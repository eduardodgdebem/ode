test "void variable" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let nothing: void = 0;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VoidVariable);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "nothing");
}
