test "unknown type" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: Missing = 1;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnknownType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "Missing");
}

test "variadic non extern" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn sum(count: i32, ...): i32 {
          return count;
        }
      `)
      .returning("i32")
      .run(`
        return sum(0);
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VariadicFunction);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "sum");
}

test "void struct field" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
