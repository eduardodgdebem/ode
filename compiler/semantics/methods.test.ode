// ---------------------------------------------------------------------------
// Methods: what checking rejects.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../support/problems";
import { Diagnostic } from "../support/diagnostics";
import { problemsIn } from "../testkit";

test "duplicate method" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,

      fn get(self: Point): i32 {
        return self.x;
      }

      fn get(self: *Point): i32 {
        return self.x;
      }
    }

    fn main(): i32 {
      return 0;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicateMethod);
  assertEq(found.at(0).line, 8);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Point.get");
}

test "method not found" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,
      y: i32,

      fn new(x: i32, y: i32): Point {
        return Point { x: x, y: y };
      }

      fn sum(self: Point): i32 {
        return self.x + self.y;
      }

      fn shift(self: *Point, by: i32): void {
        self.x = self.x + by;
      }
    }

    fn main(): i32 {
      let p: Point = Point.new(1, 2);
      return p.product();
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NoSuchMethod);
  assertEq(found.at(0).line, 20);
  assertEq(found.at(0).column, 12);
  assertEq(found.at(0).facts.name, "Point");
  assertEq(found.at(0).facts.other, "product");
}

test "method on non struct" {
  let found: *List<Diagnostic> = problemsIn(`
    fn main(): i32 {
      let count: i32 = 3;
      return count.abs();
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.MethodOfNonStruct);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 16);
  assertEq(found.at(0).facts.name, "abs");
}

test "method self wrong type" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,

      fn bad(self: i32): i32 {
        return self;
      }

      fn worse(self: **Point): i32 {
        return 0;
      }
    }

    fn main(): i32 {
      return 0;
    }
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.SelfWrongType);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Point.bad");
  assertEq(found.at(0).facts.other, "Point");
  assertEq(found.at(1).problem, Problem.SelfWrongType);
  assertEq(found.at(1).line, 8);
  assertEq(found.at(1).column, 3);
  assertEq(found.at(1).facts.name, "Point.worse");
  assertEq(found.at(1).facts.other, "Point");
}

test "pointer method on temporary" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,
      y: i32,

      fn new(x: i32, y: i32): Point {
        return Point { x: x, y: y };
      }

      fn sum(self: Point): i32 {
        return self.x + self.y;
      }

      fn shift(self: *Point, by: i32): void {
        self.x = self.x + by;
      }
    }

    fn main(): i32 {
      Point.new(1, 2).shift(5);
      return 0;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.MethodOnTemporary);
  assertEq(found.at(0).line, 19);
  assertEq(found.at(0).column, 19);
  assertEq(found.at(0).facts.name, "Point.shift");
}

test "static method not found" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,
      y: i32,

      fn new(x: i32, y: i32): Point {
        return Point { x: x, y: y };
      }

      fn sum(self: Point): i32 {
        return self.x + self.y;
      }

      fn shift(self: *Point, by: i32): void {
        self.x = self.x + by;
      }
    }

    fn main(): i32 {
      let p: Point = Point.origin();
      return p.x;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NoSuchMethod);
  assertEq(found.at(0).line, 19);
  assertEq(found.at(0).column, 24);
  assertEq(found.at(0).facts.name, "Point");
  assertEq(found.at(0).facts.other, "origin");
}

test "static method on value" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Point {
      x: i32,
      y: i32,

      fn new(x: i32, y: i32): Point {
        return Point { x: x, y: y };
      }

      fn sum(self: Point): i32 {
        return self.x + self.y;
      }

      fn shift(self: *Point, by: i32): void {
        self.x = self.x + by;
      }
    }

    fn main(): i32 {
      let p: Point = Point.new(1, 2);
      let q: Point = p.new(3, 4);
      return q.x;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NoSelf);
  assertEq(found.at(0).line, 20);
  assertEq(found.at(0).column, 20);
  assertEq(found.at(0).facts.name, "Point.new");
}

test "variadic method" {
  let found: *List<Diagnostic> = problemsIn(`
    struct Log {
      level: i32,

      fn write(self: Log, format: *i8, ...): void {}
    }

    fn main(): i32 {
      return 0;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VariadicMethod);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Log.write");
}
