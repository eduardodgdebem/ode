// ---------------------------------------------------------------------------
// The symbol table.
//
// Scopes are a flat stack of symbols plus the index each scope starts at,
// rather than a stack of maps: entering a scope pushes a marker and leaving
// one truncates back to it. Lookup walks backwards, so an inner declaration
// shadows an outer one for free.
// ---------------------------------------------------------------------------

import { malloc, realloc } from "../support/libc";
import { nullText, Buf, textEquals } from "../support/text";
import { report } from "../support/diagnostics";
import { Type } from "./types";

export let SYM_VAR: i32 = 1;
export let SYM_FN: i32 = 2;

export struct Symbol {
  name: *i8,
  kind: i32,
  // For a function this is the return type.
  type: Type,
  params: *Type,
  paramCount: i32,
  // What the IR calls a top-level declaration, which differs from `name` when
  // two files use one name or when an import renames it. Null for a local.
  linkName: *i8,
}

export struct SymbolTable {
  items: *Symbol,
  count: i32,
  capacity: i32,
  scopeStarts: *i32,
  scopeCount: i32,
  scopeCapacity: i32,

  fn new(): *SymbolTable {
    let table: *SymbolTable = malloc(sizeof(SymbolTable) as i64) as *SymbolTable;
    table.capacity = 64;
    table.count = 0;
    table.items = malloc(sizeof(Symbol) as i64 * table.capacity as i64) as *Symbol;
    table.scopeCapacity = 16;
    table.scopeCount = 0;
    table.scopeStarts =
        malloc(sizeof(i32) as i64 * table.scopeCapacity as i64) as *i32;

    table.enterScope();

    return table;
  }

  fn enterScope(self: *SymbolTable): void {
    if (self.scopeCount == self.scopeCapacity) {
      self.scopeCapacity = self.scopeCapacity * 2;
      self.scopeStarts =
          realloc(self.scopeStarts as *i8,
                  sizeof(i32) as i64 * self.scopeCapacity as i64) as *i32;
    }

    self.scopeStarts[self.scopeCount] = self.count;
    self.scopeCount = self.scopeCount + 1;
  }

  fn exitScope(self: *SymbolTable): void {
    if (self.scopeCount == 0) {
      return;
    }

    self.scopeCount = self.scopeCount - 1;
    self.count = self.scopeStarts[self.scopeCount];
  }

  // Innermost first, so a shadowing declaration wins.
  // Undoes the scopes an abandoned statement left open.
  fn truncateScopes(self: *SymbolTable, depth: i32): void {
    while (self.scopeCount > depth) {
      self.exitScope();
    }
  }

  fn find(self: *SymbolTable, name: *i8): i32 {
    let index: i32 = self.count - 1;

    while (index >= 0) {
      if (textEquals(self.items[index].name, name)) {
        return index;
      }
      index = index - 1;
    }

    return -1;
  }

  // Only the innermost scope, which is what a redeclaration check needs: the
  // same name in an enclosing scope is shadowing, not a conflict.
  fn findInScope(self: *SymbolTable, name: *i8): i32 {
    let start: i32 = self.scopeStarts[self.scopeCount - 1];
    let index: i32 = self.count - 1;

    while (index >= start) {
      if (textEquals(self.items[index].name, name)) {
        return index;
      }
      index = index - 1;
    }

    return -1;
  }

  fn declare(self: *SymbolTable, name: *i8, kind: i32, type: Type,
             params: *Type, paramCount: i32, line: i32,
             column: i32): void {
    if (self.findInScope(name) >= 0) {
      let message: *Buf = Buf.new();
      message.add("symbol '");
      message.add(name);
      message.add("' already declared in this scope");
      report(line, column, message.data);
      return;
    }

    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = realloc(self.items as *i8,
                           sizeof(Symbol) as i64 * self.capacity as i64) as
          *Symbol;
    }

    let index: i32 = self.count;
    self.items[index].name = name;
    self.items[index].kind = kind;
    self.items[index].type = type;
    self.items[index].params = params;
    self.items[index].paramCount = paramCount;
    self.items[index].linkName = nullText();
    self.count = index + 1;
  }

  // Pushes a symbol already checked for conflicts, as it was declared.
  fn push(self: *SymbolTable, symbol: Symbol): void {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = realloc(self.items as *i8,
                           sizeof(Symbol) as i64 * self.capacity as i64) as
          *Symbol;
    }

    self.items[self.count] = symbol;
    self.count = self.count + 1;
  }
}
