// ---------------------------------------------------------------------------
// Globals and their constant initialisers: what checking rejects.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../support/problems";
import { Diagnostic } from "../support/diagnostics";
import { problemsIn } from "../testkit";

test "constant division by zero" {
  let found: *List<Diagnostic> = problemsIn(`
    let PARTS: i32 = 4;
    let EACH: i32 = 100 / (PARTS - 4);

    fn main(): i32 {
      return EACH;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ConstantDivisionByZero);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 21);
}

test "global from later global" {
  let found: *List<Diagnostic> = problemsIn(`
    let FIRST: i32 = SECOND + 1;
    let SECOND: i32 = 2;

    fn main(): i32 {
      return FIRST;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.GlobalDeclaredLater);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "FIRST");
  assertEq(found.at(0).facts.other, "SECOND");
}

test "non constant global" {
  let found: *List<Diagnostic> = problemsIn(`
    fn seed(): i32 {
      return 1;
    }

    let counter: i32 = seed();

    fn main(): i32 {
      return 0;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.GlobalNotConstant);
  assertEq(found.at(0).line, 5);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "counter");
}
