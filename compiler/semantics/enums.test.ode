// ---------------------------------------------------------------------------
// Enums and match: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../support/problems";
import { Diagnostic } from "../support/diagnostics";
import { Scope } from "../testkit";

test "duplicate enum" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red }
        enum Color { Blue }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicateEnum);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "Color");
}

test "duplicate enum member" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Red }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicateMember);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 26);
  assertEq(found.at(0).facts.name, "Color");
  assertEq(found.at(0).facts.other, "Red");
}

test "enum member value not literal" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let BASE: i32 = 10;

        enum Code { First = BASE, Second }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.EnumValueNotLiteral);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 13);
  assertEq(found.at(0).facts.name, "First");
}

test "enum ordering" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        if (Color.Red < Color.Blue) {
          return 1;
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.OrderEnum);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 15);
  assertEq(found.at(0).facts.name, "Color");
}

test "enum unknown member" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        let c: Color = Color.Purple;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NoSuchMember);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 22);
  assertEq(found.at(0).facts.name, "Color");
  assertEq(found.at(0).facts.other, "Purple");
}

test "match arm after else" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        let c: Color = Color.Red;
        match (c) {
          else => {
            return 0;
          }
          Color.Red => {
            return 1;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ArmAfterElse);
  assertEq(found.at(0).line, 6);
  assertEq(found.at(0).column, 3);
}

test "match duplicate pattern" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        let c: Color = Color.Red;
        match (c) {
          Color.Red, Color.Green => {
            return 1;
          }
          Color.Green => {
            return 2;
          }
          else => {
            return 3;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DuplicatePattern);
  assertEq(found.at(0).line, 6);
  assertEq(found.at(0).column, 9);
}

test "match integer without else" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let n: i32 = 2;
        match (n) {
          1 => {
            return 1;
          }
          2 => {
            return 2;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.MatchNeedsElse);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
}

test "match missing member" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }

        fn name(c: Color): i32 {
          match (c) {
            Color.Red => {
              return 1;
            }
            Color.Green => {
              return 2;
            }
          }
          return 0;
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnhandledMember);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Color");
  assertEq(found.at(0).facts.other, "Blue");
}

test "match on struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }
      `)
      .returning("i32")
      .run(`
        let p: Point = Point { x: 1 };
        match (p) {
          else => {
            return 0;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.CannotMatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
}

test "match pattern not literal" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let n: i32 = 2;
        let m: i32 = 3;
        match (n) {
          m => {
            return 1;
          }
          else => {
            return 0;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.PatternNotLiteral);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 3);
}

test "match pattern wrong type" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let n: i32 = 1;
        match (n) {
          'a' => {
            return 1;
          }
          else => {
            return 0;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.PatternType);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 3);
}
