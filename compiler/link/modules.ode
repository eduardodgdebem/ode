// ---------------------------------------------------------------------------
// Modules.
//
// Every file is a module. Its top-level names are its own unless it marks
// them `export`, and another file sees them only by naming them in an
// `import { ... } from "./path";`.
//
// All files parse into the one arena and the one program node, and every node
// remembers which file it came from. What keeps them apart is done here,
// before the analyzer proper runs:
//
//   - Each top-level declaration gets the name it will carry in the IR. The
//     entry file claims names first and keeps them unchanged, so a program of
//     one file compiles to exactly the IR it always did. A later file whose
//     name is already taken gets `<stem>.<name>`, which no source can spell.
//   - Struct references are rewritten to the struct's IR name. A struct name
//     cannot be shadowed by a local, so this is safe to do on the tree before
//     any scope exists.
//   - Each import is checked against what its module exports.
//
// Values, unlike structs, can be shadowed, so the analyzer resolves those
// itself: each module's bodies are checked in a scope holding the module's
// own declarations and its imports, and nothing else.
// ---------------------------------------------------------------------------

import { memcpy, strlen, strncmp } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { Builder, equals, slice, endsWith } from "std/text";
import { TARGET_MODULE } from "../codegen/target";
import { Analyzer, before } from "../check/analyzer";
import { Problem, Facts } from "../diagnostics/problems";
import { SOURCE_PATH, FAILED, report } from "../diagnostics/report";
import { markTemplates, instantiateGenerics } from "./generics";
import { stemOf, realpath } from "../os/files";
import {
  NO_NODE, NodeKind, FieldAccess, ImportName, MethodCall, Syntax, importModule, itemAt,
  itemCount, nodeName, setNodeName,
} from "../syntax/ast";
import { Symbol, SymbolTable } from "../types/symbols";
import { TypeKind, typeKindFromName } from "../types/types";

struct Module {
  // As diagnostics show it: the path given on the command line for the entry
  // file, and that file's directory joined with the import for the rest.
  path: *i8,
  // What identifies the file, so two spellings of one path load it once.
  real: *i8,
}

let MODULES: *List<Module> = null;

export fn moduleAdd(path: *i8, real: *i8): i32 {
  if (MODULES == null) {
    MODULES = List<Module>.new();
  }

  MODULES.push(Module { path: path, real: real });
  return (MODULES.count - 1) as i32;
}

// Whether the file `module` is part of the standard library.
export fn isLibraryModule(module: i32): bool {
  if (STD_DIRECTORY == null) {
    return false;
  }
  let library: *i8 = realpath(STD_DIRECTORY, null);
  if (library == null) {
    return false;
  }

  let real: *i8 = MODULES.at(module as i64).real;
  let length: i64 = strlen(library);
  return strncmp(real, library, length) == 0 && real[length] == '/';
}

// The path a diagnostic shows for `module`: the one it was loaded by, except
// that a library file is `std/<name>.ode` rather than wherever the library
// happens to be installed.
export fn moduleDisplayPath(module: i32): *i8 {
  if (!isLibraryModule(module)) {
    return modulePath(module);
  }

  let real: *i8 = MODULES.at(module as i64).real;
  let library: *i8 = realpath(STD_DIRECTORY, null);
  let out: *Builder = Builder.new();
  out.add("std");
  out.add(real + strlen(library));
  return out.take();
}

// Forgets every file loaded, so that another program can be loaded from
// scratch in the same process -- which is what the tests do.
export fn resetModules(): void {
  MODULES = null;
  TARGET_MODULE = -1;
}

// How many files the program is made of so far.
export fn moduleCount(): i32 {
  if (MODULES == null) {
    return 0;
  }
  return MODULES.count as i32;
}

export fn moduleFind(real: *i8): i32 {
  for (index in 0..moduleCount()) {
    if (equals(MODULES.at(index as i64).real, real)) {
      return index;
    }
  }

  return -1;
}

export fn modulePath(module: i32): *i8 {
  return MODULES.at(module as i64).path;
}

// Everything up to and including the last `/`, or nothing for a bare name.
fn directoryOf(path: *i8): *i8 {
  let length: i64 = strlen(path);
  let end: i64 = 0;

  for (index in 0..length) {
    if (path[index] == '/') {
      end = index + 1;
    }
  }

  return slice(path, 0, end);
}

// Where `import ... from "<spec>"` written in `importer` points. A relative
// spec is taken from the importing file's directory, the way TypeScript reads
// one, and the `.ode` may be left off.
// Where the standard library's files are -- the directory `std/...` imports
// are found in -- or null when it could not be found. Set by the driver.
export let STD_DIRECTORY: *i8 = null;

// Whether an import names a file by its path: `./x`, `../x` or `/x`. Any
// other import names a library, of which there is one: `std/...`.
export fn isPathImport(spec: *i8): bool {
  return spec[0] == '/' || (spec[0] == '.' && spec[1] == '/') ||
         (spec[0] == '.' && spec[1] == '.' && spec[2] == '/');
}

export fn isStdImport(spec: *i8): bool {
  return spec[0] == 's' && spec[1] == 't' && spec[2] == 'd' && spec[3] == '/';
}

export fn resolveImportPath(importer: *i8, spec: *i8): *i8 {
  let out: *Builder = Builder.new();

  // `std/list` is the standard library's list.ode. Anything else that is not
  // a path resolves to nothing, which the import then reports.
  if (!isPathImport(spec)) {
    if (!isStdImport(spec) || STD_DIRECTORY == null) {
      return null;
    }
    out.add(STD_DIRECTORY);
    out.push('/');
    out.add(spec + 4);
    if (!endsWith(spec, ".ode")) {
      out.add(".ode");
    }
    return out.take();
  }

  if (spec[0] != '/') {
    out.add(directoryOf(importer));
  }

  // A leading `./` says nothing the directory does not already say, and
  // dropping it keeps the path in a diagnostic short.
  let rest: *i8 = spec;
  while (rest[0] == '.' && rest[1] == '/') {
    rest = rest + 2;
  }
  out.add(rest);

  if (!endsWith(rest, ".ode")) {
    out.add(".ode");
  }

  return normalizePath(out.take());
}

// `path` with each `dir/..` and `.` folded away, as far as the text alone
// allows: `a/b/../c` is `a/c`, while `../a` keeps its `..`, having nothing to
// fold it into. Diagnostics name a file by this, rather than by the trail of
// imports that led to it.
fn normalizePath(path: *i8): *i8 {
  let parts: *List<*i8> = List<*i8>.new();
  let start: i64 = 0;
  let index: i64 = 0;
  while (true) {
    if (path[index] == '/' || path[index] == '\0') {
      let part: *i8 = slice(path, start, index - start);
      if (equals(part, "..") && parts.count > 0 && !equals(parts.last(), "..") &&
          !equals(parts.last(), "")) {
        parts.pop();
      } else if (!equals(part, ".") && !(equals(part, "") && start > 0)) {
        parts.push(part);
      }
      if (path[index] == '\0') {
        break;
      }
      start = index + 1;
    }
    index = index + 1;
  }

  let out: *Builder = Builder.new();
  for (part in 0..parts.count) {
    if (part > 0) {
      out.push('/');
    }
    out.add(parts.at(part));
  }
  return out.take();
}

// ---------------------------------------------------------------------------
// IR names.
// ---------------------------------------------------------------------------

export struct NameSet {
  names: *List<*i8>,

  fn new(): *NameSet {
    let set: *NameSet = alloc<NameSet>(1);
    set.names = List<*i8>.new();

    return set;
  }

  fn has(self: *NameSet, name: *i8): bool {
    for (index in 0..self.names.count) {
      if (equals(self.names.at(index), name)) {
        return true;
      }
    }

    return false;
  }

  fn add(self: *NameSet, name: *i8): void {
    self.names.push(name);
  }

  // `name` if nobody has it yet, and otherwise a name qualified by the module.
  // The qualified form contains a `.`, which no identifier can, so it cannot
  // collide with anything written in a source file.
  fn claim(self: *NameSet, module: i32, name: *i8): *i8 {
    let chosen: *i8 = name;

    if (self.has(chosen)) {
      let qualified: *Builder = Builder.new();
      qualified.add(stemOf(modulePath(module)));
      qualified.push('.');
      qualified.add(name);
      chosen = qualified.take();
    }

    // Two files with one stem, `a/util.ode` and `b/util.ode`, need the module
    // number to tell them apart.
    if (self.has(chosen)) {
      let numbered: *Builder = Builder.new();
      numbered.add(stemOf(modulePath(module)));
      numbered.addInt(module as i64);
      numbered.push('.');
      numbered.add(name);
      chosen = numbered.take();
    }

    self.add(chosen);

    return chosen;
  }
}

// Structs, enums and aliases share one namespace: a type name means one of
// them.
fn isTypeDecl(kind: NodeKind): bool {
  return kind == NodeKind.Struct || kind == NodeKind.Enum ||
         kind == NodeKind.TypeAlias;
}

fn isValueDecl(kind: NodeKind): bool {
  return kind == NodeKind.Fn || kind == NodeKind.Extern || kind == NodeKind.VarDecl;
}

// The first top-level declaration in `module` named `name`, of a struct when
// `wantStruct` and of a value otherwise, or NO_NODE.
export fn findTopLevel(an: *Analyzer, program: i32, module: i32, name: *i8,
                wantStruct: bool): i32 {
  for (index in 0..itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    let kind: NodeKind = an.ast.nodes[item].kind;

    if (an.ast.nodes[item].module == module &&
        equals(nodeName(an.ast, item), name)) {
      if (wantStruct && isTypeDecl(kind)) {
        return item;
      }
      if (!wantStruct && isValueDecl(kind)) {
        return item;
      }
    }
  }

  return NO_NODE;
}

fn assignLinkNames(an: *Analyzer, program: i32): void {
  let count: i32 = itemCount(an.ast, program);
  let values: *NameSet = NameSet.new();
  let structs: *NameSet = NameSet.new();

  // An extern is a symbol some other object file defines, so its name is not
  // this compiler's to change. Several files may declare the same one.
  let index: i32 = 0;
  for (index in 0..count) {
    let item: i32 = itemAt(an.ast, program, index);
    if (an.ast.nodes[item].kind == NodeKind.Extern) {
      let name: *i8 = nodeName(an.ast, item);
      an.linkNames[item] = name;
      if (!values.has(name)) {
        values.add(name);
      }
    }
  }

  // Module by module, so the entry file, which is module 0, claims first.
  for (module in 0..moduleCount()) {
    for (index in 0..count) {
      let item: i32 = itemAt(an.ast, program, index);
      let kind: NodeKind = an.ast.nodes[item].kind;
      let name: *i8 = nodeName(an.ast, item);

      if (an.ast.nodes[item].module == module) {
        if (kind == NodeKind.Fn || kind == NodeKind.VarDecl) {
          an.linkNames[item] = values.claim(module, name);
        }

        // A type declared twice in one file has to keep one name, or the
        // analyzer would see two types and miss the duplicate.
        if (isTypeDecl(kind)) {
          let first: i32 = findTopLevel(an, program, module, name, true);
          if (first != item) {
            an.linkNames[item] = an.linkNames[first];
          } else {
            an.linkNames[item] = structs.claim(module, name);
          }
        }
      }
    }
  }

  // A method is named after its struct, `Point.length`, which no free
  // function can be called. Claiming it still guards against a file whose
  // stem happens to be a struct's name.
  for (index in 0..count) {
    let item: i32 = itemAt(an.ast, program, index);

    if (an.ast.nodes[item].kind == NodeKind.Struct) {
      let member: i32 = 0;
      while (member < itemCount(an.ast, item)) {
        let method: i32 = itemAt(an.ast, item, member);

        if (an.ast.nodes[method].kind == NodeKind.Fn) {
          let name: *Builder = Builder.new();
          name.add(an.linkNames[item]);
          name.push('.');
          name.add(nodeName(an.ast, method));
          an.linkNames[method] =
              values.claim(an.ast.nodes[item].module, name.take());
        }

        member = member + 1;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Imports.
// ---------------------------------------------------------------------------

// The name an imported binding goes by in the importing file.
export fn importLocalName(an: *Analyzer, importName: i32): *i8 {
  let syntax: Syntax = an.ast.nodes[importName].syntax;
  let alias: i32 = NO_NODE;
  if (syntax is ImportName) {
    alias = syntax.alias;
  }
  if (alias != NO_NODE) {
    return nodeName(an.ast, alias);
  }

  return nodeName(an.ast, importName);
}

fn importFail(an: *Analyzer, at: i32, problem: Problem, facts: Facts): void {
  SOURCE_PATH = moduleDisplayPath(an.ast.nodes[at].module);
  report(problem, an.ast.nodes[at].line, an.ast.nodes[at].column, facts);
  FAILED = false;
}

// Every imported name has to be something its module exports.
fn checkImports(an: *Analyzer, program: i32): void {
  let index: i32 = 0;

  while (index < itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    let target: i32 = importModule(an.ast, item);

    if (an.ast.nodes[item].kind == NodeKind.Import && target >= 0) {
      let name: i32 = 0;
      while (name < itemCount(an.ast, item)) {
        let importName: i32 = itemAt(an.ast, item, name);
        let text: *i8 = nodeName(an.ast, importName);

        let asStruct: i32 = findTopLevel(an, program, target, text, true);
        let asValue: i32 = findTopLevel(an, program, target, text, false);
        let exported: bool = false;
        if (asStruct != NO_NODE && an.ast.nodes[asStruct].exported) {
          exported = true;
        }
        if (asValue != NO_NODE && an.ast.nodes[asValue].exported) {
          exported = true;
        }

        if (asStruct == NO_NODE && asValue == NO_NODE) {
          importFail(an, importName, Problem.NoSuchExport,
                     Facts.aboutTwo(nodeName(an.ast, item), text));
        } else if (!exported) {
          importFail(an, importName, Problem.NotExported,
                     Facts.aboutTwo(text, nodeName(an.ast, item)));
        }

        name = name + 1;
      }
    }

    index = index + 1;
  }
}

// The IR name of the struct that `name` means in `module`, or null when the
// module neither declares nor imports one by that name.
fn resolveStructName(an: *Analyzer, program: i32, module: i32,
                     name: *i8): *i8 {
  let own: i32 = findTopLevel(an, program, module, name, true);
  if (own != NO_NODE) {
    return an.linkNames[own];
  }

  for (index in 0..itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    let target: i32 = importModule(an.ast, item);

    if (an.ast.nodes[item].kind == NodeKind.Import &&
        an.ast.nodes[item].module == module && target >= 0) {
      for (entry in 0..itemCount(an.ast, item)) {
        let importName: i32 = itemAt(an.ast, item, entry);

        if (equals(importLocalName(an, importName), name)) {
          // A private struct has been reported at the import already; it
          // still resolves, so that the import is the only error it causes.
          let declared: i32 = findTopLevel(an, program, target,
                                           nodeName(an.ast, importName), true);
          if (declared != NO_NODE) {
            return an.linkNames[declared];
          }
        }
      }
    }
  }

  return null;
}

// The first struct declared anywhere under `name`, for the diagnostic that
// says where a type the file forgot to import lives.
fn findStructAnywhere(an: *Analyzer, program: i32, name: *i8): i32 {
  for (index in 0..itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    if (isTypeDecl(an.ast.nodes[item].kind) &&
        equals(nodeName(an.ast, item), name)) {
      return item;
    }
  }

  return NO_NODE;
}

fn setNodeText(an: *Analyzer, node: i32, text: *i8): void {
  if (equals(nodeName(an.ast, node), text)) {
    return;
  }

  setNodeName(an.ast, node, text);
}

// Points every struct reference at the struct its own file can see, then
// renames the declarations to match. The declarations go last because finding
// a reference's struct reads them by the name they were written with.
fn rewriteStructNames(an: *Analyzer, program: i32): void {
  // A generic's own body is not checked or compiled -- its instances are,
  // each with its names resolved when it is made -- so it is left alone.
  let inTemplate: *i8 = markTemplates(an, program);
  let count: i32 = an.ast.count;

  for (node in 0..count) {
    if (inTemplate[node] == 0) {
      rewriteNodeNames(an, program, node, null);
    }
  }
}

// Renames each type declaration to its IR name, which every reference to it
// now uses. This comes last: until then, a declaration is found by the name
// it was written with -- which is how a generic's instance, made after the
// references, finds the structs its own file declared.
fn renameTypeDecls(an: *Analyzer, program: i32): void {
  for (index in 0..itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    if (isTypeDecl(an.ast.nodes[item].kind)) {
      setNodeText(an, item, an.linkNames[item]);
    }
  }
}

// Points the struct names at `node` at the structs its own file can see.
// Names in `skip` -- a generic's type parameters -- are left as they are.
export fn rewriteNodeNames(an: *Analyzer, program: i32, node: i32,
                    skip: *NameSet): void {
  let kind: NodeKind = an.ast.nodes[node].kind;
  let names: bool = kind == NodeKind.StructLit;
  if (kind == NodeKind.Type) {
    names = typeKindFromName(nodeName(an.ast, node)) == TypeKind.None;
  }
  if (names && skip != null && skip.has(nodeName(an.ast, node))) {
    names = false;
  }

  // `Point.new()` names a struct where a value usually goes. Whether it
  // does depends on what is in scope, which the analyzer decides, so this
  // only records the struct the name would mean.
  //
  // `Color.Red` names an enum the same way, and is resolved the same way.
  // A match arm's bare name, `Circle =>`, names a type when the match is on
  // a union; that is the analyzer's to decide, so it is recorded the same way.
  if (kind == NodeKind.Arm) {
    for (index in 0..itemCount(an.ast, node)) {
      let pattern: i32 = itemAt(an.ast, node, index);
      if (an.ast.nodes[pattern].kind == NodeKind.Ident) {
        an.structRefs[pattern] =
            resolveStructName(an, program, an.ast.nodes[pattern].module,
                              nodeName(an.ast, pattern));
      }
    }
  }

  if (kind == NodeKind.MethodCall || kind == NodeKind.FieldAccess) {
    let syntax: Syntax = an.ast.nodes[node].syntax;
    let receiver: i32 = match (syntax) {
      MethodCall => syntax.receiver,
      FieldAccess => syntax.object,
      else => NO_NODE,
    };
    if (receiver != NO_NODE && an.ast.nodes[receiver].kind == NodeKind.Ident) {
      an.structRefs[node] =
          resolveStructName(an, program, an.ast.nodes[node].module,
                            nodeName(an.ast, receiver));
    }
  }

  if (!names) {
    return;
  }

  let name: *i8 = nodeName(an.ast, node);
  let module: i32 = an.ast.nodes[node].module;
  let resolved: *i8 = resolveStructName(an, program, module, name);

  if (resolved != null) {
    setNodeText(an, node, resolved);
    return;
  }

  // Left alone, the name would quietly mean whichever file happened to claim
  // it -- the very leak modules exist to prevent. A name no file declares is
  // left for the analyzer's own "unknown type".
  let elsewhere: i32 = findStructAnywhere(an, program, name);
  if (elsewhere != NO_NODE) {
    importFail(an, node, Problem.TypeNotImported,
               Facts.aboutTwo(name,
                              moduleDisplayPath(an.ast.nodes[elsewhere].module)));
    // Pointed at the real struct anyway, so the error above is the only one
    // this mistake produces.
    setNodeText(an, node, an.linkNames[elsewhere]);
  }
}

export fn linkModules(an: *Analyzer, program: i32): void {
  assignLinkNames(an, program);
  checkImports(an, program);
  rewriteStructNames(an, program);
  instantiateGenerics(an, program);
  renameTypeDecls(an, program);
}

// ---------------------------------------------------------------------------
// Per-module scopes.
// ---------------------------------------------------------------------------

export struct SymbolList {
  items: *Symbol,
  count: i32,

  // The symbols declared since `start`, copied out before their scope closes.
  fn copyFrom(table: *SymbolTable, start: i32): SymbolList {
    let count: i32 = table.count - start;
    let items: *Symbol = null;

    if (count > 0) {
      items = alloc<Symbol>(count as i64);
      memcpy(items as *i8, (table.items + start) as *i8,
             sizeof(Symbol) * count as i64);
    }

    return SymbolList { items: items, count: count };
  }

  fn find(self: SymbolList, name: *i8): i32 {
    for (index in 0..self.count) {
      if (equals(self.items[index].name, name)) {
        return index;
      }
    }

    return -1;
  }
}

// Binds a module's imported values in the scope its bodies are checked in.
export fn declareImports(an: *Analyzer, program: i32, module: i32): void {
  let index: i32 = 0;

  while (index < itemCount(an.ast, program)) {
    let item: i32 = itemAt(an.ast, program, index);
    let target: i32 = importModule(an.ast, item);

    if (an.ast.nodes[item].kind == NodeKind.Import &&
        an.ast.nodes[item].module == module && target >= 0) {
      let entry: i32 = 0;
      while (entry < itemCount(an.ast, item)) {
        let importName: i32 = itemAt(an.ast, item, entry);
        let declared: i32 = findTopLevel(an, program, target,
                                         nodeName(an.ast, importName), false);

        // A struct import was dealt with on the tree, and a missing one has
        // already been reported. A private one has too, but is bound anyway,
        // so that its uses do not each report it again as undefined.
        if (declared != NO_NODE) {
          let symbols: SymbolList = an.moduleSymbols[target];
          let found: i32 = symbols.find(nodeName(an.ast, importName));

          if (found >= 0) {
            let before: i32 = an.symbols.count;
            an.symbols.declare(importLocalName(an, importName),
                               symbols.items[found].kind, symbols.items[found].type,
                          symbols.items[found].params,
                          symbols.items[found].paramCount,
                          an.ast.nodes[importName].line,
                          an.ast.nodes[importName].column,
                          symbols.items[found].node);
            if (an.symbols.count > before) {
              an.symbols.items[before].linkName = symbols.items[found].linkName;
              an.symbols.items[before].variadic = symbols.items[found].variadic;
            }
            FAILED = false;
          }
        }

        entry = entry + 1;
      }
    }

    index = index + 1;
  }
}

test "which imports are paths and which name the library" {
  assert(isPathImport("./lib"));
  assert(isPathImport("../lib"));
  assert(isPathImport("/abs/lib"));
  assert(!isPathImport("std/list"));
  assert(!isPathImport("lib"));
  assert(!isPathImport(".hidden"));
  assert(!isPathImport("..lib"));
  assert(isStdImport("std/list"));
  assert(!isStdImport("std"));
  assert(!isStdImport("stdlib/list"));
  assert(!isStdImport("./std/list"));
}

test "import paths resolve against the importer or the library" {
  assertEq(resolveImportPath("src/main.ode", "./util"), "src/util.ode");
  assertEq(resolveImportPath("src/main.ode", "./././util.ode"), "src/util.ode");
  assertEq(resolveImportPath("src/main.ode", "../lib/x"), "lib/x.ode");
  assertEq(resolveImportPath("main.ode", "../lib/x"), "../lib/x.ode");
  assertEq(resolveImportPath("src/main.ode", "/abs/x"), "/abs/x.ode");

  let saved: *i8 = STD_DIRECTORY;
  STD_DIRECTORY = "/opt/ode/std";
  assertEq(resolveImportPath("src/main.ode", "std/list"), "/opt/ode/std/list.ode");
  assertEq(resolveImportPath("src/main.ode", "lib/list"), null);
  STD_DIRECTORY = null;
  assertEq(resolveImportPath("src/main.ode", "std/list"), null);
  STD_DIRECTORY = saved;
}

test "normalizePath folds what the text allows" {
  assertEq(normalizePath("a/b/../c.ode"), "a/c.ode");
  assertEq(normalizePath("a/./b//c.ode"), "a/b/c.ode");
  assertEq(normalizePath("compiler/codegen/../semantics/../support/x.ode"),
           "compiler/support/x.ode");
  assertEq(normalizePath("../x.ode"), "../x.ode");
  assertEq(normalizePath("a/../../x.ode"), "../x.ode");
  assertEq(normalizePath("/a/../x.ode"), "/x.ode");
  assertEq(normalizePath("x.ode"), "x.ode");
}
