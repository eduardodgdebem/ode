// ---------------------------------------------------------------------------
// `ode build test`: the regression suite.
//
// Run cases are every tests/run/*.ode: each is compiled, linked, run, and its
// stdout compared against the <name>.out beside it.
//
// Example cases are every examples/*.ode, run the same way and compared
// against tests/examples/<name>.out, so the examples cannot rot.
//
// Invalid cases are every tests/invalid/*.ode: each must fail to compile, and
// the diagnostic is compared against tests/invalid/<name>.expected.
//
// Module cases are every tests/modules/<name>/, a program of several files
// whose entry is main.ode. What it does is compared against
// tests/modules/<name>.expected: the diagnostics if it fails to compile, and
// what it prints if it compiles.
//
// --update rewrites the expected files from what the compiler does now, which
// is how the suite is re-baselined after a deliberate language change. Read
// the diff before committing it.
//
// Everything is compiled and run in a temporary directory, so the repository
// stays clean.
// ---------------------------------------------------------------------------

import { malloc, strlen, STDOUT } from "../support/libc";
import { writeBuf, Buf, textEquals, textSlice } from "../support/text";
import { fail } from "../support/diagnostics";
import {
  memcmp, TextList, StderrMode, runCommand, isTerminal, joinPath, withSuffix,
  parentDirectory, fileExists, isExecutable, readBytes, writeBytes, sameBytes,
  makeDirectories, removeTree, copyTree, listDirectory, splitLines,
  makeTempDirectory,
} from "../support/system";
import { textEndsWith } from "../semantics/modules";
import { Workspace, complain, commandBuild } from "./build";

export struct TestOptions {
  filter: *i8,
  update: bool,
  // The compiler to test, or null to build one and test that.
  compiler: *i8,
}

struct Suite {
  ws: *Workspace,
  compiler: *i8,
  work: *i8,
  filter: *i8,
  update: bool,

  passed: i32,
  failed: i32,
  updated: i32,
  runCount: i32,
  exampleCount: i32,
  invalidCount: i32,
  moduleCount: i32,
  failures: *TextList,

  // Terminal colours, or empty text when the output is not a terminal.
  dim: *i8,
  green: *i8,
  red: *i8,
  off: *i8,

  fn selected(self: *Suite, name: *i8): bool {
    return self.filter == null || textContains(name, self.filter);
  }

  fn pass(self: *Suite, kind: *i8, name: *i8): void {
    self.passed = self.passed + 1;

    let line: *Buf = Buf.new();
    line.add(self.dim);
    line.add("  ");
    addPadded(line, kind, 10);
    line.push(' ');
    addPadded(line, name, 34);
    line.push(' ');
    line.add(self.green);
    line.add("ok");
    line.add(self.off);
    line.push('\n');
    writeBuf(STDOUT, line);
  }

  fn fail(self: *Suite, kind: *i8, name: *i8, why: *i8): void {
    self.failed = self.failed + 1;

    let record: *Buf = Buf.new();
    record.add(kind);
    record.push('/');
    record.add(name);
    record.add(": ");
    record.add(why);
    self.failures.add(record.take());

    let line: *Buf = Buf.new();
    line.add("  ");
    addPadded(line, kind, 10);
    line.push(' ');
    addPadded(line, name, 34);
    line.push(' ');
    line.add(self.red);
    line.add("FAIL");
    line.add(self.off);
    line.add("  ");
    line.add(why);
    line.push('\n');
    writeBuf(STDOUT, line);
  }

  // Compares what a case did against what it is expected to do, or records
  // it as the expectation under --update.
  fn check(self: *Suite, kind: *i8, name: *i8, expectedPath: *i8,
           actual: *Buf, missing: *i8, differs: *i8): void {
    let expected: *Buf = readBytes(expectedPath);

    if (self.update) {
      if (expected == null || !sameBytes(expected, actual)) {
        writeBytes(expectedPath, actual);
        self.updated = self.updated + 1;
      }
      self.pass(kind, name);
      return;
    }

    if (expected == null) {
      self.fail(kind, name, missing);
      return;
    }

    if (sameBytes(expected, actual)) {
      self.pass(kind, name);
      return;
    }

    self.fail(kind, name, differs);

    let actualPath: *Buf = Buf.new();
    actualPath.add(self.work);
    actualPath.push('/');
    actualPath.add(kind);
    actualPath.push('-');
    actualPath.add(name);
    actualPath.add(".actual");
    writeBytes(actualPath.data, actual);

    let diff: *TextList = TextList.new().add("diff").add("-u");
    diff.add("--label").add("expected").add(expectedPath);
    diff.add("--label").add("actual").add(actualPath.data);
    let output: *Buf = Buf.new();
    runCommand(diff, null, output, StderrMode.Merge);
    writeIndented(output);
  }
}

fn colour(code: *i8): *i8 {
  let out: *Buf = Buf.new();
  out.push(27 as i8);
  out.push('[');
  out.add(code);
  out.push('m');

  return out.take();
}

fn addPadded(out: *Buf, text: *i8, width: i32): void {
  out.add(text);

  for (length in strlen(text) as i32..width) {
    out.push(' ');
  }
}

export fn textContains(text: *i8, part: *i8): bool {
  let length: i64 = strlen(text);
  let partLength: i64 = strlen(part);
  let start: i64 = 0 as i64;

  while (start + partLength <= length) {
    if (memcmp(text + start, part, partLength) == 0) {
      return true;
    }
    start = start + 1 as i64;
  }

  return false;
}

// Prints `text` with every line indented, the way a failure's detail is set
// off from the list.
fn writeIndented(text: *Buf): void {
  let lines: *TextList = splitLines(text);
  let out: *Buf = Buf.new();

  let index: i32 = 0;
  while (index < lines.count) {
    out.add("    ");
    out.add(lines.at(index));
    out.push('\n');
    index = index + 1;
  }

  writeBuf(STDOUT, out);
}

fn withoutExtension(name: *i8): *i8 {
  return textSlice(name, 0 as i64, strlen(name) - 4 as i64);
}

fn isDirectory(path: *i8): bool {
  return fileExists(joinPath(path, "."));
}

// ---------------------------------------------------------------------------
// The cases.
// ---------------------------------------------------------------------------

// Compiles `source`, runs what it builds, and compares what it prints against
// `expectedPath`. `kind` is "run" or "example".
fn runProgramCase(suite: *Suite, kind: *i8, source: *i8, name: *i8,
                  expectedPath: *i8): void {
  if (textEquals(kind, "run")) {
    suite.runCount = suite.runCount + 1;
  } else {
    suite.exampleCount = suite.exampleCount + 1;
  }

  // Compiled with no flags and from inside the work directory, which is also
  // what pins down the default output paths.
  let compileOutput: *Buf = Buf.new();
  let compile: *TextList = TextList.new().add(suite.compiler).add(source);
  if (runCommand(compile, suite.work, compileOutput, StderrMode.Merge) != 0) {
    suite.fail(kind, name, "compilation failed");
    writeIndented(compileOutput);
    return;
  }

  let actual: *Buf = Buf.new();
  let program: *TextList = TextList.new().add(joinPath(suite.work, name));
  let status: i32 = runCommand(program, null, actual, StderrMode.Discard);
  if (status != 0) {
    let why: *Buf = Buf.new();
    why.add("program exited with status ");
    why.addInt(status as i64);
    suite.fail(kind, name, why.data);
    return;
  }

  suite.check(kind, name, expectedPath, actual,
              "no expected output recorded (run with --update)",
              "stdout differs");
}

fn runInvalid(suite: *Suite, source: *i8, name: *i8): void {
  suite.invalidCount = suite.invalidCount + 1;

  // The case is copied in and compiled by its bare name so that the recorded
  // diagnostic does not carry the absolute path it was run from.
  let copyName: *Buf = Buf.new();
  copyName.add(name);
  copyName.add(".ode");
  writeBytes(joinPath(suite.work, copyName.data), readBytes(source));

  let actual: *Buf = Buf.new();
  let compile: *TextList = TextList.new().add(suite.compiler);
  compile.add(copyName.data);
  if (runCommand(compile, suite.work, actual, StderrMode.Merge) == 0) {
    suite.fail("invalid", name, "compiled successfully but should have failed");
    return;
  }

  let expected: *Buf = Buf.new();
  expected.add(joinPath(suite.ws.root, "tests/invalid/"));
  expected.add(name);
  expected.add(".expected");
  suite.check("invalid", name, expected.data, actual,
              "no expected diagnostic recorded (run with --update)",
              "diagnostic differs");
}

fn runModule(suite: *Suite, caseDir: *i8, name: *i8): void {
  suite.moduleCount = suite.moduleCount + 1;

  // The whole directory is copied, and compiled from inside it, so the paths
  // in a diagnostic are the ones relative to the entry file.
  let work: *i8 = joinPath(joinPath(suite.work, "module-cases"), name);
  makeDirectories(work);
  copyTree(caseDir, work);

  let actual: *Buf = Buf.new();
  let compile: *TextList = TextList.new().add(suite.compiler).add("main.ode");
  if (runCommand(compile, work, actual, StderrMode.Merge) == 0) {
    actual = Buf.new();
    let program: *TextList = TextList.new().add(joinPath(work, "main"));
    runCommand(program, null, actual, StderrMode.Merge);
  }

  let expected: *Buf = Buf.new();
  expected.add(joinPath(suite.ws.root, "tests/modules/"));
  expected.add(name);
  expected.add(".expected");
  suite.check("module", name, expected.data, actual,
              "no expected result recorded (run with --update)",
              "result differs");
}

// ---------------------------------------------------------------------------
// The driver flags have no expected-output file to record; they are checked
// against the files they are supposed to produce.
// ---------------------------------------------------------------------------

fn compileQuietly(suite: *Suite, command: *TextList): bool {
  return runCommand(command, null, Buf.new(), StderrMode.Merge) == 0;
}

// Whether the program at `path` runs and prints exactly "0".
fn printsZero(path: *i8): bool {
  let output: *Buf = Buf.new();
  if (runCommand(TextList.new().add(path), null, output,
                 StderrMode.Discard) != 0) {
    return false;
  }

  return textEquals(output.data, "0\n");
}

// A program that prints "0", which is what the driver checks build.
fn exampleOne(suite: *Suite): *i8 {
  return joinPath(suite.ws.root, "tests/run/function_call.ode");
}

fn checkOutputFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/nested/renamed");
  makeDirectories(parentDirectory(out));

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  return isExecutable(out) && fileExists(withSuffix(out, ".ll")) &&
         fileExists(withSuffix(out, ".o")) && printsZero(out);
}

fn checkNoIntermediatesFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/dropped");
  makeDirectories(parentDirectory(out));

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--no-intermediates").add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  return isExecutable(out) && !fileExists(withSuffix(out, ".ll")) &&
         !fileExists(withSuffix(out, ".o"));
}

// A path holding a space and a shell metacharacter must survive the linker.
// There is no shell anywhere -- not here and not in the compiler -- but the
// check stays, because that is the property being relied on.
fn checkHostileOutputPath(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/a b $(touch pwned);/prog");
  makeDirectories(parentDirectory(out));

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  return isExecutable(out) && !fileExists(joinPath(suite.work, "pwned")) &&
         printsZero(out);
}

fn checkNoInputFile(suite: *Suite): bool {
  return !compileQuietly(suite, TextList.new().add(suite.compiler));
}

fn runCli(suite: *Suite, name: *i8, passed: bool): void {
  if (passed) {
    suite.pass("cli", name);
  } else {
    suite.fail("cli", name, "check failed");
  }
}

// ---------------------------------------------------------------------------
// The command.
// ---------------------------------------------------------------------------

export fn commandTest(ws: *Workspace, options: TestOptions): i32 {
  let compiler: *i8 = options.compiler;
  if (compiler == null) {
    if (commandBuild(ws, false) != 0) {
      return 1;
    }
    compiler = ws.output;
  }

  let work: *i8 = makeTempDirectory("ode-tests");
  if (work == null) {
    complain("cannot create a temporary directory");
    return 1;
  }

  let suite: *Suite = malloc(sizeof(Suite) as i64) as *Suite;
  suite.ws = ws;
  suite.compiler = compiler;
  suite.work = work;
  suite.filter = options.filter;
  suite.update = options.update;
  suite.passed = 0;
  suite.failed = 0;
  suite.updated = 0;
  suite.runCount = 0;
  suite.exampleCount = 0;
  suite.invalidCount = 0;
  suite.moduleCount = 0;
  suite.failures = TextList.new();
  suite.dim = "";
  suite.green = "";
  suite.red = "";
  suite.off = "";
  if (isTerminal(STDOUT)) {
    suite.dim = colour("2");
    suite.green = colour("32");
    suite.red = colour("31");
    suite.off = colour("0");
  }

  let runs: *i8 = joinPath(ws.root, "tests/run");
  let names: *TextList = listDirectory(runs);
  let index: i32 = 0;
  for (index in 0..names.count) {
    let file: *i8 = names.at(index);
    if (textEndsWith(file, ".ode") && suite.selected(withoutExtension(file))) {
      let name: *i8 = withoutExtension(file);
      runProgramCase(suite, "run", joinPath(runs, file), name,
                     withSuffix(joinPath(runs, name), ".out"));
    }
  }

  let examples: *i8 = joinPath(ws.root, "examples");
  let expectedExamples: *i8 = joinPath(ws.root, "tests/examples");
  makeDirectories(expectedExamples);
  names = listDirectory(examples);
  for (index in 0..names.count) {
    let file: *i8 = names.at(index);
    if (textEndsWith(file, ".ode") && suite.selected(withoutExtension(file))) {
      let name: *i8 = withoutExtension(file);
      runProgramCase(suite, "example", joinPath(examples, file), name,
                     withSuffix(joinPath(expectedExamples, name), ".out"));
    }
  }

  let invalid: *i8 = joinPath(ws.root, "tests/invalid");
  names = listDirectory(invalid);
  for (index in 0..names.count) {
    let file: *i8 = names.at(index);
    if (textEndsWith(file, ".ode") && suite.selected(withoutExtension(file))) {
      runInvalid(suite, joinPath(invalid, file), withoutExtension(file));
    }
  }

  let modules: *i8 = joinPath(ws.root, "tests/modules");
  names = listDirectory(modules);
  for (index in 0..names.count) {
    let name: *i8 = names.at(index);
    let caseDir: *i8 = joinPath(modules, name);
    if (isDirectory(caseDir) && suite.selected(name)) {
      runModule(suite, caseDir, name);
    }
  }

  if (suite.selected("output-flag")) {
    runCli(suite, "output-flag", checkOutputFlag(suite));
  }
  if (suite.selected("no-intermediates-flag")) {
    runCli(suite, "no-intermediates-flag", checkNoIntermediatesFlag(suite));
  }
  if (suite.selected("hostile-output-path")) {
    runCli(suite, "hostile-output-path", checkHostileOutputPath(suite));
  }
  if (suite.selected("no-input-file")) {
    runCli(suite, "no-input-file", checkNoInputFile(suite));
  }

  removeTree(work);

  let summary: *Buf = Buf.new();
  summary.push('\n');
  if (suite.update) {
    summary.addInt(suite.runCount as i64);
    summary.add(" run, ");
    summary.addInt(suite.exampleCount as i64);
    summary.add(" example, ");
    summary.addInt(suite.invalidCount as i64);
    summary.add(" invalid, ");
    summary.addInt(suite.moduleCount as i64);
    summary.add(" module: ");
    summary.addInt(suite.updated as i64);
    summary.add(" expectation(s) rewritten\n");
  }

  if (suite.failed == 0) {
    summary.add(suite.green);
    summary.add("all ");
    summary.addInt(suite.passed as i64);
    summary.add(" checks passed");
    summary.add(suite.off);
    summary.add(" (");
    summary.addInt(suite.runCount as i64);
    summary.add(" run, ");
    summary.addInt(suite.exampleCount as i64);
    summary.add(" example, ");
    summary.addInt(suite.invalidCount as i64);
    summary.add(" invalid, ");
    summary.addInt(suite.moduleCount as i64);
    summary.add(" module)\n");
    writeBuf(STDOUT, summary);
    return 0;
  }

  summary.add(suite.red);
  summary.addInt(suite.failed as i64);
  summary.add(" of ");
  summary.addInt((suite.passed + suite.failed) as i64);
  summary.add(" checks failed");
  summary.add(suite.off);
  summary.push('\n');

  index = 0;
  while (index < suite.failures.count) {
    summary.add("  ");
    summary.add(suite.failures.at(index));
    summary.push('\n');
    index = index + 1;
  }
  writeBuf(STDOUT, summary);

  return 1;
}
