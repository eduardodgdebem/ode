// ---------------------------------------------------------------------------
// Processes: running another program and collecting what it prints, forking
// this one to run a piece of it apart, and the process's own state -- its
// environment, its directory, whether it writes to a terminal.
//
// Everything goes through libc by `extern`, and nothing through a shell:
// arguments are handed to execvp as they are, so none is ever re-split or
// expanded.
// ---------------------------------------------------------------------------

import { free, printf, dprintf, fopen, fclose, fflush, read, exit, abort, getenv } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { FileError } from "std/fs";
import { Builder, contains } from "std/text";

extern fn fork(): i32;

extern fn execvp(file: *i8, argv: **i8): i32;

extern fn waitpid(pid: i32, status: *i32, options: i32): i32;

extern fn _exit(code: i32): void;

extern fn setenv(name: *i8, value: *i8, overwrite: i32): i32;

extern fn chdir(path: *i8): i32;

extern fn getcwd(buffer: *i8, size: i64): *i8;

extern fn pipe(fds: *i32): i32;

extern fn dup2(from: i32, to: i32): i32;

extern fn close(fd: i32): i32;

export extern fn isatty(fd: i32): i32;

extern fn fileno(stream: *i8): i32;

// ---------------------------------------------------------------------------
// Lists of text: argument vectors, and the lines of a program's output.
// ---------------------------------------------------------------------------

export struct TextList {
  texts: *List<*i8>,

  fn new(): *TextList {
    let list: *TextList = alloc<TextList>(1);
    list.texts = List<*i8>.new();

    return list;
  }

  // Returns the list, so that a command line can be written as one chain.
  fn add(self: *TextList, text: *i8): *TextList {
    self.texts.push(text);
    return self;
  }

  fn at(self: *TextList, index: i32): *i8 {
    return self.texts.at(index as i64);
  }

  fn size(self: *TextList): i32 {
    return self.texts.count as i32;
  }

  // The list as execvp wants it, ending in a null that is not one of its
  // texts.
  fn argv(self: *TextList): **i8 {
    self.texts.push(null);
    self.texts.count = self.texts.count - 1;
    return self.texts.items;
  }
}

// ---------------------------------------------------------------------------
// Running programs.
// ---------------------------------------------------------------------------

// What happens to a child's stderr.
export enum StderrMode {
  Inherit,
  // Collected with its stdout, in the order the two were written.
  Merge,
  Discard,
}

// Runs `command` and returns its exit status, or a ProcessError when it
// could not be run or died on a signal.
//
// `dir`, when not null, is the directory it runs in. When `out` is not null
// the child's stdout is collected into it instead of going to ours, and so is
// its stderr under StderrMode.Merge.
export fn runCommand(command: *TextList, dir: *i8, out: *Builder,
                     stderrMode: StderrMode): i32 | ProcessError {
  let capturing: bool = out != null;
  let fds: *i32 = alloc<i32>(2);
  if (capturing) {
    pipe(fds);
  }

  let devNull: *i8 = null;
  if (stderrMode == StderrMode.Discard) {
    devNull = fopen("/dev/null", "w");
  }

  let argv: **i8 = command.argv();
  let pid: i32 = fork();

  if (pid == 0) {
    if (capturing) {
      dup2(fds[1], 1);
      if (stderrMode == StderrMode.Merge) {
        dup2(fds[1], 2);
      }
      close(fds[0]);
      close(fds[1]);
    }
    if (devNull != null) {
      dup2(fileno(devNull), 2);
    }
    if (dir != null && chdir(dir) != 0) {
      _exit(127);
    }

    execvp(argv[0], argv);
    // Only reached when exec failed. The child must not return into the
    // parent's code, and must not flush the parent's buffers on the way out.
    _exit(127);
  }

  if (capturing && pid > 0) {
    drain(fds, out);
  }

  if (devNull != null) {
    fclose(devNull);
  }

  return waitFor(pid);
}

// Runs `work` in a child process -- this program, forked, rather than another
// one -- with what it writes to stdout and stderr collected into `out`. The
// child works on a copy of everything, so whatever `work` changes, or however
// it ends, the caller's state is untouched. Returns the child's exit status,
// 0 if `work` returned.
export fn runInChild(work: () => void, out: *Builder): i32 | ProcessError {
  let fds: *i32 = alloc<i32>(2);
  pipe(fds);

  // Anything still buffered would otherwise be written twice: once by each.
  fflush(null);
  let pid: i32 = fork();

  if (pid == 0) {
    dup2(fds[1], 1);
    dup2(fds[1], 2);
    close(fds[0]);
    close(fds[1]);

    work();
    fflush(null);
    _exit(0);
  }

  if (pid > 0) {
    drain(fds, out);
  }
  return waitFor(pid);
}

// Reads a child's end of the pipe to its end. This comes before waiting: a
// child whose output fills the pipe would otherwise block forever on a parent
// that is waiting for it.
fn drain(fds: *i32, out: *Builder): void {
  close(fds[1]);
  let chunk: *i8 = alloc<i8>(4096);
  while (true) {
    let count: i64 = read(fds[0], chunk, 4096);
    if (count <= 0) {
      break;
    }
    out.addBytes(chunk, count);
  }
  free(chunk);
  close(fds[0]);
}

export error enum ProcessError {
  // No process could be made: fork failed.
  CannotStart,
  // It ended on a signal -- a crash, an abort -- rather than by exiting.
  Crashed,
}

// Whether a program run ended by exiting with 0.
export fn ran(result: i32 | ProcessError): bool {
  return (result ?? -1) == 0;
}

// The exit status of the child `pid`.
fn waitFor(pid: i32): i32 | ProcessError {
  if (pid < 0) {
    return ProcessError.CannotStart;
  }

  let status: *i32 = alloc<i32>(1);
  waitpid(pid, status, 0);

  // WIFEXITED and WEXITSTATUS are macros in C, so they are written out here.
  if ((*status & 127) != 0) {
    return ProcessError.Crashed;
  }

  return (*status >> 8) & 255;
}

// ---------------------------------------------------------------------------
// The environment.
// ---------------------------------------------------------------------------

// The variable's value, or null when it is unset or empty.
export fn environment(name: *i8): *i8 {
  let value: *i8 = getenv(name);
  if (value == null || value[0] == 0) {
    return null;
  }

  return value;
}

export fn setEnvironment(name: *i8, value: *i8): void {
  setenv(name, value, 1);
}

export fn changeDirectory(path: *i8): void | FileError {
  if (chdir(path) != 0) {
    return FileError.NotFound;
  }
  return;
}

export fn currentDirectory(): *i8 {
  let buffer: *i8 = alloc<i8>(4096);
  if (getcwd(buffer, 4096) == null) {
    return null;
  }

  return buffer;
}

export fn isTerminal(fd: i32): bool {
  return isatty(fd) != 0;
}

// A command line of `words` and, when it is not null, `more`: what the tests
// below run.
export fn command(words: *i8, more: *i8): *TextList {
  let list: *TextList = TextList.new().add(words);
  if (more != null) {
    list.add(more);
  }
  return list;
}

test "a program's exit status and output come back" {
  let out: *Builder = Builder.new();
  assertEq(runCommand(command("echo", "hello"), null, out, StderrMode.Merge), 0);
  assertEq(out.data, "hello\n");
  assertEq(runCommand(command("false", null), null, null, StderrMode.Inherit), 1);
  assert(!ran(runCommand(command("false", null), null, null, StderrMode.Inherit)));
  assert(ran(runCommand(command("true", null), null, null, StderrMode.Inherit)));
}

test "a program that is not there exits 127, as a shell would say" {
  assertEq(runCommand(command("no-such-program-anywhere", null), null, null,
                      StderrMode.Discard),
           127);
}

test "a program that crashes is told apart from one that fails" {
  let crash: *TextList = TextList.new().add("sh").add("-c").add("kill -SEGV $$");
  assertEq(runCommand(crash, null, null, StderrMode.Discard), ProcessError.Crashed);
  assert(!ran(runCommand(crash, null, null, StderrMode.Discard)));
}

test "a program runs in the directory it is given" {
  let out: *Builder = Builder.new();
  assertEq(runCommand(command("pwd", null), "/", out, StderrMode.Merge), 0);
  assertEq(out.data, "/\n");
}

let CHILD_STATUS: i32 = 0;

fn childWork(): void {
  printf("from the child\n");
  dprintf(2, "and its stderr\n");
  if (CHILD_STATUS == 99) {
    abort();
  }
  exit(CHILD_STATUS);
}

test "work run in a child gives back its output and status, or its crash" {
  let out: *Builder = Builder.new();
  CHILD_STATUS = 3;
  assertEq(runInChild(childWork, out), 3);
  // Both are caught; their order is the child's buffering, stdout being a
  // pipe there.
  assert(contains(out.data, "from the child\n"));
  assert(contains(out.data, "and its stderr\n"));

  CHILD_STATUS = 99;
  assertEq(runInChild(childWork, Builder.new()), ProcessError.Crashed);
}

test "an unset or empty variable has no value" {
  setEnvironment("ODE_TEST_EMPTY", "");
  assertEq(environment("ODE_TEST_EMPTY"), null);
  assertEq(environment("ODE_TEST_NEVER_SET_ANYWHERE"), null);
  setEnvironment("ODE_TEST_SET", "yes");
  assertEq(environment("ODE_TEST_SET"), "yes");
}

test "changing to a directory that is not there says so" {
  assertEq(changeDirectory("/no/such/directory/here"), FileError.NotFound);
}
