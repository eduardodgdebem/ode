// ---------------------------------------------------------------------------
// Paths, files and directories, beyond what std/fs covers: walking and
// removing trees, scratch directories, bytes that may hold a NUL.
//
// Where libc would need a struct whose layout differs between platforms --
// `stat`, `dirent` -- the job is handed to a standard tool instead (`ls`,
// `rm`), run without a shell, so a path with a space or a `$` in it arrives
// exactly as written.
// ---------------------------------------------------------------------------

import { free, memcmp, strlen, fopen, fclose, fread, fwrite, ferror } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { exists, FileError } from "std/fs";
import { Builder, equals, slice, endsWith } from "std/text";
import { TextList, StderrMode, runCommand, environment } from "./process";

extern fn access(path: *i8, mode: i32): i32;
extern fn mkdir(path: *i8, mode: i32): i32;
extern fn mkdtemp(template: *i8): *i8;
extern fn rename(from: *i8, to: *i8): i32;
// `access` modes.
let EXISTS: i32 = 0;
let EXECUTABLE: i32 = 1;

// ---------------------------------------------------------------------------
// Paths.
// ---------------------------------------------------------------------------

export fn joinPath(directory: *i8, name: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(directory);
  if (strlen(directory) > 0 &&
      directory[strlen(directory) - 1] != '/') {
    out.push('/');
  }
  out.add(name);

  return out.take();
}

// `path` without its directory and extension, which is what a bare `ode foo.ode`
// names its output.
export fn stemOf(path: *i8): *i8 {
  let length: i64 = strlen(path);
  let start: i64 = 0;
  let end: i64 = length;

  for (index in 0..length) {
    if (path[index] == '/') {
      start = index + 1;
    }
    if (path[index] == '.') {
      end = index;
    }
  }

  if (end <= start) {
    end = length;
  }

  return slice(path, start, end - start);
}

export fn withSuffix(base: *i8, suffix: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(base);
  out.add(suffix);

  return out.take();
}

// The directory holding `path`, without a trailing `/`: `/` for something at
// the root, and `.` for a bare name.
export fn parentDirectory(path: *i8): *i8 {
  let last: i64 = -1;
  let index: i64 = 0;

  while (path[index] != 0) {
    if (path[index] == '/') {
      last = index;
    }
    index = index + 1;
  }

  if (last < 0) {
    return ".";
  }
  if (last == 0) {
    return "/";
  }

  return slice(path, 0, last);
}

export fn isExecutable(path: *i8): bool {
  return access(path, EXECUTABLE) == 0;
}

export fn absolutePath(path: *i8): *i8 {
  return realpath(path, null);
}

// A file's bytes, NULs included.
export fn readBytes(path: *i8): *Builder | FileError {
  let stream: *i8 = fopen(path, "rb");
  if (stream == null) {
    if (!exists(path)) {
      return FileError.NotFound;
    }
    return FileError.CannotRead;
  }

  let out: *Builder = Builder.new();
  let chunk: *i8 = alloc<i8>(65536);
  while (true) {
    let count: i64 = fread(chunk, 1, 65536, stream);
    if (count <= 0) {
      break;
    }
    out.addBytes(chunk, count);
  }
  free(chunk);
  let failed: bool = ferror(stream) != 0;
  fclose(stream);
  if (failed) {
    return FileError.CannotRead;
  }
  return out;
}

export fn writeBytes(path: *i8, data: *Builder): void | FileError {
  let stream: *i8 = fopen(path, "wb");
  if (stream == null) {
    return FileError.CannotWrite;
  }

  let written: i64 = fwrite(data.data, 1, data.length, stream);
  if (fclose(stream) != 0 || written != data.length) {
    return FileError.CannotWrite;
  }
  return;
}

export fn sameBytes(a: *Builder, b: *Builder): bool {
  if (a.length != b.length) {
    return false;
  }

  return memcmp(a.data, b.data, a.length) == 0;
}

// Creates `path` and any directory above it that is missing. A file in the
// way, or a directory that may not be written, stops it.
export fn makeDirectories(path: *i8): void | FileError {
  let length: i64 = strlen(path);
  let index: i64 = 1;

  while (index <= length) {
    if (index == length || path[index] == '/') {
      mkdir(slice(path, 0, index), 493);
    }
    index = index + 1;
  }

  if (!isDirectory(path)) {
    return FileError.CannotWrite;
  }
  return;
}

// Removes `path` and everything under it; nothing there is not an error.
export fn removeTree(path: *i8): void {
  // What is left behind, if anything is, is untidy rather than wrong.
  runCommand(TextList.new().add("rm").add("-rf").add(path), null,
             null, StderrMode.Inherit) ?? 0;
}

export fn moveFile(from: *i8, to: *i8): void | FileError {
  if (rename(from, to) != 0) {
    if (!exists(from)) {
      return FileError.NotFound;
    }
    return FileError.CannotWrite;
  }
  return;
}

export fn isDirectory(path: *i8): bool {
  return exists(joinPath(path, "."));
}

// Every `.ode` file under `directory`, at any depth, in a stable order.
export fn findSources(directory: *i8): *TextList {
  let found: *TextList = TextList.new();
  let names: *TextList = listDirectory(directory);
  for (index in 0..names.size()) {
    let path: *i8 = joinPath(directory, names.at(index));
    if (isDirectory(path)) {
      let inner: *TextList = findSources(path);
      for (entry in 0..inner.size()) {
        found.add(inner.at(entry));
      }
    } else if (endsWith(path, ".ode")) {
      found.add(path);
    }
  }
  return found;
}

// The names in a directory, sorted, without `.` and `..`; none for a
// directory that is not there.
export fn listDirectory(path: *i8): *TextList {
  let output: *Builder = Builder.new();
  // ls fails on a missing directory, and prints nothing, which is the
  // answer: no names.
  runCommand(TextList.new().add("ls").add("-1").add(path), null, output,
             StderrMode.Discard) ?? 0;

  return splitLines(output);
}

export fn splitLines(text: *Builder): *TextList {
  let lines: *TextList = TextList.new();
  let start: i64 = 0;
  let index: i64 = 0;

  while (index < text.length) {
    if (text.data[index] == '\n') {
      lines.add(slice(text.data, start, index - start));
      start = index + 1;
    }
    index = index + 1;
  }
  if (start < text.length) {
    lines.add(slice(text.data, start, text.length - start));
  }

  return lines;
}

// A fresh, empty directory under $TMPDIR, or /tmp without one.
export fn makeTempDirectory(prefix: *i8): *i8 | FileError {
  let base: *i8 = environment("TMPDIR");
  if (base == null) {
    base = "/tmp";
  }

  let template: *Builder = Builder.new();
  template.add(joinPath(base, prefix));
  template.add(".XXXXXX");

  let made: *i8 = mkdtemp(template.take());
  if (made == null) {
    return FileError.CannotWrite;
  }
  return made;
}

export extern fn realpath(path: *i8, resolved: *i8): *i8;

// A scratch directory for a test, which the test removes.
fn scratch(): *i8 {
  return makeTempDirectory("ode-os-test") catch (e) {
    assert(false, "cannot make a scratch directory");
    return "";
  };
}

test "paths are joined, split and suffixed" {
  assertEq(joinPath("a/b", "c.ode"), "a/b/c.ode");
  assertEq(joinPath("a/b/", "c.ode"), "a/b/c.ode");
  assertEq(joinPath("", "c.ode"), "c.ode");
  assertEq(stemOf("dir/main.ode"), "main");
  assertEq(stemOf("main"), "main");
  assertEq(stemOf("dir.d/main"), "main");
  assertEq(stemOf("archive.tar.ode"), "archive.tar");
  assertEq(withSuffix("out/prog", ".ll"), "out/prog.ll");
  assertEq(parentDirectory("a/b/c.ode"), "a/b");
  assertEq(parentDirectory("c.ode"), ".");
  assertEq(parentDirectory("/c.ode"), "/");
}

test "bytes are written and read back whole, NULs included" {
  let directory: *i8 = scratch();
  let path: *i8 = joinPath(directory, "bytes");
  let data: *Builder = Builder.new();
  data.add("before");
  data.push(0);
  data.add("after");
  assert(!(writeBytes(path, data) is FileError));

  let back: *Builder = readBytes(path) ?? Builder.new();
  assertEq(back.length, 12);
  assert(sameBytes(back, data));
  removeTree(directory);
}

test "what cannot be read or written says why" {
  let directory: *i8 = scratch();
  assertEq(readBytes(joinPath(directory, "missing")), FileError.NotFound);
  assertEq(readBytes(directory), FileError.CannotRead);
  assertEq(writeBytes(joinPath(directory, "no/such/dir/file"), Builder.new()),
           FileError.CannotWrite);
  assertEq(moveFile(joinPath(directory, "missing"), joinPath(directory, "to")),
           FileError.NotFound);
  removeTree(directory);
}

test "directories are made all the way down, unless a file is in the way" {
  let directory: *i8 = scratch();
  let deep: *i8 = joinPath(directory, "a/b/c");
  assert(!(makeDirectories(deep) is FileError));
  assert(isDirectory(deep));
  assert(!(makeDirectories(deep) is FileError));

  let file: *i8 = joinPath(directory, "file");
  assert(!(writeBytes(file, Builder.new()) is FileError));
  assertEq(makeDirectories(joinPath(file, "inside")), FileError.CannotWrite);
  assert(!isDirectory(file));
  removeTree(directory);
}

test "scratch directories are fresh each time" {
  let one: *i8 = scratch();
  let two: *i8 = scratch();
  assert(!equals(one, two));
  assert(isDirectory(one) && isDirectory(two));
  removeTree(one);
  removeTree(two);
  assert(!isDirectory(one));
}

test "sources are found at any depth, and nothing else is" {
  let directory: *i8 = scratch();
  assertEq(findSources(directory).size(), 0);
  assertEq(listDirectory(joinPath(directory, "missing")).size(), 0);

  assert(!(makeDirectories(joinPath(directory, "nested/deeper")) is FileError));
  let names: *List<*i8> = List<*i8>.new();
  names.push("top.ode");
  names.push("nested/inner.ode");
  names.push("nested/deeper/leaf.ode");
  names.push("notes.txt");
  names.push("nested/main.ode.bak");
  for (index in 0..names.count) {
    assert(!(writeBytes(joinPath(directory, names.at(index)), Builder.new()) is FileError));
  }

  let found: *TextList = findSources(directory);
  assertEq(found.size(), 3);
  assert(endsWith(found.at(0), "nested/deeper/leaf.ode"));
  assert(endsWith(found.at(1), "nested/inner.ode"));
  assert(endsWith(found.at(2), "top.ode"));
  removeTree(directory);
}
