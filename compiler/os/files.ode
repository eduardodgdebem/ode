// ---------------------------------------------------------------------------
// Paths, files and directories, beyond what std/fs covers: walking and
// copying trees, scratch directories, bytes that may hold a NUL.
//
// Where libc would need a struct whose layout differs between platforms --
// `stat`, `dirent` -- the job is handed to a standard tool instead (`ls`,
// `cp`, `rm`), run without a shell, so a path with a space or a `$` in it
// arrives exactly as written.
// ---------------------------------------------------------------------------

import { free, memcmp, strlen, fopen, fclose, fread, fwrite } from "std/c";
import { alloc } from "std/mem";
import { exists } from "std/fs";
import { Builder, slice, endsWith } from "std/text";
import { TextList, StderrMode, runCommand, environment } from "./process";

extern fn access(path: *i8, mode: i32): i32;
extern fn mkdir(path: *i8, mode: i32): i32;
extern fn mkdtemp(template: *i8): *i8;
extern fn rename(from: *i8, to: *i8): i32;
// `access` modes.
let EXISTS: i32 = 0;
let EXECUTABLE: i32 = 1;

// ---------------------------------------------------------------------------
// Lists of text: argument vectors, and the lines of a program's output.
// ---------------------------------------------------------------------------

export fn joinPath(directory: *i8, name: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(directory);
  if (strlen(directory) > 0 &&
      directory[strlen(directory) - 1] != '/') {
    out.push('/');
  }
  out.add(name);

  return out.take();
}

// `path` without its directory and extension, which is what a bare `ode foo.ode`
// names its output.
export fn stemOf(path: *i8): *i8 {
  let length: i64 = strlen(path);
  let start: i64 = 0;
  let end: i64 = length;

  for (index in 0..length) {
    if (path[index] == '/') {
      start = index + 1;
    }
    if (path[index] == '.') {
      end = index;
    }
  }

  if (end <= start) {
    end = length;
  }

  return slice(path, start, end - start);
}

export fn withSuffix(base: *i8, suffix: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(base);
  out.add(suffix);

  return out.take();
}

// The directory holding `path`, without a trailing `/`: `/` for something at
// the root, and `.` for a bare name.
export fn parentDirectory(path: *i8): *i8 {
  let last: i64 = -1;
  let index: i64 = 0;

  while (path[index] != 0) {
    if (path[index] == '/') {
      last = index;
    }
    index = index + 1;
  }

  if (last < 0) {
    return ".";
  }
  if (last == 0) {
    return "/";
  }

  return slice(path, 0, last);
}

export fn isExecutable(path: *i8): bool {
  return access(path, EXECUTABLE) == 0;
}

export fn absolutePath(path: *i8): *i8 {
  return realpath(path, null);
}

// A file's bytes, NULs included, or a null Builder if it cannot be read.
export fn readBytes(path: *i8): *Builder {
  let stream: *i8 = fopen(path, "rb");
  if (stream == null) {
    return null;
  }

  let out: *Builder = Builder.new();
  let chunk: *i8 = alloc<i8>(65536);
  while (true) {
    let count: i64 = fread(chunk, 1, 65536, stream);
    if (count <= 0) {
      break;
    }
    out.addBytes(chunk, count);
  }
  free(chunk);
  fclose(stream);

  return out;
}

export fn writeBytes(path: *i8, data: *Builder): bool {
  let stream: *i8 = fopen(path, "wb");
  if (stream == null) {
    return false;
  }

  let written: i64 = fwrite(data.data, 1, data.length, stream);
  fclose(stream);

  return written == data.length;
}

export fn sameBytes(a: *Builder, b: *Builder): bool {
  if (a.length != b.length) {
    return false;
  }

  return memcmp(a.data, b.data, a.length) == 0;
}

// Creates `path` and any directory above it that is missing.
export fn makeDirectories(path: *i8): bool {
  let length: i64 = strlen(path);
  let index: i64 = 1;

  while (index <= length) {
    if (index == length || path[index] == '/') {
      mkdir(slice(path, 0, index), 493);
    }
    index = index + 1;
  }

  return exists(path);
}

export fn removeTree(path: *i8): void {
  runCommand(TextList.new().add("rm").add("-rf").add(path), null,
             null, StderrMode.Inherit);
}

// Copies what is inside `from` into `to`, which must exist.
fn copyTree(from: *i8, to: *i8): bool {
  let contents: *i8 = joinPath(from, ".");
  return runCommand(TextList.new().add("cp").add("-R").add(contents).add(to),
                    null, null, StderrMode.Inherit) == 0;
}

export fn moveFile(from: *i8, to: *i8): bool {
  return rename(from, to) == 0;
}

// The names in a directory, sorted, without `.` and `..`.
export fn isDirectory(path: *i8): bool {
  return exists(joinPath(path, "."));
}

// Every `.ode` file under `directory`, at any depth, in a stable order.
export fn findSources(directory: *i8): *TextList {
  let found: *TextList = TextList.new();
  let names: *TextList = listDirectory(directory);
  for (index in 0..names.size()) {
    let path: *i8 = joinPath(directory, names.at(index));
    if (isDirectory(path)) {
      let inner: *TextList = findSources(path);
      for (entry in 0..inner.size()) {
        found.add(inner.at(entry));
      }
    } else if (endsWith(path, ".ode")) {
      found.add(path);
    }
  }
  return found;
}

export fn listDirectory(path: *i8): *TextList {
  let output: *Builder = Builder.new();
  runCommand(TextList.new().add("ls").add("-1").add(path), null, output,
             StderrMode.Discard);

  return splitLines(output);
}

export fn splitLines(text: *Builder): *TextList {
  let lines: *TextList = TextList.new();
  let start: i64 = 0;
  let index: i64 = 0;

  while (index < text.length) {
    if (text.data[index] == '\n') {
      lines.add(slice(text.data, start, index - start));
      start = index + 1;
    }
    index = index + 1;
  }
  if (start < text.length) {
    lines.add(slice(text.data, start, text.length - start));
  }

  return lines;
}

// A fresh, empty directory under $TMPDIR, or /tmp without one.
export fn makeTempDirectory(prefix: *i8): *i8 {
  let base: *i8 = environment("TMPDIR");
  if (base == null) {
    base = "/tmp";
  }

  let template: *Builder = Builder.new();
  template.add(joinPath(base, prefix));
  template.add(".XXXXXX");

  return mkdtemp(template.take());
}

// ---------------------------------------------------------------------------
// Files.
// ---------------------------------------------------------------------------

export extern fn realpath(path: *i8, resolved: *i8): *i8;
