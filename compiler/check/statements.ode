// ---------------------------------------------------------------------------
// Checking statements and function bodies.
//
// A failed statement raises FAILED and returns. analyzeRecovering puts back the
// scopes, loop depth and return type the failure skipped past, so the next
// statement is checked as though the failed one were not there -- which is how
// one run reports every error rather than the first.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { equals } from "std/text";
import {
  Analyzer, analyzerFail, analyzerFailAtValue, quoted, analyzerParseType,
  analyzerValidateType, analyzerParamTypes,
} from "./analyzer";
import { foldInteger, laterGlobalIn } from "./constants";
import { analyzeMatch } from "./enums";
import { holdsErrors,
  valueOf, alwaysLeaves, alwaysReturns, declaredTypeOf, narrow, pathOf, forget,
  Narrowing, narrowingsOf, applyNarrowings,
} from "./errors";
import {
  checkExpr, checkExprAs, checkAssignTarget, isConstantExpr, isNumberLiteral,
  checkLiteralAs,
} from "./expressions";
import { analyzeMethodBodies } from "./methods";
import { TEST_MODE, runsTestsOf } from "./testing";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED } from "../diagnostics/report";
import { isTemplate, isInstance } from "../link/generics";
import {
  NO_NODE, NodeKind, Assign, Block, Break, Continue, Defer, EnumDecl, ExprStmt, Extern, For,
  Function, If, Import, Match, Return, StructDecl, Syntax, TypeAlias, VarDecl, While,
  functionOf, itemAt, itemCount, nodeName, paramOf, typeDepth,
} from "../syntax/ast";
import { SymbolKind } from "../types/symbols";
import { TypeKind, Type } from "../types/types";

// Runs one checking step, then puts back anything a failure skipped past so
// the next statement is checked as though the failed one were not there.
// Returns with FAILED lowered; the diagnostic has already been recorded.
export fn analyzeRecovering(an: *Analyzer, node: i32): void {
  let depth: i32 = an.symbols.depth();
  let loops: i32 = an.loopDepth;
  let wasInFunction: bool = an.inFunction;
  let returnType: Type = an.currentReturnType;

  analyzeStatement(an, node);

  if (!FAILED) {
    return;
  }

  an.symbols.truncateScopes(depth);
  an.loopDepth = loops;
  an.inFunction = wasInFunction;
  an.currentReturnType = returnType;
  FAILED = false;
}

export fn analyzeStatement(an: *Analyzer, node: i32): void {
  if (FAILED) {
    return;
  }
  // A generic is checked as its instances, not as itself -- but for whether
  // it returns, which is the same in every instance.
  if (isTemplate(an, node)) {
    requireReturns(an, node);
    return;
  }

  let syntax: Syntax = an.ast.nodes[node].syntax;
  match (syntax) {
    Block => analyzeBlock(an, node),
    VarDecl => analyzeVarDecl(an, node, syntax),
    Assign => analyzeAssign(an, node, syntax),
    If => analyzeIf(an, node, syntax),
    While => analyzeWhile(an, node, syntax),
    For => analyzeFor(an, node, syntax),
    Function => {
      if (an.ast.nodes[node].kind == NodeKind.Test) {
        analyzeTest(an, node);
      } else {
        analyzeFuncDecl(an, node, syntax);
      }
    }
    Extern => analyzeExternDecl(an, node, syntax),
    Return => analyzeReturn(an, node, syntax),
    ExprStmt => analyzeExpressionStatement(an, node, syntax),
    Break => {
      if (an.loopDepth == 0 && an.deferDepth > 0) {
        analyzerFail(an, node, Problem.DeferLeaves, Facts.about("break"));
      } else if (an.loopDepth == 0) {
        analyzerFail(an, node, Problem.BreakOutsideLoop, Facts.none());
      }
    }
    Continue => {
      if (an.loopDepth == 0 && an.deferDepth > 0) {
        analyzerFail(an, node, Problem.DeferLeaves, Facts.about("continue"));
      } else if (an.loopDepth == 0) {
        analyzerFail(an, node, Problem.ContinueOutsideLoop, Facts.none());
      }
    }
    // Checked where it is written, with what is in scope there. A loop it is
    // in is no loop of its own: it runs as the block is left, so it cannot
    // break out of anything but a loop inside it.
    Defer => {
      let loops: i32 = an.loopDepth;
      an.loopDepth = 0;
      an.deferDepth = an.deferDepth + 1;
      analyzeRecovering(an, syntax.body);
      an.deferDepth = an.deferDepth - 1;
      an.loopDepth = loops;
    }
    // A struct's fields were handled by the two registration passes; what is
    // left is the bodies of its methods.
    StructDecl => {
      analyzeMethodBodies(an, node);
      if (!isInstance(an, node)) {
        requireReturns(an, node);
      }
    }
    // An enum was registered before anything else was checked, an alias with
    // it, and an import by linkModules and the module's scope.
    EnumDecl, TypeAlias, Import => {}
    Match => analyzeMatch(an, node),
    else => {
      analyzerFail(an, node, Problem.Internal,
                   Facts.about("unknown statement node type"));
    }
  }
}

// A call made for what it does. One that may fail cannot have its error
// dropped on the floor: it is passed on, replaced, or handled. A union with
// no error in it is only a value, and may be dropped like any other.
fn analyzeExpressionStatement(an: *Analyzer, node: i32, statement: ExprStmt): void {
  let type: Type = checkExpr(an, statement.value);
  if (!FAILED && holdsErrors(type)) {
    analyzerFail(an, node, Problem.UnhandledError, Facts.aboutType(type));
  }
}

fn analyzeBlock(an: *Analyzer, node: i32): void {
  an.symbols.enterScope();

  for (index in 0..itemCount(an.ast, node)) {
    analyzeRecovering(an, itemAt(an.ast, node, index));
  }

  an.symbols.exitScope();
}

fn analyzeVarDecl(an: *Analyzer, node: i32, declaration: VarDecl): void {
  let name: *i8 = declaration.name;
  let declaredType: Type = analyzerParseType(an, declaration.type);

  analyzerValidateType(an, node, declaredType,
                       quoted("in declaration of ", name, ""));
  if (declaredType.isVoid()) {
    analyzerFail(an, node, Problem.VoidVariable, Facts.about(name));
  }

  // The initialiser is checked before the name is bound, so `let x = x + 1;`
  // cannot see the slot it is initialising.
  let exprType: Type = checkExprAs(an, declaration.value, declaredType);

  if (!FAILED && !declaredType.accepts(exprType)) {
    analyzerFailAtValue(an, declaration.value, Problem.DeclarationMismatch,
                        Facts.about(name).withTypes(declaredType, exprType));
  }

  // Globals were declared during hoisting; all that is left is to confirm the
  // initialiser can be emitted as an LLVM constant.
  if (an.isGlobal[node] != 0) {
    let init: i32 = declaration.value;
    let constant: bool = false;
    if (declaredType.isInteger()) {
      constant = foldInteger(an, init);
    } else {
      constant = isConstantExpr(an, init);
    }

    let later: i32 = laterGlobalIn(an, init);
    if (!FAILED && !constant && later != NO_NODE) {
      analyzerFail(an, node, Problem.GlobalDeclaredLater,
                   Facts.aboutTwo(name, nodeName(an.ast, later)));
    }
    if (!FAILED && !constant) {
      analyzerFail(an, node, Problem.GlobalNotConstant, Facts.about(name));
    }
    an.isGlobal[node] = 2;
    return;
  }

  an.symbols.declare(name, SymbolKind.Var, declaredType, null, 0,
                     an.ast.nodes[node].line, an.ast.nodes[node].column, node);
}

fn analyzeAssign(an: *Analyzer, node: i32, assignment: Assign): void {
  let targetType: Type = checkAssignTarget(an, node, assignment.target);
  // A variable narrowed by `is` is still stored as declared, and assigned
  // as declared.
  let target: i32 = assignment.target;
  if (an.ast.nodes[target].kind == NodeKind.Ident) {
    let declared: Type = declaredTypeOf(an, nodeName(an.ast, target));
    if (declared.isUnion()) {
      targetType = declared;
      an.types[target] = declared;
    }
  }
  // So is a field.
  if (an.ast.nodes[target].kind == NodeKind.FieldAccess &&
      an.narrowedFrom[target].kind != TypeKind.None) {
    targetType = an.narrowedFrom[target];
    an.types[target] = targetType;
    an.narrowedFrom[target] = Type.make(TypeKind.None, 0);
  }
  let exprType: Type = checkExprAs(an, assignment.value, targetType);

  if (!targetType.accepts(exprType)) {
    analyzerFailAtValue(an, assignment.value, Problem.AssignmentMismatch,
                        Facts.aboutTypes(targetType, exprType));
  }

  // Whatever was found out about what is assigned no longer holds.
  let path: *i8 = pathOf(an, target);
  if (path != null) {
    forget(an, path);
  }
}

fn analyzeIf(an: *Analyzer, node: i32, branch: If): void {
  let condType: Type = checkExpr(an, branch.condition);
  if (!condType.isBool()) {
    analyzerFail(an, node, Problem.ConditionNotBool,
                 Facts.about("if").withType(condType));
  }

  // `if (result is SomeError)` narrows `result`: to the error in the first
  // branch, and to what is left in the second -- or after the `if`, when the
  // first branch always leaves. See narrowingsOf.
  let held: *List<Narrowing> = List<Narrowing>.new();
  let notHeld: *List<Narrowing> = List<Narrowing>.new();
  if (!FAILED) {
    narrowingsOf(an, branch.condition, true, held);
    narrowingsOf(an, branch.condition, false, notHeld);
  }

  an.symbols.enterScope();
  applyNarrowings(an, held);
  analyzeStatement(an, branch.then);
  an.symbols.exitScope();

  if (branch.otherwise != NO_NODE) {
    an.symbols.enterScope();
    applyNarrowings(an, notHeld);
    analyzeStatement(an, branch.otherwise);
    an.symbols.exitScope();
  } else if (alwaysLeaves(an, branch.then)) {
    applyNarrowings(an, notHeld);
  }
}

fn analyzeWhile(an: *Analyzer, node: i32, loop: While): void {
  let condType: Type = checkExpr(an, loop.condition);
  if (!condType.isBool()) {
    analyzerFail(an, node, Problem.ConditionNotBool,
                 Facts.about("while").withType(condType));
  }

  an.loopDepth = an.loopDepth + 1;
  analyzeStatement(an, loop.body);
  an.loopDepth = an.loopDepth - 1;
}

// `for (i in start..end)`: the bounds are integers of one type, which a
// bound that is not a bare literal decides -- so `0..count` counts in
// count's type -- and the loop variable has that type, in a scope of its
// own around the body.
fn analyzeFor(an: *Analyzer, node: i32, loop: For): void {
  let start: i32 = loop.start;
  let end: i32 = loop.end;
  let type: Type = Type.make(TypeKind.I32, 0);
  let decided: i32 = NO_NODE;

  if (!isNumberLiteral(an, start)) {
    decided = start;
  } else if (!isNumberLiteral(an, end)) {
    decided = end;
  }

  if (decided != NO_NODE) {
    type = checkExpr(an, decided);
    if (FAILED) {
      return;
    }
    if (!type.isInteger()) {
      analyzerFail(an, node, Problem.ForBoundsNotIntegers, Facts.aboutType(type));
      return;
    }
  }

  for (index in 0..2) {
    let bound: i32 = start;
    if (index == 1) {
      bound = end;
    }

    if (bound != decided) {
      if (isNumberLiteral(an, bound)) {
        if (!checkLiteralAs(an, bound, type)) {
          return;
        }
      } else {
        let other: Type = checkExpr(an, bound);
        if (FAILED) {
          return;
        }
        if (!other.equals(type)) {
          analyzerFail(an, node, Problem.ForBoundsDiffer,
                     Facts.aboutTypes(type, other));
          return;
        }
      }
    }
  }

  an.symbols.enterScope();
  an.symbols.declare(loop.name, SymbolKind.Var, type, null, 0,
                     an.ast.nodes[node].line, an.ast.nodes[node].column, node);

  an.loopDepth = an.loopDepth + 1;
  analyzeStatement(an, loop.body);
  an.loopDepth = an.loopDepth - 1;

  an.symbols.exitScope();
}

fn analyzeReturn(an: *Analyzer, node: i32, statement: Return): void {
  if (!an.inFunction) {
    analyzerFail(an, node, Problem.ReturnOutsideFunction, Facts.none());
  }
  if (an.deferDepth > 0) {
    analyzerFail(an, node, Problem.DeferLeaves, Facts.about("return"));
  }

  if (statement.value == NO_NODE) {
    // `void | IoError` succeeds with a bare return.
    let returnsNothing: bool = an.currentReturnType.isVoid() ||
        (an.currentReturnType.isUnion() &&
         valueOf(an.currentReturnType).isVoid());
    if (!returnsNothing) {
      analyzerFail(an, node, Problem.ReturnWithoutValue,
                   Facts.aboutTypes(an.currentReturnType,
                                    Type.make(TypeKind.Void, 0)));
    }
    return;
  }

  let returned: Type = checkExprAs(an, statement.value, an.currentReturnType);

  if (an.currentReturnType.isVoid()) {
    analyzerFail(an, node, Problem.ReturnFromVoid, Facts.aboutType(returned));
  }

  if (!an.currentReturnType.accepts(returned)) {
    analyzerFailAtValue(an, statement.value, Problem.WrongReturnType,
                        Facts.aboutTypes(an.currentReturnType, returned));
  }
}

// A test is checked like a void function's body, and only by `ode test`.
fn analyzeTest(an: *Analyzer, node: i32): void {
  if (TEST_MODE && runsTestsOf(an.ast.nodes[node].module)) {
    analyzeFunctionBody(an, node);
  }
}

fn analyzeFuncDecl(an: *Analyzer, node: i32, function: Function): void {
  let name: *i8 = function.name;

  // Top-level functions were already recorded by the hoisting pass.
  if (an.symbols.find(name) < 0) {
    let paramCount: i32 = 0;
    let params: *Type = analyzerParamTypes(an, function.params, &paramCount);
    an.symbols.declare(name, SymbolKind.Fn,
                       analyzerParseType(an, function.returnType), params,
                  paramCount, an.ast.nodes[node].line,
                  an.ast.nodes[node].column, node);
  }

  analyzeFunctionBody(an, node);
  if (!isInstance(an, node)) {
    requireReturns(an, node);
  }
}

// A function that returns a value returns one on every path: falling off
// its end would give back a zero, and for `i32 | SomeError` that zero says
// it succeeded. A void function may fall off its end, and so may a `void |
// SomeError` one, where that is succeeding.
//
// `node` is a function, or a struct whose methods are each asked. It is
// asked as written, so a generic is asked once, not once per instance.
fn requireReturns(an: *Analyzer, node: i32): void {
  if (an.ast.nodes[node].kind == NodeKind.Struct) {
    for (index in 0..itemCount(an.ast, node)) {
      let method: i32 = itemAt(an.ast, node, index);
      if (an.ast.nodes[method].kind == NodeKind.Fn) {
        requireReturns(an, method);
        FAILED = false;
      }
    }
    return;
  }

  let function: Function = functionOf(an.ast, node);
  if (returnsNothing(an, function.returnType) || alwaysReturns(an, function.body)) {
    return;
  }
  analyzerFail(an, node, Problem.MissingReturn, Facts.about(nodeName(an.ast, node)));
}

// Whether a return type, as written, is `void` or `void | SomeError`.
fn returnsNothing(an: *Analyzer, type: i32): bool {
  if (an.ast.nodes[type].kind == NodeKind.UnionType) {
    return returnsNothing(an, itemAt(an.ast, type, 0));
  }
  return an.ast.nodes[type].kind == NodeKind.Type && typeDepth(an.ast, type) == 0 &&
         equals(nodeName(an.ast, type), "void");
}

// Checks a function's body in a scope holding its parameters. The function
// itself has already been declared, or, for a method, needs no declaring.
export fn analyzeFunctionBody(an: *Analyzer, node: i32): void {
  let localsFrom: i32 = an.localsFrom;
  an.localsFrom = an.symbols.count;
  an.symbols.enterScope();

  let function: Function = functionOf(an.ast, node);
  let paramList: i32 = function.params;
  if (paramList != NO_NODE) {
    let index: i32 = 0;
    while (index < itemCount(an.ast, paramList)) {
      let param: i32 = itemAt(an.ast, paramList, index);
      let paramType: Type = analyzerParseType(an, paramOf(an.ast, param).type);
      an.symbols.declare(nodeName(an.ast, param), SymbolKind.Var, paramType,
                         null, 0, an.ast.nodes[param].line,
                    an.ast.nodes[param].column, param);
      index = index + 1;
    }
  }

  // A nested function gets its own return type and loop nesting; neither
  // leaks in from the function it is written inside.
  let wasInFunction: bool = an.inFunction;
  let previousReturnType: Type = an.currentReturnType;
  let previousLoopDepth: i32 = an.loopDepth;

  an.inFunction = true;
  an.currentReturnType = analyzerParseType(an, function.returnType);
  an.loopDepth = 0;

  analyzeStatement(an, function.body);

  an.inFunction = wasInFunction;
  an.currentReturnType = previousReturnType;
  an.loopDepth = previousLoopDepth;

  an.symbols.exitScope();
  an.localsFrom = localsFrom;
}

fn analyzeExternDecl(an: *Analyzer, node: i32, declaration: Extern): void {
  let name: *i8 = declaration.name;
  let paramCount: i32 = 0;
  let params: *Type = analyzerParamTypes(an, declaration.params, &paramCount);

  if (an.symbols.find(name) < 0) {
    an.symbols.declare(name, SymbolKind.Fn,
                       analyzerParseType(an, declaration.returnType), params,
                  paramCount, an.ast.nodes[node].line,
                  an.ast.nodes[node].column, node);
  }

  for (index in 0..paramCount) {
    if (params[index].isVoid()) {
      analyzerFail(an, node, Problem.VoidParameter, Facts.about(name));
    }
  }
}
