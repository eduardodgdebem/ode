// ---------------------------------------------------------------------------
// Tests, kept in the file they test, as in Zig and Rust:
//
//   test "adds two numbers" {
//     assertEq(add(2, 2), 4);
//     assert(add(0, 0) == 0, "zero is neutral");
//   }
//
// A test is only checked and compiled by `ode test`; any other build leaves
// it out, the way Rust leaves out #[cfg(test)]. `assert` and `assertEq` are
// built in everywhere, unless the program declares a function of that name.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Builder, equals } from "std/text";
import { Analyzer, analyzerFail } from "./analyzer";
import { valuesOf, holdsError } from "./errors";
import { checkExpr, checkExprAs, isLiteralTree } from "./expressions";
import { CallTarget } from "./functions";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED } from "../diagnostics/report";
import { isLibraryModule } from "../link/modules";
import { NO_NODE, NodeKind, callOf, itemAt, itemCount, nodeName } from "../syntax/ast";
import { TypeKind, Type } from "../types/types";

// Set by `ode test`: tests are checked and compiled, and the program gets a
// runner for a `main`.
export let TEST_MODE: bool = false;

// Whether the call `node` is the built-in `name` rather than a function the
// program declared.
export fn isBuiltin(an: *Analyzer, node: i32, name: *i8): bool {
  return an.ast.nodes[node].kind == NodeKind.Call &&
         equals(nodeName(an.ast, node), name) &&
         an.symbols.find(name) < 0;
}

export fn argumentCount(an: *Analyzer, args: i32): i32 {
  if (args == NO_NODE) {
    return 0;
  }
  return itemCount(an.ast, args);
}

export fn isAssert(an: *Analyzer, node: i32): bool {
  return isBuiltin(an, node, "assert");
}

// `assert(cond)` or `assert(cond, message)`: stops the program, or fails the
// test, when `cond` is false.
export fn checkAssert(an: *Analyzer, node: i32): Type {
  let args: i32 = callOf(an.ast, node).args;
  let count: i32 = argumentCount(an, args);
  an.callTargets[node] = CallTarget.Assert;

  if (count != 1 && count != 2) {
    analyzerFail(an, node, Problem.AssertArguments, Facts.none());
    return Type.make(TypeKind.Void, 0);
  }

  let condition: Type = checkExpr(an, itemAt(an.ast, args, 0));
  if (!condition.isBool()) {
    analyzerFail(an, node, Problem.AssertNotBool, Facts.aboutType(condition));
  }

  if (count == 2) {
    let message: Type = checkExpr(an, itemAt(an.ast, args, 1));
    if (!message.equals(Type.make(TypeKind.I8, 1))) {
      analyzerFail(an, node, Problem.AssertMessageNotText, Facts.aboutType(message));
    }
  }

  return Type.make(TypeKind.Void, 0);
}

export fn isAssertEq(an: *Analyzer, node: i32): bool {
  return isBuiltin(an, node, "assertEq");
}

// `assertEq(actual, expected)`: like `assert(actual == expected)`, but a
// failure shows both values -- and two strings compare by their text.
export fn checkAssertEq(an: *Analyzer, node: i32): Type {
  let args: i32 = callOf(an.ast, node).args;
  an.callTargets[node] = CallTarget.AssertEq;

  if (argumentCount(an, args) != 2) {
    analyzerFail(an, node, Problem.AssertEqArguments, Facts.none());
    return Type.make(TypeKind.Void, 0);
  }

  // Either side may be a bare literal, which takes the other side's type.
  let actualNode: i32 = itemAt(an.ast, args, 0);
  let expectedNode: i32 = itemAt(an.ast, args, 1);
  let actual: Type = Type.make(TypeKind.None, 0);
  let expected: Type = Type.make(TypeKind.None, 0);
  if (isLiteralTree(an, actualNode) && !isLiteralTree(an, expectedNode)) {
    expected = checkExpr(an, expectedNode);
    actual = checkExprAs(an, actualNode, expected);
  } else {
    actual = checkExpr(an, actualNode);
    expected = checkExprAs(an, expectedNode, actual);
  }

  // The two are compared as they are, not stored anywhere: neither becomes
  // the other's union.
  an.coerceTo[actualNode] = Type.make(TypeKind.None, 0);
  an.coerceTo[expectedNode] = Type.make(TypeKind.None, 0);

  if (!actual.accepts(expected) && !expected.accepts(actual)) {
    analyzerFail(an, node, Problem.AssertEqTypes, Facts.aboutTypes(actual, expected));
  } else if (actual.isVoid() || actual.isStruct()) {
    analyzerFail(an, node, Problem.AssertEqType, Facts.aboutType(actual));
  } else if (comparesStructs(actual, expected) || comparesStructs(expected, actual)) {
    // A union that may hold a struct can still be asked for an error.
    analyzerFail(an, node, Problem.AssertEqType, Facts.aboutType(actual));
  }

  return Type.make(TypeKind.Void, 0);
}

// Whether checking that `type` equals `other` would compare two structs:
// `type` is a union that may hold one, and `other` is not just an error.
fn comparesStructs(type: Type, other: Type): bool {
  if (!type.isUnion()) {
    return false;
  }
  if (other.isEnum() && holdsError(type, other.structName)) {
    return false;
  }
  let values: *List<Type> = valuesOf(type);
  for (index in 0..values.count) {
    if (values.at(index).isStruct()) {
      return true;
    }
  }
  return false;
}

// Whether `ode test` runs the tests written in `module`: those of what is
// being tested and of the files it imports -- but not the standard
// library's, unless the library is what is being tested.
export fn runsTestsOf(module: i32): bool {
  return module == 0 || !isLibraryModule(module) || isLibraryModule(0);
}

export fn isNameOf(an: *Analyzer, node: i32): bool {
  return isBuiltin(an, node, "nameOf");
}

// `nameOf(value)`: the name of the enum member `value` is, as a string --
// "Red" for Color.Red -- for printing one.
export fn checkNameOf(an: *Analyzer, node: i32): Type {
  let args: i32 = callOf(an.ast, node).args;
  an.callTargets[node] = CallTarget.NameOf;
  if (argumentCount(an, args) != 1) {
    analyzerFail(an, node, Problem.WrongArgumentCount,
                 Facts.about("nameOf").withCounts(1,
                                                  argumentCount(an, args) as i64));
    return Type.make(TypeKind.I8, 1);
  }

  let type: Type = checkExpr(an, itemAt(an.ast, args, 0));
  if (!FAILED && !type.isEnum()) {
    analyzerFail(an, node, Problem.WrongArgumentType,
                 Facts.about("nameOf").withTypes(Type.ofEnum("enum", 0), type)
                     .withCounts(1, 0));
  }
  return Type.make(TypeKind.I8, 1);
}

// The module `ode test` adds to the program, once it has been loaded.
export let RUNNER_MODULE: i32 = -1;

// The runner, in Ode: `ode test` compiles it in as a module of its own, and
// the generated `main` calls its `runTests` with every test in the program.
// Each test runs in a child process, so that a failed check -- which exits
// -- or a crash ends that test alone. Only tests whose name contains the
// first argument, if one is given, run.
export fn runnerSource(): *i8 {
  let out: *Builder = Builder.new();
  out.add("extern fn fork(): i32;\n");
  out.add("extern fn waitpid(pid: i32, status: *i32, options: i32): i32;\n");
  out.add("extern fn exit(code: i32): void;\n");
  out.add("extern fn fflush(stream: *i8): i32;\n");
  out.add("extern fn printf(format: *i8, ...): i32;\n");
  out.add("extern fn strstr(text: *i8, part: *i8): *i8;\n");
  out.add("\n");
  out.add("export fn runTests(count: i32, names: **i8, tests: *(() => void),\n");
  out.add("                   argc: i32, argv: **i8): i32 {\n");
  out.add("  let filter: *i8 = null;\n");
  out.add("  if (argc > 1) {\n");
  out.add("    filter = argv[1];\n");
  out.add("  }\n");
  out.add("  let passed: i32 = 0;\n");
  out.add("  let failed: i32 = 0;\n");
  out.add("  let skipped: i32 = 0;\n");
  out.add("\n");
  out.add("  for (index in 0..count) {\n");
  out.add("    if (filter != null && strstr(names[index], filter) == null) {\n");
  out.add("      skipped += 1;\n");
  out.add("      continue;\n");
  out.add("    }\n");
  out.add("\n");
  out.add("    fflush(null);\n");
  out.add("    let child: i32 = fork();\n");
  out.add("    if (child == 0) {\n");
  out.add("      let test: () => void = tests[index];\n");
  out.add("      test();\n");
  out.add("      exit(0);\n");
  out.add("    }\n");
  out.add("\n");
  out.add("    let status: i32 = 0;\n");
  out.add("    waitpid(child, &status, 0);\n");
  out.add("    let signal: i32 = status & 127;\n");
  out.add("    if (status == 0) {\n");
  out.add("      printf(\"test %s ... ok\\n\", names[index]);\n");
  out.add("      passed += 1;\n");
  out.add("    } else if (signal != 0) {\n");
  out.add("      printf(\"test %s ... CRASHED (signal %d)\\n\", names[index], signal);\n");
  out.add("      failed += 1;\n");
  out.add("    } else {\n");
  out.add("      printf(\"test %s ... FAILED\\n\", names[index]);\n");
  out.add("      failed += 1;\n");
  out.add("    }\n");
  out.add("  }\n");
  out.add("\n");
  out.add("  printf(\"\\n%d passed; %d failed\", passed, failed);\n");
  out.add("  if (skipped > 0) {\n");
  out.add("    printf(\"; %d filtered out\", skipped);\n");
  out.add("  }\n");
  out.add("  printf(\"\\n\");\n");
  out.add("\n");
  out.add("  if (failed > 0) {\n");
  out.add("    return 1;\n");
  out.add("  }\n");
  out.add("  return 0;\n");
  out.add("}\n");

  return out.take();
}
