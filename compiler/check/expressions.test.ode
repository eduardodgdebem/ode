test "invalid cast" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }
      `)
      .returning("i32")
      .run(`
        let point: Point = Point { x: 1 };
        let value: i32 = point as i32;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.InvalidCast);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 24);
}

test "literal argument out of range" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn store(value: u8): void {}
      `)
      .returning("i32")
      .run(`
        store(300);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NumberOutOfRange);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 7);
}

test "literal operand out of range" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let wide: i64 = 5;
        let value: i64 = wide + 99999999999999999999;

        return 0;
