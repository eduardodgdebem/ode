// ---------------------------------------------------------------------------
// Expressions -- operators, casts, numbers, fields: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope } from "../testkit/testkit";

test "add two pointers" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: i32 = 1;
        let pointer: *i32 = &value;
        let sum: *i32 = pointer + pointer;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AddPointers);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 25);
}

test "address of temporary" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let pointer: *i32 = &(1 + 1);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AddressOfTemporary);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 21);
}

test "arithmetic on bool" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: bool = true + false;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ArithmeticNotNumeric);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 24);
}

test "arithmetic type mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let small: i32 = 1;
        let wide: i64 = 2;
        let value: i64 = small + wide;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ArithmeticTypes);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 24);
}

test "compare bool" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: bool = true < false;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.OrderBoolOrVoid);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 24);
}

test "compare null with integer" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let count: i32 = 0;
        if (count == null) {
          return 1;
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.EqualityTypes);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 11);
}

test "comparison type mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let small: i32 = 1;
        let wide: i64 = 2;
        let value: bool = small < wide;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ComparisonTypes);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 25);
}

test "dereference non pointer" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let value: i32 = 1;
        printf("%d\n", *value);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DereferenceNonPointer);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 16);
}

test "enum arithmetic" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        let c: Color = Color.Red + Color.Green;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ArithmeticNotNumeric);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 26);
}

test "equality type mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: bool = 1 == true;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.EqualityTypes);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 21);
}

test "field access on non struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let value: i32 = 1;
        printf("%d\n", value.x);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 22);
  assertEq(found.at(0).facts.name, "x");
}

test "for bound out of range" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let limit: u8 = 10 as u8;
        for (i in -1..limit) {
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NumberOutOfRange);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 11);
}

test "for variable outside loop" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        for (i in 0..3) {
        }
        return i;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UndefinedVariable);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 8);
  assertEq(found.at(0).facts.name, "i");
}

test "generic instance type error" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Box<T> {
          value: T,
        }

        fn identity<T>(x: T): T {
          return x;
        }

        fn twice<T>(x: T): T {
          return x + x;
        }

        fn main(): i32 {
          let ok: i32 = twice<i32>(2);
          let bad: bool = twice<bool>(true);
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ArithmeticNotNumeric);
  assertEq(found.at(0).line, 10);
  assertEq(found.at(0).column, 12);
}

test "index non pointer" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let value: i32 = 1;
        printf("%d\n", value[0]);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.IndexNonPointer);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 21);
}

test "index not integer" {
  let found: *List<Diagnostic> = Scope.new()
