test "logical not on int" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: bool = !1;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotNotBool);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 19);
}

test "logical operator on ints" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: bool = 1 && 2;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.LogicalNotBool);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 21);
}

test "match pattern out of range" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let byte: u8 = 1 as u8;
        match (byte) {
          300 => {
            return 1;
          }
          else => {
            return 0;
          }
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NumberOutOfRange);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 3);
}

