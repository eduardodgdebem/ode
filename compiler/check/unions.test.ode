// ---------------------------------------------------------------------------
// Unions of types: a value that is one of several types, told apart with
// `is`, and errors as one more kind of member.
//
// Each checks a fragment in a Scope that states what it can see, and asserts
// the type found, or the problems: which, where, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope } from "../testkit/testkit";

let SHAPES: *i8 = `
  error enum Bad { Negative }

  struct Circle {
    radius: i64,
  }

  struct Rect {
    width: i64,
    height: i64,
  }

  struct Line {
    length: i64,
  }

  type Shape = Circle | Rect;
  type Drawing = Shape | Line;

  fn validated(shape: Shape): Shape | Bad {
    return shape;
  }
`;

fn shapes(): *Scope {
  return Scope.new().declare(SHAPES)
      .local("shape", "Shape")
      .local("drawing", "Drawing")
      .local("checked", "Shape | Bad")
      .local("either", "i64 | *i8");
}

test "a union of unions is one union of all their members" {
  let scope: *Scope = shapes();
  assertEq(scope.check("drawing").type.toText(), "Circle | Line | Rect");
  assertEq(scope.check("checked").type.toText(), "Circle | Rect | Bad");
  assertEq(scope.check("validated(shape) ?? shape").type.toText(), "Circle | Rect");
}

test "a union is given any of its members, or a union of some of them" {
  let found: *List<Diagnostic> = shapes().run(`
    shape = Circle { radius: 1 };
    shape = Rect { width: 1, height: 2 };
    drawing = shape;
    drawing = Line { length: 3 };
    checked = shape;
    checked = Bad.Negative;
    either = 5;
    either = "five";
    either = null;
  `);
  assertEq(found.count, 0);
}

test "a union is not given what it cannot hold, nor a wider union" {
  let found: *List<Diagnostic> = shapes().run(`
    shape = Line { length: 3 };
    shape = drawing;
    either = true;
  `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.AssignmentMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(1).problem, Problem.AssignmentMismatch);
  assertEq(found.at(1).line, 2);
  assertEq(found.at(2).problem, Problem.AssignmentMismatch);
  assertEq(found.at(2).facts.got.toText(), "bool");
}

test "null given to a union of two pointers could be either, so it is neither" {
  let found: *List<Diagnostic> = Scope.new()
      .run("let both: *i8 | *i64 = null;");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
}

test "is narrows a union to a member, and the other branch to the rest" {
  let found: *List<Diagnostic> = shapes().run(`
    if (drawing is Circle) {
      let circle: Circle = drawing;
    } else {
      let rest: Line | Rect = drawing;
    }
    if (checked is Bad) {
      let bad: Bad = checked;
    } else {
      let fine: Shape = checked;
    }
    if (either is *i8) {
      let text: *i8 = either;
    } else {
      let number: i64 = either;
    }
  `);
  assertEq(found.count, 0);
}

test "a narrowed union is the member, and no other" {
  let found: *List<Diagnostic> = shapes().run(`
    if (shape is Circle) {
      let wrong: Rect = shape;
      let radius: i64 = shape.radius;
    }
    let notYet: Circle = shape;
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 5);
}

test "is asks only about a member the union has" {
  let scope: *Scope = shapes();
  assertEq(scope.check("shape is Line").problem(), Problem.IsNeverTrue);
  assertEq(scope.check("shape is Bad").problem(), Problem.IsNeverTrue);
  assertEq(scope.check("either is i32").problem(), Problem.IsNeverTrue);
  assertEq(scope.check("drawing is Line").type.toText(), "bool");
}

test "try and ?? take what is left once the errors are gone" {
  let scope: *Scope = shapes().returning("i64 | Bad");
  assert(scope.run("let s: Shape = try validated(shape); return 0;").count == 0);
  assertEq(shapes().returning("i64").run("let s: Shape = try validated(shape); return 0;")
               .at(0).problem, Problem.ErrorNotReturned);
  assertEq(shapes().check("validated(shape) ?? Line { length: 1 }").problem(),
           Problem.CoalesceTypes);
}

test "a union of values compares with ==, one of structs or errors does not" {
  let scope: *Scope = shapes();
  assertEq(scope.check("either == either").type.toText(), "bool");
  assertEq(scope.check("either != 5").type.toText(), "bool");
  assertEq(scope.check("shape == shape").problem(), Problem.UnionStructCompared);
  assertEq(scope.check("checked == checked").problem(), Problem.UnionCompared);
  assertEq(scope.check("either == shape").problem(), Problem.EqualityTypes);
}

test "a call giving a union of values may be made for what it does" {
  let scope: *Scope = shapes().declare(`
    fn pick(): i64 | *i8 {
      return 1;
    }
  `).returning("i32");
  assertEq(scope.run("pick(); return 0;").count, 0);
  assertEq(scope.run("validated(shape); return 0;").at(0).problem, Problem.UnhandledError);
}

test "assertEq compares a union of plain values, and one of structs only to an error" {
  let found: *List<Diagnostic> = shapes().run(`
    assertEq(either, 5);
    assertEq(either, "five");
    assertEq(checked, Bad.Negative);
    assertEq(checked, Circle { radius: 1 });
    assertEq(shape, shape);
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.AssertEqType);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(1).problem, Problem.AssertEqType);
  assertEq(found.at(1).line, 5);
}

test "a match on a union narrows the variable in each arm" {
  let found: *List<Diagnostic> = shapes().run(`
    match (drawing) {
      Circle => {
        let circle: Circle = drawing;
      }
      Rect, Line => {
        let other: Line | Rect = drawing;
      }
    }
    match (checked) {
      Bad => {
        let bad: Bad = checked;
      }
      else => {
        let fine: Shape = checked;
      }
    }
    match (either) {
      i64 => {
        let number: i64 = either;
      }
      *i8 => {
        let text: *i8 = either;
      }
    }
  `);
  assertEq(found.count, 0);
}

test "an arm's variable is its own members, and no other" {
  let found: *List<Diagnostic> = shapes().run(`
    match (shape) {
      Circle => {
        let wrong: Rect = shape;
      }
      else => {
        let alsoWrong: Circle = shape;
      }
    }
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).facts.got.toText(), "Circle");
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 6);
  assertEq(found.at(1).facts.got.toText(), "Rect");
}

test "a match without else names every member, errors included" {
  let found: *List<Diagnostic> = shapes().run(`
    match (checked) {
      Circle, Rect => {}
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnhandledUnionMember);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).facts.name, "Circle | Rect | Bad");
  assertEq(found.at(0).facts.other, "Bad");
}

test "a match names only members, each once, and only types" {
  let notMember: *List<Diagnostic> = shapes().run(`
    match (shape) {
      Line => {}
      else => {}
    }
  `);
  assertEq(notMember.count, 1);
  assertEq(notMember.at(0).problem, Problem.IsNeverTrue);
  assertEq(notMember.at(0).line, 2);
  assertEq(notMember.at(0).facts.name, "Line");

  let twice: *List<Diagnostic> = shapes().run(`
    match (shape) {
      Circle => {}
      Rect, Circle => {}
    }
  `);
  assertEq(twice.count, 1);
  assertEq(twice.at(0).problem, Problem.DuplicatePattern);
  assertEq(twice.at(0).line, 3);
  assertEq(twice.at(0).column, 9);

  let notType: *List<Diagnostic> = shapes().run(`
    match (shape) {
      1 => {}
      else => {}
    }
  `);
  assertEq(notType.count, 1);
  assertEq(notType.at(0).problem, Problem.PatternNotType);

  let unknown: *List<Diagnostic> = shapes().run(`
    match (shape) {
      Missing => {}
      else => {}
    }
  `);
  assertEq(unknown.count, 1);
  assertEq(unknown.at(0).problem, Problem.UnknownType);
  assertEq(unknown.at(0).facts.name, "Missing");

  let afterElse: *List<Diagnostic> = shapes().run(`
    match (shape) {
      else => {}
      Circle => {}
    }
  `);
  assertEq(afterElse.count, 1);
  assertEq(afterElse.at(0).problem, Problem.ArmAfterElse);
}

test "a match that returns in every arm returns" {
  let found: *List<Diagnostic> = Scope.new().declare(SHAPES)
      .declare(`
        fn area(shape: Shape): i64 {
          match (shape) {
            Circle => {
              return shape.radius;
            }
            Rect => {
              return shape.width * shape.height;
            }
          }
        }
      `)
      .problems();
  assertEq(found.count, 0);
}

test "a match on what is not a variable picks an arm, and narrows nothing" {
  let found: *List<Diagnostic> = shapes().run(`
    match (validated(shape)) {
      Circle => {
        let wrong: Circle = validated(shape);
      }
      else => {}
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
}

test "a type is no pattern in a match on a number or an enum" {
  let found: *List<Diagnostic> = Scope.new().declare(SHAPES)
      .local("count", "i64")
      .run(`
        match (count) {
          i64 => {}
          else => {}
        }
        match (count) {
          Circle => {}
          else => {}
        }
      `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.PatternNotLiteral);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(1).problem, Problem.PatternNotLiteral);
  assertEq(found.at(1).line, 6);
}

let HOLDERS: *i8 = `
  struct Circle {
    radius: i64,
  }

  struct Rect {
    width: i64,
    height: i64,
  }

  type Shape = Circle | Rect;

  struct Holder {
    shape: Shape,
  }

  struct Outer {
    inner: Holder,
  }
`;

fn holders(): *Scope {
  return Scope.new().declare(HOLDERS)
      .local("holder", "Holder")
      .local("pointer", "*Holder")
      .local("outer", "Outer")
      .local("other", "Holder")
      .local("going", "bool");
}

test "is narrows a field, through pointers and nested fields alike" {
  let found: *List<Diagnostic> = holders().run(`
    if (holder.shape is Circle) {
      let radius: i64 = holder.shape.radius;
    } else {
      let width: i64 = holder.shape.width;
    }
    if (pointer.shape is Rect) {
      let width: i64 = pointer.shape.width;
    }
    if (outer.inner.shape is Circle) {
      let circle: Circle = outer.inner.shape;
    }
    if (pointer.shape is Circle) {
      return;
    }
    let height: i64 = pointer.shape.height;
  `);
  assertEq(found.count, 0);
}

test "a match narrows a field in each arm" {
  let found: *List<Diagnostic> = holders().run(`
    match (outer.inner.shape) {
      Circle => {
        let radius: i64 = outer.inner.shape.radius;
      }
      Rect => {
        let wrong: i64 = outer.inner.shape.radius;
      }
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NoSuchField);
  assertEq(found.at(0).line, 6);
}

test "a narrowed field is that member only where it was narrowed" {
  let found: *List<Diagnostic> = holders().run(`
    if (holder.shape is Circle) {
      let wrong: i64 = holder.shape.width;
      let elsewhere: i64 = other.shape.radius;
    }
    let after: i64 = holder.shape.radius;
  `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.NoSuchField);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(1).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(1).line, 3);
  assertEq(found.at(2).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(2).line, 5);
}

test "assigning a narrowed field takes any member, and forgets what was found" {
  let found: *List<Diagnostic> = holders().run(`
    if (holder.shape is Circle) {
      holder.shape = Rect { width: 1, height: 2 };
      let radius: i64 = holder.shape.radius;
    }
    if (holder.shape is Circle) {
      if (going) {
        holder.shape = Rect { width: 1, height: 2 };
      }
      let radius: i64 = holder.shape.radius;
    }
    if (holder.shape is Circle) {
      holder = other;
      let radius: i64 = holder.shape.radius;
    }
    if (holder.shape is Circle) {
      holder.shape.radius = 5;
      let radius: i64 = holder.shape.radius;
    }
  `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(1).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(1).line, 9);
  assertEq(found.at(2).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(2).line, 13);
}

test "assigning a narrowed variable forgets what was found too" {
  let found: *List<Diagnostic> = shapes().run(`
    if (either is i64) {
      either = "text";
      let number: i64 = either;
    }
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 3);
}

test "is narrows through !, the branches swapping what they learn" {
  let found: *List<Diagnostic> = shapes().run(`
    if (!(shape is Circle)) {
      let rect: Rect = shape;
    } else {
      let circle: Circle = shape;
    }
    if (!(checked is Bad)) {
      let fine: Shape = checked;
    }
    if (!!(either is i64)) {
      let number: i64 = either;
    }
  `);
  assertEq(found.count, 0);
}

test "an early return under ! leaves the member it asked about" {
  let found: *List<Diagnostic> = shapes().returning("i64").run(`
    if (!(shape is Circle)) {
      return 0;
    }
    return shape.radius;
  `);
  assertEq(found.count, 0);

  let wrong: *List<Diagnostic> = shapes().returning("i64").run(`
    if (!(shape is Circle)) {
      return shape.radius;
    }
    return 0;
  `);
  assertEq(wrong.count, 1);
  assertEq(wrong.at(0).problem, Problem.NoSuchField);
  assertEq(wrong.at(0).line, 2);
}

test "&& narrows its right side, and an if's first branch, by both sides" {
  let found: *List<Diagnostic> = shapes().run(`
    let big: bool = shape is Circle && shape.radius > 10;
    if (shape is Circle && shape.radius > 1) {
      let circle: Circle = shape;
    }
    if (shape is Rect && either is i64) {
      let width: i64 = shape.width + either;
    }
  `);
  assertEq(found.count, 0);
}

test "|| narrows its right side where the left failed, and an if's second branch" {
  let found: *List<Diagnostic> = shapes().returning("i64").run(`
    let small: bool = shape is Rect || shape.radius < 2;
    if (shape is Rect || either is *i8) {
      return 0;
    }
    return shape.radius + either;
  `);
  assertEq(found.count, 0);
}

test "&& and || narrow only where they say something" {
  let found: *List<Diagnostic> = shapes().run(`
    if (shape is Circle || either is i64) {
      let wrong: i64 = shape.radius;
    }
    let after: bool = shape is Circle || shape.radius > 0;
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.FieldOfNonStruct);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(1).problem, Problem.NoSuchField);
  assertEq(found.at(1).line, 4);
}
