// ---------------------------------------------------------------------------
// assert and assertEq: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope } from "../testkit/testkit";

test "assert argument counts" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        assert();
        assert(true, "message", 3);
        assertEq(1);

        return 0;
      `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.AssertArguments);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(1).problem, Problem.AssertArguments);
  assertEq(found.at(1).line, 2);
  assertEq(found.at(1).column, 1);
  assertEq(found.at(2).problem, Problem.AssertEqArguments);
  assertEq(found.at(2).line, 3);
  assertEq(found.at(2).column, 1);
}

test "assert eq mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let wide: i64 = 1;
        let small: i32 = 1;
        assertEq(wide, small);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AssertEqTypes);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 1);
}

test "assert eq struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
        }
      `)
      .returning("i32")
      .run(`
        let p: Point = Point { x: 1 };
        assertEq(p, p);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AssertEqType);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
}

test "assert message not text" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        assert(true, 42);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AssertMessageNotText);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "assert not boolean" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        assert(1);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AssertNotBool);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}
