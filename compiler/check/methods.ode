// ---------------------------------------------------------------------------
// Methods.
//
// A method is a function written inside a struct. One whose first parameter
// is `self`, typed as the struct or a pointer to it, is called on a value,
// and the value is passed as `self`: by address when `self` is a pointer and
// the value a struct, by loading when it is the other way round, and as it is
// otherwise -- so `p.length()` works whether `p` is a `Point` or a `*Point`.
// Any method can also be called on the struct's name with every parameter
// written out, which is the only way to call one without `self`:
// `Point.new(1, 2)`, or `Point.length(&p)`.
// ---------------------------------------------------------------------------

import { Builder, equals } from "std/text";
import {
  Analyzer, analyzerFail, quoted, analyzerParseType, analyzerValidateType,
  throughAlias,
  analyzerParamTypes, isVariadic,
} from "./analyzer";
import { isLValue, checkExpr, checkArguments } from "./expressions";
import { CallTarget, checkCallThrough } from "./functions";
import { analyzeFunctionBody } from "./statements";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED } from "../diagnostics/report";
import { isTemplate } from "../link/generics";
import {
  NO_NODE, NodeKind, itemAt, itemCount, methodCallOf, nodeName, paramsOf, returnTypeOf,
  typeNodeOf,
} from "../syntax/ast";
import { SymbolKind } from "../types/symbols";
import { TypeKind, Type } from "../types/types";

// How a method call passes its receiver.
export enum ReceiverMode {
  // There is none: the method was called on the struct's name.
  None,
  // As it is: a struct to a struct `self`, or a pointer to a pointer `self`.
  Pass,
  // The address of a struct, to a pointer `self`.
  Address,
  // The struct a pointer points at, to a struct `self`.
  Load,
}
// How a method call passes its receiver.

// What a method's first parameter makes of it.
enum SelfKind {
  None,
  Value,
  Pointer,
  // A first parameter called `self` with some other type, already reported.
  Invalid,
}

// The declaration of the struct whose IR name is `name`.
export fn structDeclOf(an: *Analyzer, name: *i8): i32 {
  for (index in 0..itemCount(an.ast, an.program)) {
    let item: i32 = itemAt(an.ast, an.program, index);
    if (an.ast.nodes[item].kind == NodeKind.Struct &&
        equals(nodeName(an.ast, item), name)) {
      return item;
    }
  }

  return NO_NODE;
}

// The first method of the struct declared at `structNode` named `name`, or
// NO_NODE.
fn findMethod(an: *Analyzer, structNode: i32, name: *i8): i32 {
  for (index in 0..itemCount(an.ast, structNode)) {
    let item: i32 = itemAt(an.ast, structNode, index);
    if (an.ast.nodes[item].kind == NodeKind.Fn &&
        equals(nodeName(an.ast, item), name)) {
      return item;
    }
  }

  return NO_NODE;
}

// The field of the struct declared at `structNode` named `name`, or NO_NODE.
export fn fieldDeclOf(an: *Analyzer, structNode: i32, name: *i8): i32 {
  if (structNode == NO_NODE) {
    return NO_NODE;
  }
  for (index in 0..itemCount(an.ast, structNode)) {
    let item: i32 = itemAt(an.ast, structNode, index);
    if (an.ast.nodes[item].kind == NodeKind.Field &&
        equals(nodeName(an.ast, item), name)) {
      return item;
    }
  }

  return NO_NODE;
}

// `Point.length`, which is how diagnostics name a method.
fn methodName(an: *Analyzer, structNode: i32, method: i32): *i8 {
  let out: *Builder = Builder.new();
  out.add(nodeName(an.ast, structNode));
  out.push('.');
  out.add(nodeName(an.ast, method));

  return out.take();
}

fn methodSelf(an: *Analyzer, structNode: i32, method: i32): SelfKind {
  let params: i32 = paramsOf(an.ast, method);
  if (params == NO_NODE || itemCount(an.ast, params) == 0) {
    return SelfKind.None;
  }

  let first: i32 = itemAt(an.ast, params, 0);
  if (!equals(nodeName(an.ast, first), "self")) {
    return SelfKind.None;
  }

  let type: Type = analyzerParseType(an, typeNodeOf(an.ast, first));
  if (type.kind != TypeKind.Struct ||
      !equals(type.structName, nodeName(an.ast, structNode))) {
    return SelfKind.Invalid;
  }
  if (type.pointerDepth == 0) {
    return SelfKind.Value;
  }
  if (type.pointerDepth == 1) {
    return SelfKind.Pointer;
  }

  return SelfKind.Invalid;
}

// Checks each method's signature, the way hoistSignature does a function's.
// Methods are not symbols: they are found through the struct they belong to.
export fn registerMethods(an: *Analyzer, node: i32): void {
  if (an.ast.nodes[node].kind != NodeKind.Struct || isTemplate(an, node)) {
    return;
  }

  let index: i32 = 0;
  while (index < itemCount(an.ast, node)) {
    let method: i32 = itemAt(an.ast, node, index);

    if (an.ast.nodes[method].kind == NodeKind.Fn) {
      let name: *i8 = methodName(an, node, method);

      if (findMethod(an, node, nodeName(an.ast, method)) != method) {
        analyzerFail(an, method, Problem.DuplicateMethod, Facts.about(name));
      }
      if (isVariadic(an, method)) {
        analyzerFail(an, method, Problem.VariadicMethod, Facts.about(name));
      }

      analyzerValidateType(an, method,
                           analyzerParseType(an, returnTypeOf(an.ast, method)),
                           quoted("return type of ", name, ""));

      let paramCount: i32 = 0;
      let params: *Type = analyzerParamTypes(an, paramsOf(an.ast, method),
                                             &paramCount);
      for (param in 0..paramCount) {
        analyzerValidateType(an, method, params[param],
                             quoted("parameter of ", name, ""));
      }

      if (methodSelf(an, node, method) == SelfKind.Invalid) {
        analyzerFail(an, method, Problem.SelfWrongType,
                     Facts.aboutTwo(name, nodeName(an.ast, node)));
      }

      FAILED = false;
    }

    index = index + 1;
  }
}

export fn analyzeMethodBodies(an: *Analyzer, node: i32): void {
  let index: i32 = 0;

  while (index < itemCount(an.ast, node)) {
    let method: i32 = itemAt(an.ast, node, index);

    if (an.ast.nodes[method].kind == NodeKind.Fn) {
      let depth: i32 = an.symbols.depth();
      analyzeFunctionBody(an, method);
      an.symbols.truncateScopes(depth);
      FAILED = false;
    }

    index = index + 1;
  }
}

fn methodReturnType(an: *Analyzer, method: i32): Type {
  return analyzerParseType(an, returnTypeOf(an.ast, method));
}

export fn checkMethodCall(an: *Analyzer, node: i32): Type {
  let object: i32 = methodCallOf(an.ast, node).receiver;
  let name: *i8 = nodeName(an.ast, node);
  an.structRefs[node] = throughAlias(an, an.structRefs[node]);

  // `Point.new(...)`: the receiver is a struct's name rather than a value. A
  // variable of the same name wins, as it would anywhere else a name is
  // read.
  if (an.ast.nodes[object].kind == NodeKind.Ident &&
      an.structRefs[node] != null) {
    let symbol: i32 = an.symbols.find(nodeName(an.ast, object));
    if (symbol < 0 || an.symbols.items[symbol].kind != SymbolKind.Var) {
      return checkStaticCall(an, node, structDeclOf(an, an.structRefs[node]));
    }
  }

  // `List<i32>.new(...)`: the receiver is an instance of a generic struct,
  // written as a type.
  if (an.ast.nodes[object].kind == NodeKind.Type) {
    let declaration: i32 = NO_NODE;
    if (an.structRefs[node] != null) {
      declaration = structDeclOf(an, an.structRefs[node]);
    }
    if (declaration == NO_NODE) {
      analyzerFail(an, node, Problem.StaticCallOnValue, Facts.none());
      return Type.make(TypeKind.None, 0);
    }
    return checkStaticCall(an, node, declaration);
  }

  let objectType: Type = checkExpr(an, object);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }

  let structType: Type = objectType.base();

  if (!structType.isStruct()) {
    analyzerFail(an, node, Problem.MethodOfNonStruct,
                 Facts.about(name).withType(objectType));
    return Type.make(TypeKind.None, 0);
  }

  let structNode: i32 = structDeclOf(an, structType.structName);
  let method: i32 = NO_NODE;
  if (structNode != NO_NODE) {
    method = findMethod(an, structNode, name);
  }

  // `ops.apply(x)` with no method `apply` calls the field of that name, if
  // it holds a function.
  if (method == NO_NODE && structNode != NO_NODE) {
    let structIndex: i32 = an.structs.indexOf(structType.structName);
    let field: i32 = an.structs.fieldIndex(structIndex, name);
    if (field >= 0) {
      let fieldType: Type = an.structs.items[structIndex].fields[field].type;
      an.callTargets[node] = CallTarget.Field;
      an.declarations[node] = fieldDeclOf(an, structNode, name);
      return checkCallThrough(an, node, name, fieldType, methodCallOf(an.ast, node).args);
    }
  }

  if (method == NO_NODE) {
    analyzerFail(an, node, Problem.NoSuchMethod,
                 Facts.aboutTwo(structType.structName, name));
    return Type.make(TypeKind.None, 0);
  }

  an.declarations[node] = method;
  let fullName: *i8 = methodName(an, structNode, method);
  let self: SelfKind = methodSelf(an, structNode, method);

  if (self == SelfKind.Invalid) {
    return Type.make(TypeKind.None, 0);
  }

  if (self == SelfKind.None) {
    analyzerFail(an, node, Problem.NoSelf, Facts.about(fullName));
    return Type.make(TypeKind.None, 0);
  }

  let receivesPointer: bool = objectType.isPointer();

  if (self == SelfKind.Pointer && !receivesPointer) {
    // `self` is the value's address, and a temporary has none to take.
    if (!isLValue(an, object)) {
      analyzerFail(an, node, Problem.MethodOnTemporary, Facts.about(fullName));
      return Type.make(TypeKind.None, 0);
    }
    an.receivers[node] = ReceiverMode.Address;
  } else if (self == SelfKind.Value && receivesPointer) {
    an.receivers[node] = ReceiverMode.Load;
  } else {
    an.receivers[node] = ReceiverMode.Pass;
  }

  let paramCount: i32 = 0;
  let params: *Type = analyzerParamTypes(an, paramsOf(an.ast, method),
                                         &paramCount);

  // `self` is the receiver, so the arguments line up with what follows it.
  checkArguments(an, node, fullName, methodCallOf(an.ast, node).args, params + 1,
                 paramCount - 1);
  an.linkNames[node] = an.linkNames[method];

  return methodReturnType(an, method);
}

// A method called on the struct's name, which takes every parameter as an
// argument -- `self` included, when it has one.
fn checkStaticCall(an: *Analyzer, node: i32, structNode: i32): Type {
  let name: *i8 = nodeName(an.ast, node);
  let method: i32 = findMethod(an, structNode, name);

  if (method == NO_NODE) {
    analyzerFail(an, node, Problem.NoSuchMethod,
                 Facts.aboutTwo(nodeName(an.ast, structNode), name));
    return Type.make(TypeKind.None, 0);
  }
  an.declarations[node] = method;

  let paramCount: i32 = 0;
  let params: *Type = analyzerParamTypes(an, paramsOf(an.ast, method),
                                         &paramCount);

  an.receivers[node] = ReceiverMode.None;
  checkArguments(an, node, methodName(an, structNode, method),
                 methodCallOf(an.ast, node).args, params, paramCount);
  an.linkNames[node] = an.linkNames[method];

  return methodReturnType(an, method);
}
