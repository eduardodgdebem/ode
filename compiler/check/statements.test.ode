test "return value from void" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn nothing(): void {
          return 1;
        }
      `)
      .returning("i32")
      .run(`
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ReturnFromVoid);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
}

