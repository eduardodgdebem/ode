// ---------------------------------------------------------------------------
// Statements: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope } from "../testkit/testkit";

test "assign to enum member" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        Color.Red = Color.Blue;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAssignable);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "assign to non lvalue" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        1 + 1 = 2;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAssignable);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "assignment type mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let value: i32 = 1;
        value = true;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.AssignmentMismatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 9);
}

test "break outside for scope" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        for (i in 0..3) {
        }
        break;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.BreakOutsideLoop);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 1);
}

test "break outside loop" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        break;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.BreakOutsideLoop);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "continue outside loop" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        continue;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ContinueOutsideLoop);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "declaration type mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let wrong: bool = 1;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 19);
  assertEq(found.at(0).facts.name, "wrong");
}

test "enum mixed enums" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }

        enum Size { Small, Large }
      `)
      .returning("i32")
      .run(`
        let c: Color = Size.Small;
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 16);
  assertEq(found.at(0).facts.name, "c");
}

test "enum to integer without cast" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        enum Color { Red, Green, Blue }
      `)
      .returning("i32")
      .run(`
        let n: i32 = Color.Green;
        return n;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 14);
  assertEq(found.at(0).facts.name, "n");
}

test "float literal for integer" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let count: i16 = 1.5;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 18);
  assertEq(found.at(0).facts.name, "count");
}

test "for bounds mismatched" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let small: i32 = 1;
        let big: i64 = 10 as i64;
        for (i in small..big) {
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ForBoundsDiffer);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).column, 1);
}

test "for bounds not integers" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        for (i in 0.5..10.0) {
        }
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ForBoundsNotIntegers);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

test "function signature mismatch" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn square(x: i32): i32 {
          return x * x;
        }
      `)
      .returning("i32")
      .run(`
        let f: fn(i64): i32 = square;
        let g: fn(i32): bool = square;
        return 0;
      `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 23);
  assertEq(found.at(0).facts.name, "f");
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 2);
  assertEq(found.at(1).column, 24);
  assertEq(found.at(1).facts.name, "g");
}

test "function used as variable" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn helper(): i32 {
          return 1;
        }
      `)
      .returning("i32")
      .run(`
        // A function's name is a value of a function type, not of its result's.
        let value: i32 = helper;

        return value;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 18);
  assertEq(found.at(0).facts.name, "value");
}

test "if condition not bool" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        if (1) {
          return 1;
        }

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ConditionNotBool);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "if");
}

test "multiple errors nested" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        // Recovery works at every block depth, not just the top level of a function.
      `)
      .returning("i32")
      .run(`
        if (true) {
          let a: bool = 1;

          while (true) {
            let b: bool = 2;
            break;
          }

          let c: bool = 3;
        }

        return 0;
      `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 17);
  assertEq(found.at(0).facts.name, "a");
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 5);
  assertEq(found.at(1).column, 19);
  assertEq(found.at(1).facts.name, "b");
  assertEq(found.at(2).problem, Problem.DeclarationMismatch);
  assertEq(found.at(2).line, 9);
  assertEq(found.at(2).column, 17);
  assertEq(found.at(2).facts.name, "c");
}

test "multiple type errors" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        // Every one of these is reported in a single run. The three 'let's each bind
        // their name despite the bad initialiser, so the uses below them add nothing.

        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let a: bool = 1;
        let b: i32 = true;
        let c: i32 = "text";

        printf("%d\n", a);
        printf("%d\n", b + c);

        if (b) {
          printf("%d\n", 1);
        }

        while (c) {
          break;
        }

        return 0;
      `);
  assertEq(found.count, 5);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 15);
  assertEq(found.at(0).facts.name, "a");
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 2);
  assertEq(found.at(1).column, 14);
  assertEq(found.at(1).facts.name, "b");
  assertEq(found.at(2).problem, Problem.DeclarationMismatch);
  assertEq(found.at(2).line, 3);
  assertEq(found.at(2).column, 14);
  assertEq(found.at(2).facts.name, "c");
  assertEq(found.at(3).problem, Problem.ConditionNotBool);
  assertEq(found.at(3).line, 8);
  assertEq(found.at(3).column, 1);
  assertEq(found.at(3).facts.name, "if");
  assertEq(found.at(4).problem, Problem.ConditionNotBool);
  assertEq(found.at(4).line, 12);
  assertEq(found.at(4).column, 1);
  assertEq(found.at(4).facts.name, "while");
}

test "null to integer" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let count: i32 = null;
        return count;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 18);
  assertEq(found.at(0).facts.name, "count");
}

