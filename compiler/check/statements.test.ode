  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        return;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ReturnWithoutValue);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
}

