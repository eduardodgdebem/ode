// ---------------------------------------------------------------------------
// Enums and match.
//
// An enum is a named set of integer constants:
//
//     enum Color { Red, Green = 5, Blue }
//
// A member without a value takes the one after the member before it, and the
// first takes 0, so Blue is 6. The enum is a type of its own -- a `Color` is
// not an i32, and converts to one only through `as` -- and its members are
// written `Color.Red`. Underneath it is an i32.
//
// `match` picks a block by value:
//
//     match (color) {
//       Color.Red => { ... }
//       Color.Green, Color.Blue => { ... }
//     }
//
// On an enum it has to handle every member or have an `else` arm, so adding
// a member is a compile error at every match that forgot it. On an integer
// or a character it has to have an `else`, since no list of arms can cover
// every value. A value may appear in only one arm.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { equals } from "std/text";
import { analyzeUnionMatch } from "./unions";
import { Analyzer, analyzerFail, analyzerFailAtValue } from "./analyzer";
import { unionInfo, valuesOf, alwaysLeaves } from "./errors";
import { checkExpr, checkExprAs, isNumberLiteral, checkLiteralAs } from "./expressions";
import { analyzeStatement } from "./statements";
import { memberName } from "../codegen/testing";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED } from "../diagnostics/report";
import {
  NO_NODE, NodeKind, EnumDecl, EnumMember, FieldAccess, Syntax, armOf, itemAt,
  itemCount, matchOf, negated, nodeName, nodeTextLength,
} from "../syntax/ast";
import { TypeKind, Type, parseMagnitude } from "../types/types";

// The declaration of the enum whose IR name is `name`.
export fn enumDeclOf(an: *Analyzer, name: *i8): i32 {
  for (index in 0..itemCount(an.ast, an.program)) {
    let item: i32 = itemAt(an.ast, an.program, index);
    if (an.ast.nodes[item].kind == NodeKind.Enum &&
        equals(nodeName(an.ast, item), name)) {
      return item;
    }
  }

  return NO_NODE;
}

// The value of an integer literal, possibly negated, or false through `ok`
// when the node is not one.
fn integerLiteralValue(an: *Analyzer, node: i32, ok: *bool): i64 {
  let kind: NodeKind = an.ast.nodes[node].kind;
  *ok = true;

  if (negated(an.ast, node) != NO_NODE) {
    let inner: i64 = integerLiteralValue(an, negated(an.ast, node), ok);
    return 0 - inner;
  }

  if (kind == NodeKind.Char) {
    return nodeName(an.ast, node)[0] as i64;
  }

  if (kind != NodeKind.Number) {
    *ok = false;
    return 0;
  }

  let text: *i8 = nodeName(an.ast, node);
  let negative: bool = text[0] == '-';
  let index: i64 = 0;
  if (negative) {
    index = 1;
  }

  // A float is no pattern; any integer, in any base, is.
  let length: i64 = nodeTextLength(an.ast, node);
  for (at in index..length) {
    if (text[at] == '.') {
      *ok = false;
      return 0;
    }
  }
  let overflowed: bool = false;
  let value: i64 = parseMagnitude(text, index, length, &overflowed) as i64;

  if (negative) {
    return 0 - value;
  }
  return value;
}

// Records an enum: its name, so that type names can be told apart from struct
// names, and the value of every member.
export fn registerEnum(an: *Analyzer, node: i32): void {
  if (an.ast.nodes[node].kind != NodeKind.Enum) {
    return;
  }

  let name: *i8 = nodeName(an.ast, node);
  if (an.enumNames.has(name)) {
    analyzerFail(an, node, Problem.DuplicateEnum, Facts.about(name));
    return;
  }
  an.enumNames.add(name);

  // An error enum's errors are numbered across the whole program, so that a
  // union of several can tell them apart; see errors.ode.
  let declared: Syntax = an.ast.nodes[node].syntax;
  let isError: bool = false;
  if (declared is EnumDecl) {
    isError = declared.isError;
  }
  if (isError) {
    an.errorEnums.add(name);
  }

  let next: i64 = 0;
  if (isError) {
    next = an.nextErrorCode;
  }
  let index: i32 = 0;
  while (index < itemCount(an.ast, node)) {
    let member: i32 = itemAt(an.ast, node, index);
    let memberName: *i8 = nodeName(an.ast, member);

    for (earlier in 0..index) {
      let other: i32 = itemAt(an.ast, node, earlier);
      if (equals(nodeName(an.ast, other), memberName)) {
        analyzerFail(an, member, Problem.DuplicateMember,
                     Facts.aboutTwo(name, memberName));
        FAILED = false;
      }
    }

    let memberSyntax: Syntax = an.ast.nodes[member].syntax;
    let valueNode: i32 = NO_NODE;
    if (memberSyntax is EnumMember) {
      valueNode = memberSyntax.value;
    }
    if (valueNode != NO_NODE && isError) {
      analyzerFail(an, member, Problem.ErrorValueWritten, Facts.about(memberName));
      FAILED = false;
    } else if (valueNode != NO_NODE) {
      let ok: bool = true;
      let written: i64 = integerLiteralValue(an, valueNode, &ok);
      if (!ok || an.ast.nodes[valueNode].kind == NodeKind.Char) {
        analyzerFail(an, member, Problem.EnumValueNotLiteral, Facts.about(memberName));
        FAILED = false;
      } else {
        next = written;
      }
    }

    // The value is an i32 underneath, so it has to fit one.
    if (next > 2147483647 || next < -2147483648) {
      analyzerFail(an, member, Problem.EnumValueOutOfRange, Facts.about(memberName));
      FAILED = false;
    }

    an.isConstant[member] = 1;
    an.values[member] = next;
    next = next + 1;
    index = index + 1;
  }

  if (isError) {
    an.nextErrorCode = next;
  }
}

// `Color.Red`, once the name in front is known to be an enum's.
export fn checkEnumMember(an: *Analyzer, node: i32, enumName: *i8): Type {
  let declaration: i32 = enumDeclOf(an, enumName);
  let memberName: *i8 = nodeName(an.ast, node);

  for (index in 0..itemCount(an.ast, declaration)) {
    let member: i32 = itemAt(an.ast, declaration, index);
    if (equals(nodeName(an.ast, member), memberName)) {
      an.isConstant[node] = 1;
      an.values[node] = an.values[member];
      return Type.ofEnum(enumName, 0);
    }
  }

  analyzerFail(an, node, Problem.NoSuchMember, Facts.aboutTwo(enumName, memberName));

  return Type.make(TypeKind.None, 0);
}

// `.Red`: a member of the enum `expected` is, or, where a union is expected,
// of the one enum among its members that has a member of that name -- so
// `return .Empty;` in a function returning `i64 | ParseError`.
export fn checkShorthand(an: *Analyzer, node: i32, expected: Type): Type {
  let member: *i8 = nodeName(an.ast, node);
  if (expected.isEnum()) {
    return checkEnumMember(an, node, expected.structName);
  }
  if (!expected.isUnion()) {
    analyzerFail(an, node, Problem.ShorthandWithoutEnum, Facts.about(member));
    return Type.make(TypeKind.None, 0);
  }

  let found: *i8 = null;
  let count: i32 = 0;
  let errors: *List<*i8> = unionInfo(expected).errors;
  for (index in 0..errors.count) {
    if (hasMember(an, errors.at(index), member)) {
      found = errors.at(index);
      count = count + 1;
    }
  }
  let values: *List<Type> = valuesOf(expected);
  for (index in 0..values.count) {
    if (values.at(index).isEnum() && hasMember(an, values.at(index).structName, member)) {
      found = values.at(index).structName;
      count = count + 1;
    }
  }
  if (count != 1) {
    analyzerFail(an, node, Problem.ShorthandWithoutEnum,
                 Facts.about(member).withType(expected));
    return Type.make(TypeKind.None, 0);
  }
  return checkEnumMember(an, node, found);
}

fn hasMember(an: *Analyzer, enumName: *i8, member: *i8): bool {
  let declaration: i32 = enumDeclOf(an, enumName);
  for (index in 0..itemCount(an.ast, declaration)) {
    if (equals(nodeName(an.ast, itemAt(an.ast, declaration, index)), member)) {
      return true;
    }
  }
  return false;
}

// Whether `node` is `.Red`, an enum member named without its enum.
export fn isShorthand(an: *Analyzer, node: i32): bool {
  let syntax: Syntax = an.ast.nodes[node].syntax;
  if (syntax is FieldAccess) {
    return syntax.object == NO_NODE;
  }
  return false;
}

// Checks what an arm runs. In a match used as a value an expression arm is
// that value -- of the type expected, or else of the first arm's type,
// recorded as the match's own -- and a block has to leave, there being no
// value for it to give.
export fn checkArmBody(an: *Analyzer, matched: i32, arm: i32, expected: Type): void {
  let body: i32 = armOf(an.ast, arm).body;
  if (!matchOf(an.ast, matched).isValue) {
    analyzeStatement(an, body);
    return;
  }
  if (an.ast.nodes[body].kind == NodeKind.Block) {
    analyzeStatement(an, body);
    if (!FAILED && !alwaysLeaves(an, body)) {
      analyzerFail(an, arm, Problem.ArmFallsThrough, Facts.none());
    }
    return;
  }

  let wanted: Type = expected;
  if (wanted.kind == TypeKind.None) {
    wanted = an.types[matched];
  }
  let type: Type = checkExprAs(an, body, wanted);
  if (FAILED) {
    return;
  }
  if (wanted.kind == TypeKind.None) {
    an.types[matched] = type;
    return;
  }
  if (!wanted.accepts(type)) {
    analyzerFailAtValue(an, body, Problem.ArmTypes, Facts.aboutTypes(wanted, type));
  }
}

// `match (...) { ... }` used as a value: its type is the one expected, or the
// first arm's.
export fn checkMatchValue(an: *Analyzer, node: i32, expected: Type): Type {
  an.types[node] = Type.make(TypeKind.None, 0);
  analyzeMatchWith(an, node, expected);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }
  if (expected.kind != TypeKind.None) {
    return expected;
  }
  if (an.types[node].kind == TypeKind.None) {
    // Every arm left; there is no value, and nothing that could use one.
    return Type.make(TypeKind.Void, 0);
  }
  return an.types[node];
}

// Checks one pattern of a match on a value of type `subject`, and records
// the value it stands for.
fn checkPattern(an: *Analyzer, pattern: i32, subject: Type): void {
  // A type names what a union holds, and is no value to match against.
  let kind: NodeKind = an.ast.nodes[pattern].kind;
  if (kind == NodeKind.Type || kind == NodeKind.FnType) {
    analyzerFail(an, pattern, Problem.PatternNotLiteral, Facts.none());
    return;
  }
  if (subject.isEnum()) {
    let type: Type = checkExprAs(an, pattern, subject);
    if (FAILED) {
      return;
    }
    if (an.isConstant[pattern] == 0 || !type.equals(subject)) {
      analyzerFail(an, pattern, Problem.PatternNotMember,
                   Facts.about(subject.structName));
    }
    return;
  }

  let ok: bool = true;
  let value: i64 = integerLiteralValue(an, pattern, &ok);
  if (!ok) {
    analyzerFail(an, pattern, Problem.PatternNotLiteral, Facts.none());
    return;
  }

  // A number takes the type of the value matched, as long as it fits it,
  // so `0` matches an i64 and `200` a u8. A character stays an i8.
  if (isNumberLiteral(an, pattern)) {
    if (!checkLiteralAs(an, pattern, subject)) {
      return;
    }
  } else {
    let type: Type = checkExpr(an, pattern);
    if (FAILED) {
      return;
    }
    if (!type.equals(subject)) {
      analyzerFail(an, pattern, Problem.PatternType, Facts.aboutTypes(subject, type));
      return;
    }
  }

  an.isConstant[pattern] = 1;
  an.values[pattern] = value;
}

// The member of the enum declared at `declaration` whose value no arm of
// `node` handles, or NO_NODE when every one is handled.
fn unhandledMember(an: *Analyzer, node: i32, declaration: i32): i32 {
  for (index in 0..itemCount(an.ast, declaration)) {
    let member: i32 = itemAt(an.ast, declaration, index);
    if (!matchHandles(an, node, an.values[member])) {
      return member;
    }
  }

  return NO_NODE;
}

fn matchHandles(an: *Analyzer, node: i32, value: i64): bool {
  for (arm in 0..itemCount(an.ast, node)) {
    let armNode: i32 = itemAt(an.ast, node, arm);
    for (pattern in 0..itemCount(an.ast, armNode)) {
      let patternNode: i32 = itemAt(an.ast, armNode, pattern);
      if (an.isConstant[patternNode] != 0 &&
          an.values[patternNode] == value) {
        return true;
      }
    }
  }

  return false;
}

export fn analyzeMatch(an: *Analyzer, node: i32): void {
  analyzeMatchWith(an, node, Type.make(TypeKind.None, 0));
}

// A match, whose arms -- in one used as a value -- give a value of the type
// `expected`, or of the first arm's when nothing is expected.
fn analyzeMatchWith(an: *Analyzer, node: i32, expected: Type): void {
  let subject: Type = checkExpr(an, matchOf(an.ast, node).subject);
  if (FAILED) {
    return;
  }
  if (subject.isUnion()) {
    analyzeUnionMatch(an, node, subject, expected);
    return;
  }

  if (!subject.isEnum() && !subject.isInteger()) {
    analyzerFail(an, node, Problem.CannotMatch, Facts.aboutType(subject));
    return;
  }

  let hasElse: bool = false;
  let arm: i32 = 0;
  while (arm < itemCount(an.ast, node)) {
    let armNode: i32 = itemAt(an.ast, node, arm);

    if (hasElse) {
      analyzerFail(an, armNode, Problem.ArmAfterElse, Facts.none());
      return;
    }

    if (armOf(an.ast, armNode).isElse) {
      hasElse = true;
    }

    for (pattern in 0..itemCount(an.ast, armNode)) {
      let patternNode: i32 = itemAt(an.ast, armNode, pattern);
      checkPattern(an, patternNode, subject);
      if (FAILED) {
        return;
      }

      // Checked before this pattern is recorded, so it does not find itself.
      let value: i64 = an.values[patternNode];
      an.isConstant[patternNode] = 0;
      if (matchHandles(an, node, value)) {
        analyzerFail(an, patternNode, Problem.DuplicatePattern, Facts.none());
        return;
      }
      an.isConstant[patternNode] = 1;
    }

    checkArmBody(an, node, armNode, expected);
    if (FAILED) {
      return;
    }

    arm = arm + 1;
  }

  if (hasElse) {
    return;
  }

  if (subject.isEnum()) {
    let declaration: i32 = enumDeclOf(an, subject.structName);
    let missing: i32 = unhandledMember(an, node, declaration);
    if (missing != NO_NODE) {
      analyzerFail(an, node, Problem.UnhandledMember,
                   Facts.aboutTwo(subject.structName, nodeName(an.ast, missing)));
    }
    return;
  }

  analyzerFail(an, node, Problem.MatchNeedsElse, Facts.aboutType(subject));
}
