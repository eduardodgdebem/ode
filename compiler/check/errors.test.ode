// ---------------------------------------------------------------------------
// Errors as values -- error enums, unions, try, ??, catch and is: what
// checking accepts, the types it settles on, and what it rejects.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope, Checked } from "../testkit/testkit";
import { TypeKind, Type } from "../types/types";

fn errors(): *Scope {
  return Scope.new().declare(`
    error enum ParseError { Empty, NotANumber }
    error enum IoError { NotFound }
    enum Color { Red }

    fn parse(text: *i8): i64 | ParseError {
      return 0;
    }

    fn read(path: *i8): *i8 | IoError {
      return path;
    }

    fn touch(path: *i8): void | IoError {
      return;
    }
  `);
}

fn i64Type(): Type {
  return Type.make(TypeKind.I64, 0);
}

test "a union takes a value, an error, or a narrower union" {
  let found: *List<Diagnostic> = errors().returning("i64 | ParseError | IoError").run(`
    let a: i64 | ParseError = 5;
    let b: i64 | ParseError = ParseError.Empty;
    let c: i64 | ParseError | IoError = a;
    if (a is ParseError) {
      return IoError.NotFound;
    }
    return c;
  `);
  assertEq(found.count, 0);
}

test "a union is not its value" {
  let found: *List<Diagnostic> = errors().run("let n: i64 = parse(\"1\");");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).facts.expected.toText(), "i64");
  assertEq(found.at(0).facts.got.toText(), "i64 | ParseError");
}

test "a union does not take another error, or a wider union" {
  let found: *List<Diagnostic> = errors().run(`
    let a: i64 | ParseError = IoError.NotFound;
    let b: i64 | IoError | ParseError = 1;
    let c: i64 | ParseError = b;
    let d: i64 | ParseError = Color.Red;
  `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(1).line, 3);
  assertEq(found.at(2).line, 4);
}

test "try gives the value, and needs the function to return the errors" {
  let scope: *Scope = errors().returning("i64 | ParseError");
  assertEq(scope.run("let n: i64 = try parse(\"1\");\nreturn n;").count, 0);
  assert(errors().returning("i64 | ParseError").check("try parse(\"1\")")
             .type.equals(i64Type()));

  let found: *List<Diagnostic> = scope.run("let p: *i8 = try read(\"x\");");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ErrorNotReturned);
  assertEq(found.at(0).facts.name, "IoError");
  assertEq(found.at(0).column, 14);

  found = errors().returning("i64").run("let n: i64 = try parse(\"1\");");
  assertEq(found.at(0).problem, Problem.ErrorNotReturned);
}

test "try needs something that may fail" {
  let checked: Checked = errors().returning("i64 | ParseError").check("try 5");
  assertEq(checked.problem(), Problem.TryNotFallible);
  assertEq(checked.problems.at(0).facts.got.toText(), "i32");
}

test "try on a void union is a statement" {
  let found: *List<Diagnostic> = errors().returning("void | IoError").run(`
    try touch("x");
    return;
  `);
  assertEq(found.count, 0);
}

test "?? gives the value, with a fallback of its type" {
  let scope: *Scope = errors().local("p", "*i8");
  assert(scope.check("parse(\"1\") ?? 0").type.equals(i64Type()));
  assert(scope.check("read(\"x\") ?? \"none\"").type.equals(Type.make(TypeKind.I8, 1)));
  assert(scope.check("p ?? \"none\"").type.equals(Type.make(TypeKind.I8, 1)));

  let wrong: Checked = scope.check("parse(\"1\") ?? true");
  assertEq(wrong.problem(), Problem.CoalesceTypes);
  assertEq(wrong.problems.at(0).column, 15);

  assertEq(scope.check("5 ?? 0").problem(), Problem.CoalesceNotFallible);
}

test "catch binds the error, and its block must leave" {
  let ok: *List<Diagnostic> = errors().returning("i32").run(`
    let n: i64 = parse("1") catch (e) {
      let which: ParseError = e;
      return 1;
    };
    while (true) {
      let m: i64 = parse("2") catch (e) {
        break;
      };
    }
  `);
  assertEq(ok.count, 0);

  let found: *List<Diagnostic> = errors().run(`
    let n: i64 = parse("1") catch (e) {
      let x: i32 = 1;
    };
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.CatchFallsThrough);
  assertEq(found.at(0).column, 25);
}

test "catch takes one kind of error, of something that may fail" {
  let found: *List<Diagnostic> = errors().returning("i32").run(`
    let wide: i64 | ParseError | IoError = 1;
    let n: i64 = wide catch (e) {
      return 1;
    };
    let m: i32 = 5 catch (e) {
      return 1;
    };
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.CatchSeveralErrors);
  assertEq(found.at(1).problem, Problem.CatchNotFallible);
}

test "is narrows a variable in each branch" {
  let found: *List<Diagnostic> = errors().returning("i32").run(`
    let result: i64 | ParseError = parse("1");
    if (result is ParseError) {
      let error: ParseError = result;
    } else {
      let value: i64 = result;
    }
    return 0;
  `);
  assertEq(found.count, 0);
}

test "is narrows what follows when its branch always leaves" {
  let found: *List<Diagnostic> = errors().returning("i32").run(`
    let result: i64 | ParseError | IoError = parse("1");
    if (result is ParseError) {
      return 1;
    }
    if (result is IoError) {
      return 2;
    }
    let value: i64 = result;
    return 0;
  `);
  assertEq(found.count, 0);

  // A branch that may fall through narrows nothing after it.
  found = errors().returning("i32").run(`
    let result: i64 | ParseError = parse("1");
    if (result is ParseError) {
      let x: i32 = 1;
    }
    let value: i64 = result;
    return 0;
  `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 5);
}

test "a narrowed variable is still assigned as declared" {
  let found: *List<Diagnostic> = errors().returning("i32").run(`
    let result: i64 | ParseError = parse("1");
    if (result is ParseError) {
      result = 5;
      result = ParseError.Empty;
    }
    return 0;
  `);
  assertEq(found.count, 0);
}

test "is asks about an error a union can hold" {
  let scope: *Scope = errors().local("n", "i64")
      .local("result", "i64 | ParseError");
  assert(scope.check("result is ParseError").type.equals(Type.make(TypeKind.Bool, 0)));
  assertEq(scope.check("result is IoError").problem(), Problem.IsNeverTrue);
  assertEq(scope.check("result is Color").problem(), Problem.IsNotAnError);
  assertEq(scope.check("n is ParseError").problem(), Problem.IsNotFallible);
}

test "an error enum's members have no values of their own" {
  let found: *List<Diagnostic> = Scope.new()
      .declare("error enum E { A, B = 5 }").problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.ErrorValueWritten);
  assertEq(found.at(0).facts.name, "B");
}

test "a union is a value, then error enums" {
  let found: *List<Diagnostic> = Scope.new().declare(`
    error enum E { A }
    enum Color { Red }
    fn f(): i64 | Color { return 0; }
    fn g(): E | i64 { return 0; }
    fn h(): i64 | i32 { return 0; }
  `).problems();
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.UnionMemberNotError);
  assertEq(found.at(0).facts.got.toText(), "Color");
  assertEq(found.at(1).problem, Problem.UnionValueIsError);
  assertEq(found.at(2).problem, Problem.UnionMemberNotError);
}

test "a bare return succeeds in a function returning void or an error" {
  assertEq(errors().returning("void | IoError").run("return;").count, 0);
  assertEq(errors().returning("i64 | IoError").run("return;").at(0).problem,
           Problem.ReturnWithoutValue);
}

test "an error cannot be dropped by calling for the effect alone" {
  let found: *List<Diagnostic> = errors().returning("void | IoError").run(`
    touch("a");
    parse("1");
    try touch("b");
    touch("c") catch (e) {};
    let n: i64 = parse("2") ?? 0;
  `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.UnhandledError);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).facts.got.toText(), "void | IoError");
  assertEq(found.at(1).problem, Problem.UnhandledError);
  assertEq(found.at(1).line, 2);
}

test "a catch of a void union may fall through, having no value to give" {
  assertEq(errors().run("touch(\"x\") catch (e) {};").count, 0);
  let found: *List<Diagnostic> = errors().run("let n: i64 = parse(\"1\") catch (e) {};");
  assertEq(found.at(0).problem, Problem.CatchFallsThrough);
}
