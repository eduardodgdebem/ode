// ---------------------------------------------------------------------------
// Errors as values.
//
// An `error enum` lists errors; a function that can fail returns a union of
// its value and the errors it may give instead:
//
//   error enum ParseError { Empty, NotANumber, TooLarge }
//
//   fn parseInt(text: *i8): i64 | ParseError {
//     if (text[0] == '\0') {
//       return ParseError.Empty;
//     }
//     ...
//     return value;
//   }
//
// and a caller says, where it calls, what happens to an error:
//
//   let n: i64 = try parseInt(s);           // passes it on to its own caller
//   let n: i64 = parseInt(s) ?? 0;           // a fallback in its place
//   let n: i64 = parseInt(s) catch (e) {     // handles it, and leaves
//     return 1;
//   };
//   if (result is ParseError) { ... }        // asks, narrowing `result`
//
// A union is not its value, so an error cannot be ignored: using one as its
// value is a type mismatch. Underneath, a union is its value and a code --
// 0 for the value, an error's own number otherwise -- every error in the
// program having a number of its own, so that a union of several error
// enums can tell them apart.
// ---------------------------------------------------------------------------

import { strcmp, strlen } from "std/c";
import { List } from "std/list";
import { Builder, equals, startsWith } from "std/text";
import {
  Analyzer, analyzerFail, analyzerFailAtValue, analyzerParseType,
} from "./analyzer";
import { enumDeclOf } from "./enums";
import { checkExpr, checkExprAs } from "./expressions";
import { analyzeStatement } from "./statements";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED } from "../diagnostics/report";
import {
  NO_NODE, NodeKind, Ast, Syntax, Binary, Unary, Try, Is, Catch, syntaxChildren, isOf,
} from "../syntax/ast";
import { SymbolKind, Symbol } from "../types/symbols";
import { TypeKind, Type } from "../types/types";

// What a union type is made of: the types of the values it may hold, and
// the errors. Its text, canonical -- the values by name, then the errors by
// name -- is the Type's name, by which this is found.
struct UnionInfo {
  text: *i8,
  values: *List<Type>,
  errors: *List<*i8>,
}

let UNIONS: *List<UnionInfo> = null;

// The union of `value` and `errors`, made the first time it is asked for.
// `value` may itself be a union, whose members join this one's.
fn unionOf(value: Type, errors: *List<*i8>): Type {
  let values: *List<Type> = List<Type>.new();
  values.push(value);
  return unionOfAll(values, errors);
}

// The union of any number of values and errors. A union among the values
// adds its own members, so `Shape | Line`, with `type Shape = Circle | Rect`,
// is `Circle | Line | Rect`. One value and no error is that value, no union.
export fn unionOfAll(values: *List<Type>, errors: *List<*i8>): Type {
  let types: *List<Type> = List<Type>.new();
  let names: *List<*i8> = errors.copy();
  for (index in 0..values.count) {
    let value: Type = values.at(index);
    if (value.isUnion()) {
      let inner: UnionInfo = unionInfo(value);
      for (member in 0..inner.values.count) {
        types.push(inner.values.at(member));
      }
      for (member in 0..inner.errors.count) {
        names.push(inner.errors.at(member));
      }
    } else {
      types.push(value);
    }
  }

  // Each member once, by name, so that `A | B`, `B | A` and `A | B | A` are
  // one union.
  types.sort((a, b) => strcmp(memberText(a), memberText(b)));
  let sortedValues: *List<Type> = List<Type>.new();
  for (index in 0..types.count) {
    if (index == 0 || !types.at(index).equals(types.at(index - 1))) {
      sortedValues.push(types.at(index));
    }
  }
  names.sort(strcmp);
  let sorted: *List<*i8> = List<*i8>.new();
  for (index in 0..names.count) {
    if (index == 0 || !equals(names.at(index), names.at(index - 1))) {
      sorted.push(names.at(index));
    }
  }

  if (sortedValues.count == 1 && sorted.count == 0) {
    return sortedValues.at(0);
  }
  // What is left once every value has been ruled out by `is`: an error, or
  // one of several.
  if (sortedValues.count == 0 && sorted.count == 1) {
    return Type.ofEnum(sorted.at(0), 0);
  }
  if (sortedValues.count == 0 && sorted.count == 0) {
    return Type.make(TypeKind.None, 0);
  }

  let text: *Builder = Builder.new();
  for (index in 0..sortedValues.count) {
    if (index > 0) {
      text.add(" | ");
    }
    text.add(memberText(sortedValues.at(index)));
  }
  for (index in 0..sorted.count) {
    if (index > 0 || sortedValues.count > 0) {
      text.add(" | ");
    }
    text.add(sorted.at(index));
  }

  if (UNIONS == null) {
    UNIONS = List<UnionInfo>.new();
  }
  for (index in 0..UNIONS.count) {
    if (equals(UNIONS.at(index).text, text.data)) {
      return unionType(UNIONS.at(index).text);
    }
  }
  UNIONS.push(UnionInfo { text: text.data, values: sortedValues, errors: sorted });
  return unionType(text.data);
}

// A member as a union writes it. A function's own result runs to the end of
// its type, so a function that is one of a union's values is written in
// parentheses.
fn memberText(type: Type): *i8 {
  if (!type.isFunction()) {
    return type.toText();
  }
  let text: *Builder = Builder.new();
  text.push('(');
  text.add(type.toText());
  text.push(')');
  return text.take();
}

export fn unionType(text: *i8): Type {
  return Type { kind: TypeKind.Union, pointerDepth: 0, structName: text };
}

export fn unionInfo(type: Type): UnionInfo {
  for (index in 0..UNIONS.count) {
    if (equals(UNIONS.at(index).text, type.structName)) {
      return UNIONS.at(index);
    }
  }
  assert(false, "a union type no union was made for");
  return UNIONS.at(0);
}

// The types of the values a union may hold.
export fn valuesOf(type: Type): *List<Type> {
  return unionInfo(type).values;
}

// Whether a union may hold values of more than one type, which changes how
// it is laid out; see codegen/errors.ode.
export fn holdsSeveral(type: Type): bool {
  return type.isUnion() && valuesOf(type).count > 1;
}

// What a union holds when it holds no error: its one value's type, or the
// union of its values when it may hold several -- or void for one that holds
// only errors, which is all `is` leaves once every value is ruled out.
export fn valueOf(type: Type): Type {
  let info: UnionInfo = unionInfo(type);
  if (info.values.count == 0) {
    return Type.make(TypeKind.Void, 0);
  }
  if (info.values.count == 1) {
    return info.values.at(0);
  }
  return unionOfAll(info.values, List<*i8>.new());
}

// The code a union that may hold several types gives a value of `type`:
// below zero, so that it is told apart from every error, which are above.
// Each type has one across the program, as each error does, so a union
// widened into another keeps its code.
let VALUE_TAGS: *List<*i8> = null;

export fn valueTag(type: Type): i64 {
  if (VALUE_TAGS == null) {
    VALUE_TAGS = List<*i8>.new();
  }
  let text: *i8 = memberText(type);
  for (index in 0..VALUE_TAGS.count) {
    if (equals(VALUE_TAGS.at(index), text)) {
      return -(index + 1);
    }
  }
  VALUE_TAGS.push(text);
  return -VALUE_TAGS.count;
}

export fn holdsError(type: Type, errorEnum: *i8): bool {
  let errors: *List<*i8> = unionInfo(type).errors;
  for (index in 0..errors.count) {
    if (equals(errors.at(index), errorEnum)) {
      return true;
    }
  }
  return false;
}

fn holdsValue(type: Type, value: Type): bool {
  let values: *List<Type> = valuesOf(type);
  for (index in 0..values.count) {
    if (values.at(index).equals(value)) {
      return true;
    }
  }
  return false;
}

// Which of a union's values `value` becomes when it is given where the union
// is expected: the one of its type, or else the one value that accepts it --
// `null` for the one pointer. None when there is no such value, or more than
// one.
export fn memberFor(union: Type, value: Type): Type {
  let values: *List<Type> = valuesOf(union);
  for (index in 0..values.count) {
    if (values.at(index).equals(value)) {
      return values.at(index);
    }
  }
  let found: Type = Type.make(TypeKind.None, 0);
  let count: i32 = 0;
  for (index in 0..values.count) {
    if (values.at(index).accepts(value)) {
      found = values.at(index);
      count = count + 1;
    }
  }
  if (count != 1) {
    return Type.make(TypeKind.None, 0);
  }
  return found;
}

// Whether a union can be given `value` where it is expected: one of its
// values, one of its errors, or a union of some of its members.
export fn unionAccepts(union: Type, value: Type): bool {
  if (value.equals(union)) {
    return true;
  }
  if (value.isEnum() && holdsError(union, value.structName)) {
    return true;
  }
  if (value.isUnion()) {
    let other: UnionInfo = unionInfo(value);
    for (index in 0..other.values.count) {
      if (!holdsValue(union, other.values.at(index))) {
        return false;
      }
    }
    for (index in 0..other.errors.count) {
      if (!holdsError(union, other.errors.at(index))) {
        return false;
      }
    }
    return true;
  }
  return memberFor(union, value).kind != TypeKind.None;
}

// The union `union` is once `removed` -- one of its values' types, or one of
// its error enums -- has been ruled out: what is left, which is a value
// alone when only one is.
fn without(union: Type, removed: Type): Type {
  let info: UnionInfo = unionInfo(union);
  let values: *List<Type> = List<Type>.new();
  for (index in 0..info.values.count) {
    if (!info.values.at(index).equals(removed)) {
      values.push(info.values.at(index));
    }
  }
  let errors: *List<*i8> = List<*i8>.new();
  for (index in 0..info.errors.count) {
    if (!removed.isEnum() || !equals(info.errors.at(index), removed.structName)) {
      errors.push(info.errors.at(index));
    }
  }
  return unionOfAll(values, errors);
}

// ---------------------------------------------------------------------------
// Error enums. Every error's number is unique in the program, counting from
// 1, so a code says which error of which enum it is.
// ---------------------------------------------------------------------------

fn isErrorEnum(an: *Analyzer, name: *i8): bool {
  return an.errorEnums.has(name);
}

// The first and last numbers of an error enum's errors, which are given to
// them in order.
export fn errorCodeRange(an: *Analyzer, name: *i8, first: *i64, last: *i64): void {
  let declaration: i32 = enumDeclOf(an, name);
  *first = an.values[an.ast.nodes[declaration].items[0]];
  *last = an.values[an.ast.nodes[declaration].items[an.ast.nodes[declaration].itemCount - 1]];
}

// ---------------------------------------------------------------------------
// Checking.
// ---------------------------------------------------------------------------

// A union type as written: `i64 | ParseError | IoError`, `Circle | Rect`.
// Its error enums are its errors; anything else, its values -- an alias of a
// union adding the union's own members.
export fn parseUnionType(an: *Analyzer, node: i32): Type {
  // A type is read again wherever it is used -- a signature when it is
  // hoisted, and again when its body is checked -- but a wrong one is
  // reported once.
  if (an.isConstant[node] == 2) {
    FAILED = true;
    return Type.make(TypeKind.None, 0);
  }

  let values: *List<Type> = List<Type>.new();
  let errors: *List<*i8> = List<*i8>.new();
  let hasVoid: bool = false;
  for (index in 0..an.ast.nodes[node].itemCount) {
    let member: Type = analyzerParseType(an, an.ast.nodes[node].items[index]);
    if (FAILED) {
      an.isConstant[node] = 2;
      return Type.make(TypeKind.None, 0);
    }
    if (member.isEnum() && member.pointerDepth == 0 &&
        isErrorEnum(an, member.structName)) {
      errors.push(member.structName);
    } else {
      values.push(member);
      hasVoid = hasVoid || member.isVoid();
    }
  }

  let union: Type = unionOfAll(values, errors);
  if (!union.isUnion()) {
    // Every member was the same value, or one error alone.
    if (union.isEnum() && union.pointerDepth == 0 &&
        isErrorEnum(an, union.structName)) {
      analyzerFail(an, node, Problem.UnionWithoutValue, Facts.aboutType(union));
      an.isConstant[node] = 2;
      return Type.make(TypeKind.None, 0);
    }
    return union;
  }
  if (valuesOf(union).count == 0) {
    analyzerFail(an, node, Problem.UnionWithoutValue,
                 Facts.aboutType(Type.ofEnum(unionInfo(union).errors.at(0), 0)));
    an.isConstant[node] = 2;
    return Type.make(TypeKind.None, 0);
  }
  if (hasVoid && valuesOf(union).count > 1) {
    analyzerFail(an, node, Problem.UnionVoidMember, Facts.none());
    an.isConstant[node] = 2;
    return Type.make(TypeKind.None, 0);
  }
  return union;
}

// `try value`.
export fn checkTry(an: *Analyzer, node: i32, attempt: Try): Type {
  let type: Type = checkExpr(an, attempt.value);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }
  if (!type.isUnion()) {
    analyzerFail(an, node, Problem.TryNotFallible, Facts.aboutType(type));
    return Type.make(TypeKind.None, 0);
  }
  if (!an.inFunction) {
    analyzerFail(an, node, Problem.TryOutsideFunction, Facts.none());
    return Type.make(TypeKind.None, 0);
  }

  // Every error it may pass on has to be one the function can return.
  let errors: *List<*i8> = unionInfo(type).errors;
  for (index in 0..errors.count) {
    if (!an.currentReturnType.isUnion() ||
        !holdsError(an.currentReturnType, errors.at(index))) {
      analyzerFail(an, node, Problem.ErrorNotReturned,
                   Facts.about(errors.at(index)).withType(an.currentReturnType));
      return Type.make(TypeKind.None, 0);
    }
  }
  return valueOf(type);
}

// `value ?? fallback`: a union's value, or a pointer that is not null.
export fn checkCoalesce(an: *Analyzer, node: i32, coalesce: Binary): Type {
  let left: Type = checkExpr(an, coalesce.left);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }

  let result: Type = left;
  if (left.isUnion()) {
    result = valueOf(left);
  } else if (!left.isPointer()) {
    analyzerFail(an, node, Problem.CoalesceNotFallible, Facts.aboutType(left));
    return Type.make(TypeKind.None, 0);
  }

  let fallback: Type = checkExprAs(an, coalesce.right, result);
  if (!FAILED && !result.accepts(fallback)) {
    analyzerFailAtValue(an, coalesce.right, Problem.CoalesceTypes,
                        Facts.aboutTypes(result, fallback));
  }
  return result;
}

// `value catch (e) { ... }`.
export fn checkCatch(an: *Analyzer, node: i32, caught: Catch): Type {
  let type: Type = checkExpr(an, caught.value);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }
  if (!type.isUnion()) {
    analyzerFail(an, node, Problem.CatchNotFallible, Facts.aboutType(type));
    return Type.make(TypeKind.None, 0);
  }
  let errors: *List<*i8> = unionInfo(type).errors;
  if (errors.count != 1) {
    analyzerFail(an, node, Problem.CatchSeveralErrors, Facts.aboutType(type));
    return Type.make(TypeKind.None, 0);
  }

  let block: i32 = caught.block;
  an.symbols.enterScope();
  an.symbols.declare(caught.name, SymbolKind.Var,
                     Type.ofEnum(errors.at(0), 0), null, 0,
                     an.ast.nodes[node].line, an.ast.nodes[node].column);
  analyzeStatement(an, block);
  an.symbols.exitScope();
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }

  // A block that falls through leaves nothing to use as the value -- unless
  // there is none, when falling through just carries on.
  if (!valueOf(type).isVoid() && !alwaysLeaves(an, block)) {
    analyzerFail(an, node, Problem.CatchFallsThrough, Facts.none());
    return Type.make(TypeKind.None, 0);
  }
  return valueOf(type);
}

// `value is SomeError`, `shape is Circle`: whether a union holds that member.
export fn checkIs(an: *Analyzer, node: i32, question: Is): Type {
  let type: Type = checkExpr(an, question.value);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }
  let asked: Type = analyzerParseType(an, question.type);
  if (FAILED) {
    return Type.make(TypeKind.None, 0);
  }
  if (!type.isUnion()) {
    analyzerFail(an, node, Problem.IsNotFallible, Facts.aboutType(type));
    return Type.make(TypeKind.None, 0);
  }
  if (!holdsMember(type, asked)) {
    analyzerFail(an, node, Problem.IsNeverTrue,
                 Facts.about(asked.toText()).withTypes(type, asked));
    return Type.make(TypeKind.None, 0);
  }
  return Type.make(TypeKind.Bool, 0);
}

// Whether `member` is one of a union's error enums or one of its values.
export fn holdsMember(union: Type, member: Type): bool {
  if (member.isEnum() && member.pointerDepth == 0 &&
      holdsError(union, member.structName)) {
    return true;
  }
  return holdsValue(union, member);
}

// Whether a statement can never be followed: it returns, breaks or continues
// on every path, or loops forever.
export fn alwaysLeaves(an: *Analyzer, node: i32): bool {
  return leaves(an, node, true);
}

// Whether a statement leaves the function on every path: it returns, or
// loops forever. A break or continue leaves only its loop, after which the
// function goes on.
export fn alwaysReturns(an: *Analyzer, node: i32): bool {
  return leaves(an, node, false);
}

// alwaysLeaves, with `loopExits` saying whether leaving by break or continue
// counts.
fn leaves(an: *Analyzer, node: i32, loopExits: bool): bool {
  let kind: NodeKind = an.ast.nodes[node].kind;
  if (kind == NodeKind.Return) {
    return true;
  }
  if (kind == NodeKind.Break || kind == NodeKind.Continue) {
    return loopExits;
  }
  if (kind == NodeKind.Block) {
    // A block leaves the way the first of its statements that cannot be
    // followed does; nothing after that one is reached.
    for (index in 0..an.ast.nodes[node].itemCount) {
      let item: i32 = an.ast.nodes[node].items[index];
      if (leaves(an, item, loopExits)) {
        return true;
      }
      if (alwaysLeaves(an, item)) {
        return false;
      }
    }
    return false;
  }
  if (kind == NodeKind.If) {
    return an.ast.nodes[node].c != NO_NODE &&
           leaves(an, an.ast.nodes[node].b, loopExits) &&
           leaves(an, an.ast.nodes[node].c, loopExits);
  }
  // A match that checks covers every value, so it leaves when every arm does.
  if (kind == NodeKind.Match) {
    for (index in 0..an.ast.nodes[node].itemCount) {
      let arm: i32 = an.ast.nodes[node].items[index];
      if (!leaves(an, an.ast.nodes[arm].a, loopExits)) {
        return false;
      }
    }
    return an.ast.nodes[node].itemCount > 0;
  }
  // `while (true)` is never followed, unless a break gets out of it.
  if (kind == NodeKind.While) {
    let condition: i32 = an.ast.nodes[node].a;
    return an.ast.nodes[condition].kind == NodeKind.Bool &&
           equals(an.ast.nodes[condition].text, "true") &&
           !breaksOut(an, an.ast.nodes[node].b);
  }
  return false;
}

// Whether `node` holds a break of the loop it is in: one not inside a loop
// of its own. A break may be anywhere a statement may, in a catch block in
// the middle of an expression too.
fn breaksOut(an: *Analyzer, node: i32): bool {
  if (node == NO_NODE) {
    return false;
  }
  let kind: NodeKind = an.ast.nodes[node].kind;
  if (kind == NodeKind.Break) {
    return true;
  }
  if (kind == NodeKind.While || kind == NodeKind.For || kind == NodeKind.Fn ||
      kind == NodeKind.Lambda) {
    return false;
  }
  if (breaksOut(an, an.ast.nodes[node].a) || breaksOut(an, an.ast.nodes[node].b) ||
      breaksOut(an, an.ast.nodes[node].c)) {
    return true;
  }
  for (index in 0..an.ast.nodes[node].itemCount) {
    if (breaksOut(an, an.ast.nodes[node].items[index])) {
      return true;
    }
  }
  let children: *List<i32> = syntaxChildren(an.ast.nodes[node].syntax);
  for (index in 0..children.count) {
    if (breaksOut(an, children.at(index))) {
      return true;
    }
  }
  return false;
}

// What `if (name is SomeError)` -- or `name is Circle` -- tells the branches
// about `name`: in the first, it holds that member; in the second -- or
// after the `if`, when the first always leaves -- it does not. `name` may be
// a variable or a field of one, `holder.shape`, and is read there with the
// narrower type; its storage is untouched.
export fn narrowedLocal(an: *Analyzer, condition: i32): i32 {
  let flipped: bool = false;
  let question: i32 = questionIn(an, condition, &flipped);
  if (question == NO_NODE) {
    return NO_NODE;
  }
  let value: i32 = isOf(an.ast, question).value;
  if (pathOf(an, value) == null || an.types[value].kind == TypeKind.None ||
      !an.types[value].isUnion()) {
    return NO_NODE;
  }
  return value;
}

// The `is` a condition asks, under any number of `!` -- each of which swaps
// what the two branches learn, recorded in `flipped` -- or NO_NODE.
fn questionIn(an: *Analyzer, condition: i32, flipped: *bool): i32 {
  let syntax: Syntax = an.ast.nodes[condition].syntax;
  if (syntax is Is) {
    return condition;
  }
  if (syntax is Unary) {
    if (syntax.op == .Not) {
      *flipped = !*flipped;
      return questionIn(an, syntax.operand, flipped);
    }
  }
  return NO_NODE;
}

// The name narrowing knows `node` by, when it can be narrowed: a variable's
// name, or the path to a field of one -- `holder.shape`, `self.kind.left`,
// through pointers alike. Null for anything else.
export fn pathOf(an: *Analyzer, node: i32): *i8 {
  let kind: NodeKind = an.ast.nodes[node].kind;
  if (kind == NodeKind.Ident) {
    let symbol: i32 = an.symbols.find(an.ast.nodes[node].text);
    if (symbol < 0 || an.symbols.items[symbol].kind != SymbolKind.Var) {
      return null;
    }
    return an.ast.nodes[node].text;
  }
  if (kind != NodeKind.FieldAccess || an.isConstant[node] != 0 ||
      an.ast.nodes[node].a == NO_NODE) {
    return null;
  }
  let object: *i8 = pathOf(an, an.ast.nodes[node].a);
  if (object == null) {
    return null;
  }
  let path: *Builder = Builder.new();
  path.add(object);
  path.push('.');
  path.add(an.ast.nodes[node].text);
  return path.take();
}

// The type `name` was declared with, before any narrowing: the outermost
// symbol of that name that is not a narrowing of it.
export fn declaredTypeOf(an: *Analyzer, name: *i8): Type {
  let symbol: i32 = an.symbols.find(name);
  if (symbol < 0) {
    return Type.make(TypeKind.None, 0);
  }
  return an.symbols.items[symbol].declared;
}

// Narrows what `subject` names -- a variable, or a field path -- to `type`,
// innermost: a symbol of its name, shadowing it for the rest of the current
// scope without the rule against redeclaring. A field has no symbol of its
// own until it is first narrowed; its path is the name.
export fn narrow(an: *Analyzer, subject: i32, type: Type): void {
  let name: *i8 = pathOf(an, subject);
  let symbol: i32 = an.symbols.find(name);
  if (symbol >= 0) {
    let narrowed: Symbol = an.symbols.items[symbol];
    narrowed.type = type;
    // `declared` is kept: it is what the storage holds.
    an.symbols.push(narrowed);
    return;
  }
  let declared: Type = an.types[subject];
  if (an.narrowedFrom[subject].kind != TypeKind.None) {
    declared = an.narrowedFrom[subject];
  }
  an.symbols.push(Symbol { name: name, kind: SymbolKind.Var, type: type,
                           params: null as *Type, paramCount: 0, linkName: null,
                           variadic: false, declared: declared });
}

// The type a field read along `path` has been narrowed to, or None.
export fn narrowedPath(an: *Analyzer, path: *i8): Type {
  let symbol: i32 = an.symbols.find(path);
  if (symbol < 0) {
    return Type.make(TypeKind.None, 0);
  }
  return an.symbols.items[symbol].type;
}

// Undoes what `is` and `match` found out about `path`, and every field under
// it, once it has been assigned: from here on, in every scope still open, it
// may hold any member again.
export fn forget(an: *Analyzer, path: *i8): void {
  let length: i64 = strlen(path);
  for (index in 0..an.symbols.count) {
    let name: *i8 = an.symbols.items[index].name;
    let under: bool = equals(name, path) ||
        (startsWith(name, path) && name[length] == '.');
    if (under && an.symbols.items[index].declared.isUnion()) {
      an.symbols.items[index].type = an.symbols.items[index].declared;
    }
  }
}

// The type `name` has where `condition` -- `name is SomeError` -- held, and
// where it did not.
export fn narrowedTypes(an: *Analyzer, condition: i32, held: *Type,
                        notHeld: *Type): void {
  let flipped: bool = false;
  let question: Is = isOf(an.ast, questionIn(an, condition, &flipped));
  let union: Type = an.types[question.value];
  let asked: Type = analyzerParseType(an, question.type);
  *held = asked;
  *notHeld = without(union, asked);
  // `if (!(x is T))`: the first branch is where it is not.
  if (flipped) {
    *held = without(union, asked);
    *notHeld = asked;
  }
}

fn errorsOf(names: *i8, other: *i8): *List<*i8> {
  let list: *List<*i8> = List<*i8>.new();
  list.push(names);
  if (other != null) {
    list.push(other);
  }
  return list;
}

test "a union is the same whatever order its errors are written in" {
  let i64Type: Type = Type.make(TypeKind.I64, 0);
  let one: Type = unionOf(i64Type, errorsOf("ParseError", "IoError"));
  let other: Type = unionOf(i64Type, errorsOf("IoError", "ParseError"));
  assert(one.equals(other));
  assertEq(one.toText(), "i64 | IoError | ParseError");
  assert(unionOf(i64Type, errorsOf("IoError", "IoError"))
             .equals(unionOf(i64Type, errorsOf("IoError", null))));
}

test "a union accepts its value, its errors, and narrower unions" {
  let i64Type: Type = Type.make(TypeKind.I64, 0);
  let wide: Type = unionOf(i64Type, errorsOf("IoError", "ParseError"));
  let narrow: Type = unionOf(i64Type, errorsOf("ParseError", null));
  assert(wide.accepts(i64Type));
  assert(wide.accepts(Type.ofEnum("ParseError", 0)));
  assert(wide.accepts(narrow));
  assert(!narrow.accepts(wide));
  assert(!wide.accepts(Type.make(TypeKind.I32, 0)));
  assert(!wide.accepts(Type.ofEnum("OtherError", 0)));
  assert(!wide.accepts(unionOf(Type.make(TypeKind.I32, 0), errorsOf("IoError", null))));
  assert(!i64Type.accepts(wide));
}

test "ruling an error out leaves the rest, or the value alone" {
  let i64Type: Type = Type.make(TypeKind.I64, 0);
  let wide: Type = unionOf(i64Type, errorsOf("IoError", "ParseError"));
  assertEq(without(wide, Type.ofEnum("IoError", 0)).toText(), "i64 | ParseError");
  assert(without(without(wide, Type.ofEnum("IoError", 0)), Type.ofEnum("ParseError", 0))
             .equals(i64Type));
}

// A block of `statements`, made by hand.
fn blockOf(ast: *Ast, statements: *List<i32>): i32 {
  let block: i32 = ast.add(NodeKind.Block, 1, 1);
  for (index in 0..statements.count) {
    ast.addItem(block, statements.at(index));
  }
  return block;
}

// Two statements of these kinds -- `break; return;` -- with nothing in them.
fn statementsOf(ast: *Ast, first: NodeKind, second: NodeKind): *List<i32> {
  let statements: *List<i32> = List<i32>.new();
  statements.push(ast.add(first, 1, 1));
  statements.push(ast.add(second, 1, 1));
  return statements;
}

// `while (condition) body`, its condition `true` or a variable.
fn loopOf(ast: *Ast, forever: bool, body: i32): i32 {
  let condition: i32 = ast.add(NodeKind.Ident, 1, 1);
  ast.nodes[condition].text = "going";
  if (forever) {
    ast.nodes[condition].kind = NodeKind.Bool;
    ast.nodes[condition].text = "true";
  }
  let loop: i32 = ast.add(NodeKind.While, 1, 1);
  ast.nodes[loop].a = condition;
  ast.nodes[loop].b = body;
  return loop;
}

test "a break or continue leaves its loop, but not the function" {
  let ast: *Ast = Ast.new();
  let breaks: i32 = blockOf(ast, statementsOf(ast, NodeKind.Break, NodeKind.Return));
  let continues: i32 = blockOf(ast, statementsOf(ast, NodeKind.Continue, NodeKind.Return));
  let returns: i32 = blockOf(ast, statementsOf(ast, NodeKind.Return, NodeKind.Break));
  let an: *Analyzer = Analyzer.new(ast);

  // The return after the break or continue is never reached.
  assert(alwaysLeaves(an, breaks));
  assert(!alwaysReturns(an, breaks));
  assert(alwaysLeaves(an, continues));
  assert(!alwaysReturns(an, continues));
  assert(alwaysLeaves(an, returns));
  assert(alwaysReturns(an, returns));
}

test "a loop that never ends leaves, unless a break gets out of it" {
  let ast: *Ast = Ast.new();
  let empty: *List<i32> = List<i32>.new();
  let forever: i32 = loopOf(ast, true, blockOf(ast, empty));
  let whileGoing: i32 = loopOf(ast, false, blockOf(ast, empty));

  let breaks: *List<i32> = List<i32>.new();
  breaks.push(ast.add(NodeKind.Break, 1, 1));
  let brokenOut: i32 = loopOf(ast, true, blockOf(ast, breaks));

  // A break of a loop inside it is that loop's.
  let inner: *List<i32> = List<i32>.new();
  inner.push(loopOf(ast, false, blockOf(ast, breaks)));
  let innerBreak: i32 = loopOf(ast, true, blockOf(ast, inner));

  let an: *Analyzer = Analyzer.new(ast);
  assert(alwaysReturns(an, forever));
  assert(alwaysLeaves(an, forever));
  assert(!alwaysReturns(an, whileGoing));
  assert(!alwaysReturns(an, brokenOut));
  assert(!alwaysLeaves(an, brokenOut));
  assert(alwaysReturns(an, innerBreak));
}

fn valuesList(first: Type, second: Type): *List<Type> {
  let list: *List<Type> = List<Type>.new();
  list.push(first);
  list.push(second);
  return list;
}

test "a union of values is one union whatever their order, nesting or repeats" {
  let circle: Type = Type.ofStruct("Circle", 0);
  let rect: Type = Type.ofStruct("Rect", 0);
  let shape: Type = unionOfAll(valuesList(rect, circle), List<*i8>.new());
  assertEq(shape.toText(), "Circle | Rect");
  assert(holdsSeveral(shape));
  assert(shape.equals(unionOfAll(valuesList(circle, rect), List<*i8>.new())));

  let nested: Type = unionOfAll(valuesList(shape, circle), errorsOf("IoError", null));
  assertEq(nested.toText(), "Circle | Rect | IoError");
  assert(valueOf(nested).equals(shape));
  assert(unionOfAll(valuesList(circle, circle), List<*i8>.new()).equals(circle));
}

test "ruling out a value leaves the rest, a value alone, or the errors" {
  let circle: Type = Type.ofStruct("Circle", 0);
  let rect: Type = Type.ofStruct("Rect", 0);
  let wide: Type = unionOfAll(valuesList(circle, rect), errorsOf("IoError", null));
  assertEq(without(wide, circle).toText(), "Rect | IoError");
  assert(!holdsSeveral(without(wide, circle)));
  assertEq(without(without(wide, circle), rect).toText(), "IoError");
  assert(without(without(wide, circle), Type.ofEnum("IoError", 0)).equals(rect));
}

test "a value goes to the one member it is, or the one that takes it" {
  let text: Type = Type.make(TypeKind.I8, 1);
  let count: Type = Type.make(TypeKind.I64, 0);
  let either: Type = unionOfAll(valuesList(count, text), List<*i8>.new());
  assert(memberFor(either, count).equals(count));
  assert(memberFor(either, Type.make(TypeKind.Null, 0)).equals(text));
  assertEq(memberFor(either, Type.make(TypeKind.I32, 0)).kind, TypeKind.None);

  // `null` fits both pointers, so it is neither.
  let pointers: Type = unionOfAll(valuesList(text, Type.make(TypeKind.I64, 1)),
                                  List<*i8>.new());
  assertEq(memberFor(pointers, Type.make(TypeKind.Null, 0)).kind, TypeKind.None);
  assert(!pointers.accepts(Type.make(TypeKind.Null, 0)));
}

test "every value type has a code of its own, below every error's" {
  let first: i64 = valueTag(Type.ofStruct("Circle", 0));
  let second: i64 = valueTag(Type.ofStruct("Rect", 0));
  assert(first < 0 && second < 0);
  assert(first != second);
  assertEq(valueTag(Type.ofStruct("Circle", 0)), first);
}
