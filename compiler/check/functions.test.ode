// ---------------------------------------------------------------------------
// Calls and function values: what checking rejects.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { Scope } from "../testkit/testkit";

test "call a variable" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let value: i32 = 1;
        printf("%d\n", value());

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAFunction);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 16);
  assertEq(found.at(0).facts.name, "value");
}

test "call function value wrong arguments" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn square(x: i32): i32 {
          return x * x;
        }
      `)
      .returning("i32")
      .run(`
        let f: (i32) => i32 = square;
        return f(true) + f(1, 2);
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.WrongArgumentType);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 10);
  assertEq(found.at(0).facts.name, "f");
}

test "call non function value" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        let values: *i32 = null;
        return values[0](1);
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.CannotCall);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 17);
}

test "call struct field not function" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Counter {
          hits: i32,
        }
      `)
      .returning("i32")
      .run(`
        let c: Counter = Counter { hits: 0 };
        return c.hits(1);
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAFunction);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 10);
  assertEq(found.at(0).facts.name, "hits");
}

test "method wrong arguments" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        struct Point {
          x: i32,
          y: i32,

          fn new(x: i32, y: i32): Point {
            return Point { x: x, y: y };
          }

          fn sum(self: Point): i32 {
            return self.x + self.y;
          }

          fn shift(self: *Point, by: i32): void {
            self.x = self.x + by;
          }
        }
      `)
      .returning("i32")
      .run(`
        let p: Point = Point.new(1, 2);
        p.shift();
        p.shift(true);
        Point.shift(p, 1);
        return 0;
      `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.WrongArgumentCount);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "Point.shift");
  assertEq(found.at(1).problem, Problem.WrongArgumentType);
  assertEq(found.at(1).line, 3);
  assertEq(found.at(1).column, 9);
  assertEq(found.at(1).facts.name, "Point.shift");
  assertEq(found.at(2).problem, Problem.WrongArgumentType);
  assertEq(found.at(2).line, 4);
  assertEq(found.at(2).column, 13);
  assertEq(found.at(2).facts.name, "Point.shift");
}

test "print is gone" {
  let found: *List<Diagnostic> = Scope.new()
      .returning("i32")
      .run(`
        print(1);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UndefinedFunction);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "print");
}

test "std list wrong item" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        import { List } from "std/list";
      `)
      .returning("i32")
      .run(`
        let numbers: *List<i32> = List<i32>.new();
        numbers.push("one");
        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.WrongArgumentType);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 14);
  assertEq(found.at(0).facts.name, "List.push");
}

test "undefined function" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        printf("%d\n", missing());

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UndefinedFunction);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 16);
  assertEq(found.at(0).facts.name, "missing");
}

test "variadic as value" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        let say: (*i8) => i32 = printf;

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VariadicAsValue);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 25);
  assertEq(found.at(0).facts.name, "printf");
}

test "variadic struct argument" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;

        struct Point {
          x: i32,
        }
      `)
      .returning("i32")
      .run(`
        let point: Point = Point { x: 1 };
        printf("%d\n", point);

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VariadicArgument);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "printf");
}

test "variadic too few arguments" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        printf();

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.TooFewArguments);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "printf");
}

test "variadic void argument" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn nothing(): void {
          return;
        }

        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        printf("%d\n", nothing());

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.VariadicArgument);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 1);
  assertEq(found.at(0).facts.name, "printf");
}

test "wrong argument count" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn sum(a: i32, b: i32): i32 {
          return a + b;
        }

        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        printf("%d\n", sum(1));

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.WrongArgumentCount);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 16);
  assertEq(found.at(0).facts.name, "sum");
}

test "wrong argument type" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn twice(value: i32): i32 {
          return value * 2;
        }

        extern fn printf(format: *i8, ...): i32;
      `)
      .returning("i32")
      .run(`
        printf("%d\n", twice(true));

        return 0;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.WrongArgumentType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 22);
  assertEq(found.at(0).facts.name, "twice");
}

let FALLIBLE: *i8 = `
  error enum Bad { Oops }

  fn half(n: i32): i32 | Bad {
    if (n % 2 == 0) {
      return n / 2;
    }
    return Bad.Oops;
  }

  fn square(x: i32): i32 {
    return x * x;
  }
`;

test "a function that can fail has a function type that can" {
  let scope: *Scope = Scope.new().declare(FALLIBLE)
      .local("h", "(i32) => i32 | Bad")
      .local("maybe", "((i32) => i32) | Bad");
  assertEq(scope.check("half").type.toText(), "(i32) => i32 | Bad");
  assertEq(scope.check("h(4)").type.toText(), "i32 | Bad");
  assertEq(scope.check("maybe").type.toText(), "((i32) => i32) | Bad");
  assert(scope.check("h == half").clean());
}

test "a function that can fail is not one that cannot, nor the other way" {
  let found: *List<Diagnostic> = Scope.new().declare(FALLIBLE)
      .run(`
        let sure: (i32) => i32 = half;
        let unsure: (i32) => i32 | Bad = square;
      `);
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).facts.expected.toText(), "(i32) => i32");
  assertEq(found.at(0).facts.got.toText(), "(i32) => i32 | Bad");
  assertEq(found.at(1).problem, Problem.DeclarationMismatch);
  assertEq(found.at(1).line, 2);
  assertEq(found.at(1).facts.got.toText(), "(i32) => i32");
}

test "an error from a function value is handled like any other" {
  let scope: *Scope = Scope.new().declare(FALLIBLE)
      .local("h", "(i32) => i32 | Bad");
  assert(scope.returning("i32 | Bad").run("return try h(3);").count == 0);
  assert(Scope.new().declare(FALLIBLE).local("h", "(i32) => i32 | Bad")
      .returning("i32").run("return h(3) ?? 0;").count == 0);

  let dropped: *List<Diagnostic> = Scope.new().declare(FALLIBLE)
      .local("h", "(i32) => i32 | Bad")
      .run("h(3);");
  assertEq(dropped.count, 1);
  assertEq(dropped.at(0).problem, Problem.UnhandledError);

  let unpassed: *List<Diagnostic> = Scope.new().declare(FALLIBLE)
      .local("h", "(i32) => i32 | Bad")
      .returning("i32")
      .run("return try h(3);");
  assertEq(unpassed.count, 1);
  assertEq(unpassed.at(0).problem, Problem.ErrorNotReturned);
}

test "a parameter of a function type may be fallible too" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        error enum Bad { Oops }

        fn orZero(value: i32 | Bad): i32 {
          return value ?? 0;
        }

        fn wrong(value: i32): i32 {
          return value;
        }
      `)
      .run(`
        let f: (i32 | Bad) => i32 = orZero;
        let g: (i32 | Bad) => i32 = wrong;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.DeclarationMismatch);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).facts.got.toText(), "(i32) => i32");
}
