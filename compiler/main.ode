// ---------------------------------------------------------------------------
// `ode`: the compiler's command line.
//
//   ode file.ode     compiles a program: driver/compile.ode
//   ode test ...     runs a program's tests: driver/test.ode
//   ode build ...    builds and tests the compiler itself: tool/build.ode
// ---------------------------------------------------------------------------

import { equals } from "std/text";
import { compileMain } from "./driver/compile";
import { findStdDirectory } from "./driver/library";
import { testMain } from "./driver/test";
import { STD_DIRECTORY } from "./link/modules";
import { buildMain } from "./tool/build";

fn main(argc: i32, argv: **i8): i32 {
  STD_DIRECTORY = findStdDirectory(argv[0]);

  if (argc >= 2 && equals(argv[1], "build")) {
    return buildMain(argc, argv);
  }
  if (argc >= 2 && equals(argv[1], "test")) {
    return testMain(argc, argv);
  }
  return compileMain(argc, argv);
}
