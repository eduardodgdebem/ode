// ---------------------------------------------------------------------------
// Driver.
//
// Reads a file and the files it imports, runs the phases, writes textual LLVM
// IR, and assembles and links it with the C toolchain. The dump flags print
// what a phase produced, for looking at when one misbehaves.
//
// `ode build ...` is a different program sharing the binary: see
// buildtool.ode.
// ---------------------------------------------------------------------------

import { readFile } from "std/fs";
import { Builder, equals } from "std/text";
import { STDOUT, STDERR } from "./support/libc";
import { Problem } from "./support/problems";
import { writeText, writeBuilder } from "./support/text";
import {
  SOURCE_PATH, Diagnostics, DIAGS, hasErrors, printDiagnostics, fail,
} from "./support/diagnostics";
import {
  TextList, StderrMode, runCommand, setEnvironment, joinPath, stemOf,
  removeTree, isDirectory, findSources, makeTempDirectory,
} from "./support/system";
import { TokenList } from "./syntax/token";
import { NodeKind, Ast } from "./syntax/ast";
import { tokenize } from "./syntax/lexer";
import { dumpTokens, dumpNode } from "./syntax/dump";
import { STD_DIRECTORY } from "./semantics/modules";
import { Analyzer, analyze } from "./semantics/analyzer";
import { TEST_MODE, RUNNER_MODULE, runnerSource } from "./semantics/testing";
import { Emitter } from "./codegen/emitter";
import { genProgram } from "./codegen/program";
import {
  loadModule, loadProgram, loadFiles, buildExecutable, findStdDirectory,
} from "./pipeline";
import { buildMain } from "./tool/build";

// Ode has no adjacent string literal concatenation, so this is one line.
let USAGE: *i8 = "usage: ode [-o <path>] [--keep-intermediates] [--emit-llvm] [--dump-tokens | --dump-ast | --dump-types] <input.ode>\n       ode test <input.ode | directory> [filter]   runs the tests in a program, or in every file under a directory\n       ode build [build | test | bootstrap | seed] [options]   (ode build --help)\n";

// `ode test <input.ode | directory> [filter]`: builds the program with its tests and a
// runner for its `main`, in a scratch directory, and runs it. The exit status
// is the runner's: 0 when every test that ran passed.
fn testMain(argc: i32, argv: **i8): i32 {
  if (argc < 3 || argc > 4 || argv[2][0] == '-') {
    writeText(STDERR, USAGE);
    return 2;
  }
  let path: *i8 = argv[2];

  TEST_MODE = true;
  // The tests run elsewhere -- some compile programs of their own -- and
  // need this run's standard library too.
  if (STD_DIRECTORY != null) {
    setEnvironment("ODE_STD", STD_DIRECTORY);
  }
  SOURCE_PATH = path;
  DIAGS = Diagnostics.new();

  let ast: *Ast = Ast.new();
  let root: i32 = ast.add(NodeKind.Program, 0, 0);

  // A directory is tested whole: every file in it, at any depth, and what
  // they import.
  if (isDirectory(path)) {
    let files: *TextList = findSources(path);
    if (files.size() == 0) {
      fail(Problem.NothingToTest);
    }
    loadFiles(ast, root, files);
  } else {
    let source: *i8 = readFile(path);
    if (source == null) {
      fail(Problem.CannotOpenInput);
    }
    loadProgram(ast, root, path, source);
  }
  RUNNER_MODULE = loadModule(ast, root, "ode:testing", "ode:testing",
                             runnerSource());
  SOURCE_PATH = path;

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  let an: *Analyzer = Analyzer.new(ast);
  analyze(an, root);

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  let module: *i8 = genProgram(Emitter.new(ast, an), root);

  let directory: *i8 = makeTempDirectory("ode-test");
  if (directory == null) {
    fail(Problem.CannotMakeScratchDirectory);
  }
  let program: *i8 = joinPath(directory, "tests");
  buildExecutable(module, program, false);

  let run: *TextList = TextList.new();
  run.add(program);
  if (argc == 4) {
    run.add(argv[3]);
  }
  let status: i32 = runCommand(run, null, null, StderrMode.Inherit);

  removeTree(directory);
  return status;
}

fn main(argc: i32, argv: **i8): i32 {
  STD_DIRECTORY = findStdDirectory(argv[0]);

  if (argc >= 2 && equals(argv[1], "build")) {
    return buildMain(argc, argv);
  }
  if (argc >= 2 && equals(argv[1], "test")) {
    return testMain(argc, argv);
  }

  let wantTokens: bool = false;
  let wantAst: bool = false;
  let wantTypes: bool = false;
  let emitOnly: bool = false;
  let keepIntermediates: bool = false;
  let path: *i8 = null;
  let output: *i8 = null;

  let index: i32 = 1;
  while (index < argc) {
    let argument: *i8 = argv[index];

    if (equals(argument, "--dump-tokens")) {
      wantTokens = true;
    } else if (equals(argument, "--dump-ast")) {
      wantAst = true;
    } else if (equals(argument, "--dump-types")) {
      wantTypes = true;
    } else if (equals(argument, "--emit-llvm")) {
      emitOnly = true;
    } else if (equals(argument, "--keep-intermediates")) {
      keepIntermediates = true;
    } else if (equals(argument, "-o")) {
      index = index + 1;
      if (index >= argc) {
        writeText(STDERR, USAGE);
        return 2;
      }
      output = argv[index];
    } else if (argument[0] == '-') {
      writeText(STDERR, USAGE);
      return 2;
    } else {
      path = argument;
    }

    index = index + 1;
  }

  if (path == null) {
    writeText(STDERR, USAGE);
    return 2;
  }

  SOURCE_PATH = path;
  DIAGS = Diagnostics.new();

  let source: *i8 = readFile(path);
  if (source == null) {
    fail(Problem.CannotOpenInput);
  }

  let tokens: *TokenList = tokenize(source);
  let out: *Builder = Builder.new();

  if (wantTokens) {
    dumpTokens(tokens, out);
    writeBuilder(STDOUT, out);
    return 0;
  }

  let ast: *Ast = Ast.new();
  let root: i32 = ast.add(NodeKind.Program, 0, 0);

  loadProgram(ast, root, path, source);

  // A tree with a hole in it says nothing trustworthy about types, so the
  // syntax errors are reported on their own rather than alongside whatever
  // the analyzer would invent from the wreckage.
  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  if (wantAst) {
    dumpNode(ast, null, root, 0, out);
    writeBuilder(STDOUT, out);
    return 0;
  }

  let an: *Analyzer = Analyzer.new(ast);
  analyze(an, root);

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  if (wantTypes) {
    dumpNode(ast, an.types, root, 0, out);
    writeBuilder(STDOUT, out);
    return 0;
  }

  let emitter: *Emitter = Emitter.new(ast, an);
  let module: *i8 = genProgram(emitter, root);

  if (emitOnly) {
    writeText(STDOUT, module);
    return 0;
  }

  if (output == null) {
    output = stemOf(path);
  }

  // The intermediates hang off the executable rather than the input, so that
  // -o keeps a whole build in one directory.
  buildExecutable(module, output, keepIntermediates);

  return 0;
}
