
import { printf } from "std/c";
import { List } from "std/list";
import { Diagnostic } from "./support/diagnostics";
import { problemsIn } from "./testkit";

test "zzgen add_two_pointers" {
  let found: *List<Diagnostic> = problemsIn(`
    fn main(): i32 {
      let value: i32 = 1;
      let pointer: *i32 = &value;
      let sum: *i32 = pointer + pointer;

      return 0;
    }
  `);
  printf("CASE add_two_pointers %lld\n", found.count);
  for (index in 0..found.count) {
    let d: Diagnostic = found.at(index);
    let name: *i8 = d.facts.name;
    let other: *i8 = d.facts.other;
    if (name == null) { name = "-"; }
    if (other == null) { other = "-"; }
    printf("P %s %d %d %s\x1f%s\x1f%s\n", nameOf(d.problem), d.line, d.column, d.path, name, other);
  }
}

