test "zzgen multiple_syntax_errors" {
  let found: *List<Diagnostic> = problemsIn(`
    // A missing semicolon in three separate functions. Recovery resumes at the
    // next statement, so each one is found in the same run.
    fn first(): i32 {
      let a: i32 = 1
      return a;
    }

    fn second(): i32 {
      let b: i32 = 2;
      return b
    }

    fn main(): i32 {
      printf("%d\n", first() + second())
      return 0;
    }

    extern fn printf(format: *i8, ...): i32;
  `);
  printf("CASE multiple_syntax_errors %lld\n", found.count);
  for (index in 0..found.count) {
    let d: Diagnostic = found.at(index);
    let name: *i8 = d.facts.name;
    let other: *i8 = d.facts.other;
    if (name == null) { name = "-"; }
    if (other == null) { other = "-"; }
    printf("P %s %d %d %s\x1f%s\x1f%s\n", nameOf(d.problem), d.line, d.column, d.path, name, other);
  }
}

test "zzgen multiple_type_errors" {
  let found: *List<Diagnostic> = problemsIn(`
    // Every one of these is reported in a single run. The three 'let's each bind
    // their name despite the bad initialiser, so the uses below them add nothing.
    fn main(): i32 {
      let a: bool = 1;
      let b: i32 = true;
      let c: i32 = "text";

      printf("%d\n", a);
      printf("%d\n", b + c);

      if (b) {
        printf("%d\n", 1);
      }

      while (c) {
        break;
      }

      return 0;
    }

    extern fn printf(format: *i8, ...): i32;
  `);
  printf("CASE multiple_type_errors %lld\n", found.count);
  for (index in 0..found.count) {
    let d: Diagnostic = found.at(index);
    let name: *i8 = d.facts.name;
    let other: *i8 = d.facts.other;
    if (name == null) { name = "-"; }
    if (other == null) { other = "-"; }
