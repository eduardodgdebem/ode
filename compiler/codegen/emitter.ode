// ---------------------------------------------------------------------------
// The IR emitter: textual LLVM IR, handed to clang.
//
// The IR is written as text rather than built through the LLVM C API, so the
// compiler links against nothing and depends on clang only at the end. This
// file holds the emitter's state, the helpers that write lines and labels,
// locals, and string constants; the rest of codegen/ is built on them.
//
// Temporaries and labels are named (%t0, L0) rather than numbered, because
// LLVM requires unnamed values to run 0, 1, 2... with no gaps, counting the
// parameters. Naming them sidesteps the rule entirely.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { Builder, equals } from "std/text";
import { SOURCE_PATH, internalError } from "../support/diagnostics";
import { Ast } from "../syntax/ast";
import { Type } from "../semantics/types";
import { moduleDisplayPath } from "../semantics/modules";
import { Analyzer } from "../semantics/analyzer";
import { TEST_MODE } from "../semantics/testing";

struct Local {
  name: *i8,
  // The alloca holding it, as a register name.
  reg: *i8,
  type: Type,
}

export struct Emitter {
  ast: *Ast,
  an: *Analyzer,
  // Struct bodies, string constants, globals and declarations.
  head: *Builder,
  // Function definitions.
  body: *Builder,
  // The current function's stack slots, which all go in its entry block: an
  // alloca where a local is declared would run again on every pass through
  // a loop, and take more stack each time.
  allocas: *Builder,
  nextTemp: i32,
  nextLabel: i32,
  nextString: i32,
  // Whether the block being written already ended in a terminator, so that
  // anything after a `return` opens a new block instead of emitting into a
  // closed one.
  terminated: bool,
  // Whether a check -- `assert`, `assertEq` -- was emitted, which needs the
  // declarations emitCheckSupport adds.
  usesChecks: bool,
  // The enums whose member names were asked for, each of which gets a
  // function giving them; see emitEnumNames.
  namedEnums: *List<*i8>,

  locals: *List<Local>,
  // Where each open scope's locals start, innermost last.
  scopeStarts: *List<i64>,

  // `continue` goes to the condition, `break` to the block after the loop.
  loopContinue: *List<*i8>,
  loopBreak: *List<*i8>,

  fn new(ast: *Ast, an: *Analyzer): *Emitter {
    let e: *Emitter = alloc<Emitter>(1);
    e.ast = ast;
    e.an = an;
    e.head = Builder.new();
    e.body = Builder.new();
    e.allocas = Builder.new();
    e.nextTemp = 0;
    e.nextLabel = 0;
    e.nextString = 0;
    e.terminated = false;
    e.usesChecks = false;
    e.namedEnums = List<*i8>.new();

    e.locals = List<Local>.new();
    e.scopeStarts = List<i64>.new();
    e.loopContinue = List<*i8>.new();
    e.loopBreak = List<*i8>.new();

    return e;
  }
}

// ---------------------------------------------------------------------------
// Names and lines.
// ---------------------------------------------------------------------------

export fn freshTemp(e: *Emitter): *i8 {
  let name: *Builder = Builder.new();
  name.add("%t");
  name.addInt(e.nextTemp as i64);
  e.nextTemp = e.nextTemp + 1;

  return name.take();
}

export fn freshLabel(e: *Emitter): *i8 {
  let name: *Builder = Builder.new();
  name.add("L");
  name.addInt(e.nextLabel as i64);
  e.nextLabel = e.nextLabel + 1;

  return name.take();
}

// A stack slot for a value of LLVM type `typeName`, made once when the
// function is entered.
export fn emitAlloca(e: *Emitter, typeName: *i8): *i8 {
  let slot: *i8 = freshTemp(e);
  e.allocas.add("  ");
  e.allocas.add(slot);
  e.allocas.add(" = alloca ");
  e.allocas.add(typeName);
  e.allocas.push('\n');

  return slot;
}

export fn emitLine(e: *Emitter, text: *i8): void {
  e.body.add("  ");
  e.body.add(text);
  e.body.push('\n');
}

export fn emitLabel(e: *Emitter, label: *i8): void {
  e.body.add(label);
  e.body.add(":\n");
  e.terminated = false;
}

export fn emitBranch(e: *Emitter, label: *i8): void {
  if (e.terminated) {
    return;
  }

  let line: *Builder = Builder.new();
  line.add("br label %");
  line.add(label);
  emitLine(e, line.data);
  e.terminated = true;
}

export fn emitCondBranch(e: *Emitter, condition: *i8, whenTrue: *i8,
                         whenFalse: *i8): void {
  if (e.terminated) {
    return;
  }

  let line: *Builder = Builder.new();
  line.add("br i1 ");
  line.add(condition);
  line.add(", label %");
  line.add(whenTrue);
  line.add(", label %");
  line.add(whenFalse);
  emitLine(e, line.data);
  e.terminated = true;
}

// ---------------------------------------------------------------------------
// Locals.
// ---------------------------------------------------------------------------

export fn emitterEnterScope(e: *Emitter): void {
  e.scopeStarts.push(e.locals.count);
}

export fn emitterExitScope(e: *Emitter): void {
  e.locals.truncate(e.scopeStarts.pop());
}

export fn declareLocal(e: *Emitter, name: *i8, reg: *i8, type: Type): void {
  e.locals.push(Local { name: name, reg: reg, type: type });
}

// Innermost first, so a shadowed name resolves to the slot the analyzer
// type-checked it against. A miss means the name is a top-level global, which
// goes by the IR name the analyzer resolved it to.
export fn variableAddress(e: *Emitter, node: i32): *i8 {
  let name: *i8 = e.ast.nodes[node].text;
  let index: i64 = e.locals.count - 1;

  while (index >= 0) {
    if (equals(e.locals.at(index).name, name)) {
      return e.locals.at(index).reg;
    }
    index = index - 1;
  }

  return llvmName('@', e.an.linkNames[node]);
}

// `%name` or `@name`, quoted when the name holds anything LLVM does not allow
// bare -- which a generic's instances do: `%"List<i32>"`.
export fn llvmName(sigil: i8, name: *i8): *i8 {
  // Under `ode test` the runner is the program's `main`, so the program's own
  // goes by another name.
  if (sigil == '@' && TEST_MODE && equals(name, "main")) {
    name = "ode.main";
  }

  let out: *Builder = Builder.new();
  out.push(sigil);

  let bare: bool = true;
  for (index in 0..strlen(name)) {
    let c: i8 = name[index];
    let plain: bool = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                      (c >= '0' && c <= '9') || c == '_' || c == '.' ||
                      c == '$' || c == '-';
    if (!plain) {
      bare = false;
    }
  }

  if (bare) {
    out.add(name);
  } else {
    out.push('"');
    out.add(name);
    out.push('"');
  }

  return out.take();
}

// ---------------------------------------------------------------------------
// Constants.
// ---------------------------------------------------------------------------

// One byte of an LLVM string constant. Anything outside plain printable ASCII
// is written as \XX, and so are the quote and the backslash.
fn emitIRByte(out: *Builder, value: i8): void {
  let code: i32 = value as i32;
  if (code < 0) {
    code = code + 256;
  }

  if (code >= 32 && code < 127 && value != '"' && value != '\\') {
    out.push(value);
    return;
  }

  out.push('\\');
  out.push(hexDigit(code / 16));
  out.push(hexDigit(code % 16));
}

export fn hexDigit(value: i32): i8 {
  if (value < 10) {
    return ('0' + value) as i8;
  }

  return ('A' + value - 10) as i8;
}

// Adds a private constant for a string literal and returns its name.
export fn internString(e: *Emitter, text: *i8, length: i64): *i8 {
  let name: *Builder = Builder.new();
  name.add("@.str.");
  name.addInt(e.nextString as i64);
  e.nextString = e.nextString + 1;
  let symbol: *i8 = name.take();

  e.head.add(symbol);
  e.head.add(" = private unnamed_addr constant [");
  e.head.addInt(length + 1);
  e.head.add(" x i8] c\"");

  for (index in 0..length) {
    emitIRByte(e.head, text[index]);
  }

  e.head.add("\\00\"\n");

  return symbol;
}

test "llvmName quotes only what LLVM cannot take bare" {
  assertEq(llvmName('@', "main.helper"), "@main.helper");
  assertEq(llvmName('%', "List<i32>"), "%\"List<i32>\"");
}

// A fault in code generation, reported at `node` in the file it came from.
export fn codegenFault(e: *Emitter, node: i32, what: *i8): void {
  SOURCE_PATH = moduleDisplayPath(e.ast.nodes[node].module);
  internalError(e.ast.nodes[node].line, e.ast.nodes[node].column, what);
}
