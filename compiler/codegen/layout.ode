// ---------------------------------------------------------------------------
// How Ode's types are spelled in LLVM IR. Their sizes are in
// semantics/layout.ode.
// ---------------------------------------------------------------------------

import { Builder } from "std/text";
import { valueOf, holdsSeveral } from "../check/errors";
import { payloadWords } from "../types/layout";
import { llvmName } from "./emitter";
import { TypeKind, Type } from "../types/types";

export fn llvmTypeName(type: Type): *i8 {
  // Pointers are opaque in modern LLVM, so every depth is the same `ptr`.
  if (type.isPointer() || type.isNull() || type.isFunction()) {
    return "ptr";
  }
  if (type.kind == TypeKind.Enum) {
    return "i32";
  }

  if (type.kind == TypeKind.Struct) {
    return llvmName('%', type.structName);
  }
  if (type.isSlice()) {
    return "{ ptr, i64 }";
  }

  // A union is its code -- 0 for the value, the error's number otherwise --
  // and its value. One that may hold several types keeps the value in as
  // many 8-byte words as the largest needs, and its code says which type it
  // holds: see codegen/errors.ode.
  if (holdsSeveral(type)) {
    let out: *Builder = Builder.new();
    out.add("{ i32, [");
    out.addInt(payloadWords(type) as i64);
    out.add(" x i64] }");
    return out.take();
  }
  if (type.isUnion()) {
    let value: Type = valueOf(type);
    if (value.isVoid()) {
      return "{ i32 }";
    }
    let out: *Builder = Builder.new();
    out.add("{ i32, ");
    out.add(llvmTypeName(value));
    out.add(" }");
    return out.take();
  }

  return match (type.kind) {
    .I8, .U8 => "i8",
    .I16, .U16 => "i16",
    .I32, .U32 => "i32",
    .I64, .U64 => "i64",
    .F32 => "float",
    .F64 => "double",
    .Bool => "i1",
    .Void => "void",
    else => "void",
  };
}

export fn zeroValue(type: Type): *i8 {
  if (type.isPointer() || type.isFunction()) { return "null"; }
  return match (type.kind) {
    .Struct, .Union, .Slice => "zeroinitializer",
    .Bool => "false",
    .F32, .F64 => "0.0",
    else => "0",
  };
}
