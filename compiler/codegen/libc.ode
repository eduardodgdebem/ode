// ---------------------------------------------------------------------------
// The C library for Linux: musl, bundled, and built the first time a program
// is built for a target that needs it.
//
// A Linux program links statically against musl, so it runs on any Linux of
// its architecture, whatever libc that has. vendor/ holds musl's release
// tarball and the generic C sources of compiler-rt's builtins -- the helpers
// clang calls for what the CPU cannot do in an instruction, such as aarch64's
// 128-bit long double, which musl's printf needs. Both are built with the C
// compiler that builds everything else, once per target, into a cache:
//
//   $ODE_CACHE, or $XDG_CACHE_HOME/ode, or ~/.cache/ode
//     libc/musl-1.2.5/<triple>/lib/{crt1.o, crti.o, crtn.o, libc.a, libcompiler_rt.a}
//
// Building musl takes its own `configure` and `make`, which need a shell and
// make, and an archiver that writes ELF symbol tables: llvm-ar, since the
// ar on a Mac writes Mach-O ones. Linking is done by lld.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { exists } from "std/fs";
import { Builder, contains, endsWith, slice } from "std/text";
import { executablePath } from "../driver/library";
import { STD_DIRECTORY } from "../link/modules";
import {
  joinPath, parentDirectory, isExecutable, makeDirectories, makeTempDirectory,
  removeTree, moveFile, listDirectory,
} from "../os/files";
import { STDERR, writeBuilder, writeText } from "../os/output";
import {
  TextList, StderrMode, runCommand, ran, environment,
} from "../os/process";
import { isSpace } from "../syntax/lexer";
import { Abi, Arch, Os, Target } from "./target";
import { ccProgram, LinkInputs } from "./toolchain";

export let MUSL: *i8 = "musl-1.2.5";
export let BUILTINS: *i8 = "compiler-rt-builtins-23.1.3";

export error enum LibcError {
  // No vendor/ beside the standard library.
  NoSources,
  // No llvm-ar to archive what was built.
  NoArchiver,
  // Nowhere to keep it: no HOME and no cache directory named.
  NoCache,
  // musl's build or the builtins' failed; what they printed has been shown.
  BuildFailed,
}

// Where the bundled sources are: vendor/, beside std/ in the repository and
// in an install alike.
fn vendorDirectory(): *i8 {
  if (STD_DIRECTORY == null) {
    return null;
  }
  return joinPath(parentDirectory(STD_DIRECTORY), "vendor");
}

fn cacheDirectory(): *i8 {
  let chosen: *i8 = environment("ODE_CACHE");
  if (chosen != null) {
    return chosen;
  }
  let xdg: *i8 = environment("XDG_CACHE_HOME");
  if (xdg != null) {
    return joinPath(xdg, "ode");
  }
  let home: *i8 = environment("HOME");
  if (home == null) {
    return null;
  }
  return joinPath(home, ".cache/ode");
}

// A tool of the C compiler's own installation when it has one -- Homebrew's
// llvm-ar is beside its clang, not on PATH -- or else the one on PATH, or
// else Homebrew's LLVM's, which Apple's clang does not know about.
export fn findTool(name: *i8): *i8 {
  let asked: *Builder = Builder.new();
  asked.add("-print-prog-name=");
  asked.add(name);
  let output: *Builder = Builder.new();
  let command: *TextList = TextList.new().add(ccProgram()).add(asked.take());
  if (ran(runCommand(command, null, output, StderrMode.Discard))) {
    while (output.length > 0 && isSpace(output.data[output.length - 1])) {
      output.length = output.length - 1;
    }
    output.data[output.length] = 0;
    if (contains(output.data, "/") && isExecutable(output.data)) {
      return output.take();
    }
  }
  let found: *i8 = executablePath(name);
  if (found != null) {
    return found;
  }
  let homebrew: *TextList = TextList.new();
  homebrew.add("/opt/homebrew/opt/llvm/bin").add("/usr/local/opt/llvm/bin");
  for (index in 0..homebrew.size()) {
    let candidate: *i8 = joinPath(homebrew.at(index), name);
    if (isExecutable(candidate)) {
      return candidate;
    }
  }
  return null;
}

// Runs a step of the build, keeping what it prints to show if it fails.
fn step(command: *TextList, directory: *i8, log: *Builder): bool {
  return ran(runCommand(command, directory, log, StderrMode.Merge));
}

// Which of the builtins `target` compiles: all but the x87 ones (`xf`, and
// complex `xc3`) everywhere but x86.
fn wantsBuiltin(target: Target, file: *i8): bool {
  if (!endsWith(file, ".c")) {
    return false;
  }
  if (target.arch == Arch.X86_64) {
    return true;
  }
  return !contains(file, "xf") && !contains(file, "xc3");
}

// Builds musl and the builtins for `target` into `into`.
fn build(target: Target, vendor: *i8, scratch: *i8, into: *i8,
         log: *Builder): void | LibcError {
  let ar: *i8 = findTool("llvm-ar");
  if (ar == null) {
    return LibcError.NoArchiver;
  }
  let triple: *i8 = target.triple();
  let targetFlag: *Builder = Builder.new();
  targetFlag.add("--target=");
  targetFlag.add(triple);
  let flag: *i8 = targetFlag.take();

  let musl: *Builder = Builder.new();
  musl.add(joinPath(vendor, MUSL));
  musl.add(".tar.gz");
  let builtins: *Builder = Builder.new();
  builtins.add(joinPath(vendor, BUILTINS));
  builtins.add(".tar.gz");
  if (!step(TextList.new().add("tar").add("xzf").add(musl.take()).add("-C").add(scratch),
            null, log) ||
      !step(TextList.new().add("tar").add("xzf").add(builtins.take()).add("-C").add(scratch),
            null, log)) {
    return LibcError.BuildFailed;
  }

  // musl's own build: static only, installed straight into the cache.
  let source: *i8 = joinPath(scratch, MUSL);
  let configure: *TextList = TextList.new().add("sh").add("./configure");
  configure.add(flag).add(text2("--prefix=", into)).add("--disable-shared");
  configure.add(text2("CC=", ccProgram()));
  configure.add(text3("CFLAGS=", flag, " -O2"));
  configure.add(text2("AR=", ar));
  // musl indexes its archive with RANLIB, which llvm-ar does as `s`.
  configure.add(text3("RANLIB=", ar, " s"));
  if (!step(configure, source, log) ||
      !step(TextList.new().add("make").add("-j8"), source, log) ||
      !step(TextList.new().add("make").add("install"), source, log)) {
    return LibcError.BuildFailed;
  }

  // The builtins, compiled in one run of the C compiler against musl's
  // headers, which writes each object into the directory it runs in.
  let rt: *i8 = joinPath(scratch, BUILTINS);
  let compile: *TextList = TextList.new().add(ccProgram()).add(flag);
  compile.add("--sysroot").add(into).add("-O2").add("-fPIC").add("-fno-builtin");
  compile.add("-c");
  let archive: *TextList = TextList.new().add(ar).add("rcs");
  archive.add(joinPath(into, "lib/libcompiler_rt.a"));
  let files: *TextList = listDirectory(rt);
  for (index in 0..files.size()) {
    let file: *i8 = files.at(index);
    if (wantsBuiltin(target, file)) {
      compile.add(joinPath(rt, file));
      archive.add(text2(slice(file, 0, strlen(file) - 2), ".o"));
    }
  }
  if (!step(compile, rt, log) || !step(archive, rt, log)) {
    return LibcError.BuildFailed;
  }
  return;
}

// The directory holding musl and the builtins for `target`, built into the
// cache first if they are not there yet.
export fn bundledLibc(target: Target): *i8 | LibcError {
  let cache: *i8 = cacheDirectory();
  if (cache == null) {
    return LibcError.NoCache;
  }
  let directory: *i8 = joinPath(joinPath(joinPath(cache, "libc"), MUSL),
                                target.triple());
  if (exists(joinPath(directory, "lib/libcompiler_rt.a"))) {
    return directory;
  }

  let vendor: *i8 = vendorDirectory();
  if (vendor == null || !exists(joinPath(vendor, "musl-1.2.5.tar.gz"))) {
    return LibcError.NoSources;
  }
  makeDirectories(parentDirectory(directory)) catch (e) {
    return LibcError.NoCache;
  };
  let scratch: *i8 = makeTempDirectory("ode-libc") catch (e) {
    return LibcError.NoCache;
  };

  writeText(STDERR, text3("building musl for ", target.triple(),
                          ", once; it is kept in the cache\n"));
  // Built beside where it goes, and moved there whole, so that a build cut
  // short is never taken for one that finished.
  let partial: *i8 = text2(directory, ".partial");
  removeTree(partial);
  let log: *Builder = Builder.new();
  build(target, vendor, scratch, partial, log) catch (e) {
    if (e == LibcError.BuildFailed) {
      writeBuilder(STDERR, log);
    }
    removeTree(scratch);
    removeTree(partial);
    return e;
  };
  removeTree(scratch);

  // Another build may have finished first, which is as good.
  moveFile(partial, directory) catch (e) {
    removeTree(partial);
  };
  if (!exists(joinPath(directory, "lib/libcompiler_rt.a"))) {
    return LibcError.NoCache;
  }
  return directory;
}

// The command line that links `object` into a static executable against the
// musl in `libc`: musl's start files around the program, what the program
// links, then musl and the builtins, which everything before may call.
export fn muslLinkCommand(command: *TextList, libc: *i8, object: *i8,
                          output: *i8, inputs: *LinkInputs): *TextList {
  let lib: *i8 = joinPath(libc, "lib");
  command.add("-static").add("-nostdlib").add("-o").add(output);
  command.add(joinPath(lib, "crt1.o")).add(joinPath(lib, "crti.o"));
  command.add(object);
  // musl's libm, libpthread and the rest are empty, but -lm must find one.
  command.add("-L").add(lib);
  inputs.addTo(command);
  command.add(joinPath(lib, "libc.a")).add(joinPath(lib, "libcompiler_rt.a"));
  command.add(joinPath(lib, "crtn.o"));
  return command;
}

fn text2(a: *i8, b: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(a);
  out.add(b);
  return out.take();
}

fn text3(a: *i8, b: *i8, c: *i8): *i8 {
  let out: *Builder = Builder.new();
  out.add(a);
  out.add(b);
  out.add(c);
  return out.take();
}

test "the builtins skip the x87 ones away from x86" {
  let arm: Target = Target { arch: Arch.Aarch64, os: Os.Linux, abi: Abi.Musl };
  let intel: Target = Target { arch: Arch.X86_64, os: Os.Linux, abi: Abi.Musl };
  assert(wantsBuiltin(arm, "addtf3.c"));
  assert(!wantsBuiltin(arm, "fixxfdi.c"));
  assert(!wantsBuiltin(arm, "mulxc3.c"));
  assert(wantsBuiltin(intel, "fixxfdi.c"));
  assert(!wantsBuiltin(intel, "int_lib.h"));
}
