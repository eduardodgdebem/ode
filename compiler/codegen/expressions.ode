// ---------------------------------------------------------------------------
// Emitting expressions.
//
// genExpr writes the instructions computing a value and returns what holds it:
// a temporary, or a constant written in place. genAddress does the same for
// the storage an lvalue names. Every type is read from the analyzer's table, so
// nothing here infers one.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { alloc } from "std/mem";
import { Builder, equals, fromInt } from "std/text";
import { analyzerParseType } from "../check/analyzer";
import { textHasDot } from "../check/expressions";
import { CallTarget } from "../check/functions";
import { ReceiverMode } from "../check/methods";
import {
  Emitter, freshTemp, freshLabel, emitAlloca, emitLine, emitLabel, emitBranch,
  emitCondBranch, variableAddress, llvmName, internString, codegenFault,
  lambdaValue,
} from "./emitter";
import {
  wrapInUnion, genVariable, genTry, genCoalesce, genCatch, genIs,
  narrowedAddress, memberAddress, convertUnion,
} from "./errors";
import { llvmTypeName, zeroValue } from "./layout";
import { genMatchValue } from "./statements";
import { genAssert, instruction, genAssertEq, genNameOf } from "./testing";
import { internalError } from "../diagnostics/report";
import { line } from "../driver/options";
import {
  NO_NODE, NodeKind, Syntax, Binary, BinaryOp, Unary, UnaryOp, Cast, Index, Sizeof, Try, Is,
  Catch, Unmoved, binaryOf, unaryOf,
} from "../syntax/ast";
import { sizeOf } from "../types/layout";
import { TypeKind, Type } from "../types/types";

export fn typeOfNode(e: *Emitter, node: i32): Type {
  return e.an.types[node];
}

// Emits `%t = <op>` and returns the temporary.
export fn emitAssign(e: *Emitter, instruction: *i8): *i8 {
  let temp: *i8 = freshTemp(e);
  let line: *Builder = Builder.new();
  line.add(temp);
  line.add(" = ");
  line.add(instruction);
  emitLine(e, line.data);

  return temp;
}

export fn emitLoad(e: *Emitter, type: Type, address: *i8): *i8 {
  let line: *Builder = Builder.new();
  line.add("load ");
  line.add(llvmTypeName(type));
  line.add(", ptr ");
  line.add(address);

  return emitAssign(e, line.data);
}

export fn emitStore(e: *Emitter, type: Type, value: *i8, address: *i8): void {
  let line: *Builder = Builder.new();
  line.add("store ");
  line.add(llvmTypeName(type));
  line.push(' ');
  line.add(value);
  line.add(", ptr ");
  line.add(address);
  emitLine(e, line.data);
}

export fn emitCast(e: *Emitter, value: *i8, from: Type, to: Type): *i8 {
  if (from.equals(to)) {
    return value;
  }

  // An enum is an i32 underneath, so it converts as one.
  if (from.isEnum()) {
    return emitCast(e, value, Type.make(TypeKind.I32, 0), to);
  }
  if (to.isEnum()) {
    return emitCast(e, value, from, Type.make(TypeKind.I32, 0));
  }

  let target: *i8 = llvmTypeName(to);
  let source: *i8 = llvmTypeName(from);

  // Opaque pointers: pointer to pointer is not a conversion at all.
  let fromCode: bool = from.isPointer() || from.isNull() || from.isFunction();
  if (fromCode && (to.isPointer() || to.isFunction())) {
    return value;
  }

  let opcode: *i8 = null;

  if (from.isPointer() && to.isInteger()) {
    opcode = "ptrtoint";
  } else if (from.isInteger() && to.isPointer()) {
    opcode = "inttoptr";
  } else if (from.isBool()) {
    // An i1 always widens without sign extension.
    opcode = "zext";
  } else if (to.isBool()) {
    let line: *Builder = Builder.new();
    line.add("icmp ne ");
    line.add(source);
    line.push(' ');
    line.add(value);
    line.add(", ");
    line.add(zeroValue(from));
    return emitAssign(e, line.data);
  } else if (from.isInteger() && to.isInteger()) {
    if (to.bitWidth() == from.bitWidth()) {
      return value;
    }
    if (to.bitWidth() < from.bitWidth()) {
      opcode = "trunc";
    } else if (from.isSigned()) {
      opcode = "sext";
    } else {
      opcode = "zext";
    }
  } else if (from.isInteger() && to.isFloat()) {
    if (from.isSigned()) {
      opcode = "sitofp";
    } else {
      opcode = "uitofp";
    }
  } else if (from.isFloat() && to.isInteger()) {
    if (to.isSigned()) {
      opcode = "fptosi";
    } else {
      opcode = "fptoui";
    }
  } else if (from.isFloat() && to.isFloat()) {
    // f32 and f64 are distinct LLVM types, so this is a real conversion.
    if (to.bitWidth() > from.bitWidth()) {
      opcode = "fpext";
    } else {
      opcode = "fptrunc";
    }
  } else {
    internalError(0, 0, "cannot cast in codegen");
  }

  let line: *Builder = Builder.new();
  line.add(opcode);
  line.push(' ');
  line.add(source);
  line.push(' ');
  line.add(value);
  line.add(" to ");
  line.add(target);

  return emitAssign(e, line.data);
}

fn isAddressable(e: *Emitter, node: i32): bool {
  let kind: NodeKind = e.ast.nodes[node].kind;

  if (kind == NodeKind.Ident || kind == NodeKind.Index) {
    return true;
  }
  // A field has an address when what it is read from does: a pointer, or
  // storage -- not the struct a call returned. `Color.Red` has none.
  if (kind == NodeKind.FieldAccess) {
    if (e.an.isConstant[node] != 0) {
      return false;
    }
    let object: i32 = e.ast.nodes[node].a;
    return typeOfNode(e, object).isPointer() || isAddressable(e, object);
  }
  let syntax: Syntax = e.ast.nodes[node].syntax;
  if (syntax is Unary) {
    return syntax.op == UnaryOp.Deref;
  }

  return false;
}

export fn genAddress(e: *Emitter, node: i32): *i8 {
  let kind: NodeKind = e.ast.nodes[node].kind;

  if (kind == NodeKind.Ident) {
    return narrowedAddress(e, node);
  }

  if (kind == NodeKind.FieldAccess) {
    let address: *i8 = genFieldAddress(e, e.ast.nodes[node].a, e.ast.nodes[node].text);
    if (e.an.narrowedFrom[node].kind != TypeKind.None) {
      return memberAddress(e, e.an.narrowedFrom[node], typeOfNode(e, node), address);
    }
    return address;
  }

  let syntax: Syntax = e.ast.nodes[node].syntax;
  if (syntax is Index) {
    return genIndexAddress(e, syntax);
  }

  // For `*p` the address to read or write is simply the value of `p`.
  if (kind == NodeKind.Unary) {
    return genExpr(e, unaryOf(e.ast, node).operand);
  }

  codegenFault(e, node, "expression does not denote an addressable location");
  return null;
}

// The address of the field `field` of the struct `object` is, or points at.
fn genFieldAddress(e: *Emitter, object: i32, field: *i8): *i8 {
  let objectType: Type = typeOfNode(e, object);

  // `p.field` follows pointers automatically, so the base is either what
  // the pointers lead to or the address of a struct variable.
  let base: *i8 = null;
  let structType: Type = objectType.base();
  if (objectType.isPointer()) {
    base = genStructPointer(e, object);
  } else {
    base = genAddress(e, object);
  }

  let structIndex: i32 = e.an.structs.indexOf(structType.structName);
  let fieldIndex: i32 = e.an.structs.fieldIndex(structIndex, field);

  let line: *Builder = Builder.new();
  line.add("getelementptr inbounds ");
  line.add(llvmTypeName(structType));
  line.add(", ptr ");
  line.add(base);
  line.add(", i32 0, i32 ");
  line.addInt(fieldIndex as i64);

  return emitAssign(e, line.data);
}

// The address of the struct `object` points at, through however many
// pointers it takes to get there.
fn genStructPointer(e: *Emitter, object: i32): *i8 {
  let objectType: Type = typeOfNode(e, object);
  let pointer: *i8 = genExpr(e, object);

  for (level in 1..objectType.pointerDepth) {
    pointer = emitLoad(e, codePointer(), pointer);
  }

  return pointer;
}

// The value of the field `field` of the struct `object` is, or points at.
fn genFieldValue(e: *Emitter, object: i32, field: *i8): *i8 {
  let objectType: Type = typeOfNode(e, object);
  let structType: Type = objectType.base();
  let structIndex: i32 = e.an.structs.indexOf(structType.structName);
  let fieldIndex: i32 = e.an.structs.fieldIndex(structIndex, field);
  let fieldType: Type = e.an.structs.items[structIndex].fields[fieldIndex].type;

  // A struct with no storage -- a call result, say -- cannot be GEPed into,
  // so the field is read straight out of the aggregate value.
  if (!objectType.isPointer() && !isAddressable(e, object)) {
    let line: *Builder = Builder.new();
    line.add("extractvalue ");
    line.add(llvmTypeName(objectType));
    line.push(' ');
    line.add(genExpr(e, object));
    line.add(", ");
    line.addInt(fieldIndex as i64);

    return emitAssign(e, line.data);
  }

  return emitLoad(e, fieldType, genFieldAddress(e, object, field));
}

// The address of element `b` of the pointer `a`.
fn genIndexAddress(e: *Emitter, index: Index): *i8 {
  let base: i32 = index.base;
  let baseType: Type = typeOfNode(e, base);
  let pointer: *i8 = genExpr(e, base);

  let indexNode: i32 = index.index;
  let offset: *i8 = emitCast(e, genExpr(e, indexNode), typeOfNode(e, indexNode),
                             Type.make(TypeKind.I64, 0));

  let line: *Builder = Builder.new();
  line.add("getelementptr inbounds ");
  line.add(llvmTypeName(baseType.pointee()));
  line.add(", ptr ");
  line.add(pointer);
  line.add(", i64 ");
  line.add(offset);

  return emitAssign(e, line.data);
}

// `&&` and `||` evaluate their right operand only when the left does not
// already decide the result, so they branch rather than emitting a bitwise
// instruction.
fn genShortCircuit(e: *Emitter, binary: Binary): *i8 {
  let isAnd: bool = binary.op == BinaryOp.And;

  let slot: *i8 = emitAlloca(e, "i1");
  let left: *i8 = genExpr(e, binary.left);
  emitStore(e, Type.make(TypeKind.Bool, 0), left, slot);

  let rightLabel: *i8 = freshLabel(e);
  let doneLabel: *i8 = freshLabel(e);

  if (isAnd) {
    emitCondBranch(e, left, rightLabel, doneLabel);
  } else {
    emitCondBranch(e, left, doneLabel, rightLabel);
  }

  emitLabel(e, rightLabel);
  let right: *i8 = genExpr(e, binary.right);
  emitStore(e, Type.make(TypeKind.Bool, 0), right, slot);
  emitBranch(e, doneLabel);

  emitLabel(e, doneLabel);

  return emitLoad(e, Type.make(TypeKind.Bool, 0), slot);
}

fn genPointerArithmetic(e: *Emitter, op: BinaryOp, left: *i8, right: *i8,
                        leftType: Type, rightType: Type): *i8 {
  let i64Type: Type = Type.make(TypeKind.I64, 0);

  // p - q: a byte distance scaled down to a count of elements.
  if (leftType.isPointer() && rightType.isPointer()) {
    let leftInt: *i8 = emitCast(e, left, leftType, i64Type);
    let rightInt: *i8 = emitCast(e, right, rightType, i64Type);

    let subtraction: *Builder = Builder.new();
    subtraction.add("sub i64 ");
    subtraction.add(leftInt);
    subtraction.add(", ");
    subtraction.add(rightInt);
    let difference: *i8 = emitAssign(e, subtraction.data);

    let elementSize: i32 = sizeOf(e.an.structs, leftType.pointee());
    if (elementSize <= 1) {
      return difference;
    }

    let division: *Builder = Builder.new();
    division.add("sdiv i64 ");
    division.add(difference);
    division.add(", ");
    division.addInt(elementSize as i64);

    return emitAssign(e, division.data);
  }

  let pointer: *i8 = left;
  let offset: *i8 = right;
  let pointerType: Type = leftType;
  let offsetType: Type = rightType;

  if (!leftType.isPointer()) {
    pointer = right;
    offset = left;
    pointerType = rightType;
    offsetType = leftType;
  }

  // GEP indices are pointer-sized, so widen or narrow the offset to match.
  offset = emitCast(e, offset, offsetType, i64Type);

  // `p - i` is `p + (-i)`.
  if (op == BinaryOp.Subtract) {
    let negation: *Builder = Builder.new();
    negation.add("sub i64 0, ");
    negation.add(offset);
    offset = emitAssign(e, negation.data);
  }

  let line: *Builder = Builder.new();
  line.add("getelementptr inbounds ");
  line.add(llvmTypeName(pointerType.pointee()));
  line.add(", ptr ");
  line.add(pointer);
  line.add(", i64 ");
  line.add(offset);

  return emitAssign(e, line.data);
}

// The instruction for a binary operator, given the operand type. Integer
// division, remainder and the comparisons all differ by signedness, and the
// float forms are different opcodes again.
fn binaryOpcode(op: BinaryOp, type: Type): *i8 {
  let float: bool = type.isFloat();
  let signed: bool = type.isSigned();

  match (op) {
    .Add => { if (float) { return "fadd"; } return "add"; }
    .Subtract => { if (float) { return "fsub"; } return "sub"; }
    .Multiply => { if (float) { return "fmul"; } return "mul"; }
    .Divide => {
      if (float) { return "fdiv"; }
      if (signed) { return "sdiv"; }
      return "udiv";
    }
    .Remainder => {
      if (signed) { return "srem"; }
      return "urem";
    }
    .BitAnd => { return "and"; }
    .BitOr => { return "or"; }
    .BitXor => { return "xor"; }
    .ShiftLeft => { return "shl"; }
    .ShiftRight => {
      if (signed) { return "ashr"; }
      return "lshr";
    }

    // The comparisons. A pointer compares as an unsigned integer.
    .Equal => { if (float) { return "fcmp oeq"; } return "icmp eq"; }
    .NotEqual => { if (float) { return "fcmp one"; } return "icmp ne"; }
    .Less => {
      if (float) { return "fcmp olt"; }
      if (signed) { return "icmp slt"; }
      return "icmp ult";
    }
    .LessEqual => {
      if (float) { return "fcmp ole"; }
      if (signed) { return "icmp sle"; }
      return "icmp ule";
    }
    .Greater => {
      if (float) { return "fcmp ogt"; }
      if (signed) { return "icmp sgt"; }
      return "icmp ugt";
    }
    .GreaterEqual => {
      if (float) { return "fcmp oge"; }
      if (signed) { return "icmp sge"; }
      return "icmp uge";
    }
    // These branch instead, and never ask for an instruction of their own.
    .And, .Or, .Coalesce => {
      return "";
    }
  }
}

fn isComparison(op: BinaryOp): bool {
  return match (op) {
    .Equal, .NotEqual, .Less, .LessEqual, .Greater, .GreaterEqual => true,
    else => false,
  };
}

fn genBinary(e: *Emitter, node: i32, binary: Binary): *i8 {
  let op: BinaryOp = binary.op;
  if (op == BinaryOp.And || op == BinaryOp.Or) {
    return genShortCircuit(e, binary);
  }
  if (op == BinaryOp.Coalesce) {
    return genCoalesce(e, node, binary);
  }

  let leftType: Type = typeOfNode(e, binary.left);
  let rightType: Type = typeOfNode(e, binary.right);

  let left: *i8 = genExpr(e, binary.left);
  let right: *i8 = genExpr(e, binary.right);

  // A comparison of two pointers is an ordinary icmp; everything else is
  // pointer arithmetic.
  if ((leftType.isPointer() || rightType.isPointer()) && !isComparison(op)) {
    return genPointerArithmetic(e, op, left, right, leftType, rightType);
  }

  let line: *Builder = Builder.new();
  line.add(binaryOpcode(op, leftType));
  line.push(' ');
  line.add(llvmTypeName(leftType));
  line.push(' ');
  line.add(left);
  line.add(", ");
  line.add(right);

  return emitAssign(e, line.data);
}

fn genUnary(e: *Emitter, node: i32, unary: Unary): *i8 {
  let operand: i32 = unary.operand;
  match (unary.op) {
    .AddressOf => {
      return genAddress(e, operand);
    }
    .Deref => {
      return emitLoad(e, typeOfNode(e, node), genExpr(e, operand));
    }
    .Plus => {
      return genExpr(e, operand);
    }
    .Negate => {
      let operandType: Type = typeOfNode(e, operand);
      let value: *i8 = genExpr(e, operand);
      let line: *Builder = Builder.new();
      if (operandType.isFloat()) {
        line.add("fneg ");
        line.add(llvmTypeName(operandType));
        line.push(' ');
        line.add(value);
      } else {
        line.add("sub ");
        line.add(llvmTypeName(operandType));
        line.add(" 0, ");
        line.add(value);
      }
      return emitAssign(e, line.data);
    }
    // Logical NOT on an i1 is a flip against true.
    .Not => {
      let line: *Builder = Builder.new();
      line.add("xor i1 ");
      line.add(genExpr(e, operand));
      line.add(", true");
      return emitAssign(e, line.data);
    }
  }
}

// The callee's signature is read off the analyzer's types rather than looked
// up again: the call's own type is the return type, and every argument was
// required to have exactly its parameter's type.
fn genCall(e: *Emitter, node: i32): *i8 {
  if (e.an.callTargets[node] == CallTarget.Assert) {
    return genAssert(e, node);
  }
  if (e.an.callTargets[node] == CallTarget.AssertEq) {
    return genAssertEq(e, node);
  }
  if (e.an.callTargets[node] == CallTarget.NameOf) {
    return genNameOf(e, node);
  }

  // A variable holding a function is loaded, and the call goes through it.
  if (e.an.callTargets[node] == CallTarget.Value) {
    let callee: *i8 = emitLoad(e, codePointer(), variableAddress(e, node));
    return genCallWith(e, node, callee, e.ast.nodes[node].a, "", "");
  }

  return genCallWith(e, node, direct(e, node), e.ast.nodes[node].a, "", "");
}

// `@name`: a call straight to the function the analyzer resolved.
fn direct(e: *Emitter, node: i32): *i8 {
  return llvmName('@', e.an.linkNames[node]);
}

// The type a function value is loaded as. Every pointer is the same `ptr`.
fn codePointer(): Type {
  return Type.make(TypeKind.I8, 1);
}

// `table[i](x)`: a call of whatever an expression produced.
fn genCallValue(e: *Emitter, node: i32): *i8 {
  let callee: *i8 = genExpr(e, e.ast.nodes[node].a);
  return genCallWith(e, node, callee, e.ast.nodes[node].b, "", "");
}

// A method call is a call with the receiver, when there is one, put in front
// of the arguments as `self`.
fn genMethodCall(e: *Emitter, node: i32): *i8 {
  // `ops.apply(x)` calls the function a field holds.
  if (e.an.callTargets[node] == CallTarget.Field) {
    let callee: *i8 = genFieldValue(e, e.ast.nodes[node].a,
                                    e.ast.nodes[node].text);
    return genCallWith(e, node, callee, e.ast.nodes[node].b, "", "");
  }

  let mode: ReceiverMode = e.an.receivers[node];
  if (mode == ReceiverMode.None) {
    return genCallWith(e, node, direct(e, node), e.ast.nodes[node].b, "", "");
  }

  let object: i32 = e.ast.nodes[node].a;
  let objectType: Type = typeOfNode(e, object);

  if (mode == ReceiverMode.Address) {
    return genCallWith(e, node, direct(e, node), e.ast.nodes[node].b, "ptr",
                       genAddress(e, object));
  }

  if (mode == ReceiverMode.Load) {
    let structType: Type = objectType.base();
    let value: *i8 = emitLoad(e, structType, genStructPointer(e, object));
    return genCallWith(e, node, direct(e, node), e.ast.nodes[node].b,
                       llvmTypeName(structType), value);
  }

  if (objectType.isPointer()) {
    return genCallWith(e, node, direct(e, node), e.ast.nodes[node].b, "ptr",
                       genStructPointer(e, object));
  }

  return genCallWith(e, node, direct(e, node), e.ast.nodes[node].b, llvmTypeName(objectType),
                     genExpr(e, object));
}

// The type C's default argument promotions turn `type` into.
fn promotedType(type: Type): Type {
  if (type.isBool() || type.isEnum() ||
      (type.isInteger() && type.bitWidth() < 32)) {
    return Type.make(TypeKind.I32, 0);
  }
  if (type.kind == TypeKind.F32 && !type.isPointer()) {
    return Type.make(TypeKind.F64, 0);
  }
  return type;
}

// Writes the call `node` resolved to, passing `args`, preceded by `first` of
// type `firstType` when that is not empty.
fn genCallWith(e: *Emitter, node: i32, callee: *i8, args: i32,
               firstType: *i8, first: *i8): *i8 {
  let returnType: Type = typeOfNode(e, node);

  let argCount: i32 = 0;
  if (args != NO_NODE) {
    argCount = e.ast.nodes[args].itemCount;
  }

  // Every argument is evaluated before the call is written, because each one
  // may emit instructions of its own.
  let values: **i8 = alloc<*i8>((argCount + 1) as i64);
  let types: *Type = alloc<Type>((argCount + 1) as i64);
  let named: i32 = e.an.variadicAfter[node] - 1;
  for (index in 0..argCount) {
    let argument: i32 = e.ast.nodes[args].items[index];
    values[index] = genExpr(e, argument);
    types[index] = resultTypeOf(e, argument);

    // What goes through `...` is promoted the way C promotes it: anything
    // narrower than an int widens to i32, and an f32 to a double.
    if (named >= 0 && index >= named) {
      let promoted: Type = promotedType(types[index]);
      values[index] = emitCast(e, values[index], types[index], promoted);
      types[index] = promoted;
    }
  }

  let line: *Builder = Builder.new();
  line.add("call ");
  line.add(llvmTypeName(returnType));
  line.push(' ');
  // A variadic callee is called with its own type spelled out, which is how
  // LLVM tells the named arguments from the rest.
  if (named >= 0) {
    line.push('(');
    for (index in 0..named) {
      if (index > 0) {
        line.add(", ");
      }
      line.add(llvmTypeName(types[index]));
    }
    if (named > 0) {
      line.add(", ");
    }
    line.add("...) ");
  }
  line.add(callee);
  line.push('(');

  let hasFirst: bool = strlen(firstType) > 0;
  if (hasFirst) {
    line.add(firstType);
    line.push(' ');
    line.add(first);
  }

  for (index in 0..argCount) {
    if (index > 0 || hasFirst) {
      line.add(", ");
    }
    line.add(llvmTypeName(types[index]));
    line.push(' ');
    line.add(values[index]);
  }
  line.push(')');

  // A void call has no value to name.
  if (returnType.isVoid()) {
    emitLine(e, line.data);
    return "";
  }

  return emitAssign(e, line.data);
}

fn genStructLiteral(e: *Emitter, node: i32): *i8 {
  let name: *i8 = e.ast.nodes[node].text;
  let type: Type = Type.ofStruct(name, 0);
  let structIndex: i32 = e.an.structs.indexOf(name);
  let typeName: *i8 = llvmTypeName(type);

  // Built up field by field from `undef`, which needs no storage.
  let current: *i8 = "undef";
  let index: i32 = 0;

  while (index < e.ast.nodes[node].itemCount) {
    let init: i32 = e.ast.nodes[node].items[index];
    let fieldIndex: i32 =
        e.an.structs.fieldIndex(structIndex, e.ast.nodes[init].text);
    let fieldType: Type =
        e.an.structs.items[structIndex].fields[fieldIndex].type;
    let value: *i8 = genExpr(e, e.ast.nodes[init].a);

    let line: *Builder = Builder.new();
    line.add("insertvalue ");
    line.add(typeName);
    line.push(' ');
    line.add(current);
    line.add(", ");
    line.add(llvmTypeName(fieldType));
    line.push(' ');
    line.add(value);
    line.add(", ");
    line.addInt(fieldIndex as i64);

    current = emitAssign(e, line.data);
    index = index + 1;
  }

  return current;
}

// A float literal is written in LLVM's hexadecimal form only when it has to
// be; plain decimal text round-trips for everything the language can express.
export fn genNumberLiteral(e: *Emitter, node: i32): *i8 {
  let type: Type = typeOfNode(e, node);
  let text: *i8 = e.ast.nodes[node].text;

  if (type.isFloat()) {
    // LLVM wants a decimal point in a floating literal.
    if (!textHasDot(text, strlen(text))) {
      let out: *Builder = Builder.new();
      out.add(text);
      out.add(".0");
      return out.take();
    }
    return text;
  }

  return text;
}

// A character is its byte's value, 0 to 255 -- except in an i8, which is
// signed, where a byte above 127 is written as its negative form.
export fn genCharLiteral(e: *Emitter, node: i32): *i8 {
  let value: i32 = e.ast.nodes[node].text[0] as i32;
  if (value < 0) {
    value = value + 256;
  }
  if (value > 127 && typeOfNode(e, node).kind == TypeKind.I8) {
    value = value - 256;
  }
  return fromInt(value as i64);
}

// The type of what genExpr gives for `node`: its own, or the union it is
// turned into where it is used.
export fn resultTypeOf(e: *Emitter, node: i32): Type {
  if (e.an.coerceTo[node].kind != TypeKind.None) {
    return e.an.coerceTo[node];
  }
  return typeOfNode(e, node);
}

export fn genExpr(e: *Emitter, node: i32): *i8 {
  let value: *i8 = genValue(e, node);
  if (e.an.coerceTo[node].kind != TypeKind.None) {
    return wrapInUnion(e, value, typeOfNode(e, node), e.an.coerceTo[node]);
  }
  return value;
}

fn genValue(e: *Emitter, node: i32): *i8 {
  let kind: NodeKind = e.ast.nodes[node].kind;

  if (kind == NodeKind.Match) {
    return genMatchValue(e, node);
  }
  if (!(e.ast.nodes[node].syntax is Unmoved)) {
    return genSyntax(e, node);
  }

  if (kind == NodeKind.Number) { return genNumberLiteral(e, node); }

  if (kind == NodeKind.Bool) {
    if (equals(e.ast.nodes[node].text, "true")) {
      return "true";
    }
    return "false";
  }

  if (kind == NodeKind.Char) {
    return genCharLiteral(e, node);
  }

  if (kind == NodeKind.Null) {
    return "null";
  }

  if (kind == NodeKind.String) {
    return internString(e, e.ast.nodes[node].text,
                        e.ast.nodes[node].textLength);
  }

  // A function's name used as a value is the function's address.
  if (kind == NodeKind.Ident && e.an.functionRefs[node] != 0) {
    return direct(e, node);
  }
  if (kind == NodeKind.Lambda) {
    return lambdaValue(e, node);
  }

  if (kind == NodeKind.Ident) {
    return genVariable(e, node);
  }

  match (kind) {
    .Call => { return genCall(e, node); }
    .MethodCall => { return genMethodCall(e, node); }
    .CallValue => { return genCallValue(e, node); }
    .StructLit => { return genStructLiteral(e, node); }
    else => {}
  }

  // `Color.Red` is a constant the analyzer already worked out.
  if (kind == NodeKind.FieldAccess && e.an.isConstant[node] != 0) {
    return fromInt(e.an.values[node]);
  }

  // A union field narrowed by `is` or `match` is read whole, as declared,
  // and the member it holds taken out of it.
  if (kind == NodeKind.FieldAccess) {
    let value: *i8 = genFieldValue(e, e.ast.nodes[node].a, e.ast.nodes[node].text);
    if (e.an.narrowedFrom[node].kind != TypeKind.None) {
      return convertUnion(e, value, e.an.narrowedFrom[node], typeOfNode(e, node));
    }
    return value;
  }

  codegenFault(e, node, "unsupported expression in code generation");
  return null;
}

// An expression whose kind has syntax of its own, by what it is.
fn genSyntax(e: *Emitter, node: i32): *i8 {
  let syntax: Syntax = e.ast.nodes[node].syntax;
  return match (syntax) {
    Binary => genBinary(e, node, syntax),
    Unary => genUnary(e, node, syntax),
    Cast => emitCast(e, genExpr(e, syntax.value), typeOfNode(e, syntax.value),
                     typeOfNode(e, node)),
    Sizeof => fromInt(sizeOf(e.an.structs, analyzerParseType(e.an, syntax.type)) as i64),
    Index => emitLoad(e, typeOfNode(e, node), genIndexAddress(e, syntax)),
    Try => genTry(e, syntax),
    Catch => genCatch(e, syntax),
    Is => genIs(e, syntax),
    Unmoved => {
      codegenFault(e, node, "an expression without syntax");
      return null;
    }
  };
}
