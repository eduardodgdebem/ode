// ---------------------------------------------------------------------------
// Emitting unions; see check/errors.ode for the language side.
//
// A union is `{ i32 code, value }`: code 0 when it holds its value, and the
// error's number otherwise. One that may hold values of several types is
// `{ i32 code, [n x i64] }` instead, its value kept in words enough for the
// largest of them, and its code below zero for a value -- each type has its
// own, see valueTag -- and an error's number above. Either way a code above
// zero is an error, which is all `try`, `catch` and `??` ask.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Builder, equals, fromInt } from "std/text";
import { analyzerParseType } from "../check/analyzer";
import {
  unionInfo, valueOf, valuesOf, errorCodeRange, holdsError, holdsSeveral,
  memberFor, valueTag, holdsValue,
} from "../check/errors";
import {
  Emitter, freshLabel, emitAlloca, emitLine, emitLabel, emitBranch,
  emitCondBranch, emitterEnterScope, emitterExitScope, declareLocal,
  localTypeOf, variableAddress,
} from "./emitter";
import {
  typeOfNode, emitAssign, emitLoad, emitStore, genExpr,
} from "./expressions";
import { llvmTypeName } from "./layout";
import { genStatement, runDefers } from "./statements";
import { line } from "../driver/options";
import { Binary, Try, Is, Catch } from "../syntax/ast";
import { payloadWords } from "../types/layout";
import { TypeKind, Type } from "../types/types";

// `value`, of type `from`, as the union `union`: an error becomes the code
// it is, a value the value with its code, and a narrower union this one.
export fn wrapInUnion(e: *Emitter, value: *i8, from: Type, union: Type): *i8 {
  return convertUnion(e, value, from, union);
}

// `value`, of type `from`, as a `to`, where one is a union and the other one
// of its members or a union of some of them: widening a value into a union,
// or narrowing one to what `is` found it to hold.
export fn convertUnion(e: *Emitter, value: *i8, from: Type, to: Type): *i8 {
  if (from.equals(to)) {
    return value;
  }

  if (to.isUnion()) {
    if (from.isEnum() && holdsError(to, from.structName)) {
      let line: *Builder = Builder.new();
      line.add("insertvalue ");
      line.add(llvmTypeName(to));
      line.add(" zeroinitializer, i32 ");
      line.add(value);
      line.add(", 0");
      return emitAssign(e, line.data);
    }
    if (!from.isUnion()) {
      let member: Type = memberFor(to, from);
      if (!holdsSeveral(to)) {
        let line: *Builder = Builder.new();
        line.add("insertvalue ");
        line.add(llvmTypeName(to));
        line.add(" zeroinitializer, ");
        line.add(llvmTypeName(member));
        line.push(' ');
        line.add(value);
        line.add(", 1");
        return emitAssign(e, line.data);
      }
      let slot: *i8 = emitAlloca(e, llvmTypeName(to));
      emitStore(e, Type.make(TypeKind.I32, 0), fromInt(valueTag(member)),
                part(e, to, slot, 0));
      emitStore(e, member, value, part(e, to, slot, 1));
      return emitLoad(e, to, slot);
    }
    if (holdsSeveral(from) == holdsSeveral(to) &&
        equals(llvmTypeName(from), llvmTypeName(to))) {
      return value;
    }
    return reshape(e, value, from, to);
  }

  // Narrowing a union to one of its members.
  if (to.isEnum() && holdsError(from, to.structName)) {
    return extract(e, from, value, 0);
  }
  if (!holdsSeveral(from)) {
    return extract(e, from, value, 1);
  }
  let slot: *i8 = emitAlloca(e, llvmTypeName(from));
  emitStore(e, from, value, slot);
  return emitLoad(e, to, part(e, from, slot, 1));
}

// One union as another of a different shape: its code, renumbered between
// the 0 of a union of one value and the value's own code in a union of
// several, and its value moved over.
fn reshape(e: *Emitter, value: *i8, from: Type, to: Type): *i8 {
  let code: *i8 = extract(e, from, value, 0);
  let fromValues: *List<Type> = valuesOf(from);
  let toValues: *List<Type> = valuesOf(to);
  if (!holdsSeveral(from) && holdsSeveral(to) && fromValues.count == 1) {
    code = pick(e, compare(e, "eq", "i32", code, "0"),
                fromInt(valueTag(fromValues.at(0))), code);
  }
  if (holdsSeveral(from) && !holdsSeveral(to) && toValues.count == 1) {
    code = pick(e, compare(e, "eq", "i32", code, fromInt(valueTag(toValues.at(0)))),
                "0", code);
  }

  let slot: *i8 = emitAlloca(e, llvmTypeName(to));
  emitStore(e, Type.make(TypeKind.I32, 0), code, part(e, to, slot, 0));
  if (toValues.count == 0 || fromValues.count == 0 || fromValues.at(0).isVoid()) {
    return emitLoad(e, to, slot);
  }

  if (!holdsSeveral(from)) {
    emitStore(e, fromValues.at(0), extract(e, from, value, 1), part(e, to, slot, 1));
    return emitLoad(e, to, slot);
  }

  let source: *i8 = emitAlloca(e, llvmTypeName(from));
  emitStore(e, from, value, source);
  if (!holdsSeveral(to)) {
    let moved: *i8 = emitLoad(e, toValues.at(0), part(e, from, source, 1));
    emitStore(e, toValues.at(0), moved, part(e, to, slot, 1));
    return emitLoad(e, to, slot);
  }
  // Both keep words: the narrower has fewer, and they are what it holds.
  let count: i32 = payloadWords(from);
  if (payloadWords(to) < count) {
    count = payloadWords(to);
  }
  let array: *Builder = Builder.new();
  array.push('[');
  array.addInt(count as i64);
  array.add(" x i64]");
  let load: *Builder = Builder.new();
  load.add("load ");
  load.add(array.data);
  load.add(", ptr ");
  load.add(part(e, from, source, 1));
  let moved: *i8 = emitAssign(e, load.data);
  let store: *Builder = Builder.new();
  store.add("store ");
  store.add(array.data);
  store.push(' ');
  store.add(moved);
  store.add(", ptr ");
  store.add(part(e, to, slot, 1));
  emitLine(e, store.data);
  return emitLoad(e, to, slot);
}

// The address of part `index` of the union at `slot`: 0 its code, 1 its
// value.
fn part(e: *Emitter, union: Type, slot: *i8, index: i32): *i8 {
  let line: *Builder = Builder.new();
  line.add("getelementptr inbounds ");
  line.add(llvmTypeName(union));
  line.add(", ptr ");
  line.add(slot);
  line.add(", i32 0, i32 ");
  line.addInt(index as i64);
  return emitAssign(e, line.data);
}

fn pick(e: *Emitter, condition: *i8, ifTrue: *i8, ifFalse: *i8): *i8 {
  let line: *Builder = Builder.new();
  line.add("select i1 ");
  line.add(condition);
  line.add(", i32 ");
  line.add(ifTrue);
  line.add(", i32 ");
  line.add(ifFalse);
  return emitAssign(e, line.data);
}

// A union's code: 0 or below for a value, an error's number above.
export fn unionCode(e: *Emitter, union: Type, value: *i8): *i8 {
  return extract(e, union, value, 0);
}

fn extract(e: *Emitter, union: Type, value: *i8, index: i32): *i8 {
  let line: *Builder = Builder.new();
  line.add("extractvalue ");
  line.add(llvmTypeName(union));
  line.push(' ');
  line.add(value);
  line.add(", ");
  line.addInt(index as i64);
  return emitAssign(e, line.data);
}

export fn compare(e: *Emitter, predicate: *i8, type: *i8, left: *i8, right: *i8): *i8 {
  let line: *Builder = Builder.new();
  line.add("icmp ");
  line.add(predicate);
  line.push(' ');
  line.add(type);
  line.push(' ');
  line.add(left);
  line.add(", ");
  line.add(right);
  return emitAssign(e, line.data);
}

// A variable's value. One narrowed by `is` is stored as its declared union,
// so the part it is known to hold is read out of it.
export fn genVariable(e: *Emitter, node: i32): *i8 {
  let type: Type = typeOfNode(e, node);
  let declared: Type = localTypeOf(e, node);
  let address: *i8 = variableAddress(e, node);

  if (!declared.isUnion() || declared.equals(type)) {
    return emitLoad(e, type, address);
  }

  return convertUnion(e, emitLoad(e, declared, address), declared, type);
}

// Where a variable is kept, as what it is known to hold: a union narrowed by
// `is` to one of its values keeps that value in its second part, so
// `shape.radius`, with `shape is Circle`, is read from there. One narrowed to
// an error is its code.
export fn narrowedAddress(e: *Emitter, node: i32): *i8 {
  return memberAddress(e, localTypeOf(e, node), typeOfNode(e, node),
                       variableAddress(e, node));
}

// Where in a union of type `declared`, kept at `address`, the member `type`
// that narrowing found it holds is: its code for an error, its value
// otherwise. A narrower union is kept as the union, at the union's address.
export fn memberAddress(e: *Emitter, declared: Type, type: Type, address: *i8): *i8 {
  if (!declared.isUnion() || declared.equals(type) || type.isUnion()) {
    return address;
  }
  if (type.isEnum() && holdsError(declared, type.structName)) {
    return part(e, declared, address, 0);
  }
  return part(e, declared, address, 1);
}

// `try value`: the value, or a return of its error.
export fn genTry(e: *Emitter, attempt: Try): *i8 {
  let operand: i32 = attempt.value;
  let union: Type = typeOfNode(e, operand);
  let value: *i8 = genExpr(e, operand);
  let code: *i8 = extract(e, union, value, 0);

  let failed: *i8 = freshLabel(e);
  let ok: *i8 = freshLabel(e);
  emitCondBranch(e, compare(e, "sgt", "i32", code, "0"), failed, ok);

  // The function's own union holds the same error, by the same number.
  emitLabel(e, failed);
  let line: *Builder = Builder.new();
  line.add("insertvalue ");
  line.add(llvmTypeName(e.returnType));
  line.add(" zeroinitializer, i32 ");
  line.add(code);
  line.add(", 0");
  let returned: *i8 = emitAssign(e, line.data);
  runDefers(e, 0);
  let ret: *Builder = Builder.new();
  ret.add("ret ");
  ret.add(llvmTypeName(e.returnType));
  ret.push(' ');
  ret.add(returned);
  emitLine(e, ret.data);
  e.terminated = true;

  emitLabel(e, ok);
  if (valueOf(union).isVoid()) {
    return "";
  }
  return convertUnion(e, value, union, valueOf(union));
}

// `value ?? fallback`: the fallback only runs when the value is an error,
// `none`, or a null pointer.
export fn genCoalesce(e: *Emitter, node: i32, coalesce: Binary): *i8 {
  let left: i32 = coalesce.left;
  let leftType: Type = typeOfNode(e, left);
  let result: Type = typeOfNode(e, node);
  let slot: *i8 = emitAlloca(e, llvmTypeName(result));

  let value: *i8 = genExpr(e, left);
  let present: *i8 = "";
  if (leftType.isUnion() && holdsValue(leftType, Type.none())) {
    // A value, and not the one that is `none`.
    let code: *i8 = extract(e, leftType, value, 0);
    let both: *Builder = Builder.new();
    both.add("and i1 ");
    both.add(compare(e, "sle", "i32", code, "0"));
    both.add(", ");
    both.add(compare(e, "ne", "i32", code, fromInt(valueTag(Type.none()))));
    present = emitAssign(e, both.data);
  } else if (leftType.isUnion()) {
    present = compare(e, "sle", "i32", extract(e, leftType, value, 0), "0");
  } else {
    present = compare(e, "ne", "ptr", value, "null");
  }

  let has: *i8 = freshLabel(e);
  let fallback: *i8 = freshLabel(e);
  let done: *i8 = freshLabel(e);
  emitCondBranch(e, present, has, fallback);

  emitLabel(e, has);
  if (leftType.isUnion()) {
    emitStore(e, result, convertUnion(e, value, leftType, result), slot);
  } else {
    emitStore(e, result, value, slot);
  }
  emitBranch(e, done);

  emitLabel(e, fallback);
  emitStore(e, result, genExpr(e, coalesce.right), slot);
  emitBranch(e, done);

  emitLabel(e, done);
  return emitLoad(e, result, slot);
}

// `value catch (name) { ... }`: the value, or the block run with the error
// bound to `name`. The block always leaves, so nothing follows it.
export fn genCatch(e: *Emitter, caught: Catch): *i8 {
  let operand: i32 = caught.value;
  let union: Type = typeOfNode(e, operand);
  let value: *i8 = genExpr(e, operand);
  let code: *i8 = extract(e, union, value, 0);

  let failed: *i8 = freshLabel(e);
  let ok: *i8 = freshLabel(e);
  emitCondBranch(e, compare(e, "sgt", "i32", code, "0"), failed, ok);

  emitLabel(e, failed);
  let slot: *i8 = emitAlloca(e, "i32");
  let errorType: Type = Type.ofEnum(unionInfo(union).errors.at(0), 0);
  emitStore(e, errorType, code, slot);
  emitterEnterScope(e);
  declareLocal(e, caught.name, slot, errorType);
  genStatement(e, caught.block);
  emitterExitScope(e);
  // Checking made sure the block leaves; whatever block its last statement
  // opened after itself is never reached.
  if (!e.terminated) {
    emitLine(e, "unreachable");
    e.terminated = true;
  }

  emitLabel(e, ok);
  if (valueOf(union).isVoid()) {
    return "";
  }
  return convertUnion(e, value, union, valueOf(union));
}

// `value is SomeError`: whether the code is one of that enum's numbers,
// which are given to its errors in order. `shape is Circle`: whether it is
// Circle's code -- or, in a union of one value, whether it is no error.
export fn genIs(e: *Emitter, question: Is): *i8 {
  let operand: i32 = question.value;
  let union: Type = typeOfNode(e, operand);
  let code: *i8 = extract(e, union, genExpr(e, operand), 0);
  return holdsTest(e, union, code, analyzerParseType(e.an, question.type));
}

// Whether a union whose code is `code` holds `asked`: one of its value
// types, or an error enum.
export fn holdsTest(e: *Emitter, union: Type, code: *i8, asked: Type): *i8 {
  if (!asked.isEnum() || !holdsError(union, asked.structName)) {
    if (holdsSeveral(union)) {
      return compare(e, "eq", "i32", code, fromInt(valueTag(asked)));
    }
    return compare(e, "sle", "i32", code, "0");
  }

  let first: i64 = 0;
  let last: i64 = 0;
  errorCodeRange(e.an, asked.structName, &first, &last);

  let low: *i8 = compare(e, "sge", "i32", code, fromInt(first));
  let high: *i8 = compare(e, "sle", "i32", code, fromInt(last));
  let both: *Builder = Builder.new();
  both.add("and i1 ");
  both.add(low);
  both.add(", ");
  both.add(high);
  return emitAssign(e, both.data);
}
