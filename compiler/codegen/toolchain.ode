// ---------------------------------------------------------------------------
// The C toolchain: what assembles and links the IR this compiler writes.
//
// The compiler is `clang` unless ODE_CC names another. On macOS it is also
// told which SDK to build against, because a clang that is not Apple's may
// have no idea: Homebrew's reads the SDK path out of per-OS-version config
// files, and on an OS newer than the SDKs installed that path points nowhere
// and nothing links. SDKROOT says which SDK when it is set; otherwise xcrun
// is asked, the way Apple's own tools find it. Passing it as `-isysroot`
// matters, because a non-Apple clang ignores SDKROOT entirely.
//
// That SDK is macOS's, so it is used only when building for macOS. A Linux
// target links against the musl Ode bundles (libc.ode), or against the
// sysroot --sysroot names; either way from a Mac it links with lld, since
// Apple's linker writes only Mach-O, and against musl always, since a
// Linux linker may know only its own machine.
// ---------------------------------------------------------------------------

import { exists } from "std/fs";
import { alloc } from "std/mem";
import { List } from "std/list";
import { Builder } from "std/text";
import {
  TextList, StderrMode, runCommand, ran, environment, setEnvironment, command,
} from "../os/process";
import { isSpace } from "../syntax/lexer";
import { TARGET, targetsDarwin, targetsWasm } from "./target";

// Whether this run optimises what it assembles: --release.
export let RELEASE: bool = false;

let SYSROOT_PROBED: bool = false;
let SYSROOT: *i8 = null;

export fn ccProgram(): *i8 {
  let chosen: *i8 = environment("ODE_CC");
  if (chosen == null) {
    return "clang";
  }

  return chosen;
}

// What --sysroot named, in place of the SDK that would be looked for.
export fn chooseSysroot(path: *i8): void {
  SYSROOT_PROBED = true;
  SYSROOT = path;
}

// The SDK or sysroot to build against, or null when there is none to give.
// Asked for once per run.
export fn sysroot(): *i8 {
  if (SYSROOT_PROBED) {
    return SYSROOT;
  }
  SYSROOT_PROBED = true;
  if (!targetsDarwin()) {
    return null;
  }
  SYSROOT = environment("SDKROOT");

  if (SYSROOT == null && isMacHost()) {
    let output: *Builder = Builder.new();
    let command: *TextList = TextList.new().add("xcrun").add("--show-sdk-path");
    if (ran(runCommand(command, null, output, StderrMode.Discard))) {
      // The path comes back with a newline after it.
      while (output.length > 0 &&
             isSpace(output.data[output.length - 1])) {
        output.length = output.length - 1;
      }
      output.data[output.length] = 0;
      if (output.length > 0) {
        SYSROOT = output.take();
      }
    }
  }

  return SYSROOT;
}

fn isMacHost(): bool {
  return exists("/usr/bin/xcrun");
}

// The start of a command line that runs the C compiler: the compiler itself,
// the target when one was chosen, and the SDK or sysroot when there is one.
// The caller adds the rest.
export fn ccCommand(): *TextList {
  let command: *TextList = TextList.new().add(ccProgram());

  if (TARGET != null) {
    command.add("-target").add(TARGET.triple());
  }

  let root: *i8 = sysroot();
  if (root != null && targetsDarwin()) {
    command.add("-isysroot").add(root);
  } else if (root != null) {
    command.add("--sysroot").add(root);
  }
  return command;
}

// The same, for the run that links.
export fn linkCommand(): *TextList {
  let command: *TextList = ccCommand();
  if (!targetsDarwin() && !targetsWasm() && (isMacHost() || usesBundledLibc())) {
    command.add("-fuse-ld=lld");
  }
  return command;
}

// Whether the program links against the musl Ode bundles: a musl target that
// was given no sysroot of its own.
export fn usesBundledLibc(): bool {
  return TARGET != null && TARGET.isMusl() && sysroot() == null;
}

// Whether linking is for a target that has none of its libraries here: a
// glibc one that was given no sysroot.
export fn linksWithoutLibraries(): bool {
  return !targetsDarwin() && sysroot() == null && !usesBundledLibc() &&
         !targetsWasm();
}

// What a program is linked against besides libc: -l, -L and -framework.
export struct LinkInputs {
  libraries: *List<*i8>,
  paths: *List<*i8>,
  frameworks: *List<*i8>,
  // What a wasm module exports, by IR name.
  exports: *List<*i8>,

  fn new(): *LinkInputs {
    let inputs: *LinkInputs = alloc<LinkInputs>(1);
    inputs.libraries = List<*i8>.new();
    inputs.paths = List<*i8>.new();
    inputs.frameworks = List<*i8>.new();
    inputs.exports = List<*i8>.new();
    return inputs;
  }

  // Paths first, so that a library is looked for in them.
  fn addTo(self: *LinkInputs, command: *TextList): void {
    for (index in 0..self.paths.count) {
      command.add("-L").add(self.paths.at(index));
    }
    for (index in 0..self.libraries.count) {
      command.add("-l").add(self.libraries.at(index));
    }
    for (index in 0..self.frameworks.count) {
      command.add("-framework").add(self.frameworks.at(index));
    }
  }
}

// For a run that starts many compiles, such as the test suite: the SDK is
// found once here and handed to every child through SDKROOT, so that none of
// them has to ask xcrun again.
export fn shareSysroot(): void {
  let sdk: *i8 = sysroot();
  if (sdk != null) {
    setEnvironment("SDKROOT", sdk);
  }
}
