// ---------------------------------------------------------------------------
// The C toolchain: what assembles and links the IR this compiler writes.
//
// The compiler is `clang` unless ODE_CC names another. On macOS it is also
// told which SDK to build against, because a clang that is not Apple's may
// have no idea: Homebrew's reads the SDK path out of per-OS-version config
// files, and on an OS newer than the SDKs installed that path points nowhere
// and nothing links. SDKROOT says which SDK when it is set; otherwise xcrun
// is asked, the way Apple's own tools find it. Passing it as `-isysroot`
// matters, because a non-Apple clang ignores SDKROOT entirely.
// ---------------------------------------------------------------------------

import { Builder } from "std/text";
import {
  TextList, StderrMode, runCommand, environment, setEnvironment, fileExists,
} from "../support/system";
import { isSpace } from "../syntax/lexer";

let SYSROOT_PROBED: bool = false;
let SYSROOT: *i8 = null;

export fn ccProgram(): *i8 {
  let chosen: *i8 = environment("ODE_CC");
  if (chosen == null) {
    return "clang";
  }

  return chosen;
}

// The SDK to build against, or null on a platform that has none. Asked for
// once per run.
export fn sysroot(): *i8 {
  if (SYSROOT_PROBED) {
    return SYSROOT;
  }
  SYSROOT_PROBED = true;
  SYSROOT = environment("SDKROOT");

  if (SYSROOT == null && fileExists("/usr/bin/xcrun")) {
    let output: *Builder = Builder.new();
    let command: *TextList = TextList.new().add("xcrun").add("--show-sdk-path");
    if (runCommand(command, null, output, StderrMode.Discard) == 0) {
      // The path comes back with a newline after it.
      while (output.length > 0 &&
             isSpace(output.data[output.length - 1])) {
        output.length = output.length - 1;
      }
      output.data[output.length] = 0;
      if (output.length > 0) {
        SYSROOT = output.take();
      }
    }
  }

  return SYSROOT;
}

// The start of a command line that runs the C compiler: the compiler itself,
// and the SDK when there is one. The caller adds the rest.
export fn ccCommand(): *TextList {
  let command: *TextList = TextList.new().add(ccProgram());

  let sdk: *i8 = sysroot();
  if (sdk != null) {
    command.add("-isysroot").add(sdk);
  }

  return command;
}

// For a run that starts many compiles, such as the test suite: the SDK is
// found once here and handed to every child through SDKROOT, so that none of
// them has to ask xcrun again.
export fn shareSysroot(): void {
  let sdk: *i8 = sysroot();
  if (sdk != null) {
    setEnvironment("SDKROOT", sdk);
  }
}
