// ---------------------------------------------------------------------------
// Emitting statements.
//
// Locals live in allocas, and `if` and `while` become explicit branches between
// labelled blocks. A block that has already ended -- in a `return`, `break` or
// `continue` -- gets a fresh label before anything after it, so unreachable
// code still forms valid IR.
// ---------------------------------------------------------------------------

import { alloc } from "std/mem";
import { Builder, fromInt } from "std/text";
import { before, analyzerParseType } from "../check/analyzer";
import {
  Emitter, freshLabel, emitAlloca, emitLine, emitLabel, emitBranch,
  emitCondBranch, emitterEnterScope, emitterExitScope, declareLocal,
  codegenFault,
} from "./emitter";
import { compare, holdsTest, unionCode } from "./errors";
import { instruction } from "./testing";
import {
  typeOfNode, emitAssign, emitLoad, emitStore, genAddress, resultTypeOf,
  genExpr,
} from "./expressions";
import { llvmTypeName } from "./layout";
import { line } from "../driver/options";
import {
  NO_NODE, NodeKind, Assign, Block, Break, Continue, EnumDecl, ExprStmt, Extern, For,
  If, Match, Return, StructDecl, Syntax, TypeAlias, VarDecl, While, armOf, itemAt,
  itemCount, matchOf,
} from "../syntax/ast";
import { Type } from "../types/types";

export fn genStatement(e: *Emitter, node: i32): void {
  let syntax: Syntax = e.ast.nodes[node].syntax;
  match (syntax) {
    // A struct declaration produced its type up front, an enum and an alias
    // need nothing, and a nested function declaration is not reachable here.
    StructDecl, Extern, EnumDecl, TypeAlias => {}
    Match => genMatch(e, node),
    Block => {
      emitterEnterScope(e);
      for (index in 0..syntax.items.count) {
        genStatement(e, syntax.items.at(index));
      }
      emitterExitScope(e);
    }
    VarDecl => {
      let type: Type = analyzerParseType(e.an, syntax.type);
      let value: *i8 = genExpr(e, syntax.value);

      let slot: *i8 = emitAlloca(e, llvmTypeName(type));

      emitStore(e, type, value, slot);
      // Bound after the initialiser, so `let x = x + 1;` reads the outer x.
      declareLocal(e, syntax.name, slot, type);
    }
    Assign => {
      let type: Type = typeOfNode(e, syntax.target);
      let value: *i8 = genExpr(e, syntax.value);
      emitStore(e, type, value, genAddress(e, syntax.target));
    }
    ExprStmt => genExpr(e, syntax.value),
    Return => genReturn(e, syntax),
    If => genIf(e, syntax),
    While => genWhile(e, syntax),
    For => genFor(e, node, syntax),
    Break => {
      emitBranch(e, e.loopBreak.last());
      // Anything written after this needs a block of its own to live in.
      emitLabel(e, freshLabel(e));
    }
    Continue => {
      emitBranch(e, e.loopContinue.last());
      emitLabel(e, freshLabel(e));
    }
    else => codegenFault(e, node, "unsupported statement in code generation"),
  }
}

fn genReturn(e: *Emitter, statement: Return): void {
  if (statement.value == NO_NODE && e.returnType.isUnion()) {
    let line: *Builder = Builder.new();
    line.add("ret ");
    line.add(llvmTypeName(e.returnType));
    line.add(" zeroinitializer");
    emitLine(e, line.data);
  } else if (statement.value == NO_NODE) {
    emitLine(e, "ret void");
  } else {
    let type: Type = resultTypeOf(e, statement.value);
    let value: *i8 = genExpr(e, statement.value);

    let line: *Builder = Builder.new();
    line.add("ret ");
    line.add(llvmTypeName(type));
    line.push(' ');
    line.add(value);
    emitLine(e, line.data);
  }
  e.terminated = true;
}

fn genIf(e: *Emitter, branch: If): void {
  let condition: *i8 = genExpr(e, branch.condition);
  let thenLabel: *i8 = freshLabel(e);
  let elseLabel: *i8 = freshLabel(e);
  let doneLabel: *i8 = freshLabel(e);

  if (branch.otherwise == NO_NODE) {
    emitCondBranch(e, condition, thenLabel, doneLabel);
  } else {
    emitCondBranch(e, condition, thenLabel, elseLabel);
  }

  emitLabel(e, thenLabel);
  genStatement(e, branch.then);
  emitBranch(e, doneLabel);

  if (branch.otherwise != NO_NODE) {
    emitLabel(e, elseLabel);
    genStatement(e, branch.otherwise);
    emitBranch(e, doneLabel);
  }

  emitLabel(e, doneLabel);
}

fn genWhile(e: *Emitter, loop: While): void {
  let condLabel: *i8 = freshLabel(e);
  let bodyLabel: *i8 = freshLabel(e);
  let doneLabel: *i8 = freshLabel(e);

  emitBranch(e, condLabel);
  emitLabel(e, condLabel);
  let condition: *i8 = genExpr(e, loop.condition);
  emitCondBranch(e, condition, bodyLabel, doneLabel);

  enterLoop(e, condLabel, doneLabel);
  emitLabel(e, bodyLabel);
  genStatement(e, loop.body);
  emitBranch(e, condLabel);
  leaveLoop(e);

  emitLabel(e, doneLabel);
}

// A pattern's value as LLVM spells it for an integer of `bits` bits: in the
// signed range, so that `255` matched against a u8 is written as -1.
fn switchConstant(value: i64, bits: i32): *i8 {
  if (bits >= 64) {
    return fromInt(value);
  }

  let span: i64 = 1 << bits as i64;
  let wrapped: i64 = value % span;
  if (wrapped < 0) {
    wrapped = wrapped + span;
  }
  if (wrapped >= span / 2) {
    wrapped = wrapped - span;
  }

  return fromInt(wrapped);
}

// A match is LLVM's `switch`: one comparison table, a block per arm, and the
// `else` arm -- or, for an enum match that handles every member, the end --
// as the default.
fn genMatch(e: *Emitter, node: i32): void {
  genMatchInto(e, node, null);
}

// A match used as a value: each arm that gives one stores it in a slot of
// its own, read once the arms meet again.
export fn genMatchValue(e: *Emitter, node: i32): *i8 {
  let type: Type = typeOfNode(e, node);
  if (type.isVoid()) {
    genMatchInto(e, node, null);
    return "";
  }
  let slot: *i8 = emitAlloca(e, llvmTypeName(type));
  genMatchInto(e, node, slot);
  return emitLoad(e, type, slot);
}

// What an arm runs: its block, or -- in a match used as a value -- its
// value, stored in `slot`.
fn genArmBody(e: *Emitter, node: i32, arm: i32, slot: *i8): void {
  let body: i32 = armOf(e.ast, arm).body;
  if (slot == null || e.ast.nodes[body].kind == NodeKind.Block) {
    genStatement(e, body);
    return;
  }
  emitStore(e, typeOfNode(e, node), genExpr(e, body), slot);
}

fn genMatchInto(e: *Emitter, node: i32, slot: *i8): void {
  let subject: i32 = matchOf(e.ast, node).subject;
  let type: Type = typeOfNode(e, subject);
  if (e.an.isConstant[subject] != 0) {
    genChosenArm(e, node, e.an.values[subject], slot);
    return;
  }
  if (type.isUnion()) {
    genUnionMatch(e, node, type, slot);
    return;
  }
  let typeName: *i8 = llvmTypeName(type);
  let value: *i8 = genExpr(e, subject);

  let done: *i8 = freshLabel(e);
  let fallback: *i8 = done;
  let armCount: i32 = itemCount(e.ast, node);
  let labels: **i8 = alloc<*i8>((armCount + 1) as i64);

  let arm: i32 = 0;
  for (arm in 0..armCount) {
    labels[arm] = freshLabel(e);
    if (armOf(e.ast, itemAt(e.ast, node, arm)).isElse) {
      fallback = labels[arm];
    }
  }

  let line: *Builder = Builder.new();
  line.add("switch ");
  line.add(typeName);
  line.push(' ');
  line.add(value);
  line.add(", label %");
  line.add(fallback);
  line.add(" [");

  for (arm in 0..armCount) {
    let armNode: i32 = itemAt(e.ast, node, arm);
    let pattern: i32 = 0;
    while (pattern < itemCount(e.ast, armNode)) {
      let patternNode: i32 = itemAt(e.ast, armNode, pattern);
      line.push(' ');
      line.add(typeName);
      line.push(' ');
      line.add(switchConstant(e.an.values[patternNode], type.bitWidth()));
      line.add(", label %");
      line.add(labels[arm]);
      pattern = pattern + 1;
    }
  }
  line.add(" ]");

  if (!e.terminated) {
    emitLine(e, line.data);
    e.terminated = true;
  }

  for (arm in 0..armCount) {
    emitLabel(e, labels[arm]);
    genArmBody(e, node, itemAt(e.ast, node, arm), slot);
    emitBranch(e, done);
  }

  emitLabel(e, done);
}

// A match on a constant -- `match (OS)`, on what std/target says the program
// is built for -- compiles only the arm that value picks: the others were
// checked, and are left out of the program, along with whatever they call.
fn genChosenArm(e: *Emitter, node: i32, value: i64, slot: *i8): void {
  let chosen: i32 = NO_NODE;
  for (arm in 0..itemCount(e.ast, node)) {
    let armNode: i32 = itemAt(e.ast, node, arm);
    if (armOf(e.ast, armNode).isElse && chosen == NO_NODE) {
      chosen = armNode;
    }
    for (pattern in 0..itemCount(e.ast, armNode)) {
      if (e.an.values[itemAt(e.ast, armNode, pattern)] == value) {
        chosen = armNode;
        break;
      }
    }
  }

  let done: *i8 = freshLabel(e);
  // Checking saw to it that some arm is taken.
  genArmBody(e, node, chosen, slot);
  emitBranch(e, done);
  emitLabel(e, done);
}

// A match on a union: each arm in turn asks whether the code is one of the
// members it names, the way `is` does, and the first that holds runs.
fn genUnionMatch(e: *Emitter, node: i32, type: Type, slot: *i8): void {
  let value: *i8 = genExpr(e, matchOf(e.ast, node).subject);
  let code: *i8 = unionCode(e, type, value);

  let done: *i8 = freshLabel(e);
  let armCount: i32 = itemCount(e.ast, node);
  let labels: **i8 = alloc<*i8>(armCount as i64);
  for (arm in 0..armCount) {
    labels[arm] = freshLabel(e);
  }

  for (arm in 0..armCount) {
    let armNode: i32 = itemAt(e.ast, node, arm);
    if (armOf(e.ast, armNode).isElse) {
      emitBranch(e, labels[arm]);
      e.terminated = true;
      break;
    }
    let holds: *i8 = "false";
    for (index in 0..itemCount(e.ast, armNode)) {
      let pattern: i32 = itemAt(e.ast, armNode, index);
      let test: *i8 = holdsTest(e, type, code, e.an.types[pattern]);
      if (index == 0) {
        holds = test;
      } else {
        holds = instruction(e, "or i1 ", holds, test);
      }
    }
    let next: *i8 = freshLabel(e);
    emitCondBranch(e, holds, labels[arm], next);
    emitLabel(e, next);
  }
  // Checking saw to it that some arm holds.
  if (!e.terminated) {
    emitLine(e, "unreachable");
    e.terminated = true;
  }

  for (arm in 0..armCount) {
    emitLabel(e, labels[arm]);
    genArmBody(e, node, itemAt(e.ast, node, arm), slot);
    emitBranch(e, done);
  }
  emitLabel(e, done);
}

// Where `continue` and `break` go inside the loop being entered.
fn enterLoop(e: *Emitter, continueLabel: *i8, breakLabel: *i8): void {
  e.loopContinue.push(continueLabel);
  e.loopBreak.push(breakLabel);
}

fn leaveLoop(e: *Emitter): void {
  e.loopContinue.pop();
  e.loopBreak.pop();
}

// `for (i in start..end)`. The count lives in a slot of its own and is
// copied into the loop variable at the top of every pass, so assigning to
// the variable in the body cannot change how many passes there are. Both
// bounds are evaluated once, before the first.
fn genFor(e: *Emitter, node: i32, loop: For): void {
  let start: i32 = loop.start;
  let type: Type = typeOfNode(e, start);
  let typeName: *i8 = llvmTypeName(type);

  let first: *i8 = genExpr(e, start);
  let last: *i8 = genExpr(e, loop.end);

  let counter: *i8 = emitAlloca(e, typeName);
  let variable: *i8 = emitAlloca(e, typeName);
  emitStore(e, type, first, counter);

  let condLabel: *i8 = freshLabel(e);
  let bodyLabel: *i8 = freshLabel(e);
  let stepLabel: *i8 = freshLabel(e);
  let doneLabel: *i8 = freshLabel(e);

  emitBranch(e, condLabel);
  emitLabel(e, condLabel);
  let current: *i8 = emitLoad(e, type, counter);

  let compare: *Builder = Builder.new();
  if (type.isSigned()) {
    compare.add("icmp slt ");
  } else {
    compare.add("icmp ult ");
  }
  compare.add(typeName);
  compare.push(' ');
  compare.add(current);
  compare.add(", ");
  compare.add(last);
  emitCondBranch(e, emitAssign(e, compare.data), bodyLabel, doneLabel);

  enterLoop(e, stepLabel, doneLabel);
  emitLabel(e, bodyLabel);
  emitterEnterScope(e);
  declareLocal(e, loop.name, variable, type);
  emitStore(e, type, current, variable);
  genStatement(e, loop.body);
  emitterExitScope(e);
  emitBranch(e, stepLabel);
  leaveLoop(e);

  emitLabel(e, stepLabel);
  let before: *i8 = emitLoad(e, type, counter);
  let increment: *Builder = Builder.new();
  increment.add("add ");
  increment.add(typeName);
  increment.push(' ');
  increment.add(before);
  increment.add(", 1");
  emitStore(e, type, emitAssign(e, increment.data), counter);
  emitBranch(e, condLabel);

  emitLabel(e, doneLabel);
}
