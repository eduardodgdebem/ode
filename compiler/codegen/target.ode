// ---------------------------------------------------------------------------
// Targets: the machine and the OS a program is built for.
//
// Without --target a program is built for whatever the C compiler builds
// for by default, and the IR names no triple -- which is what lets
// bootstrap/ode.ll seed a compiler on macOS and Linux alike. With one, the IR
// names its triple and the C compiler is told the same with --target.
//
// The IR carries no data layout: the compiler works sizes out itself
// (types/layout.ode), and clang fills in the layout that goes with the
// triple. A pointer is 8 bytes everywhere but wasm32, where it is 4.
//
// wasm32 is freestanding: a module with no C library and no entry point,
// whose exports are the entry file's exported functions and whose imports
// are its externs (codegen/wasm.ode).
//
// A program asks what it is built for by importing `std/target`, a module
// this file writes for each build: the target as enums, in constants that a
// `match` picks its arm from at compile time.
// ---------------------------------------------------------------------------

import { alloc } from "std/mem";
import { Builder, contains, equals, indexOf, slice, startsWith } from "std/text";
import { exists } from "std/fs";
import { TextList, StderrMode, runCommand, ran } from "../os/process";
import { ccProgram } from "./toolchain";

export enum Arch {
  X86_64,
  Aarch64,
  Wasm32,
}

export enum Os {
  Macos,
  Linux,
  // No OS at all: what the host hands the program is all it has.
  Freestanding,
}

// Which C library a Linux program is linked against. macOS has one. Linux's
// default is musl, which Ode bundles (codegen/libc.ode), so that a Linux
// program builds from anywhere; glibc needs the target's own sysroot.
export enum Abi {
  Default,
  Gnu,
  Musl,
}

export error enum TargetError {
  UnknownArch,
  UnknownOs,
  UnknownAbi,
  // An ABI on an OS that has only one, or more parts than arch-os-abi.
  TooManyParts,
  // An arch and an OS that do not go together: wasm32 is only freestanding,
  // and only wasm32 is.
  NoSuchPair,
}

export struct Target {
  arch: Arch,
  os: Os,
  abi: Abi,

  // The LLVM triple, as clang's --target and the IR's `target triple` take
  // it.
  fn triple(self: Target): *i8 {
    if (self.arch == Arch.Wasm32) {
      return "wasm32-unknown-unknown";
    }
    let out: *Builder = Builder.new();
    if (self.os == Os.Macos) {
      out.add(match (self.arch) { .X86_64 => "x86_64", else => "arm64" });
      out.add("-apple-macosx");
      return out.take();
    }

    out.add(match (self.arch) { .X86_64 => "x86_64", else => "aarch64" });
    out.add("-unknown-linux-");
    out.add(match (self.abi) { .Gnu => "gnu", else => "musl" });
    return out.take();
  }

  fn isDarwin(self: Target): bool {
    return self.os == Os.Macos;
  }

  fn isMusl(self: Target): bool {
    return self.os == Os.Linux && self.abi != Abi.Gnu;
  }
}

// What the program is being built for; null for the C compiler's default.
export let TARGET: *Target = null;

// The module `std/target` was loaded as, or -1 when nothing imports it.
// Its globals are constants.
export let TARGET_MODULE: i32 = -1;

export let TARGET_IMPORT: *i8 = "std/target";

let HOST: *Target = null;

// The machine the C compiler builds for by default, from its -dumpmachine:
// `arm64-apple-darwin24.0.0`, `x86_64-pc-linux-gnu`, `aarch64-linux-musl`.
// Asked once a run.
export fn hostTarget(): Target {
  if (HOST != null) {
    return *HOST;
  }
  HOST = alloc<Target>(1);
  HOST.arch = Arch.X86_64;
  HOST.os = Os.Linux;
  HOST.abi = Abi.Gnu;
  if (exists("/usr/bin/xcrun")) {
    HOST.os = Os.Macos;
    HOST.abi = Abi.Default;
  }

  let output: *Builder = Builder.new();
  let command: *TextList = TextList.new().add(ccProgram()).add("-dumpmachine");
  if (ran(runCommand(command, null, output, StderrMode.Discard))) {
    readTriple(output.data, HOST);
  }
  return *HOST;
}

// Fills in what `triple` says of the arch, the OS and the C library, and
// leaves what it does not say as it was.
fn readTriple(triple: *i8, into: *Target): void {
  if (startsWith(triple, "x86_64") || startsWith(triple, "amd64")) {
    into.arch = Arch.X86_64;
  } else if (startsWith(triple, "aarch64") || startsWith(triple, "arm64")) {
    into.arch = Arch.Aarch64;
  } else if (startsWith(triple, "wasm32")) {
    into.arch = Arch.Wasm32;
  }
  if (contains(triple, "darwin") || contains(triple, "macos")) {
    into.os = Os.Macos;
    into.abi = Abi.Default;
  } else if (contains(triple, "linux")) {
    into.os = Os.Linux;
    into.abi = Abi.Gnu;
    if (contains(triple, "musl")) {
      into.abi = Abi.Musl;
    }
  }
}

// What the program is built for: the --target, or this machine.
export fn effectiveTarget(): Target {
  if (TARGET != null) {
    return *TARGET;
  }
  return hostTarget();
}

export error enum TargetConstantError {
  NotOne,
}

// The value of the std/target constant `name`: an enum member's, counted in
// the order targetModuleSource declares them, or the number.
export fn targetConstant(name: *i8): i64 | TargetConstantError {
  let target: Target = effectiveTarget();
  if (equals(name, "OS")) {
    return match (target.os) { .Macos => 0, .Linux => 1, .Freestanding => 2 };
  }
  if (equals(name, "ARCH")) {
    return match (target.arch) { .X86_64 => 0, .Aarch64 => 1, .Wasm32 => 2 };
  }
  if (equals(name, "ABI")) {
    if (target.isMusl()) {
      return 2;
    }
    if (target.os == Os.Linux) {
      return 1;
    }
    return 0;
  }
  if (equals(name, "POINTER_BYTES")) {
    return pointerBytes() as i64;
  }
  return TargetConstantError.NotOne;
}

// The source of `std/target`, for what this build is for.
export fn targetModuleSource(): *i8 {
  let target: Target = effectiveTarget();
  let out: *Builder = Builder.new();
  out.add(`// What this program is being built for, written by the compiler for each
// build: ode --target chooses it, and without one it is this machine.
// Each is a constant, so a match on one compiles only the arm it picks --
// though every arm is still checked, on every target.

// The operating system. Freestanding is none: a wasm32 module.
export enum Os {
  Macos,
  Linux,
  Freestanding,
}

export enum Arch {
  X86_64,
  Aarch64,
  Wasm32,
}

// Which C library a program links against: musl or glibc on Linux, and
// none to choose between elsewhere.
export enum Abi {
  None,
  Gnu,
  Musl,
}

`);
  out.add("export let OS: Os = Os.");
  out.add(match (target.os) {
    .Macos => "Macos",
    .Linux => "Linux",
    .Freestanding => "Freestanding",
  });
  out.add(";\nexport let ARCH: Arch = Arch.");
  out.add(match (target.arch) {
    .X86_64 => "X86_64",
    .Aarch64 => "Aarch64",
    .Wasm32 => "Wasm32",
  });
  out.add(";\nexport let ABI: Abi = Abi.");
  let abi: *i8 = "None";
  if (target.isMusl()) {
    abi = "Musl";
  } else if (target.os == Os.Linux) {
    abi = "Gnu";
  }
  out.add(abi);
  out.add(";\n\n// How many bytes a pointer takes, and so an isize or a usize.\n");
  out.add("export let POINTER_BYTES: i32 = ");
  out.addInt(pointerBytes() as i64);
  out.add(";\n");
  return out.take();
}

// Whether the program is a wasm module rather than an executable.
export fn targetsWasm(): bool {
  return TARGET != null && TARGET.arch == Arch.Wasm32;
}

// How many bytes a pointer, or a function value, takes.
export fn pointerBytes(): i32 {
  if (targetsWasm()) {
    return 4;
  }
  return 8;
}

// Whether the SDK that xcrun knows suits what is being built: it does for
// macOS, and for the default target only when that is macOS, which a Mac
// has xcrun to say.
export fn targetsDarwin(): bool {
  return TARGET == null || TARGET.isDarwin();
}

// `arch-os` or `arch-os-abi`, the way Zig spells them: `x86_64-linux`,
// `aarch64-macos`, `x86_64-linux-musl`, `wasm32-freestanding`. `arm64` is
// taken for `aarch64`, and `wasm32` alone for `wasm32-freestanding`.
export fn parseTarget(text: *i8): *Target | TargetError {
  let target: *Target = alloc<Target>(1);
  target.abi = Abi.Default;
  if (equals(text, "wasm32")) {
    target.arch = Arch.Wasm32;
    target.os = Os.Freestanding;
    return target;
  }

  let archEnd: i64 = indexOf(text, "-");
  if (archEnd < 0) {
    return TargetError.UnknownOs;
  }
  let arch: *i8 = slice(text, 0, archEnd);
  if (equals(arch, "x86_64")) {
    target.arch = Arch.X86_64;
  } else if (equals(arch, "aarch64") || equals(arch, "arm64")) {
    target.arch = Arch.Aarch64;
  } else if (equals(arch, "wasm32")) {
    target.arch = Arch.Wasm32;
  } else {
    return TargetError.UnknownArch;
  }

  let rest: *i8 = text + archEnd + 1;
  let osEnd: i64 = indexOf(rest, "-");
  let os: *i8 = rest;
  if (osEnd >= 0) {
    os = slice(rest, 0, osEnd);
  }
  if (equals(os, "macos")) {
    target.os = Os.Macos;
  } else if (equals(os, "linux")) {
    target.os = Os.Linux;
  } else if (equals(os, "freestanding")) {
    target.os = Os.Freestanding;
  } else {
    return TargetError.UnknownOs;
  }
  if ((target.arch == Arch.Wasm32) != (target.os == Os.Freestanding)) {
    return TargetError.NoSuchPair;
  }

  if (osEnd < 0) {
    return target;
  }
  let abi: *i8 = rest + osEnd + 1;
  if (target.os != Os.Linux || indexOf(abi, "-") >= 0) {
    return TargetError.TooManyParts;
  }
  if (equals(abi, "gnu")) {
    target.abi = Abi.Gnu;
  } else if (equals(abi, "musl")) {
    target.abi = Abi.Musl;
  } else {
    return TargetError.UnknownAbi;
  }
  return target;
}

fn tripleOf(text: *i8): *i8 {
  let target: *Target = parseTarget(text) catch (e) {
    return nameOf(e);
  };
  return target.triple();
}

test "a target is arch-os, with an ABI on Linux" {
  assertEq(tripleOf("x86_64-linux"), "x86_64-unknown-linux-musl");
  assertEq(tripleOf("x86_64-linux-gnu"), "x86_64-unknown-linux-gnu");
  assertEq(tripleOf("aarch64-linux-musl"), "aarch64-unknown-linux-musl");
  assertEq(tripleOf("aarch64-macos"), "arm64-apple-macosx");
  assertEq(tripleOf("arm64-macos"), "arm64-apple-macosx");
  assertEq(tripleOf("x86_64-macos"), "x86_64-apple-macosx");
  assertEq(tripleOf("wasm32"), "wasm32-unknown-unknown");
  assertEq(tripleOf("wasm32-freestanding"), "wasm32-unknown-unknown");
}

test "the host is read from what the C compiler says it builds for" {
  let target: Target = Target { arch: Arch.X86_64, os: Os.Linux, abi: Abi.Gnu };
  readTriple("arm64-apple-darwin24.0.0", &target);
  assertEq(target.arch, Arch.Aarch64);
  assertEq(target.os, Os.Macos);
  readTriple("x86_64-pc-linux-gnu", &target);
  assertEq(target.arch, Arch.X86_64);
  assertEq(target.abi, Abi.Gnu);
  readTriple("aarch64-alpine-linux-musl", &target);
  assert(target.isMusl());
}

test "a target that is not one says which part is wrong" {
  assertEq(parseTarget("riscv64-linux"), TargetError.UnknownArch);
  assertEq(parseTarget("x86_64-windows"), TargetError.UnknownOs);
  assertEq(parseTarget("x86_64"), TargetError.UnknownOs);
  assertEq(parseTarget("x86_64-linux-android"), TargetError.UnknownAbi);
  assertEq(parseTarget("aarch64-macos-gnu"), TargetError.TooManyParts);
  assertEq(parseTarget("x86_64-linux-gnu-extra"), TargetError.TooManyParts);
  assertEq(parseTarget("wasm32-linux"), TargetError.NoSuchPair);
  assertEq(parseTarget("x86_64-freestanding"), TargetError.NoSuchPair);
}
