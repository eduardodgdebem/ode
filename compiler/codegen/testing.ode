// ---------------------------------------------------------------------------
// Emitting tests and the built-in checks.
//
// A failed check writes where it was and why to stderr, through dprintf, and
// ends the process with status 1. Under `ode test` every test runs in a
// process of its own (see the runner in semantics/testing.ode), so that ends
// the one test rather than the run -- and a crash ends it the same way.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { List } from "std/list";
import { Builder, equals } from "std/text";
import { enumDeclOf } from "../check/enums";
import { unionType, valueOf } from "../check/errors";
import { RUNNER_MODULE } from "../check/testing";
import {
  Emitter, freshLabel, emitAlloca, emitLine, emitLabel, emitCondBranch,
  llvmName, internString,
} from "./emitter";
import {
  typeOfNode, emitAssign, emitCast, resultTypeOf, genExpr,
} from "./expressions";
import { llvmTypeName } from "./layout";
import { line } from "../driver/options";
import { moduleDisplayPath, NameSet } from "../link/modules";
import { NodeKind } from "../syntax/ast";
import { shown } from "../tool/build";
import { TypeKind, Type } from "../types/types";

// `path:line:column` of `node`, as a string constant.
fn location(e: *Emitter, node: i32): *i8 {
  let text: *Builder = Builder.new();
  text.add(moduleDisplayPath(e.ast.nodes[node].module));
  text.push(':');
  text.addInt(e.ast.nodes[node].line as i64);
  text.push(':');
  text.addInt(e.ast.nodes[node].column as i64);

  return internString(e, text.data, text.length);
}

// Writes `format` and the arguments in `args` (each `, type value`) to
// stderr, and ends the process. The block is closed afterwards.
fn emitFailure(e: *Emitter, format: *i8, args: *Builder): void {
  e.usesChecks = true;

  let line: *Builder = Builder.new();
  line.add("call i32 (i32, ptr, ...) @dprintf(i32 2, ptr ");
  line.add(internString(e, format, strlen(format)));
  line.add(args.data);
  line.push(')');
  emitAssign(e, line.data);

  emitLine(e, "call void @exit(i32 1)");
  emitLine(e, "unreachable");
  e.terminated = true;
}

// `assert(cond)` and `assert(cond, message)`. The message is only evaluated
// when the condition fails.
export fn genAssert(e: *Emitter, node: i32): *i8 {
  let args: i32 = e.ast.nodes[node].a;
  let condition: *i8 = genExpr(e, e.ast.nodes[args].items[0]);

  let passed: *i8 = freshLabel(e);
  let failed: *i8 = freshLabel(e);
  emitCondBranch(e, condition, passed, failed);
  emitLabel(e, failed);

  let values: *Builder = Builder.new();
  values.add(", ptr ");
  values.add(location(e, node));

  if (e.ast.nodes[args].itemCount == 2) {
    values.add(", ptr ");
    values.add(genExpr(e, e.ast.nodes[args].items[1]));
    emitFailure(e, "%s: assertion failed: %s\n", values);
  } else {
    emitFailure(e, "%s: assertion failed\n", values);
  }

  emitLabel(e, passed);
  return "";
}

fn isText(type: Type): bool {
  return type.kind == TypeKind.I8 && type.pointerDepth == 1;
}

// Whether two values of these types are equal, as an i1: as `==` decides,
// but by the text for two strings.
fn genEquals(e: *Emitter, left: *i8, leftType: Type, right: *i8,
             rightType: Type): *i8 {
  if (rightType.isUnion() && !leftType.isUnion()) {
    return unionEquals(e, right, rightType, left, leftType);
  }
  if (leftType.isUnion()) {
    return unionEquals(e, left, leftType, right, rightType);
  }

  let line: *Builder = Builder.new();

  if (isText(leftType) && isText(rightType)) {
    e.usesChecks = true;
    line.add("call i1 @ode.textEquals(ptr ");
    line.add(left);
    line.add(", ptr ");
    line.add(right);
    line.push(')');
    return emitAssign(e, line.data);
  }

  if (leftType.isFloat()) {
    line.add("fcmp oeq ");
  } else {
    line.add("icmp eq ");
  }
  // `null` has no type of its own to compare as, but the other side does.
  let type: Type = leftType;
  if (type.isNull()) {
    type = rightType;
  }
  line.add(llvmTypeName(type));
  line.push(' ');
  line.add(left);
  line.add(", ");
  line.add(right);

  return emitAssign(e, line.data);
}

// A union against an error, a value, or another union: the same error, or
// no error and the same value.
fn unionEquals(e: *Emitter, union: *i8, unionType: Type, other: *i8,
               otherType: Type): *i8 {
  let code: *i8 = unionPart(e, unionType, union, 0);
  if (otherType.isEnum()) {
    return instruction(e, "icmp eq i32 ", code, other);
  }

  let value: Type = valueOf(unionType);
  if (otherType.isUnion()) {
    let sameCode: *i8 = instruction(e, "icmp eq i32 ", code,
                                    unionPart(e, otherType, other, 0));
    if (value.isVoid()) {
      return sameCode;
    }
    let sameValue: *i8 = genEquals(e, unionPart(e, unionType, union, 1), value,
                                   unionPart(e, otherType, other, 1), value);
    let failed: *i8 = instruction(e, "icmp ne i32 ", code, "0");
    let either: *i8 = instruction(e, "or i1 ", failed, sameValue);
    return instruction(e, "and i1 ", sameCode, either);
  }

  let succeeded: *i8 = instruction(e, "icmp eq i32 ", code, "0");
  if (value.isVoid()) {
    return succeeded;
  }
  let sameValue: *i8 = genEquals(e, unionPart(e, unionType, union, 1), value,
                                 other, otherType);
  return instruction(e, "and i1 ", succeeded, sameValue);
}

fn unionPart(e: *Emitter, type: Type, value: *i8, index: i32): *i8 {
  let line: *Builder = Builder.new();
  line.add("extractvalue ");
  line.add(llvmTypeName(type));
  line.push(' ');
  line.add(value);
  line.add(", ");
  line.addInt(index as i64);
  return emitAssign(e, line.data);
}

// `operation a, b`, where `operation` names the type as well.
export fn instruction(e: *Emitter, operation: *i8, a: *i8, b: *i8): *i8 {
  let line: *Builder = Builder.new();
  line.add(operation);
  line.add(a);
  line.add(", ");
  line.add(b);
  return emitAssign(e, line.data);
}

// A union as text: its error's name, `ParseError.Empty`, or its value
// written as its own type would be.
fn unionText(e: *Emitter, value: *i8, type: Type): *i8 {
  e.usesErrorNames = true;
  let code: *i8 = unionPart(e, type, value, 0);
  let call: *Builder = Builder.new();
  call.add("call ptr @ode.errorName(i32 ");
  call.add(code);
  call.push(')');
  let name: *i8 = emitAssign(e, call.data);
  if (valueOf(type).isVoid()) {
    return name;
  }

  // A struct has no printf conversion of its own; it shows as its type.
  let valueType: Type = valueOf(type);
  if (valueType.isStruct()) {
    let text: *Builder = Builder.new();
    text.add("a ");
    text.add(valueType.toText());
    let shown: *i8 = internString(e, text.data, text.length);
    let succeeded: *i8 = instruction(e, "icmp eq i32 ", code, "0");
    let pick: *Builder = Builder.new();
    pick.add("select i1 ");
    pick.add(succeeded);
    pick.add(", ptr ");
    pick.add(shown);
    pick.add(", ptr ");
    pick.add(name);
    return emitAssign(e, pick.data);
  }

  // The value, printed into a buffer of its own, picked when there is no
  // error.
  let buffer: *i8 = emitAlloca(e, "[64 x i8]");
  let args: *Builder = Builder.new();
  let format: *i8 = formatValue(e, unionPart(e, type, value, 1), valueOf(type),
                                args);
  let print: *Builder = Builder.new();
  print.add("call i32 (ptr, i64, ptr, ...) @snprintf(ptr ");
  print.add(buffer);
  print.add(", i64 64, ptr ");
  print.add(internString(e, format, strlen(format)));
  print.add(args.data);
  print.push(')');
  emitAssign(e, print.data);

  let succeeded: *i8 = instruction(e, "icmp eq i32 ", code, "0");
  let pick: *Builder = Builder.new();
  pick.add("select i1 ");
  pick.add(succeeded);
  pick.add(", ptr ");
  pick.add(buffer);
  pick.add(", ptr ");
  pick.add(name);
  return emitAssign(e, pick.data);
}

// Adds `value` to `args` in the form its printf conversion wants, and
// returns that conversion.
fn formatValue(e: *Emitter, value: *i8, type: Type, args: *Builder): *i8 {
  if (type.isBool()) {
    let line: *Builder = Builder.new();
    line.add("select i1 ");
    line.add(value);
    line.add(", ptr ");
    line.add(internString(e, "true", 4));
    line.add(", ptr ");
    line.add(internString(e, "false", 5));
    args.add(", ptr ");
    args.add(emitAssign(e, line.data));
    return "%s";
  }

  if (isText(type)) {
    args.add(", ptr ");
    args.add(value);
    return "\"%s\"";
  }

  if (type.isUnion()) {
    args.add(", ptr ");
    args.add(unionText(e, value, type));
    return "%s";
  }

  // An enum shows as its member: `Color.Red`.
  if (type.isEnum()) {
    args.add(", ptr ");
    args.add(internString(e, type.toText(), strlen(type.toText())));
    args.add(", ptr ");
    args.add(memberName(e, value, type));
    return "%s.%s";
  }

  if (type.isPointer() || type.isNull() || type.isFunction()) {
    args.add(", ptr ");
    args.add(value);
    return "%p";
  }

  if (type.isFloat()) {
    args.add(", double ");
    args.add(emitCast(e, value, type, Type.make(TypeKind.F64, 0)));
    return "%g";
  }

  if (type.isSigned() || type.isEnum()) {
    args.add(", i64 ");
    args.add(emitCast(e, value, type, Type.make(TypeKind.I64, 0)));
    return "%lld";
  }

  args.add(", i64 ");
  args.add(emitCast(e, value, type, Type.make(TypeKind.U64, 0)));
  return "%llu";
}

// `assertEq(actual, expected)`: a failure shows both values.
export fn genAssertEq(e: *Emitter, node: i32): *i8 {
  let args: i32 = e.ast.nodes[node].a;
  let actualNode: i32 = e.ast.nodes[args].items[0];
  let expectedNode: i32 = e.ast.nodes[args].items[1];
  let actualType: Type = resultTypeOf(e, actualNode);
  let expectedType: Type = resultTypeOf(e, expectedNode);

  let actual: *i8 = genExpr(e, actualNode);
  let expected: *i8 = genExpr(e, expectedNode);
  let equal: *i8 = genEquals(e, actual, actualType, expected, expectedType);

  let passed: *i8 = freshLabel(e);
  let failed: *i8 = freshLabel(e);
  emitCondBranch(e, equal, passed, failed);
  emitLabel(e, failed);

  let values: *Builder = Builder.new();
  values.add(", ptr ");
  values.add(location(e, node));

  let format: *Builder = Builder.new();
  format.add("%s: assertEq failed\n  actual:   ");
  format.add(formatValue(e, actual, actualType, values));
  format.add("\n  expected: ");
  format.add(formatValue(e, expected, expectedType, values));
  format.push('\n');
  emitFailure(e, format.data, values);

  emitLabel(e, passed);
  return "";
}

// What the checks call, unless the program declared it already, and the
// string comparison assertEq uses.
export fn emitCheckSupport(e: *Emitter, declared: *NameSet): void {
  if (!e.usesChecks) {
    return;
  }

  if (!declared.has("dprintf")) {
    e.head.add("declare i32 @dprintf(i32, ptr, ...)\n");
  }
  if (!declared.has("exit")) {
    e.head.add("declare void @exit(i32)\n");
  }
  if (!declared.has("strcmp")) {
    e.head.add("declare i32 @strcmp(ptr, ptr)\n");
  }
  if (!declared.has("snprintf")) {
    e.head.add("declare i32 @snprintf(ptr, i64, ptr, ...)\n");
  }
  if (e.usesErrorNames) {
    emitErrorNames(e);
  }

  // Equal when both are the same pointer, or neither is null and their
  // text matches.
  e.body.add("define private i1 @ode.textEquals(ptr %a, ptr %b) {\n");
  e.body.add("entry:\n");
  e.body.add("  %same = icmp eq ptr %a, %b\n");
  e.body.add("  br i1 %same, label %yes, label %check\n");
  e.body.add("check:\n");
  e.body.add("  %aNull = icmp eq ptr %a, null\n");
  e.body.add("  %bNull = icmp eq ptr %b, null\n");
  e.body.add("  %either = or i1 %aNull, %bNull\n");
  e.body.add("  br i1 %either, label %no, label %compare\n");
  e.body.add("compare:\n");
  e.body.add("  %order = call i32 @strcmp(ptr %a, ptr %b)\n");
  e.body.add("  %equal = icmp eq i32 %order, 0\n");
  e.body.add("  ret i1 %equal\n");
  e.body.add("yes:\n");
  e.body.add("  ret i1 true\n");
  e.body.add("no:\n");
  e.body.add("  ret i1 false\n");
  e.body.add("}\n\n");
}

// The program's `main` under `ode test`: it hands every test, by name, to the
// runner. The program's own `main` was renamed out of the way; see llvmName.
export fn emitTestMain(e: *Emitter, program: i32, tests: *Builder, names: *Builder,
                       count: i32): void {
  let runner: *i8 = null;
  for (index in 0..e.ast.nodes[program].itemCount) {
    let item: i32 = e.ast.nodes[program].items[index];
    if (e.ast.nodes[item].kind == NodeKind.Fn &&
        e.ast.nodes[item].module == RUNNER_MODULE &&
        equals(e.ast.nodes[item].text, "runTests")) {
      runner = e.an.linkNames[item];
    }
  }

  let table: *Builder = Builder.new();
  table.push('[');
  table.addInt(count as i64);
  table.add(" x ptr] ");

  e.head.add("@ode.test.names = private constant ");
  e.head.add(table.data);
  if (count == 0) {
    e.head.add("zeroinitializer\n");
  } else {
    e.head.push('[');
    e.head.add(names.data);
    e.head.add("]\n");
  }

  e.head.add("@ode.test.functions = private constant ");
  e.head.add(table.data);
  if (count == 0) {
    e.head.add("zeroinitializer\n");
  } else {
    e.head.push('[');
    e.head.add(tests.data);
    e.head.add("]\n");
  }

  e.body.add("define i32 @main(i32 %argc, ptr %argv) {\nentry:\n");
  e.body.add("  %status = call i32 ");
  e.body.add(llvmName('@', runner));
  e.body.add("(i32 ");
  e.body.addInt(count as i64);
  e.body.add(", ptr @ode.test.names, ptr @ode.test.functions, ");
  e.body.add("i32 %argc, ptr %argv)\n");
  e.body.add("  ret i32 %status\n}\n\n");
}

// `nameOf(value)`.
export fn genNameOf(e: *Emitter, node: i32): *i8 {
  let argument: i32 = e.ast.nodes[e.ast.nodes[node].a].items[0];
  return memberName(e, genExpr(e, argument), typeOfNode(e, argument));
}

// The name of the member `value`, of the enum `type`, as a string.
export fn memberName(e: *Emitter, value: *i8, type: Type): *i8 {
  let known: bool = false;
  for (index in 0..e.namedEnums.count) {
    if (equals(e.namedEnums.at(index), type.structName)) {
      known = true;
    }
  }
  if (!known) {
    e.namedEnums.push(type.structName);
  }

  let line: *Builder = Builder.new();
  line.add("call ptr ");
  line.add(namesFunction(type.structName));
  line.add("(i32 ");
  line.add(value);
  line.push(')');
  return emitAssign(e, line.data);
}

fn namesFunction(enumName: *i8): *i8 {
  let name: *Builder = Builder.new();
  name.add("ode.names.");
  name.add(enumName);
  return llvmName('@', name.data);
}

// For each enum a name was asked for, a function from its values to its
// members' names; "?" for a value that is no member's.
export fn emitEnumNames(e: *Emitter): void {
  for (index in 0..e.namedEnums.count) {
    let enumName: *i8 = e.namedEnums.at(index);
    let declaration: i32 = enumDeclOf(e.an, enumName);

    e.body.add("define private ptr ");
    e.body.add(namesFunction(enumName));
    e.body.add("(i32 %value) {\nentry:\n  switch i32 %value, label %unknown [");

    // Two members of one value would be two cases of one value, which LLVM
    // rejects; the first is the name it goes by.
    let seen: *List<i64> = List<i64>.new();
    let arms: *Builder = Builder.new();
    for (member in 0..e.ast.nodes[declaration].itemCount) {
      let node: i32 = e.ast.nodes[declaration].items[member];
      let value: i64 = e.an.values[node];
      let repeated: bool = false;
      for (other in 0..seen.count) {
        if (seen.at(other) == value) {
          repeated = true;
        }
      }
      if (!repeated) {
        seen.push(value);
        e.body.add(" i32 ");
        e.body.addInt(value);
        e.body.add(", label %m");
        e.body.addInt(member as i64);

        arms.add("m");
        arms.addInt(member as i64);
        arms.add(":\n  ret ptr ");
        arms.add(internString(e, e.ast.nodes[node].text,
                              strlen(e.ast.nodes[node].text)));
        arms.push('\n');
      }
    }
    e.body.add(" ]\n");
    e.body.add(arms.data);
    e.body.add("unknown:\n  ret ptr ");
    e.body.add(internString(e, "?", 1));
    e.body.add("\n}\n\n");
  }
}

// `@ode.errorName`: every error in the program by its number, as
// `ParseError.Empty`; "ok" for 0, which is no error.
fn emitErrorNames(e: *Emitter): void {
  let arms: *Builder = Builder.new();
  e.body.add("define private ptr @ode.errorName(i32 %code) {\nentry:\n");
  e.body.add("  switch i32 %code, label %unknown [ i32 0, label %ok");
  let names: *List<*i8> = e.an.errorEnums.names;
  for (index in 0..names.count) {
    let declaration: i32 = enumDeclOf(e.an, names.at(index));
    for (member in 0..e.ast.nodes[declaration].itemCount) {
      let node: i32 = e.ast.nodes[declaration].items[member];
      let code: i64 = e.an.values[node];
      e.body.add(" i32 ");
      e.body.addInt(code);
      e.body.add(", label %e");
      e.body.addInt(code);

      let text: *Builder = Builder.new();
      text.add(Type.ofEnum(names.at(index), 0).toText());
      text.push('.');
      text.add(e.ast.nodes[node].text);
      arms.add("e");
      arms.addInt(code);
      arms.add(":\n  ret ptr ");
      arms.add(internString(e, text.data, text.length));
      arms.push('\n');
    }
  }
  e.body.add(" ]\nok:\n  ret ptr ");
  e.body.add(internString(e, "ok", 2));
  e.body.add("\n");
  e.body.add(arms.data);
  e.body.add("unknown:\n  ret ptr ");
  e.body.add(internString(e, "?", 1));
  e.body.add("\n}\n\n");
}
