// ---------------------------------------------------------------------------
// Functions and the module.
//
// A module is written in two parts. The head holds the struct types, string
// constants, extern declarations and globals; the body holds every function
// and method. genProgram puts them together into the text handed to clang.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Builder, equals, fromInt } from "std/text";
import { analyzerParseType, isVariadic } from "../check/analyzer";
import { globalDeclOf } from "../check/constants";
import { signatureIndex } from "../check/functions";
import { TEST_MODE, runsTestsOf } from "../check/testing";
import {
  Emitter, emitAlloca, emitLine, emitterEnterScope, emitterExitScope,
  declareLocal, llvmName, internString, lambdaValue,
} from "./emitter";
import { emitStore, genNumberLiteral, genCharLiteral } from "./expressions";
import { Lowered, lowerArgument, lowerReturn, pointerAttribute } from "./abi";
import { llvmTypeName, zeroValue } from "./layout";
import { genStatement } from "./statements";
import { TARGET, targetsWasm } from "./target";
import {
  emitCheckSupport, emitTestMain, emitWasmTestExports, emitEnumNames,
} from "./testing";
import { line } from "../driver/options";
import { isTemplate } from "../link/generics";
import { NameSet } from "../link/modules";
import {
  NO_NODE, NodeKind, BoolLit, Cast, Sizeof, Syntax, Unary, bodyOf, itemAt, itemCount,
  nodeName, nodeTextLength, paramsOf, returnTypeOf, typeNodeOf, varDeclOf,
} from "../syntax/ast";
import { sizeOf } from "../types/layout";
import { Type } from "../types/types";

// A function's return type: as written, or for a lambda that left it out,
// as its context gave it.
fn resultTypeOf(e: *Emitter, node: i32): Type {
  if (e.ast.nodes[node].kind == NodeKind.Lambda) {
    return e.an.signatures.at(signatureIndex(e.an, e.an.types[node])).result;
  }
  return analyzerParseType(e.an, returnTypeOf(e.ast, node));
}

// A parameter's type, the same way: checking recorded a lambda's.
fn paramTypeOf(e: *Emitter, param: i32): Type {
  if (typeNodeOf(e.ast, param) == NO_NODE) {
    return e.an.types[param];
  }
  return analyzerParseType(e.an, typeNodeOf(e.ast, param));
}

fn emitSignature(e: *Emitter, out: *Builder, node: i32, keyword: *i8): void {
  let returnType: Type = resultTypeOf(e, node);
  if (e.ast.nodes[node].kind == NodeKind.Extern && takesStructs(e, node)) {
    emitExternSignature(e, out, node, returnType);
    return;
  }

  out.add(keyword);
  out.push(' ');
  out.add(llvmTypeName(returnType));
  out.push(' ');
  out.add(llvmName('@', e.an.linkNames[node]));
  out.push('(');

  let params: i32 = paramsOf(e.ast, node);
  let count: i32 = 0;
  if (params != NO_NODE) {
    count = itemCount(e.ast, params);
  }

  for (index in 0..count) {
    if (index > 0) {
      out.add(", ");
    }

    let param: i32 = itemAt(e.ast, params, index);
    out.add(llvmTypeName(paramTypeOf(e, param)));

    // A declaration names no parameters; a definition needs them to store.
    if (equals(keyword, "define")) {
      out.add(" %p");
      out.addInt(index as i64);
    }
  }

  if (params != NO_NODE && isVariadic(e.an, node)) {
    if (count > 0) {
      out.add(", ");
    }
    out.add("...");
  }

  out.push(')');
}

// Whether the extern `node` takes or returns a struct by value.
fn takesStructs(e: *Emitter, node: i32): bool {
  if (resultTypeOf(e, node).isStruct()) {
    return true;
  }
  let params: i32 = paramsOf(e.ast, node);
  if (params == NO_NODE) {
    return false;
  }
  for (index in 0..itemCount(e.ast, params)) {
    if (paramTypeOf(e, itemAt(e.ast, params, index)).isStruct()) {
      return true;
    }
  }
  return false;
}

// `declare` for an extern that passes structs, as the target passes them:
// an `sret` pointer first for a struct coming back that way, and each struct
// argument as its parts, or by address.
fn emitExternSignature(e: *Emitter, out: *Builder, node: i32, returnType: Type): void {
  let list: *List<*i8> = List<*i8>.new();
  let result: *i8 = llvmTypeName(returnType);
  if (returnType.isStruct()) {
    result = lowerReturn(e.an.structs, returnType);
    if (result == null) {
      result = "void";
      list.push(pointerAttribute(e.an.structs, "sret", returnType));
    }
  }
  let paramList: i32 = paramsOf(e.ast, node);
  if (paramList != NO_NODE) {
    for (index in 0..itemCount(e.ast, paramList)) {
      let type: Type = paramTypeOf(e, itemAt(e.ast, paramList, index));
      if (!type.isStruct()) {
        list.push(llvmTypeName(type));
        continue;
      }
      let lowered: Lowered = lowerArgument(e.an.structs, type);
      if (lowered.byAddress && lowered.byval) {
        list.push(pointerAttribute(e.an.structs, "byval", type));
      } else if (lowered.byAddress) {
        list.push("ptr");
      }
      for (part in 0..lowered.parts.count) {
        let text: *Builder = Builder.new();
        text.add(lowered.parts.at(part));
        text.add(lowered.attribute);
        list.push(text.take());
      }
    }
  }

  out.add("declare ");
  out.add(result);
  out.push(' ');
  out.add(llvmName('@', e.an.linkNames[node]));
  out.push('(');
  for (index in 0..list.count) {
    if (index > 0) {
      out.add(", ");
    }
    out.add(list.at(index));
  }
  out.push(')');
}

fn genFunction(e: *Emitter, node: i32): void {
  let returnType: Type = resultTypeOf(e, node);

  e.returnType = returnType;
  e.nextTemp = 0;
  e.nextLabel = 0;
  e.terminated = false;

  emitSignature(e, e.body, node, "define");
  e.body.add(" {\nentry:\n");

  // The body is written after the entry label, and the slots it asks for are
  // collected apart and put in front of it once the function is done.
  let entry: i64 = e.body.length;
  e.allocas = Builder.new();

  emitterEnterScope(e);

  // Each parameter gets a slot of its own, so it can be assigned like any
  // other local.
  let params: i32 = paramsOf(e.ast, node);
  if (params != NO_NODE) {
    let index: i32 = 0;
    while (index < itemCount(e.ast, params)) {
      let param: i32 = itemAt(e.ast, params, index);
      let type: Type = paramTypeOf(e, param);

      let slot: *i8 = emitAlloca(e, llvmTypeName(type));

      let incoming: *Builder = Builder.new();
      incoming.add("%p");
      incoming.addInt(index as i64);
      emitStore(e, type, incoming.data, slot);

      declareLocal(e, nodeName(e.ast, param), slot, type);
      index = index + 1;
    }
  }

  genStatement(e, bodyOf(e.ast, node));

  // Checking saw to it that a function returning a value returns on every
  // path, so what reaches here is the end of a void function -- or of a
  // `void | SomeError` one, succeeding -- or nothing at all: the block after
  // a `while (true)`, which no branch goes to but LLVM still wants ended.
  if (!e.terminated) {
    if (returnType.isVoid()) {
      emitLine(e, "ret void");
    } else {
      let line: *Builder = Builder.new();
      line.add("ret ");
      line.add(llvmTypeName(returnType));
      line.push(' ');
      line.add(zeroValue(returnType));
      emitLine(e, line.data);
    }
  }

  emitterExitScope(e);
  e.body.add("}\n\n");

  let spliced: *Builder = Builder.new();
  spliced.addBytes(e.body.data, entry);
  spliced.addBytes(e.allocas.data, e.allocas.length);
  spliced.addBytes(e.body.data + entry, e.body.length - entry);
  e.body = spliced;
}

// A global's initialiser becomes an LLVM constant initialiser, so it is
// folded here rather than being computed at run time.
fn genConstant(e: *Emitter, node: i32, type: Type): *i8 {
  let kind: NodeKind = e.ast.nodes[node].kind;

  // An integer's value was worked out by the analyzer.
  if (type.isInteger() && kind != NodeKind.Number) {
    return fromInt(e.an.values[node]);
  }
  // Any other global made from an earlier one shares its initialiser.
  let source: i32 = globalDeclOf(e.an, node);
  if (source != NO_NODE) {
    return genConstant(e, varDeclOf(e.ast, source).value, type);
  }

  if (kind == NodeKind.String) {
    return internString(e, nodeName(e.ast, node),
                        nodeTextLength(e.ast, node));
  }
  if (kind == NodeKind.Null) {
    return "null";
  }
  if (kind == NodeKind.Ident) {
    return llvmName('@', e.an.linkNames[node]);
  }
  if (kind == NodeKind.Lambda) {
    return lambdaValue(e, node);
  }
  if (kind == NodeKind.FieldAccess) {
    return fromInt(e.an.values[node]);
  }
  let syntax: Syntax = e.ast.nodes[node].syntax;
  match (syntax) {
    Cast => {
      return genConstant(e, syntax.value, type);
    }
    // A constant global's initialiser was folded where it could be; what is
    // left of a unary operator here is a minus in front of a constant.
    Unary => {
      let inner: *i8 = genConstant(e, syntax.operand, type);
      let out: *Builder = Builder.new();
      out.push('-');
      out.add(inner);
      return out.take();
    }
    Sizeof => {
      return fromInt(sizeOf(e.an.structs, analyzerParseType(e.an, syntax.type)) as i64);
    }
    else => {}
  }
  if (kind == NodeKind.Bool) {
    let literal: Syntax = e.ast.nodes[node].syntax;
    if (literal is BoolLit) {
      if (literal.value) {
        return "true";
      }
    }
    return "false";
  }
  if (kind == NodeKind.Char) {
    return genCharLiteral(e, node);
  }

  // A pointer-typed global cannot be initialised from a bare integer: LLVM
  // wants `null` for zero, and an inttoptr for anything else. This is the one
  // place a constant's spelling depends on the type it is being stored into.
  if (type.isPointer()) {
    let text: *i8 = genNumberLiteral(e, node);

    if (equals(text, "0")) {
      return "null";
    }

    let out: *Builder = Builder.new();
    out.add("inttoptr (i64 ");
    out.add(text);
    out.add(" to ptr)");

    return out.take();
  }

  return genNumberLiteral(e, node);
}

fn genGlobal(e: *Emitter, node: i32): void {
  let type: Type = analyzerParseType(e.an, varDeclOf(e.ast, node).type);

  // The string constant, if any, has to be emitted before the global that
  // points at it.
  let value: *i8 = genConstant(e, varDeclOf(e.ast, node).value, type);

  e.head.add(llvmName('@', e.an.linkNames[node]));
  e.head.add(" = global ");
  e.head.add(llvmTypeName(type));
  e.head.push(' ');
  e.head.add(value);
  e.head.push('\n');
}

export fn genProgram(e: *Emitter, program: i32): *i8 {
  let count: i32 = itemCount(e.ast, program);

  // Named struct types come first, so a function signature can mention one.
  let index: i32 = 0;
  while (index < e.an.structs.count) {
    e.head.add(llvmName('%', e.an.structs.items[index].name));
    e.head.add(" = type { ");

    let field: i32 = 0;
    while (field < e.an.structs.items[index].count) {
      if (field > 0) {
        e.head.add(", ");
      }
      e.head.add(llvmTypeName(e.an.structs.items[index].fields[field].type));
      field = field + 1;
    }

    e.head.add(" }\n");
    index = index + 1;
  }

  // Several files may declare one extern, and LLVM takes one declaration.
  let declared: *NameSet = e.externs;
  for (index in 0..count) {
    let statement: i32 = itemAt(e.ast, program, index);
    if (e.ast.nodes[statement].kind == NodeKind.Extern &&
        !declared.has(e.an.linkNames[statement])) {
      declared.add(e.an.linkNames[statement]);
      emitSignature(e, e.head, statement, "declare");
      e.head.push('\n');
    }
  }

  for (index in 0..count) {
    let statement: i32 = itemAt(e.ast, program, index);
    if (e.ast.nodes[statement].kind == NodeKind.VarDecl) {
      genGlobal(e, statement);
    }
  }

  // Under `ode test`, each test is a function, listed for the runner by its
  // address and its name.
  let tests: *Builder = Builder.new();
  let testNames: *Builder = Builder.new();
  let testCount: i32 = 0;

  for (index in 0..count) {
    let statement: i32 = itemAt(e.ast, program, index);
    // A generic is compiled as its instances, which are items of their own.
    if (isTemplate(e.an, statement)) {
      continue;
    }

    if (e.ast.nodes[statement].kind == NodeKind.Test && TEST_MODE &&
        runsTestsOf(e.ast.nodes[statement].module)) {
      let name: *Builder = Builder.new();
      name.add("ode.test.");
      name.addInt(testCount as i64);
      e.an.linkNames[statement] = name.take();
      genFunction(e, statement);

      if (testCount > 0) {
        tests.add(", ");
        testNames.add(", ");
      }
      tests.add("ptr ");
      tests.add(llvmName('@', e.an.linkNames[statement]));
      testNames.add("ptr ");
      testNames.add(internString(e, nodeName(e.ast, statement),
                                 nodeTextLength(e.ast, statement)));
      testCount = testCount + 1;
    }

    if (e.ast.nodes[statement].kind == NodeKind.Fn) {
      genFunction(e, statement);
    }

    // A struct's methods are functions like any other once named.
    if (e.ast.nodes[statement].kind == NodeKind.Struct) {
      for (member in 0..itemCount(e.ast, statement)) {
        let method: i32 = itemAt(e.ast, statement, member);
        if (e.ast.nodes[method].kind == NodeKind.Fn) {
          genFunction(e, method);
        }
      }
    }
  }

  // The lambdas met on the way, and any met inside those.
  let lambda: i64 = 0;
  while (lambda < e.lambdas.count) {
    genFunction(e, e.lambdas.at(lambda));
    lambda = lambda + 1;
  }

  if (TEST_MODE && targetsWasm()) {
    emitWasmTestExports(e, tests, testNames, testCount);
  } else if (TEST_MODE) {
    emitTestMain(e, program, tests, testNames, testCount);
  }
  emitCheckSupport(e, declared);
  emitEnumNames(e);

  let module: *Builder = Builder.new();
  // The default target is left to the C compiler, so that the IR builds
  // wherever it is taken.
  if (TARGET != null) {
    module.add("target triple = \"");
    module.add(TARGET.triple());
    module.add("\"\n\n");
  }
  module.addBytes(e.head.data, e.head.length);
  module.push('\n');
  module.addBytes(e.body.data, e.body.length);

  return module.take();
}
