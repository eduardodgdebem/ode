// ---------------------------------------------------------------------------
// Tokens.
//
// Kinds are plain integer globals rather than an enum, and they are grouped in
// tens so a new operator can be added without renumbering the delimiters.
// ---------------------------------------------------------------------------

import { malloc, realloc } from "../support/libc";

// Not a token: the state before the first one has been read.
export let TK_NONE: i32 = -1;

export let TK_END: i32 = 0;
export let TK_IDENT: i32 = 1;
export let TK_NUMBER: i32 = 2;
export let TK_STRING: i32 = 3;
export let TK_CHAR: i32 = 4;
export let TK_BOOL: i32 = 5;
export let TK_TYPE: i32 = 6;

export let TK_LET: i32 = 10;
export let TK_IF: i32 = 11;
export let TK_ELSE: i32 = 12;
export let TK_FN: i32 = 13;
export let TK_EXTERN: i32 = 14;
export let TK_STRUCT: i32 = 15;
export let TK_SIZEOF: i32 = 16;
export let TK_RETURN: i32 = 17;
export let TK_WHILE: i32 = 18;
export let TK_BREAK: i32 = 19;
export let TK_CONTINUE: i32 = 20;
export let TK_PRINT: i32 = 21;
export let TK_AS: i32 = 22;
export let TK_IMPORT: i32 = 23;
export let TK_EXPORT: i32 = 24;
export let TK_NULL: i32 = 25;
export let TK_ENUM: i32 = 26;
export let TK_MATCH: i32 = 27;

export let TK_ASSIGN: i32 = 30;
export let TK_PLUS: i32 = 31;
export let TK_MINUS: i32 = 32;
export let TK_STAR: i32 = 33;
export let TK_SLASH: i32 = 34;
export let TK_PERCENT: i32 = 35;
export let TK_NOT: i32 = 36;
export let TK_AMP: i32 = 37;
export let TK_PIPE: i32 = 38;
export let TK_CARET: i32 = 39;
export let TK_SHL: i32 = 40;
export let TK_SHR: i32 = 41;
export let TK_ANDAND: i32 = 42;
export let TK_OROR: i32 = 43;
export let TK_EQ: i32 = 44;
export let TK_NE: i32 = 45;
export let TK_LT: i32 = 46;
export let TK_LE: i32 = 47;
export let TK_GT: i32 = 48;
export let TK_GE: i32 = 49;

export let TK_PLUS_ASSIGN: i32 = 50;
export let TK_MINUS_ASSIGN: i32 = 51;
export let TK_STAR_ASSIGN: i32 = 52;
export let TK_SLASH_ASSIGN: i32 = 53;
export let TK_PERCENT_ASSIGN: i32 = 54;

export let TK_LPAREN: i32 = 60;
export let TK_RPAREN: i32 = 61;
export let TK_LBRACE: i32 = 62;
export let TK_RBRACE: i32 = 63;
export let TK_LBRACKET: i32 = 64;
export let TK_RBRACKET: i32 = 65;
export let TK_DOT: i32 = 66;
export let TK_SEMICOLON: i32 = 67;
export let TK_COMMA: i32 = 68;
export let TK_COLON: i32 = 69;

// `=>`, between a match arm's patterns and its body.
export let TK_ARROW: i32 = 70;

export struct Token {
  kind: i32,
  // The token's own text, owned. A number keeps its digits and a string keeps
  // its decoded contents; the parser is what turns either into a value.
  text: *i8,
  // Bytes in `text`, which is not always strlen: a `'\0'` literal is one byte
  // of NUL, and strlen would call it empty.
  length: i64,
  line: i32,
  column: i32,
}

export struct TokenList {
  items: *Token,
  count: i32,
  capacity: i32,

  fn new(): *TokenList {
    let list: *TokenList = malloc(sizeof(TokenList) as i64) as *TokenList;
    list.capacity = 256;
    list.count = 0;
    list.items = malloc(sizeof(Token) as i64 * list.capacity as i64) as *Token;

    return list;
  }

  fn add(self: *TokenList, kind: i32, text: *i8, length: i64,
         line: i32, column: i32): void {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = realloc(self.items as *i8,
                           sizeof(Token) as i64 * self.capacity as i64) as *Token;
    }

    let index: i32 = self.count;
    self.items[index].kind = kind;
    self.items[index].text = text;
    self.items[index].length = length;
    self.items[index].line = line;
    self.items[index].column = column;
    self.count = self.count + 1;
  }

  // The parser walks tokens through this rather than by index, so that reading
  // past the end yields an end token instead of running off the allocation.
  fn at(self: *TokenList, index: i32): *Token {
    if (index >= self.count) {
      return self.items + (self.count - 1);
    }

    return self.items + index;
  }
}

export fn kindName(kind: i32): *i8 {
  if (kind == TK_END) { return "end"; }
  if (kind == TK_IDENT) { return "ident"; }
  if (kind == TK_NUMBER) { return "number"; }
  if (kind == TK_STRING) { return "string"; }
  if (kind == TK_CHAR) { return "char"; }
  if (kind == TK_BOOL) { return "bool"; }
  if (kind == TK_TYPE) { return "type"; }

  if (kind == TK_LET) { return "let"; }
  if (kind == TK_IF) { return "if"; }
  if (kind == TK_ELSE) { return "else"; }
  if (kind == TK_FN) { return "fn"; }
  if (kind == TK_EXTERN) { return "extern"; }
  if (kind == TK_STRUCT) { return "struct"; }
  if (kind == TK_SIZEOF) { return "sizeof"; }
  if (kind == TK_RETURN) { return "return"; }
  if (kind == TK_WHILE) { return "while"; }
  if (kind == TK_BREAK) { return "break"; }
  if (kind == TK_CONTINUE) { return "continue"; }
  if (kind == TK_PRINT) { return "print"; }
  if (kind == TK_AS) { return "as"; }
  if (kind == TK_IMPORT) { return "import"; }
  if (kind == TK_EXPORT) { return "export"; }
  if (kind == TK_NULL) { return "null"; }
  if (kind == TK_ENUM) { return "enum"; }
  if (kind == TK_MATCH) { return "match"; }

  if (kind == TK_ASSIGN) { return "="; }
  if (kind == TK_PLUS) { return "+"; }
  if (kind == TK_MINUS) { return "-"; }
  if (kind == TK_STAR) { return "*"; }
  if (kind == TK_SLASH) { return "/"; }
  if (kind == TK_PERCENT) { return "%"; }
  if (kind == TK_NOT) { return "!"; }
  if (kind == TK_AMP) { return "&"; }
  if (kind == TK_PIPE) { return "|"; }
  if (kind == TK_CARET) { return "^"; }
  if (kind == TK_SHL) { return "<<"; }
  if (kind == TK_SHR) { return ">>"; }
  if (kind == TK_ANDAND) { return "&&"; }
  if (kind == TK_OROR) { return "||"; }
  if (kind == TK_EQ) { return "=="; }
  if (kind == TK_NE) { return "!="; }
  if (kind == TK_LT) { return "<"; }
  if (kind == TK_LE) { return "<="; }
  if (kind == TK_GT) { return ">"; }
  if (kind == TK_GE) { return ">="; }

  if (kind == TK_PLUS_ASSIGN) { return "+="; }
  if (kind == TK_MINUS_ASSIGN) { return "-="; }
  if (kind == TK_STAR_ASSIGN) { return "*="; }
  if (kind == TK_SLASH_ASSIGN) { return "/="; }
  if (kind == TK_PERCENT_ASSIGN) { return "%="; }

  if (kind == TK_LPAREN) { return "("; }
  if (kind == TK_RPAREN) { return ")"; }
  if (kind == TK_LBRACE) { return "{"; }
  if (kind == TK_RBRACE) { return "}"; }
  if (kind == TK_LBRACKET) { return "["; }
  if (kind == TK_RBRACKET) { return "]"; }
  if (kind == TK_DOT) { return "."; }
  if (kind == TK_SEMICOLON) { return ";"; }
  if (kind == TK_COMMA) { return ","; }
  if (kind == TK_COLON) { return ":"; }
  if (kind == TK_ARROW) { return "=>"; }

  return "?";
}
