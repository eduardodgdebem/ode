// ---------------------------------------------------------------------------
// Tokens.
//
// A token is its kind, its text, and where it starts.
// ---------------------------------------------------------------------------

import { alloc, grow } from "std/mem";
import { line } from "../driver/options";
import { Type } from "../types/types";

export enum TokenKind {
  // Not a token: the state before the first one has been read.
  None,
  End,
  Ident,
  Number,
  String,
  Char,
  Bool,
  Type,
  Let,
  If,
  Else,
  Fn,
  Extern,
  Struct,
  Sizeof,
  Return,
  // `try` and `catch`, which pass on an error or handle it.
  Try,
  Catch,
  While,
  Break,
  Continue,
  As,
  Import,
  Export,
  Null,
  Enum,
  Match,
  For,
  Assign,
  Plus,
  Minus,
  Star,
  Slash,
  Percent,
  Not,
  Amp,
  Pipe,
  Caret,
  Shl,
  Shr,
  AndAnd,
  OrOr,
  Eq,
  Ne,
  Lt,
  Le,
  Gt,
  Ge,
  PlusAssign,
  MinusAssign,
  StarAssign,
  SlashAssign,
  PercentAssign,
  LParen,
  RParen,
  LBrace,
  RBrace,
  LBracket,
  RBracket,
  Dot,
  Semicolon,
  Comma,
  Colon,
  // `=>`, between a match arm's patterns and its body.
  Arrow,
  // `..`, between a for loop's bounds.
  DotDot,
  // `...`, ending a variadic extern's parameters.
  Ellipsis,
  // `??`, a value's fallback.
  Coalesce,
}
// Not a token: the state before the first one has been read.







export struct Token {
  kind: TokenKind,
  // The token's own text, owned. A number keeps its digits and a string keeps
  // its decoded contents; the parser is what turns either into a value.
  text: *i8,
  // Bytes in `text`, which is not always strlen: a `'\0'` literal is one byte
  // of NUL, and strlen would call it empty.
  length: i64,
  line: i32,
  column: i32,
}

export struct TokenList {
  items: *Token,
  count: i32,
  capacity: i32,

  fn new(): *TokenList {
    let list: *TokenList = alloc<TokenList>(1);
    list.capacity = 256;
    list.count = 0;
    list.items = alloc<Token>(list.capacity as i64);

    return list;
  }

  fn add(self: *TokenList, kind: TokenKind, text: *i8, length: i64,
         line: i32, column: i32): void {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = grow<Token>(self.items, self.capacity as i64);
    }

    let index: i32 = self.count;
    self.items[index].kind = kind;
    self.items[index].text = text;
    self.items[index].length = length;
    self.items[index].line = line;
    self.items[index].column = column;
    self.count = self.count + 1;
  }

  // The parser walks tokens through this rather than by index, so that reading
  // past the end yields an end token instead of running off the allocation.
  fn at(self: *TokenList, index: i32): *Token {
    if (index >= self.count) {
      return self.items + (self.count - 1);
    }

    return self.items + index;
  }
}

export fn kindName(kind: TokenKind): *i8 {
  return match (kind) {
    .End => "end",
    .Ident => "ident",
    .Number => "number",
    .String => "string",
    .Char => "char",
    .Bool => "bool",
    .Type => "type",
    .Let => "let",
    .If => "if",
    .Else => "else",
    .Fn => "fn",
    .Extern => "extern",
    .Struct => "struct",
    .Sizeof => "sizeof",
    .Return => "return",
    .Try => "try",
    .Catch => "catch",
    .While => "while",
    .Break => "break",
    .Continue => "continue",
    .As => "as",
    .Import => "import",
    .Export => "export",
    .Null => "null",
    .Enum => "enum",
    .Match => "match",
    .For => "for",
    .Assign => "=",
    .Plus => "+",
    .Minus => "-",
    .Star => "*",
    .Slash => "/",
    .Percent => "%",
    .Not => "!",
    .Amp => "&",
    .Pipe => "|",
    .Caret => "^",
    .Shl => "<<",
    .Shr => ">>",
    .AndAnd => "&&",
    .OrOr => "||",
    .Eq => "==",
    .Ne => "!=",
    .Lt => "<",
    .Le => "<=",
    .Gt => ">",
    .Ge => ">=",
    .PlusAssign => "+=",
    .MinusAssign => "-=",
    .StarAssign => "*=",
    .SlashAssign => "/=",
    .PercentAssign => "%=",
    .LParen => "(",
    .RParen => ")",
    .LBrace => "{",
    .RBrace => "}",
    .LBracket => "[",
    .RBracket => "]",
    .Dot => ".",
    .Semicolon => ";",
    .Comma => ",",
    .Colon => ":",
    .Arrow => "=>",
    .DotDot => "..",
    .Ellipsis => "...",
    .Coalesce => "??",
    else => "?",
  };
}
