// ---------------------------------------------------------------------------
// Lexer.
//
// One pass over the source. Position is tracked as a byte offset plus a line
// and column, so every token can be pointed at in a diagnostic.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { Builder, equals, copy, slice } from "std/text";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED, report } from "../diagnostics/report";
import { line } from "../driver/options";
import { TokenKind, TokenList, kindName } from "./token";

struct Lexer {
  source: *i8,
  pos: i64,
  length: i64,
  line: i32,
  column: i32,

  fn new(source: *i8): *Lexer {
    let lexer: *Lexer = alloc<Lexer>(1);
    lexer.source = source;
    lexer.pos = 0;
    lexer.length = strlen(source);
    lexer.line = 1;
    lexer.column = 1;

    return lexer;
  }

  fn atEnd(self: *Lexer): bool {
    return self.pos >= self.length;
  }

  fn peek(self: *Lexer): i8 {
    if (self.atEnd()) {
      return 0;
    }

    return self.source[self.pos];
  }

  fn peekNext(self: *Lexer): i8 {
    if (self.pos + 1 >= self.length) {
      return 0;
    }

    return self.source[self.pos + 1];
  }

  fn advance(self: *Lexer): i8 {
    let character: i8 = self.peek();
    self.pos = self.pos + 1;

    if (character == '\n') {
      self.line = self.line + 1;
      self.column = 1;
    } else {
      self.column = self.column + 1;
    }

    return character;
  }

  // Whitespace and `//` comments, which run to the end of the line.
  fn skipTrivia(self: *Lexer): void {
    while (!self.atEnd()) {
      let character: i8 = self.peek();

      if (isSpace(character)) {
        self.advance();
        continue;
      }

      if (character == '/' && self.peekNext() == '/') {
        while (!self.atEnd() && self.peek() != '\n') {
          self.advance();
        }
        continue;
      }

      return;
    }
  }

  fn readIdentifier(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let start: i64 = self.pos;

    while (!self.atEnd() && isAlphaNumeric(self.peek())) {
      self.advance();
    }

    let count: i64 = self.pos - start;
    let text: *i8 = slice(self.source, start, count);
    list.add(keywordKind(text), text, count, line, column);
  }

  fn readNumber(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let start: i64 = self.pos;

    if (self.peek() == '-') {
      self.advance();
    }

    // Digits and dots both run on, so `1.` and `1.2.3` lex as one number here
    // and are rejected later, with a message about the whole of it. The
    // exception is `..`, which ends the number: `0..n` is a range.
    while (!self.atEnd() &&
           (isDigit(self.peek()) || self.peek() == '.')) {
      if (self.peek() == '.' && self.peekNext() == '.') {
        break;
      }
      self.advance();
    }

    let count: i64 = self.pos - start;
    let text: *i8 = slice(self.source, start, count);
    list.add(TokenKind.Number, text, count, line, column);
  }

  fn readString(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();

    let text: *Builder = Builder.new();

    while (true) {
      if (self.atEnd()) {
        lexError(Problem.UnterminatedString, line, column);
        break;
      }

      let character: i8 = self.peek();
      if (character == '"') {
        self.advance();
        break;
      }
      // The string is taken to end with its line, so the next line lexes as
      // it was written.
      if (character == '\n') {
        lexError(Problem.StringCrossesLine, line, column);
        break;
      }

      if (character == '\\') {
        text.push(self.readEscape());
        continue;
      }

      text.push(self.advance());
    }

    let count: i64 = text.length;
    list.add(TokenKind.String, text.take(), count, line, column);
  }

  // `...`: a string written as it is, across lines if need be. Nothing in
  // it is an escape. `${` is rejected rather than kept as text: anyone used
  // to template literals would read it as interpolation, which Ode does not
  // have. A string whose opening backtick ends its line is a block; see
  // dedent.
  fn readRawString(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();

    let raw: *Builder = Builder.new();
    while (self.peek() != '`') {
      if (self.atEnd()) {
        lexError(Problem.UnterminatedString, line, column);
        break;
      }
      if (self.peek() == '$' && self.peekNext() == '{') {
        lexError(Problem.StringInterpolation, self.line, self.column);
      }
      raw.push(self.advance());
    }
    if (!self.atEnd()) {
      self.advance();
    }

    let text: *i8 = raw.take();
    if (text[0] == '\n') {
      text = dedent(text + 1);
    }

    list.add(TokenKind.String, text, strlen(text), line, column);
  }

  // The byte a backslash escape stands for, reading it from the backslash:
  // `\n`, `\t`, `\r`, `\0`, `\\`, `\"`, `\'`, or `\x` and two hex digits.
  fn readEscape(self: *Lexer): i8 {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();
    let escaped: i8 = self.advance();

    if (escaped == 'x') {
      let high: i32 = hexValue(self.peek());
      let low: i32 = hexValue(self.peekNext());
      if (high < 0 || low < 0) {
        lexError(Problem.BadHexEscape, line, column);
        return 0;
      }
      self.advance();
      self.advance();
      return (high * 16 + low) as i8;
    }

    return escapeValue(escaped, line, column);
  }

  fn readChar(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();

    let text: *Builder = Builder.new();
    let character: i8 = self.advance();

    if (character == '\\') {
      self.pos = self.pos - 1;
      self.column = self.column - 1;
      text.push(self.readEscape());
    } else {
      text.push(character);
    }

    if (self.peek() != '\'') {
      lexError(Problem.CharacterLiteralLength, line, column);
      // Skip to its closing quote, if it has one on this line.
      while (!self.atEnd() && self.peek() != '\'' && self.peek() != '\n') {
        self.advance();
      }
    }
    if (self.peek() == '\'') {
      self.advance();
    }

    let count: i64 = text.length;
    list.add(TokenKind.Char, text.take(), count, line, column);
  }

  // Longer operators are tried before shorter ones, so `<=` never lexes as `<`
  // followed by `=`.
  fn readOperator(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let first: i8 = self.peek();
    let second: i8 = self.peekNext();
    let kind: TokenKind = TokenKind.None;

    // `...` is the one three-character operator.
    if (first == '.' && second == '.' && self.pos + 2 < self.length &&
        self.source[self.pos + 2] == '.') {
      for (step in 0..3) {
        self.advance();
      }
      list.add(TokenKind.Ellipsis, copy("..."), 3, line, column);
      return;
    }

    if (first == '=' && second == '=') { kind = TokenKind.Eq; }
    else if (first == '=' && second == '>') { kind = TokenKind.Arrow; }
    else if (first == '.' && second == '.') { kind = TokenKind.DotDot; }
    else if (first == '!' && second == '=') { kind = TokenKind.Ne; }
    else if (first == '<' && second == '=') { kind = TokenKind.Le; }
    else if (first == '>' && second == '=') { kind = TokenKind.Ge; }
    else if (first == '&' && second == '&') { kind = TokenKind.AndAnd; }
    else if (first == '|' && second == '|') { kind = TokenKind.OrOr; }
    else if (first == '?' && second == '?') { kind = TokenKind.Coalesce; }
    else if (first == '<' && second == '<') { kind = TokenKind.Shl; }
    else if (first == '>' && second == '>') { kind = TokenKind.Shr; }
    else if (first == '+' && second == '=') { kind = TokenKind.PlusAssign; }
    else if (first == '-' && second == '=') { kind = TokenKind.MinusAssign; }
    else if (first == '*' && second == '=') { kind = TokenKind.StarAssign; }
    else if (first == '/' && second == '=') { kind = TokenKind.SlashAssign; }
    else if (first == '%' && second == '=') { kind = TokenKind.PercentAssign; }

    if (kind != TokenKind.None) {
      self.advance();
      self.advance();
      list.add(kind, copy(kindName(kind)),
               strlen(kindName(kind)), line, column);
      return;
    }

    if (first == '=') { kind = TokenKind.Assign; }
    else if (first == '+') { kind = TokenKind.Plus; }
    else if (first == '-') { kind = TokenKind.Minus; }
    else if (first == '*') { kind = TokenKind.Star; }
    else if (first == '/') { kind = TokenKind.Slash; }
    else if (first == '%') { kind = TokenKind.Percent; }
    else if (first == '!') { kind = TokenKind.Not; }
    else if (first == '&') { kind = TokenKind.Amp; }
    else if (first == '|') { kind = TokenKind.Pipe; }
    else if (first == '^') { kind = TokenKind.Caret; }
    else if (first == '<') { kind = TokenKind.Lt; }
    else if (first == '>') { kind = TokenKind.Gt; }
    else if (first == '(') { kind = TokenKind.LParen; }
    else if (first == ')') { kind = TokenKind.RParen; }
    else if (first == '{') { kind = TokenKind.LBrace; }
    else if (first == '}') { kind = TokenKind.RBrace; }
    else if (first == '[') { kind = TokenKind.LBracket; }
    else if (first == ']') { kind = TokenKind.RBracket; }
    else if (first == '.') { kind = TokenKind.Dot; }
    else if (first == ';') { kind = TokenKind.Semicolon; }
    else if (first == ',') { kind = TokenKind.Comma; }
    else if (first == ':') { kind = TokenKind.Colon; }
    else {
      lexError(Problem.UnexpectedCharacter, line, column);
      self.advance();
      return;
    }

    self.advance();
    list.add(kind, copy(kindName(kind)), strlen(kindName(kind)),
             line, column);
  }
}

fn isDigit(character: i8): bool {
  return character >= '0' && character <= '9';
}

fn isAlpha(character: i8): bool {
  if (character >= 'a' && character <= 'z') {
    return true;
  }
  if (character >= 'A' && character <= 'Z') {
    return true;
  }

  return character == '_';
}

fn isAlphaNumeric(character: i8): bool {
  return isAlpha(character) || isDigit(character);
}

export fn isSpace(character: i8): bool {
  return character == ' ' || character == '\t' || character == '\n' ||
         character == '\r';
}

fn keywordKind(text: *i8): TokenKind {
  if (equals(text, "let")) { return TokenKind.Let; }
  if (equals(text, "if")) { return TokenKind.If; }
  if (equals(text, "else")) { return TokenKind.Else; }
  if (equals(text, "fn")) { return TokenKind.Fn; }
  if (equals(text, "extern")) { return TokenKind.Extern; }
  if (equals(text, "struct")) { return TokenKind.Struct; }
  if (equals(text, "sizeof")) { return TokenKind.Sizeof; }
  if (equals(text, "return")) { return TokenKind.Return; }
  if (equals(text, "try")) { return TokenKind.Try; }
  if (equals(text, "catch")) { return TokenKind.Catch; }
  if (equals(text, "while")) { return TokenKind.While; }
  if (equals(text, "break")) { return TokenKind.Break; }
  if (equals(text, "continue")) { return TokenKind.Continue; }
  if (equals(text, "as")) { return TokenKind.As; }
  if (equals(text, "import")) { return TokenKind.Import; }
  if (equals(text, "export")) { return TokenKind.Export; }
  if (equals(text, "null")) { return TokenKind.Null; }
  if (equals(text, "enum")) { return TokenKind.Enum; }
  if (equals(text, "match")) { return TokenKind.Match; }
  if (equals(text, "for")) { return TokenKind.For; }
  // `from` is not a keyword: it only means anything after an import list, and
  // it is too useful a name to take away everywhere else.
  if (equals(text, "true")) { return TokenKind.Bool; }
  if (equals(text, "false")) { return TokenKind.Bool; }

  // Type names are their own kind rather than identifiers, which is what the
  // parser reads to tell `let x: i32` from `let x: Point`.
  if (equals(text, "i8")) { return TokenKind.Type; }
  if (equals(text, "u8")) { return TokenKind.Type; }
  if (equals(text, "i16")) { return TokenKind.Type; }
  if (equals(text, "u16")) { return TokenKind.Type; }
  if (equals(text, "i32")) { return TokenKind.Type; }
  if (equals(text, "u32")) { return TokenKind.Type; }
  if (equals(text, "i64")) { return TokenKind.Type; }
  if (equals(text, "u64")) { return TokenKind.Type; }
  if (equals(text, "usize")) { return TokenKind.Type; }
  if (equals(text, "f32")) { return TokenKind.Type; }
  if (equals(text, "f64")) { return TokenKind.Type; }
  if (equals(text, "bool")) { return TokenKind.Type; }
  if (equals(text, "void")) { return TokenKind.Type; }

  return TokenKind.Ident;
}

// Decodes the character after a backslash, other than `x`; no unicode yet.
fn escapeValue(character: i8, line: i32, column: i32): i8 {
  if (character == 'n') { return '\n'; }
  if (character == 't') { return '\t'; }
  if (character == 'r') { return '\r'; }
  if (character == '0') { return 0; }
  if (character == '\\') { return '\\'; }
  if (character == '"') { return '"'; }
  if (character == '\'') { return '\''; }

  lexError(Problem.UnknownEscape, line, column);
  return character;
}

fn hexValue(character: i8): i32 {
  if (character >= '0' && character <= '9') {
    return (character - '0') as i32;
  }
  if (character >= 'a' && character <= 'f') {
    return (character - 'a') as i32 + 10;
  }
  if (character >= 'A' && character <= 'F') {
    return (character - 'A') as i32 + 10;
  }
  return -1;
}

// Records a lexer error and carries on: each is a mistake of its own, so every
// one in the file is reported, though none of the file is parsed.
fn lexError(problem: Problem, line: i32, column: i32): void {
  report(problem, line, column, Facts.none());
  FAILED = false;
}

// A leading `-` belongs to the literal only where the previous token cannot
// end an expression, which is what makes `print(-17 % 5)` one negative number
// and `x = 5 - 3` a subtraction. Note that `=` is absent from the set, so
// `let c: i32 = --5;` is a negation of `-5`.
fn foldsNegative(lastKind: TokenKind): bool {
  if (lastKind == TokenKind.None) {
    return true;
  }

  match (lastKind) {
    TokenKind.Eq, TokenKind.Ne => { return true; }
    TokenKind.Lt, TokenKind.Le => { return true; }
    TokenKind.Gt, TokenKind.Ge => { return true; }
    TokenKind.Plus, TokenKind.Minus => { return true; }
    TokenKind.Star, TokenKind.Slash => { return true; }
    TokenKind.AndAnd, TokenKind.OrOr => { return true; }
    TokenKind.LParen, TokenKind.LBrace => { return true; }
    TokenKind.Comma, TokenKind.Colon => { return true; }
    TokenKind.Coalesce, TokenKind.Try => { return true; }
    else => {}
  }

  return lastKind == TokenKind.Return;
}

// A block of text, written indented to match the code around it, as the text
// it stands for: the indentation every non-blank line shares is removed, and
// so is a last line holding nothing but the indentation of the closing
// delimiter. The text then ends with the newline before it.
//
//   let program: *i8 = `
//     fn main(): i32 {
//       return 0;
//     }
//   `;                       // "fn main(): i32 {\n  return 0;\n}\n"
fn dedent(text: *i8): *i8 {
  let lines: *List<*i8> = List<*i8>.new();
  let start: i64 = 0;
  let index: i64 = 0;
  while (true) {
    if (text[index] == '\n' || text[index] == '\0') {
      lines.push(slice(text, start, index - start));
      if (text[index] == '\0') {
        break;
      }
      start = index + 1;
    }
    index = index + 1;
  }

  // The closing delimiter's own line.
  let closing: bool = lines.count > 1 && isBlank(lines.last());
  if (closing) {
    lines.pop();
  }

  let indent: i64 = -1;
  for (line in 0..lines.count) {
    let text: *i8 = lines.at(line);
    if (!isBlank(text)) {
      let width: i64 = 0;
      while (text[width] == ' ' || text[width] == '\t') {
        width = width + 1;
      }
      if (indent < 0 || width < indent) {
        indent = width;
      }
    }
  }

  let out: *Builder = Builder.new();
  for (line in 0..lines.count) {
    let text: *i8 = lines.at(line);
    if (!isBlank(text)) {
      out.add(text + indent);
    }
    if (line < lines.count - 1 || closing) {
      out.push('\n');
    }
  }

  return out.take();
}

fn isBlank(text: *i8): bool {
  let index: i64 = 0;
  while (text[index] == ' ' || text[index] == '\t') {
    index = index + 1;
  }
  return text[index] == '\0';
}

export fn tokenize(source: *i8): *TokenList {
  let lexer: *Lexer = Lexer.new(source);
  let list: *TokenList = TokenList.new();
  // What the negative-literal rule reads to decide whether a `-` starts a
  // number or is an operator.
  let lastKind: TokenKind = TokenKind.None;

  while (true) {
    lexer.skipTrivia();
    if (lexer.atEnd()) {
      break;
    }

    let character: i8 = lexer.peek();

    if (isAlpha(character)) {
      lexer.readIdentifier(list);
    } else if (isDigit(character)) {
      lexer.readNumber(list);
    } else if (character == '-' && isDigit(lexer.peekNext()) &&
               foldsNegative(lastKind)) {
      lexer.readNumber(list);
    } else if (character == '"') {
      lexer.readString(list);
    } else if (character == '`') {
      lexer.readRawString(list);
    } else if (character == '\'') {
      lexer.readChar(list);
    } else {
      lexer.readOperator(list);
    }

    lastKind = list.at(list.count - 1).kind;
  }

  // The end token carries no position, so a diagnostic about running out of
  // input names the file rather than pointing past its last line.
  list.add(TokenKind.End, copy(""), 0, 0, 0);

  return list;
}

test "the lexer prefers the longest operator" {
  let tokens: *TokenList = tokenize("a <<= ... .. b");
  assertEq(tokens.at(0).kind, TokenKind.Ident);
  assertEq(tokens.at(1).kind, TokenKind.Shl);
  assertEq(tokens.at(2).kind, TokenKind.Assign);
  assertEq(tokens.at(3).kind, TokenKind.Ellipsis);
  assertEq(tokens.at(4).kind, TokenKind.DotDot);
  assertEq(tokens.at(5).text, "b");
}

test "character escapes decode to their byte" {
  let tokens: *TokenList = tokenize("'\\n' '\\0' \"a\\tb\"");
  assertEq(tokens.at(0).text[0], '\n');
  assertEq(tokens.at(1).length, 1);
  assertEq(tokens.at(2).text, "a\tb");
}

test "a raw string keeps everything as written" {
  let tokens: *TokenList = tokenize("`a\\n \"b\" 'c'`");
  assertEq(tokens.at(0).kind, TokenKind.String);
  assertEq(tokens.at(0).text, "a\\n \"b\" 'c'");
}

test "a block string loses the indentation it shares" {
  assertEq(dedent("    fn main() {\n      return;\n    }\n  "),
           "fn main() {\n  return;\n}\n");
  assertEq(dedent("  a\n\n    b\n"), "a\n\n  b\n");
  assertEq(dedent("  one line"), "one line");
  assertEq(dedent(""), "");
}

test "a raw string that does not start a line is not dedented" {
  let tokens: *TokenList = tokenize("`  kept\n  as is`");
  assertEq(tokens.at(0).text, "  kept\n  as is");
}

test "hex escapes give any byte" {
  let tokens: *TokenList = tokenize("\"\\x1b[0m\" '\\xff' '\\x41'");
  assertEq(tokens.at(0).text[0], 27);
  assertEq(slice(tokens.at(0).text, 1, 3), "[0m");
  assertEq(tokens.at(1).text[0] as u8, 255);
  assertEq(tokens.at(2).text[0], 'A');
}
