// ---------------------------------------------------------------------------
// Lexer.
//
// One pass over the source. Position is tracked as a byte offset plus a line
// and column, so every token can be pointed at in a diagnostic.
// ---------------------------------------------------------------------------

import { malloc, strlen } from "../support/libc";
import { Buf, textEquals, textCopy, textSlice } from "../support/text";
import { failAt } from "../support/diagnostics";
import { TokenKind, TokenList, kindName } from "./token";

struct Lexer {
  source: *i8,
  pos: i64,
  length: i64,
  line: i32,
  column: i32,

  fn new(source: *i8): *Lexer {
    let lexer: *Lexer = malloc(sizeof(Lexer)) as *Lexer;
    lexer.source = source;
    lexer.pos = 0;
    lexer.length = strlen(source);
    lexer.line = 1;
    lexer.column = 1;

    return lexer;
  }

  fn atEnd(self: *Lexer): bool {
    return self.pos >= self.length;
  }

  fn peek(self: *Lexer): i8 {
    if (self.atEnd()) {
      return 0;
    }

    return self.source[self.pos];
  }

  fn peekNext(self: *Lexer): i8 {
    if (self.pos + 1 >= self.length) {
      return 0;
    }

    return self.source[self.pos + 1];
  }

  fn advance(self: *Lexer): i8 {
    let character: i8 = self.peek();
    self.pos = self.pos + 1;

    if (character == '\n') {
      self.line = self.line + 1;
      self.column = 1;
    } else {
      self.column = self.column + 1;
    }

    return character;
  }

  // Whitespace and `//` comments, which run to the end of the line.
  fn skipTrivia(self: *Lexer): void {
    while (!self.atEnd()) {
      let character: i8 = self.peek();

      if (isSpace(character)) {
        self.advance();
        continue;
      }

      if (character == '/' && self.peekNext() == '/') {
        while (!self.atEnd() && self.peek() != '\n') {
          self.advance();
        }
        continue;
      }

      return;
    }
  }

  fn readIdentifier(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let start: i64 = self.pos;

    while (!self.atEnd() && isAlphaNumeric(self.peek())) {
      self.advance();
    }

    let count: i64 = self.pos - start;
    let text: *i8 = textSlice(self.source, start, count);
    list.add(keywordKind(text), text, count, line, column);
  }

  fn readNumber(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let start: i64 = self.pos;

    if (self.peek() == '-') {
      self.advance();
    }

    // Digits and dots both run on, so `1.` and `1.2.3` lex as one number here
    // and are rejected later, with a message about the whole of it. The
    // exception is `..`, which ends the number: `0..n` is a range.
    while (!self.atEnd() &&
           (isDigit(self.peek()) || self.peek() == '.')) {
      if (self.peek() == '.' && self.peekNext() == '.') {
        break;
      }
      self.advance();
    }

    let count: i64 = self.pos - start;
    let text: *i8 = textSlice(self.source, start, count);
    list.add(TokenKind.Number, text, count, line, column);
  }

  fn readString(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();

    let text: *Buf = Buf.new();

    while (true) {
      if (self.atEnd()) {
        failAt(line, column, "unterminated string literal");
      }

      let character: i8 = self.peek();
      if (character == '"') {
        self.advance();
        break;
      }
      if (character == '\n') {
        failAt(line, column, "string literal may not cross a newline");
      }

      if (character == '\\') {
        self.advance();
        let escaped: i8 = self.advance();
        text.push(escapeValue(escaped, self.line, self.column));
        continue;
      }

      text.push(self.advance());
    }

    let count: i64 = text.length;
    list.add(TokenKind.String, text.take(), count, line, column);
  }

  fn readChar(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    self.advance();

    let text: *Buf = Buf.new();
    let character: i8 = self.advance();

    if (character == '\\') {
      let escaped: i8 = self.advance();
      text.push(escapeValue(escaped, line, column));
    } else {
      text.push(character);
    }

    if (self.peek() != '\'') {
      failAt(line, column, "character literal must hold exactly one character");
    }
    self.advance();

    let count: i64 = text.length;
    list.add(TokenKind.Char, text.take(), count, line, column);
  }

  // Longer operators are tried before shorter ones, so `<=` never lexes as `<`
  // followed by `=`.
  fn readOperator(self: *Lexer, list: *TokenList): void {
    let line: i32 = self.line;
    let column: i32 = self.column;
    let first: i8 = self.peek();
    let second: i8 = self.peekNext();
    let kind: TokenKind = TokenKind.None;

    // `...` is the one three-character operator.
    if (first == '.' && second == '.' && self.pos + 2 < self.length &&
        self.source[self.pos + 2] == '.') {
      for (step in 0..3) {
        self.advance();
      }
      list.add(TokenKind.Ellipsis, textCopy("..."), 3, line, column);
      return;
    }

    if (first == '=' && second == '=') { kind = TokenKind.Eq; }
    else if (first == '=' && second == '>') { kind = TokenKind.Arrow; }
    else if (first == '.' && second == '.') { kind = TokenKind.DotDot; }
    else if (first == '!' && second == '=') { kind = TokenKind.Ne; }
    else if (first == '<' && second == '=') { kind = TokenKind.Le; }
    else if (first == '>' && second == '=') { kind = TokenKind.Ge; }
    else if (first == '&' && second == '&') { kind = TokenKind.AndAnd; }
    else if (first == '|' && second == '|') { kind = TokenKind.OrOr; }
    else if (first == '<' && second == '<') { kind = TokenKind.Shl; }
    else if (first == '>' && second == '>') { kind = TokenKind.Shr; }
    else if (first == '+' && second == '=') { kind = TokenKind.PlusAssign; }
    else if (first == '-' && second == '=') { kind = TokenKind.MinusAssign; }
    else if (first == '*' && second == '=') { kind = TokenKind.StarAssign; }
    else if (first == '/' && second == '=') { kind = TokenKind.SlashAssign; }
    else if (first == '%' && second == '=') { kind = TokenKind.PercentAssign; }

    if (kind != TokenKind.None) {
      self.advance();
      self.advance();
      list.add(kind, textCopy(kindName(kind)),
               strlen(kindName(kind)), line, column);
      return;
    }

    if (first == '=') { kind = TokenKind.Assign; }
    else if (first == '+') { kind = TokenKind.Plus; }
    else if (first == '-') { kind = TokenKind.Minus; }
    else if (first == '*') { kind = TokenKind.Star; }
    else if (first == '/') { kind = TokenKind.Slash; }
    else if (first == '%') { kind = TokenKind.Percent; }
    else if (first == '!') { kind = TokenKind.Not; }
    else if (first == '&') { kind = TokenKind.Amp; }
    else if (first == '|') { kind = TokenKind.Pipe; }
    else if (first == '^') { kind = TokenKind.Caret; }
    else if (first == '<') { kind = TokenKind.Lt; }
    else if (first == '>') { kind = TokenKind.Gt; }
    else if (first == '(') { kind = TokenKind.LParen; }
    else if (first == ')') { kind = TokenKind.RParen; }
    else if (first == '{') { kind = TokenKind.LBrace; }
    else if (first == '}') { kind = TokenKind.RBrace; }
    else if (first == '[') { kind = TokenKind.LBracket; }
    else if (first == ']') { kind = TokenKind.RBracket; }
    else if (first == '.') { kind = TokenKind.Dot; }
    else if (first == ';') { kind = TokenKind.Semicolon; }
    else if (first == ',') { kind = TokenKind.Comma; }
    else if (first == ':') { kind = TokenKind.Colon; }
    else {
      failAt(line, column, "unexpected character");
    }

    self.advance();
    list.add(kind, textCopy(kindName(kind)), strlen(kindName(kind)),
             line, column);
  }
}

fn isDigit(character: i8): bool {
  return character >= '0' && character <= '9';
}

fn isAlpha(character: i8): bool {
  if (character >= 'a' && character <= 'z') {
    return true;
  }
  if (character >= 'A' && character <= 'Z') {
    return true;
  }

  return character == '_';
}

fn isAlphaNumeric(character: i8): bool {
  return isAlpha(character) || isDigit(character);
}

export fn isSpace(character: i8): bool {
  return character == ' ' || character == '\t' || character == '\n' ||
         character == '\r';
}

fn keywordKind(text: *i8): TokenKind {
  if (textEquals(text, "let")) { return TokenKind.Let; }
  if (textEquals(text, "if")) { return TokenKind.If; }
  if (textEquals(text, "else")) { return TokenKind.Else; }
  if (textEquals(text, "fn")) { return TokenKind.Fn; }
  if (textEquals(text, "extern")) { return TokenKind.Extern; }
  if (textEquals(text, "struct")) { return TokenKind.Struct; }
  if (textEquals(text, "sizeof")) { return TokenKind.Sizeof; }
  if (textEquals(text, "return")) { return TokenKind.Return; }
  if (textEquals(text, "while")) { return TokenKind.While; }
  if (textEquals(text, "break")) { return TokenKind.Break; }
  if (textEquals(text, "continue")) { return TokenKind.Continue; }
  if (textEquals(text, "as")) { return TokenKind.As; }
  if (textEquals(text, "import")) { return TokenKind.Import; }
  if (textEquals(text, "export")) { return TokenKind.Export; }
  if (textEquals(text, "null")) { return TokenKind.Null; }
  if (textEquals(text, "enum")) { return TokenKind.Enum; }
  if (textEquals(text, "match")) { return TokenKind.Match; }
  if (textEquals(text, "for")) { return TokenKind.For; }
  // `from` is not a keyword: it only means anything after an import list, and
  // it is too useful a name to take away everywhere else.
  if (textEquals(text, "true")) { return TokenKind.Bool; }
  if (textEquals(text, "false")) { return TokenKind.Bool; }

  // Type names are their own kind rather than identifiers, which is what the
  // parser reads to tell `let x: i32` from `let x: Point`.
  if (textEquals(text, "i8")) { return TokenKind.Type; }
  if (textEquals(text, "u8")) { return TokenKind.Type; }
  if (textEquals(text, "i16")) { return TokenKind.Type; }
  if (textEquals(text, "u16")) { return TokenKind.Type; }
  if (textEquals(text, "i32")) { return TokenKind.Type; }
  if (textEquals(text, "u32")) { return TokenKind.Type; }
  if (textEquals(text, "i64")) { return TokenKind.Type; }
  if (textEquals(text, "u64")) { return TokenKind.Type; }
  if (textEquals(text, "usize")) { return TokenKind.Type; }
  if (textEquals(text, "f32")) { return TokenKind.Type; }
  if (textEquals(text, "f64")) { return TokenKind.Type; }
  if (textEquals(text, "bool")) { return TokenKind.Type; }
  if (textEquals(text, "void")) { return TokenKind.Type; }

  return TokenKind.Ident;
}

// Decodes the character after a backslash: no \xNN and no unicode yet.
fn escapeValue(character: i8, line: i32, column: i32): i8 {
  if (character == 'n') { return '\n'; }
  if (character == 't') { return '\t'; }
  if (character == 'r') { return '\r'; }
  if (character == '0') { return 0; }
  if (character == '\\') { return '\\'; }
  if (character == '"') { return '"'; }
  if (character == '\'') { return '\''; }

  failAt(line, column, "unknown escape sequence");
  return 0;
}

// A leading `-` belongs to the literal only where the previous token cannot
// end an expression, which is what makes `print(-17 % 5)` one negative number
// and `x = 5 - 3` a subtraction. Note that `=` is absent from the set, so
// `let c: i32 = --5;` is a negation of `-5`.
fn foldsNegative(lastKind: TokenKind): bool {
  if (lastKind == TokenKind.None) {
    return true;
  }

  match (lastKind) {
    TokenKind.Eq, TokenKind.Ne => { return true; }
    TokenKind.Lt, TokenKind.Le => { return true; }
    TokenKind.Gt, TokenKind.Ge => { return true; }
    TokenKind.Plus, TokenKind.Minus => { return true; }
    TokenKind.Star, TokenKind.Slash => { return true; }
    TokenKind.AndAnd, TokenKind.OrOr => { return true; }
    TokenKind.LParen, TokenKind.LBrace => { return true; }
    TokenKind.Comma, TokenKind.Colon => { return true; }
    else => {}
  }

  return lastKind == TokenKind.Return;
}

export fn tokenize(source: *i8): *TokenList {
  let lexer: *Lexer = Lexer.new(source);
  let list: *TokenList = TokenList.new();
  // What the negative-literal rule reads to decide whether a `-` starts a
  // number or is an operator.
  let lastKind: TokenKind = TokenKind.None;

  while (true) {
    lexer.skipTrivia();
    if (lexer.atEnd()) {
      break;
    }

    let character: i8 = lexer.peek();

    if (isAlpha(character)) {
      lexer.readIdentifier(list);
    } else if (isDigit(character)) {
      lexer.readNumber(list);
    } else if (character == '-' && isDigit(lexer.peekNext()) &&
               foldsNegative(lastKind)) {
      lexer.readNumber(list);
    } else if (character == '"') {
      lexer.readString(list);
    } else if (character == '\'') {
      lexer.readChar(list);
    } else {
      lexer.readOperator(list);
    }

    lastKind = list.at(list.count - 1).kind;
  }

  // The end token carries no position, so a diagnostic about running out of
  // input names the file rather than pointing past its last line.
  list.add(TokenKind.End, textCopy(""), 0, 0, 0);

  return list;
}
