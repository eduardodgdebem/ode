test "a pointer to a function type without parentheses is refused" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let TABLE: *(i32) => i32 = null;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.PointerToFunctionType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 12);
}

test "the old fn(...) spelling of a function type costs one problem" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn apply(f: fn(i32): i32, x: i32): i32 {
          return f(x);
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.OldFunctionType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 13);
}

test "a function type without its arrow" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let F: (i32) i32 = null;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).column, 14);
  assertEq(found.at(0).facts.name, "=>");
  assertEq(found.at(0).facts.other, "i32");
}

test "parentheses hold only a function type" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let N: (i32) = 1;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).facts.name, "=>");
  assertEq(found.at(0).facts.other, "=");
}

// The type written for the `index`th global in `tree`.
fn declaredType(tree: Parsed, index: i32): i32 {
  return varDeclOf(tree.ast, tree.item(index)).type;
}

// What a function type returns.
fn resultOf(tree: Parsed, type: i32): i32 {
  let syntax: Syntax = tree.ast.nodes[type].syntax;
  if (syntax is FnTypeRef) {
    return syntax.result;
  }
  return NO_NODE;
}

test "a function type's result runs to the end of the type" {
  let tree: Parsed = parse("let F: (i32) => i32 | E = null;");
  let type: i32 = declaredType(tree, 0);
  assertEq(tree.kind(type), NodeKind.FnType);
  assertEq(itemCount(tree.ast, type), 1);
  assertEq(tree.kind(resultOf(tree, type)), NodeKind.UnionType);
}

test "a union holding a function puts the function in parentheses" {
  let tree: Parsed = parse("let F: ((i32) => i32) | E = null;");
  let type: i32 = declaredType(tree, 0);
  assertEq(tree.kind(type), NodeKind.UnionType);
  let first: i32 = itemAt(tree.ast, type, 0);
  assertEq(tree.kind(first), NodeKind.FnType);
  assertEq(tree.kind(resultOf(tree, first)), NodeKind.Type);
}

test "a function may return a function, take none, and be pointed to" {
  let tree: Parsed = parse(`
    let CURRIED: (i32) => (i32) => i32 = null;
    let NOTHING: () => void = null;
    let TABLE: **((i32, bool) => i32) = null;
  `);
  let curried: i32 = declaredType(tree, 0);
  assertEq(tree.kind(resultOf(tree, curried)), NodeKind.FnType);

  let nothing: i32 = declaredType(tree, 1);
  assertEq(itemCount(tree.ast, nothing), 0);

  let table: i32 = declaredType(tree, 2);
  assertEq(tree.kind(table), NodeKind.FnType);
  assertEq(typeDepth(tree.ast, table), 2);
  assertEq(itemCount(tree.ast, table), 2);
}

// The `index`th statement of the first function in `tree`.
fn statementOf(tree: Parsed, index: i32): i32 {
  let body: i32 = functionOf(tree.ast, tree.item(0)).body;
  return itemAt(tree.ast, body, index);
}

// The value the `index`th statement -- a `let` -- gives its variable.
fn declaredValue(tree: Parsed, index: i32): i32 {
  return varDeclOf(tree.ast, statementOf(tree, index)).value;
}

test "a lambda's expression body is a block that returns it" {
  let tree: Parsed = parse("fn main(): void { let f: (i32) => i32 = (x) => x + 1; }");
  let node: i32 = declaredValue(tree, 0);
  assertEq(tree.kind(node), NodeKind.Lambda);
  let lambda: Lambda = lambdaOf(tree.ast, node);
  assert(lambda.expressionBody);
  assertEq(lambda.returnType, NO_NODE);

  let param: i32 = itemAt(tree.ast, lambda.params, 0);
  assertEq(nodeName(tree.ast, param), "x");
  assertEq(paramOf(tree.ast, param).type, NO_NODE);

  assertEq(tree.kind(lambda.body), NodeKind.Block);
  let returned: Syntax = tree.ast.nodes[itemAt(tree.ast, lambda.body, 0)].syntax;
  assert(returned is Return);
  if (returned is Return) {
    assertEq(tree.kind(returned.value), NodeKind.Binary);
  }
}

test "a lambda may write its types, and take a block" {
  let tree: Parsed = parse(`
    fn main(): void {
      let f: (i32, bool) => i32 = (x: i32, flag: bool): i32 => { return x; };
      let g: () => void = () => {};
    }
  `);
  let lambda: Lambda = lambdaOf(tree.ast, declaredValue(tree, 0));
  assert(!lambda.expressionBody);
  assertEq(tree.kind(lambda.returnType), NodeKind.Type);
  assertEq(itemCount(tree.ast, lambda.params), 2);
  let flag: i32 = itemAt(tree.ast, lambda.params, 1);
  assertEq(tree.kind(paramOf(tree.ast, flag).type), NodeKind.Type);

  let empty: i32 = declaredValue(tree, 1);
  assertEq(tree.kind(empty), NodeKind.Lambda);
  assertEq(itemCount(tree.ast, lambdaOf(tree.ast, empty).params), 0);
}

test "parentheses without an arrow after them are still grouping" {
  let tree: Parsed = parse("fn main(): void { let n: i32 = (1 + 2) * (3); }");
  let value: i32 = declaredValue(tree, 0);
  let product: Binary = binaryOf(tree.ast, value);
  assertEq(product.op, BinaryOp.Multiply);
  assertEq(binaryOf(tree.ast, product.left).op, BinaryOp.Add);
  assertEq(tree.kind(product.right), NodeKind.Number);
}

test "an operator's node says which operator, and holds its operands" {
  let tree: Parsed = parse(`
    fn main(): void {
      let a: bool = !(*x ?? -y < 2 << 1);
      count += 1;
    }
  `);
  let not: Unary = unaryOf(tree.ast, declaredValue(tree, 0));
  assertEq(not.op, UnaryOp.Not);
  let coalesce: Binary = binaryOf(tree.ast, not.operand);
  assertEq(coalesce.op, BinaryOp.Coalesce);
  assertEq(unaryOf(tree.ast, coalesce.left).op, UnaryOp.Deref);
  let less: Binary = binaryOf(tree.ast, coalesce.right);
  assertEq(less.op, BinaryOp.Less);
  assertEq(unaryOf(tree.ast, less.left).op, UnaryOp.Negate);
  assertEq(binaryOf(tree.ast, less.right).op, BinaryOp.ShiftLeft);

  // `count += 1` is `count = count + 1`.
  let assignment: Syntax = tree.ast.nodes[statementOf(tree, 1)].syntax;
  let assigned: i32 = NO_NODE;
  if (assignment is Assign) {
    assigned = assignment.value;
  }
  let sum: Binary = binaryOf(tree.ast, assigned);
  assertEq(sum.op, BinaryOp.Add);
  assertEq(nodeName(tree.ast, sum.left), "count");
}

test "a lambda's parameters are names" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        let f: (i32) => i32 = (1) => 1;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 24);
  assertEq(found.at(0).facts.name, "parameter name");
}

test "a type alias names a type, and may be exported" {
  let tree: Parsed = parse(`
    type Reader = (*i8) => i64 | ParseError;
    export type Count = i64;
  `);
  let reader: i32 = tree.item(0);
  assertEq(tree.kind(reader), NodeKind.TypeAlias);
  assertEq(nodeName(tree.ast, reader), "Reader");
  assertEq(tree.kind(typeNodeOf(tree.ast, reader)), NodeKind.FnType);

  let count: i32 = tree.item(1);
  assertEq(tree.kind(count), NodeKind.TypeAlias);
  assert(tree.ast.nodes[count].exported);
}

test "type is still a name wherever no alias follows it" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        let type: i32 = 1;
        type = type + 1;
      `);
  assertEq(found.count, 0);
}

test "a type alias is declared at the top level only" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          type Count = i64;
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).facts.name, "type");
}

test "a match arm may name built-in types and pointers" {
  let tree: Parsed = parse(`
    fn main(): void {
      match (value) {
        i64, *i8 => {}
        Circle => {}
      }
    }
  `);
  let switchNode: i32 = statementOf(tree, 0);
  let first: i32 = itemAt(tree.ast, switchNode, 0);
  assertEq(tree.kind(itemAt(tree.ast, first, 0)), NodeKind.Type);
  assertEq(typeDepth(tree.ast, itemAt(tree.ast, first, 1)), 1);
  let second: i32 = itemAt(tree.ast, switchNode, 1);
  assertEq(tree.kind(itemAt(tree.ast, second, 0)), NodeKind.Ident);
}

test "an arm runs an expression or a block, and a match may be a value" {
  let tree: Parsed = parse(`
    fn main(): void {
      match (op) {
        .Add => print(1),
        .Sub => {
          print(2);
        }
        else => print(3)
      }
      let name: *i8 = match (op) { .Add => "add", else => "other" };
    }
  `);
  let statement: i32 = statementOf(tree, 0);
  let first: i32 = itemAt(tree.ast, statement, 0);
  // In a statement, an expression arm is run as an expression statement.
  assertEq(tree.kind(armOf(tree.ast, first).body), NodeKind.ExprStmt);
  let pattern: i32 = itemAt(tree.ast, first, 0);
  assertEq(tree.kind(pattern), NodeKind.FieldAccess);
  assertEq(fieldAccessOf(tree.ast, pattern).object, NO_NODE);
  assertEq(nodeName(tree.ast, pattern), "Add");
  assertEq(itemCount(tree.ast, statement), 3);

  let value: i32 = declaredValue(tree, 1);
  assertEq(tree.kind(value), NodeKind.Match);
  assert(matchOf(tree.ast, value).isValue);
  let arm: i32 = itemAt(tree.ast, value, 0);
  assertEq(tree.kind(armOf(tree.ast, arm).body), NodeKind.String);
}

test "a pattern in parentheses is never a lambda" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        match (1) {
          (1) => {}
          else => {}
        }
      `);
  assertEq(found.count, 0);
}

test "an expression arm ends at a comma, or at the closing brace" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        let n: i32 = 1;
        match (n) {
          1 => n = 2
          else => {}
        }
      `);
  // Assigning is a statement, so the arm's expression is `n`, and what
  // follows it has to end the arm.
  assert(found.count >= 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 3);
  assertEq(found.at(0).facts.name, ",");
  assertEq(found.at(0).facts.other, "=");
}

test "casts, indexing, sizes, try, is and catch hold their parts by name" {
  let tree: Parsed = parse(`
    fn main(): void {
      let a: i64 = values[2] as i64;
      let b: u64 = sizeof(Point);
      let c: i64 = try read(path);
      let d: bool = c is ParseError;
      let e: i64 = read(path) catch (problem) {
        return;
      };
    }
  `);
  let cast: Syntax = tree.ast.nodes[declaredValue(tree, 0)].syntax;
  assert(cast is Cast);
  if (cast is Cast) {
    assertEq(tree.kind(cast.type), NodeKind.Type);
    let index: Syntax = tree.ast.nodes[cast.value].syntax;
    assert(index is Index);
    if (index is Index) {
      assertEq(nodeName(tree.ast, index.base), "values");
      assertEq(tree.kind(index.index), NodeKind.Number);
    }
  }

  let size: Syntax = tree.ast.nodes[declaredValue(tree, 1)].syntax;
  assert(size is Sizeof);
  if (size is Sizeof) {
    assertEq(nodeName(tree.ast, size.type), "Point");
  }

  let attempt: Syntax = tree.ast.nodes[declaredValue(tree, 2)].syntax;
  assert(attempt is Try);
  if (attempt is Try) {
    assertEq(tree.kind(attempt.value), NodeKind.Call);
  }

  let question: Is = isOf(tree.ast, declaredValue(tree, 3));
  assertEq(nodeName(tree.ast, question.value), "c");
  assertEq(nodeName(tree.ast, question.type), "ParseError");

  let caught: Syntax = tree.ast.nodes[declaredValue(tree, 4)].syntax;
  assert(caught is Catch);
  if (caught is Catch) {
    assertEq(caught.name, "problem");
    assertEq(tree.kind(caught.block), NodeKind.Block);
  }
}

test "the parts a node's syntax holds are its children, types included" {
  let tree: Parsed = parse("fn main(): void { let a: i64 = x as i64; }");
  let cast: i32 = declaredValue(tree, 0);
  let children: *List<i32> = syntaxChildren(tree.ast.nodes[cast].syntax);
  assertEq(children.count, 2);
  assertEq(tree.kind(children.at(0)), NodeKind.Ident);
  assertEq(tree.kind(children.at(1)), NodeKind.Type);
}
