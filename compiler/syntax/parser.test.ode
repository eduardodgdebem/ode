// ---------------------------------------------------------------------------
// What the parser rejects, and where.
//
// Each checks a fragment -- statements in a function body, or declarations
// -- in a Scope that states what it can see, and asserts the problems found:
// which, where in the fragment, and about what.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { NO_NODE, NodeKind } from "./ast";
import { Scope, Parsed, parse } from "../testkit/testkit";

test "for missing in" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          for (i of 0..10) {
          }
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 10);
  assertEq(found.at(0).facts.other, "of");
}

test "function without body" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn broken(): i32;

        fn main(): i32 {
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 17);
  assertEq(found.at(0).facts.other, ";");
}

test "match missing arrow" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          let n: i32 = 1;
          match (n) {
            1 {
              return 1;
            }
          }
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 7);
  assertEq(found.at(0).facts.other, "{");
}

test "multiple syntax errors" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        // A missing semicolon in three separate functions. Recovery resumes at the
        // next statement, so each one is found in the same run.
        fn first(): i32 {
          let a: i32 = 1
          return a;
        }

        fn second(): i32 {
          let b: i32 = 2;
          return b
        }

        fn main(): i32 {
          printf("%d\n", first() + second())
          return 0;
        }

        extern fn printf(format: *i8, ...): i32;
      `)
      .problems();
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 5);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.other, "return");
  assertEq(found.at(1).problem, Problem.UnexpectedToken);
  assertEq(found.at(1).line, 11);
  assertEq(found.at(1).column, 1);
  assertEq(found.at(1).facts.other, "}");
  assertEq(found.at(2).problem, Problem.UnexpectedToken);
  assertEq(found.at(2).line, 15);
  assertEq(found.at(2).column, 3);
  assertEq(found.at(2).facts.other, "return");
}

test "nested extern" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          extern fn puts(text: *i8): i32;

          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "extern");
}

test "nested function" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          fn helper(): i32 {
            return 7;
          }

          return helper();
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "fn");
}

test "nested struct" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          struct Local { x: i32, }

          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "struct");
}

test "syntax missing return type" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main() {
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 11);
  assertEq(found.at(0).facts.other, "{");
}

test "syntax missing semicolon" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          let value: i32 = 1

          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 4);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.other, "return");
}

test "syntax unclosed block" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          return 0;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).facts.other, "end of file");
}

test "test inside function" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          test "nested" {
          }

          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).column, 3);
  assertEq(found.at(0).facts.name, "test");
}

test "test without body" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        test "no body";

        fn main(): i32 {
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 15);
  assertEq(found.at(0).facts.other, ";");
}

test "a pointer to a function type without parentheses is refused" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let TABLE: *(i32) => i32 = null;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.PointerToFunctionType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 12);
}

test "the old fn(...) spelling of a function type costs one problem" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn apply(f: fn(i32): i32, x: i32): i32 {
          return f(x);
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.OldFunctionType);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 13);
}

test "a function type without its arrow" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let F: (i32) i32 = null;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).column, 14);
  assertEq(found.at(0).facts.name, "=>");
  assertEq(found.at(0).facts.other, "i32");
}

test "parentheses hold only a function type" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        let N: (i32) = 1;
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).facts.name, "=>");
  assertEq(found.at(0).facts.other, "=");
}

// The type written for the `index`th global in `tree`.
fn declaredType(tree: Parsed, index: i32): i32 {
  return tree.ast.nodes[tree.item(index)].a;
}

test "a function type's result runs to the end of the type" {
  let tree: Parsed = parse("let F: (i32) => i32 | E = null;");
  let type: i32 = declaredType(tree, 0);
  assertEq(tree.kind(type), NodeKind.FnType);
  assertEq(tree.ast.nodes[type].itemCount, 1);
  assertEq(tree.kind(tree.ast.nodes[type].a), NodeKind.UnionType);
}

test "a union holding a function puts the function in parentheses" {
  let tree: Parsed = parse("let F: ((i32) => i32) | E = null;");
  let type: i32 = declaredType(tree, 0);
  assertEq(tree.kind(type), NodeKind.UnionType);
  let first: i32 = tree.ast.nodes[type].items[0];
  assertEq(tree.kind(first), NodeKind.FnType);
  assertEq(tree.kind(tree.ast.nodes[first].a), NodeKind.Type);
}

test "a function may return a function, take none, and be pointed to" {
  let tree: Parsed = parse(`
    let CURRIED: (i32) => (i32) => i32 = null;
    let NOTHING: () => void = null;
    let TABLE: **((i32, bool) => i32) = null;
  `);
  let curried: i32 = declaredType(tree, 0);
  assertEq(tree.kind(tree.ast.nodes[curried].a), NodeKind.FnType);

  let nothing: i32 = declaredType(tree, 1);
  assertEq(tree.ast.nodes[nothing].itemCount, 0);

  let table: i32 = declaredType(tree, 2);
  assertEq(tree.kind(table), NodeKind.FnType);
  assertEq(tree.ast.nodes[table].extra, 2);
  assertEq(tree.ast.nodes[table].itemCount, 2);
}

// The `index`th statement of the first function in `tree`.
fn statementOf(tree: Parsed, index: i32): i32 {
  let body: i32 = tree.ast.nodes[tree.item(0)].c;
  return tree.ast.nodes[body].items[index];
}

test "a lambda's expression body is a block that returns it" {
  let tree: Parsed = parse("fn main(): void { let f: (i32) => i32 = (x) => x + 1; }");
  let lambda: i32 = tree.ast.nodes[statementOf(tree, 0)].b;
  assertEq(tree.kind(lambda), NodeKind.Lambda);
  assertEq(tree.ast.nodes[lambda].extra, 1);
  assertEq(tree.ast.nodes[lambda].a, NO_NODE);

  let param: i32 = tree.ast.nodes[tree.ast.nodes[lambda].b].items[0];
  assertEq(tree.ast.nodes[param].text, "x");
  assertEq(tree.ast.nodes[param].a, NO_NODE);

  let body: i32 = tree.ast.nodes[lambda].c;
  assertEq(tree.kind(body), NodeKind.Block);
  let returned: i32 = tree.ast.nodes[body].items[0];
  assertEq(tree.kind(returned), NodeKind.Return);
  assertEq(tree.kind(tree.ast.nodes[returned].a), NodeKind.Binary);
}

test "a lambda may write its types, and take a block" {
  let tree: Parsed = parse(`
    fn main(): void {
      let f: (i32, bool) => i32 = (x: i32, flag: bool): i32 => { return x; };
      let g: () => void = () => {};
    }
  `);
  let lambda: i32 = tree.ast.nodes[statementOf(tree, 0)].b;
  assertEq(tree.ast.nodes[lambda].extra, 0);
  assertEq(tree.kind(tree.ast.nodes[lambda].a), NodeKind.Type);
  assertEq(tree.ast.nodes[tree.ast.nodes[lambda].b].itemCount, 2);
  let flag: i32 = tree.ast.nodes[tree.ast.nodes[lambda].b].items[1];
  assertEq(tree.kind(tree.ast.nodes[flag].a), NodeKind.Type);

  let empty: i32 = tree.ast.nodes[statementOf(tree, 1)].b;
  assertEq(tree.kind(empty), NodeKind.Lambda);
  assertEq(tree.ast.nodes[tree.ast.nodes[empty].b].itemCount, 0);
}

test "parentheses without an arrow after them are still grouping" {
  let tree: Parsed = parse("fn main(): void { let n: i32 = (1 + 2) * (3); }");
  let value: i32 = tree.ast.nodes[statementOf(tree, 0)].b;
  assertEq(tree.kind(value), NodeKind.Binary);
  assertEq(tree.kind(tree.ast.nodes[value].a), NodeKind.Binary);
}

test "a lambda's parameters are names" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        let f: (i32) => i32 = (1) => 1;
      `);
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(0).column, 24);
  assertEq(found.at(0).facts.name, "parameter name");
}

test "a type alias names a type, and may be exported" {
  let tree: Parsed = parse(`
    type Reader = (*i8) => i64 | ParseError;
    export type Count = i64;
  `);
  let reader: i32 = tree.item(0);
  assertEq(tree.kind(reader), NodeKind.TypeAlias);
  assertEq(tree.ast.nodes[reader].text, "Reader");
  assertEq(tree.kind(tree.ast.nodes[reader].a), NodeKind.FnType);

  let count: i32 = tree.item(1);
  assertEq(tree.kind(count), NodeKind.TypeAlias);
  assert(tree.ast.nodes[count].exported);
}

test "type is still a name wherever no alias follows it" {
  let found: *List<Diagnostic> = Scope.new()
      .run(`
        let type: i32 = 1;
        type = type + 1;
      `);
  assertEq(found.count, 0);
}

test "a type alias is declared at the top level only" {
  let found: *List<Diagnostic> = Scope.new()
      .declare(`
        fn main(): i32 {
          type Count = i64;
          return 0;
        }
      `)
      .problems();
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.NotAtTopLevel);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(0).facts.name, "type");
}

test "a match arm may name built-in types and pointers" {
  let tree: Parsed = parse(`
    fn main(): void {
      match (value) {
        i64, *i8 => {}
        Circle => {}
      }
    }
  `);
  let switchNode: i32 = statementOf(tree, 0);
  let first: i32 = tree.ast.nodes[switchNode].items[0];
  assertEq(tree.kind(tree.ast.nodes[first].items[0]), NodeKind.Type);
  assertEq(tree.ast.nodes[tree.ast.nodes[first].items[1]].extra, 1);
  let second: i32 = tree.ast.nodes[switchNode].items[1];
  assertEq(tree.kind(tree.ast.nodes[second].items[0]), NodeKind.Ident);
}
