// ---------------------------------------------------------------------------
// Statements and declarations.
// ---------------------------------------------------------------------------

import { Buf, textEquals, textSlice } from "../support/text";
import { FAILED, report } from "../support/diagnostics";
import { TokenKind, Token } from "./token";
import { NO_NODE, NodeKind } from "./ast";
import { Parser, startsStatement, parseType, parseTypeParams } from "./parser";
import { parseExpr } from "./expressions";

// `a op= b` is sugar for `a = a op b`; this names the binary operator each
// compound token stands for, or TK_NONE when the token is not one.
fn compoundAssignOp(kind: TokenKind): TokenKind {
  match (kind) {
    TokenKind.PlusAssign => { return TokenKind.Plus; }
    TokenKind.MinusAssign => { return TokenKind.Minus; }
    TokenKind.StarAssign => { return TokenKind.Star; }
    TokenKind.SlashAssign => { return TokenKind.Slash; }
    TokenKind.PercentAssign => { return TokenKind.Percent; }
    else => {}
  }

  return TokenKind.None;
}

// Parses the expression starting at `start` again and leaves the position
// where it was, so a desugaring can use the same operand twice without every
// node having to know how to copy itself.
fn parserReparse(parser: *Parser, start: i32): i32 {
  let resume: i32 = parser.pos;
  parser.pos = start;
  let copy: i32 = parseExpr(parser);
  parser.pos = resume;

  return copy;
}

// Parses one statement, recording the error and resynchronising if it does
// not parse. Returns NO_NODE for a statement that recovery dropped.
fn parseStatementRecovering(parser: *Parser): i32 {
  let start: i32 = parser.pos;
  let node: i32 = parseStatement(parser);

  if (!FAILED) {
    return node;
  }

  // A statement that failed on its very first token would otherwise be
  // retried forever, so recovery always costs at least one token.
  if (parser.pos == start) {
    parser.advance();
  }

  parser.synchronize();
  FAILED = false;

  return NO_NODE;
}

fn parseStatement(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let startLine: i32 = start.line;
  let startColumn: i32 = start.column;

  let node: i32 = parseStatementInner(parser, start);

  // A construct that already knows where it starts keeps its own position.
  if (parser.ast.nodes[node].line == 0) {
    parser.ast.nodes[node].line = startLine;
    parser.ast.nodes[node].column = startColumn;
  }

  return node;
}

fn parseStatementInner(parser: *Parser, start: *Token): i32 {
  let kind: TokenKind = parser.kind();

  match (kind) {
    TokenKind.Let => { return parseVarDecl(parser); }
    TokenKind.LBrace => { return parseBlock(parser); }
    TokenKind.If => { return parseIfStmt(parser); }
    TokenKind.While => { return parseWhileStmt(parser); }
    TokenKind.For => { return parseForStmt(parser); }
    TokenKind.Break => { return parseBreakStmt(parser); }
    TokenKind.Continue => { return parseContinueStmt(parser); }
    TokenKind.Return => { return parseReturnStmt(parser); }
    TokenKind.Print => { return parsePrintStmt(parser); }
    else => {}
  }

  // A declaration is parsed before it is rejected, so that a later recovery
  // resumes after it rather than inside it.
  if (kind == TokenKind.Fn) {
    let node: i32 = parseFuncDecl(parser);
    return requireTopLevel(parser, start, "fn", node);
  }
  if (kind == TokenKind.Extern) {
    let node: i32 = parseExternDecl(parser);
    return requireTopLevel(parser, start, "extern", node);
  }
  if (kind == TokenKind.Struct) {
    let node: i32 = parseStructDecl(parser);
    return requireTopLevel(parser, start, "struct", node);
  }
  if (kind == TokenKind.Match) { return parseMatchStmt(parser); }
  if (kind == TokenKind.Enum) {
    let node: i32 = parseEnumDecl(parser);
    return requireTopLevel(parser, start, "enum", node);
  }
  if (kind == TokenKind.Import) {
    let node: i32 = parseImportDecl(parser);
    return requireTopLevel(parser, start, "import", node);
  }
  if (kind == TokenKind.Export) {
    let node: i32 = parseExportDecl(parser);
    return requireTopLevel(parser, start, "export", node);
  }

  return parseExprStmt(parser);
}

fn requireTopLevel(parser: *Parser, at: *Token, construct: *i8,
                   declaration: i32): i32 {
  if (!parser.atTopLevel) {
    let message: *Buf = Buf.new();
    message.push('\'');
    message.add(construct);
    message.add("' declarations are only allowed at the top level of the ");
    message.add("program");
    report(at.line, at.column, message.data);
  }

  return declaration;
}

fn parseVarDecl(parser: *Parser): i32 {
  parser.expect(TokenKind.Let, "let");
  let name: *Token = parser.expect(TokenKind.Ident, "identifier");
  parser.expect(TokenKind.Colon, ":");
  let type: i32 = parseType(parser);
  parser.expect(TokenKind.Assign, "=");
  let expr: i32 = parseExpr(parser);
  parser.expect(TokenKind.Semicolon, ";");

  let node: i32 = parser.ast.add(NodeKind.VarDecl, 0, 0);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].a = type;
  parser.ast.nodes[node].b = expr;

  return node;
}

// Either `expr;`, `lvalue = expr;` or `lvalue op= expr;`. All start with an
// expression, so parse one and let the following token decide which statement
// this is. That is what lets `*p = v;` work without a separate lookahead rule.
fn parseExprStmt(parser: *Parser): i32 {
  let targetStart: i32 = parser.pos;
  let expr: i32 = parseExpr(parser);

  if (parser.kind() == TokenKind.Assign) {
    parser.advance();
    let value: i32 = parseExpr(parser);
    parser.expect(TokenKind.Semicolon, ";");

    let node: i32 = parser.ast.add(NodeKind.Assign, 0, 0);
    parser.ast.nodes[node].a = expr;
    parser.ast.nodes[node].b = value;

    return node;
  }

  let binary: TokenKind = compoundAssignOp(parser.kind());
  if (binary != TokenKind.None) {
    // The desugaring needs the target on both sides of the `=`, so build a
    // second tree for it. The operand appears twice in the result, so a target
    // with a side effect -- `a[next()] += 1` -- runs it twice.
    let target: i32 = parserReparse(parser, targetStart);

    let op: *Token = parser.current();
    let opLine: i32 = op.line;
    let opColumn: i32 = op.column;
    // The operator's spelling is the compound token without its `=`.
    let opText: *i8 = textSlice(op.text, 0, op.length - 1);
    parser.advance();

    let value: i32 = parseExpr(parser);
    parser.expect(TokenKind.Semicolon, ";");

    let sum: i32 = parser.ast.add(NodeKind.Binary, opLine, opColumn);
    parser.ast.nodes[sum].text = opText;
    parser.ast.nodes[sum].textLength = op.length - 1;
    parser.ast.nodes[sum].a = target;
    parser.ast.nodes[sum].b = value;

    let node: i32 = parser.ast.add(NodeKind.Assign, 0, 0);
    parser.ast.nodes[node].a = expr;
    parser.ast.nodes[node].b = sum;

    return node;
  }

  parser.expect(TokenKind.Semicolon, ";");

  let node: i32 = parser.ast.add(NodeKind.ExprStmt, 0, 0);
  parser.ast.nodes[node].a = expr;

  return node;
}

fn parseBlock(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.Block, start.line, start.column);
  parser.expect(TokenKind.LBrace, "{");

  let wasTopLevel: bool = parser.atTopLevel;
  parser.atTopLevel = false;

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    let statement: i32 = parseStatementRecovering(parser);
    if (statement != NO_NODE) {
      parser.ast.addItem(node, statement);
    }
  }

  parser.atTopLevel = wasTopLevel;
  parser.expect(TokenKind.RBrace, "}");

  return node;
}

fn parseIfStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.If, "if");
  parser.expect(TokenKind.LParen, "(");
  let condition: i32 = parseExpr(parser);
  parser.expect(TokenKind.RParen, ")");
  let thenBlock: i32 = parseBlock(parser);

  let elseBlock: i32 = NO_NODE;
  if (parser.kind() == TokenKind.Else) {
    parser.advance();
    // `else if` chains by making the next `if` the else branch outright,
    // rather than requiring it to be wrapped in a block.
    if (parser.kind() == TokenKind.If) {
      elseBlock = parseIfStmt(parser);
    } else {
      elseBlock = parseBlock(parser);
    }
  }

  let node: i32 = parser.ast.add(NodeKind.If, 0, 0);
  parser.ast.nodes[node].a = condition;
  parser.ast.nodes[node].b = thenBlock;
  parser.ast.nodes[node].c = elseBlock;

  return node;
}

// ForStmt -> 'for' '(' IDENT 'in' Expr '..' Expr ')' Block
//
// `in` is matched by its text rather than as a keyword, like `from`.
fn parseForStmt(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.For, start.line, start.column);

  parser.expect(TokenKind.For, "for");
  parser.expect(TokenKind.LParen, "(");
  let name: *Token = parser.expect(TokenKind.Ident, "loop variable");
  parser.ast.setText(node, name);

  let word: *Token = parser.current();
  if (word.kind != TokenKind.Ident || !textEquals(word.text, "in")) {
    // Recovery skips the rest of the loop, body and all, from here.
    parser.fail("in");
    return node;
  }
  parser.advance();

  parser.ast.nodes[node].a = parseExpr(parser);
  parser.expect(TokenKind.DotDot, "..");
  parser.ast.nodes[node].b = parseExpr(parser);
  parser.expect(TokenKind.RParen, ")");
  parser.ast.nodes[node].c = parseBlock(parser);

  return node;
}

fn parseWhileStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.While, "while");
  parser.expect(TokenKind.LParen, "(");
  let condition: i32 = parseExpr(parser);
  parser.expect(TokenKind.RParen, ")");
  let body: i32 = parseBlock(parser);

  let node: i32 = parser.ast.add(NodeKind.While, 0, 0);
  parser.ast.nodes[node].a = condition;
  parser.ast.nodes[node].b = body;

  return node;
}

fn parseBreakStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.Break, "break");
  parser.expect(TokenKind.Semicolon, ";");

  return parser.ast.add(NodeKind.Break, 0, 0);
}

fn parseContinueStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.Continue, "continue");
  parser.expect(TokenKind.Semicolon, ";");

  return parser.ast.add(NodeKind.Continue, 0, 0);
}

fn parseReturnStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.Return, "return");

  let node: i32 = parser.ast.add(NodeKind.Return, 0, 0);

  // `return;` carries no value and is only valid in a void function.
  if (parser.kind() == TokenKind.Semicolon) {
    parser.advance();
    return node;
  }

  parser.ast.nodes[node].a = parseExpr(parser);
  parser.expect(TokenKind.Semicolon, ";");

  return node;
}

fn parsePrintStmt(parser: *Parser): i32 {
  parser.expect(TokenKind.Print, "print");
  let expr: i32 = parseExpr(parser);
  parser.expect(TokenKind.Semicolon, ";");

  let node: i32 = parser.ast.add(NodeKind.Print, 0, 0);
  parser.ast.nodes[node].a = expr;

  return node;
}

fn parseParamList(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.Params, start.line, start.column);
  parser.expect(TokenKind.LParen, "(");

  if (parser.kind() == TokenKind.RParen) {
    parser.advance();
    return node;
  }

  while (true) {
    let name: *Token = parser.expect(TokenKind.Ident, "parameter name");
    parser.expect(TokenKind.Colon, ":");

    let param: i32 = parser.ast.add(NodeKind.Param, name.line, name.column);
    parser.ast.setText(param, name);
    parser.ast.nodes[param].a = parseType(parser);
    parser.ast.addItem(node, param);

    if (parser.kind() != TokenKind.Comma) {
      break;
    }
    parser.advance();
  }

  parser.expect(TokenKind.RParen, ")");

  return node;
}

fn parseFuncDecl(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let line: i32 = start.line;
  let column: i32 = start.column;

  parser.expect(TokenKind.Fn, "fn");
  let name: *Token = parser.expect(TokenKind.Ident, "identifier");
  let typeParams: i32 = 0;
  if (parser.kind() == TokenKind.Lt) {
    typeParams = parseTypeParams(parser);
  }
  let params: i32 = parseParamList(parser);
  parser.expect(TokenKind.Colon, ":");
  let returnType: i32 = parseType(parser);
  let body: i32 = parseBlock(parser);

  let node: i32 = parser.ast.add(NodeKind.Fn, line, column);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].extra = typeParams;
  parser.ast.nodes[node].a = returnType;
  parser.ast.nodes[node].b = params;
  parser.ast.nodes[node].c = body;

  return node;
}

// ExternDecl -> 'extern' 'fn' IDENT '(' ParamList? ')' ':' Type ';'
fn parseExternDecl(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let line: i32 = start.line;
  let column: i32 = start.column;

  parser.expect(TokenKind.Extern, "extern");
  parser.expect(TokenKind.Fn, "fn");
  let name: *Token = parser.expect(TokenKind.Ident, "identifier");
  let params: i32 = parseParamList(parser);
  parser.expect(TokenKind.Colon, ":");
  let returnType: i32 = parseType(parser);
  parser.expect(TokenKind.Semicolon, ";");

  let node: i32 = parser.ast.add(NodeKind.Extern, line, column);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].a = returnType;
  parser.ast.nodes[node].b = params;

  return node;
}

// StructDecl -> 'struct' IDENT TypeParams? '{' (IDENT ':' Type ','? |
//               FuncDecl)* '}'
//
// A function written inside a struct is a method of it. One whose first
// parameter is `self`, of the struct's type or a pointer to it, is called on
// a value: `p.length()`. Any other is called on the struct: `Point.new(1, 2)`.
fn parseStructDecl(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let line: i32 = start.line;
  let column: i32 = start.column;

  parser.expect(TokenKind.Struct, "struct");
  let name: *Token = parser.expect(TokenKind.Ident, "struct name");
  let typeParams: i32 = 0;
  if (parser.kind() == TokenKind.Lt) {
    typeParams = parseTypeParams(parser);
  }
  parser.expect(TokenKind.LBrace, "{");

  let node: i32 = parser.ast.add(NodeKind.Struct, line, column);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].extra = typeParams;

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    if (parser.kind() == TokenKind.Fn) {
      parser.ast.addItem(node, parseFuncDecl(parser));
      if (FAILED) {
        break;
      }
      continue;
    }

    let fieldName: *Token = parser.expect(TokenKind.Ident, "field name");
    parser.expect(TokenKind.Colon, ":");

    let field: i32 = parser.ast.add(NodeKind.Field, fieldName.line,
                                    fieldName.column);
    parser.ast.setText(field, fieldName);
    parser.ast.nodes[field].a = parseType(parser);
    parser.ast.addItem(node, field);

    if (parser.kind() == TokenKind.Comma) {
      parser.advance();
    }
    if (FAILED) {
      break;
    }
  }

  parser.expect(TokenKind.RBrace, "}");

  return node;
}

// ImportDecl -> 'import' '{' (ImportName (',' ImportName)* ','?)? '}'
//               'from' STRING ';'
// ImportName -> IDENT ('as' IDENT)?
//
// `from` is matched by its text rather than as a keyword, so it stays free
// for use as a name everywhere else.
fn parseImportDecl(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.Import, start.line, start.column);
  // Filled in by the driver once it has found the file.
  parser.ast.nodes[node].extra = -1;

  parser.expect(TokenKind.Import, "import");
  parser.expect(TokenKind.LBrace, "{");

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    let name: *Token = parser.expect(TokenKind.Ident, "imported name");
    if (FAILED) {
      break;
    }

    let item: i32 = parser.ast.add(NodeKind.ImportName, name.line, name.column);
    parser.ast.setText(item, name);

    if (parser.kind() == TokenKind.As) {
      parser.advance();
      let alias: *Token = parser.expect(TokenKind.Ident, "alias");
      let aliasNode: i32 = parser.ast.add(NodeKind.Ident, alias.line,
                                          alias.column);
      parser.ast.setText(aliasNode, alias);
      parser.ast.nodes[item].a = aliasNode;
    }

    parser.ast.addItem(node, item);

    if (parser.kind() != TokenKind.Comma) {
      break;
    }
    parser.advance();
  }

  parser.expect(TokenKind.RBrace, "}");

  // General recovery stops at a `}`, which here would leave the rest of the
  // import to be misread as a statement of its own. The import ends at its
  // `;`, so that is where this one resumes.
  if (FAILED) {
    while (parser.kind() != TokenKind.Semicolon && parser.kind() != TokenKind.End &&
           !startsStatement(parser.kind())) {
      parser.advance();
    }
    if (parser.kind() == TokenKind.Semicolon) {
      parser.advance();
    }
    return node;
  }

  let from: *Token = parser.current();
  if (from.kind == TokenKind.Ident && textEquals(from.text, "from")) {
    parser.advance();
  } else {
    parser.fail("from");
  }

  let path: *Token = parser.expect(TokenKind.String, "module path");
  parser.ast.setText(node, path);
  parser.expect(TokenKind.Semicolon, ";");

  return node;
}

// ExportDecl -> 'export' (FuncDecl | ExternDecl | StructDecl | EnumDecl |
//                         VarDecl)
fn parseExportDecl(parser: *Parser): i32 {
  parser.expect(TokenKind.Export, "export");

  let kind: TokenKind = parser.kind();
  let node: i32 = NO_NODE;

  if (kind == TokenKind.Fn) {
    node = parseFuncDecl(parser);
  } else if (kind == TokenKind.Extern) {
    node = parseExternDecl(parser);
  } else if (kind == TokenKind.Struct) {
    node = parseStructDecl(parser);
  } else if (kind == TokenKind.Let) {
    node = parseVarDecl(parser);
  } else if (kind == TokenKind.Enum) {
    node = parseEnumDecl(parser);
  } else {
    parser.fail("declaration");
    return parser.errorNode();
  }

  parser.ast.nodes[node].exported = true;

  return node;
}

// EnumDecl -> 'enum' IDENT '{' (IDENT ('=' Expr)? (',' IDENT ('=' Expr)?)*
//             ','?)? '}'
//
// A member without a value takes the one after the member before it, and the
// first takes 0. A written value has to be an integer literal, which the
// analyzer checks.
fn parseEnumDecl(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let line: i32 = start.line;
  let column: i32 = start.column;

  parser.expect(TokenKind.Enum, "enum");
  let name: *Token = parser.expect(TokenKind.Ident, "enum name");
  parser.expect(TokenKind.LBrace, "{");

  let node: i32 = parser.ast.add(NodeKind.Enum, line, column);
  parser.ast.setText(node, name);

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    let memberName: *Token = parser.expect(TokenKind.Ident, "enum member");
    if (FAILED) {
      break;
    }

    let member: i32 = parser.ast.add(NodeKind.EnumMember, memberName.line,
                                     memberName.column);
    parser.ast.setText(member, memberName);
    if (parser.kind() == TokenKind.Assign) {
      parser.advance();
      parser.ast.nodes[member].a = parseExpr(parser);
    }
    parser.ast.addItem(node, member);

    if (parser.kind() != TokenKind.Comma) {
      break;
    }
    parser.advance();
  }

  parser.expect(TokenKind.RBrace, "}");

  return node;
}

// MatchStmt -> 'match' '(' Expr ')' '{' MatchArm* '}'
// MatchArm  -> (Expr (',' Expr)* | 'else') '=>' Block
fn parseMatchStmt(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.Match, start.line, start.column);

  parser.expect(TokenKind.Match, "match");
  parser.expect(TokenKind.LParen, "(");
  parser.ast.nodes[node].a = parseExpr(parser);
  parser.expect(TokenKind.RParen, ")");
  parser.expect(TokenKind.LBrace, "{");

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    let armStart: *Token = parser.current();
    let arm: i32 = parser.ast.add(NodeKind.Arm, armStart.line, armStart.column);

    if (parser.kind() == TokenKind.Else) {
      parser.advance();
      parser.ast.nodes[arm].extra = 1;
    } else {
      while (true) {
        parser.ast.addItem(arm, parseExpr(parser));
        if (parser.kind() != TokenKind.Comma) {
          break;
        }
        parser.advance();
      }
    }

    parser.expect(TokenKind.Arrow, "=>");
    parser.ast.nodes[arm].a = parseBlock(parser);
    parser.ast.addItem(node, arm);

    if (FAILED) {
      break;
    }
  }

  parser.expect(TokenKind.RBrace, "}");

  return node;
}

// Parses one file's top level onto the end of `program`, which is shared by
// every file in the build.
export fn parseModuleInto(parser: *Parser, program: i32): void {
  while (parser.kind() != TokenKind.End) {
    let statement: i32 = parseStatementRecovering(parser);
    if (statement != NO_NODE) {
      parser.ast.addItem(program, statement);
    }
  }
}
