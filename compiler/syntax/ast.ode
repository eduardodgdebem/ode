// ---------------------------------------------------------------------------
// The AST.
//
// Nodes live in one growable arena and refer to each other by index, not by
// pointer: the arena moves when it grows, so a held pointer would dangle. An
// index of NO_NODE is the absent child.
//
// Every node is the same struct with a kind tag. What a node holds is moving
// into `syntax`, a union with a struct per kind that says what each part is:
// a Binary's `left` and `right`, where the older kinds still keep `a`, `b`
// and `c`, which mean different things per kind, and `items`, the
// variable-length child list that only some kinds use. Those are Unmoved.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { alloc, grow } from "std/mem";
import { line } from "../driver/options";
import { Token } from "./token";
import { Type } from "../types/types";

export let NO_NODE: i32 = -1;

// ---------------------------------------------------------------------------
// Syntax: what a node holds, by kind.
// ---------------------------------------------------------------------------

export enum BinaryOp {
  Add,
  Subtract,
  Multiply,
  Divide,
  Remainder,
  Equal,
  NotEqual,
  Less,
  LessEqual,
  Greater,
  GreaterEqual,
  And,
  Or,
  BitAnd,
  BitOr,
  BitXor,
  ShiftLeft,
  ShiftRight,
  // `??`: the left side's value, or the right side when it has none.
  Coalesce,
}

export enum UnaryOp {
  Negate,
  Plus,
  Not,
  // `*p`
  Deref,
  // `&x`
  AddressOf,
}

// `left op right`.
export struct Binary {
  op: BinaryOp,
  left: i32,
  right: i32,
}

// `op operand`.
export struct Unary {
  op: UnaryOp,
  operand: i32,
}

// `value as type`.
export struct Cast {
  value: i32,
  type: i32,
}

// `base[index]`.
export struct Index {
  base: i32,
  index: i32,
}

// `sizeof(type)`.
export struct Sizeof {
  type: i32,
}

// `try value`.
export struct Try {
  value: i32,
}

// `value is type`.
export struct Is {
  value: i32,
  type: i32,
}

// `value catch (name) block`.
export struct Catch {
  value: i32,
  name: *i8,
  block: i32,
}

// A kind not moved into syntax of its own yet: its parts are in the node's
// `a`, `b`, `c`, `text` and `items`.
export struct Unmoved {}

export type Syntax = Binary | Unary | Cast | Index | Sizeof | Try | Is | Catch | Unmoved;

// The children a node's syntax holds, in order, for the walks that visit
// every node without caring what each one is: cloning a generic, marking a
// subtree. A walk also visits `a`, `b`, `c` and `items`, which an Unmoved
// node keeps its children in.
export fn syntaxChildren(syntax: Syntax): *List<i32> {
  let children: *List<i32> = List<i32>.new();
  match (syntax) {
    Binary => {
      children.push(syntax.left);
      children.push(syntax.right);
    }
    Unary => children.push(syntax.operand),
    Cast => {
      children.push(syntax.value);
      children.push(syntax.type);
    }
    Index => {
      children.push(syntax.base);
      children.push(syntax.index);
    }
    Sizeof => children.push(syntax.type),
    Try => children.push(syntax.value),
    Is => {
      children.push(syntax.value);
      children.push(syntax.type);
    }
    Catch => {
      children.push(syntax.value);
      children.push(syntax.block);
    }
    Unmoved => {}
  }
  return children;
}

// `syntax` with its children replaced by `children`, given in the order
// syntaxChildren lists them.
export fn withChildren(syntax: Syntax, children: *List<i32>): Syntax {
  return match (syntax) {
    Binary => Binary { op: syntax.op, left: children.at(0), right: children.at(1) },
    Unary => Unary { op: syntax.op, operand: children.at(0) },
    Cast => Cast { value: children.at(0), type: children.at(1) },
    Index => Index { base: children.at(0), index: children.at(1) },
    Sizeof => Sizeof { type: children.at(0) },
    Try => Try { value: children.at(0) },
    Is => Is { value: children.at(0), type: children.at(1) },
    Catch => Catch { value: children.at(0), name: syntax.name, block: children.at(1) },
    Unmoved => syntax,
  };
}

// A node's syntax as the kind it is known to be.
export fn binaryOf(ast: *Ast, node: i32): Binary {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Binary) {
    return syntax;
  }
  assert(false, "not a binary operator");
  return Binary { op: BinaryOp.Add, left: NO_NODE, right: NO_NODE };
}

export fn unaryOf(ast: *Ast, node: i32): Unary {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Unary) {
    return syntax;
  }
  assert(false, "not a unary operator");
  return Unary { op: UnaryOp.Plus, operand: NO_NODE };
}

export fn castOf(ast: *Ast, node: i32): Cast {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Cast) {
    return syntax;
  }
  assert(false, "not a cast");
  return Cast { value: NO_NODE, type: NO_NODE };
}

export fn isOf(ast: *Ast, node: i32): Is {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Is) {
    return syntax;
  }
  assert(false, "not an is");
  return Is { value: NO_NODE, type: NO_NODE };
}

export fn sizeofOf(ast: *Ast, node: i32): Sizeof {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Sizeof) {
    return syntax;
  }
  assert(false, "not a sizeof");
  return Sizeof { type: NO_NODE };
}

// The operand of `node` when it is a minus in front of something -- `-5`,
// `-x` -- and NO_NODE otherwise.
export fn negated(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Unary) {
    if (syntax.op == UnaryOp.Negate) {
      return syntax.operand;
    }
  }
  return NO_NODE;
}

// How an operator is written, for what a diagnostic quotes.
export fn binaryOpText(op: BinaryOp): *i8 {
  return match (op) {
    .Add => "+",
    .Subtract => "-",
    .Multiply => "*",
    .Divide => "/",
    .Remainder => "%",
    .Equal => "==",
    .NotEqual => "!=",
    .Less => "<",
    .LessEqual => "<=",
    .Greater => ">",
    .GreaterEqual => ">=",
    .And => "&&",
    .Or => "||",
    .BitAnd => "&",
    .BitOr => "|",
    .BitXor => "^",
    .ShiftLeft => "<<",
    .ShiftRight => ">>",
    .Coalesce => "??",
  };
}

export fn unaryOpText(op: UnaryOp): *i8 {
  return match (op) {
    .Negate => "-",
    .Plus => "+",
    .Not => "!",
    .Deref => "*",
    .AddressOf => "&",
  };
}

export enum NodeKind {
  Program,
  Block,
  VarDecl,
  Assign,
  If,
  While,
  Break,
  Continue,
  Fn,
  Extern,
  Struct,
  Field,
  Call,
  Return,
  ExprStmt,
  Binary,
  Unary,
  Cast,
  FieldAccess,
  Index,
  StructLit,
  FieldInit,
  Sizeof,
  Number,
  String,
  Char,
  Bool,
  Ident,
  Type,
  Params,
  Param,
  Args,
  // Stands in for a construct that did not parse.
  Error,
  Import,
  ImportName,
  MethodCall,
  Null,
  Enum,
  EnumMember,
  Match,
  Arm,
  // A function type, `(i32) => bool`.
  FnType,
  // `type Shape = Circle | Rect;`: `text` the name, `a` the type it stands
  // for.
  TypeAlias,
  // A function written where it is used, `(x) => x * 2`. Laid out like a Fn:
  // `a` its return type or NO_NODE, `b` its Params -- each Param's type
  // NO_NODE when left to the context -- and `c` its body, a Block. A body
  // written as an expression becomes a block returning it, with `extra` 1.
  Lambda,
  // A call of a value rather than of a name: `table[i](x)`.
  CallValue,
  For,
  // `<T, U>` after a generic declaration's name, and one of its names.
  TypeParams,
  TypeParam,
  // The `<i64>` of a generic call, `max<i64>(a, b)`.
  // `test "name" { ... }`, laid out like a fn.
  Test,
  // `i64 | ParseError`: a value, or one of the errors, as a type.
  UnionType,
  // `try value`: the value, or its error passed on.
  Try,
  // `value catch (e) { ... }`: the value, or the block run with its error.
  Catch,
  // `value is ParseError`: whether a union holds that error.
  Is,
  TypeArgs,
}

struct Node {
  kind: NodeKind,
  line: i32,
  column: i32,
  // A name, an operator's spelling, or a literal's decoded text.
  text: *i8,
  textLength: i64,
  // Fixed children, NO_NODE when absent:
  //   vardecl  a=type   b=expr
  //   assign   a=target b=expr
  //   if       a=cond   b=then   c=else
  //   while    a=cond   b=body
  //   fn       a=type   b=params c=body
  //   test     a=type   b=params c=body, all a void fn's, and its name
  //   uniontype items=the value's type, then each error's
  //   try      a=value
  //   catch    a=value  b=block, and the error's name
  //   is       a=value  b=type
  //   extern   a=type   b=params
  //   field    a=type
  //   param    a=type
  //   finit    a=value
  //   call     a=args
  //   return   a=expr
  //   exprstmt a=expr
  //   binary   a=left   b=right
  //   unary    a=operand
  //   cast     a=expr   b=type
  //   field access a=object
  //   index    a=base   b=index
  //   sizeof   a=type
  //   importname a=alias, an ident, when the name is renamed with `as`
  //   methodcall a=receiver, or the struct's name b=args
  //   enummember a=value, when one is written
  //   match    a=subject, items=arms
  //   arm      a=body,    items=patterns, none for the `else` arm
  //   fntype   a=return type, items=parameter types
  //   callvalue a=callee b=args
  //   for      a=start  b=end    c=body, and the loop variable's name
  //
  // Generics: a generic struct or fn keeps its TypeParams node's index in
  // `extra`. A type node naming a generic carries its type arguments as
  // items -- `List<i32>` -- and so does the one a generic struct literal
  // keeps in `a`. A generic call keeps its arguments in a typeargs node, `b`.
  a: i32,
  b: i32,
  c: i32,
  // Pointer depth, for a type node. For an import, the module it loads, once
  // the driver has found it. For a match arm, 1 when it is the `else` arm.
  // For a parameter list, 1 when it ends in `...`. For an enum, 1 when it is
  // an `error enum`.
  extra: i32,
  // Child indices, for program, block, struct, structlit, params, args and
  // import. A struct's items are its fields and then, mixed in, its methods.
  items: *i32,
  itemCount: i32,
  itemCapacity: i32,
  // The source file this node was parsed from, as an index into MODULES.
  module: i32,
  // Set on a top-level declaration written with `export`.
  exported: bool,
  // What the node holds, for the kinds moved into a struct of their own.
  syntax: Syntax,
}

export struct Ast {
  nodes: *Node,
  count: i32,
  capacity: i32,
  // Every file is parsed into the one arena, so nodes are stamped with the
  // file being parsed as they are made.
  currentModule: i32,

  fn new(): *Ast {
    let ast: *Ast = alloc<Ast>(1);
    ast.capacity = 256;
    ast.count = 0;
    ast.currentModule = 0;
    ast.nodes = alloc<Node>(ast.capacity as i64);

    return ast;
  }

  fn add(self: *Ast, kind: NodeKind, line: i32, column: i32): i32 {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.nodes = grow<Node>(self.nodes, self.capacity as i64);
    }

    let index: i32 = self.count;
    self.nodes[index].kind = kind;
    self.nodes[index].line = line;
    self.nodes[index].column = column;
    self.nodes[index].text = null;
    self.nodes[index].textLength = 0;
    self.nodes[index].a = NO_NODE;
    self.nodes[index].b = NO_NODE;
    self.nodes[index].c = NO_NODE;
    self.nodes[index].extra = 0;
    self.nodes[index].items = null;
    self.nodes[index].itemCount = 0;
    self.nodes[index].itemCapacity = 0;
    self.nodes[index].module = self.currentModule;
    self.nodes[index].exported = false;
    self.nodes[index].syntax = Unmoved {};
    self.count = self.count + 1;

    return index;
  }

  // Copies a token's text onto a node, length included so a `'\0'` survives.
  fn setText(self: *Ast, index: i32, token: *Token): void {
    self.nodes[index].text = token.text;
    self.nodes[index].textLength = token.length;
  }

  fn addItem(self: *Ast, parent: i32, child: i32): void {
    if (self.nodes[parent].itemCount == self.nodes[parent].itemCapacity) {
      if (self.nodes[parent].itemCapacity == 0) {
        self.nodes[parent].itemCapacity = 4;
        self.nodes[parent].items =
            alloc<i32>(4);
      } else {
        self.nodes[parent].itemCapacity = self.nodes[parent].itemCapacity * 2;
        self.nodes[parent].items =
            grow<i32>(self.nodes[parent].items, self.nodes[parent].itemCapacity as i64);
      }
    }

    let count: i32 = self.nodes[parent].itemCount;
    self.nodes[parent].items[count] = child;
    self.nodes[parent].itemCount = count + 1;
  }
}

export fn nodeKindName(kind: NodeKind): *i8 {
  return match (kind) {
    .Program => "program",
    .Block => "block",
    .VarDecl => "vardecl",
    .Assign => "assign",
    .If => "if",
    .While => "while",
    .Break => "break",
    .Continue => "continue",
    .Fn => "fn",
    .Extern => "extern",
    .Struct => "struct",
    .Field => "field",
    .Call => "call",
    .Return => "return",
    .ExprStmt => "exprstmt",
    .Binary => "binary",
    .Unary => "unary",
    .Cast => "cast",
    .FieldAccess => "fieldaccess",
    .Index => "index",
    .StructLit => "structlit",
    .FieldInit => "finit",
    .Sizeof => "sizeof",
    .Number => "number",
    .String => "string",
    .Char => "char",
    .Bool => "bool",
    .Ident => "ident",
    .Type => "type",
    .Params => "params",
    .Param => "param",
    .Args => "args",
    .UnionType => "uniontype",
    .Try => "try",
    .Catch => "catch",
    .Is => "is",
    .Test => "test",
    .Error => "error",
    .Import => "import",
    .ImportName => "importname",
    .MethodCall => "methodcall",
    .Null => "null",
    .Enum => "enum",
    .EnumMember => "enummember",
    .Match => "match",
    .Arm => "arm",
    .FnType => "fntype",
    .Lambda => "lambda",
    .TypeAlias => "typealias",
    .CallValue => "callvalue",
    .For => "for",
    .TypeParams => "typeparams",
    .TypeParam => "typeparam",
    .TypeArgs => "typeargs",
  };
}

// True for the kinds whose text is worth printing in a dump.
export fn nodeCarriesText(kind: NodeKind): bool {
  return match (kind) {
    .VarDecl, .Fn, .Extern, .Struct, .Field, .Call, .FieldAccess, .StructLit,
    .FieldInit, .Param, .Number, .String, .Char, .Import, .ImportName,
    .MethodCall, .Enum, .EnumMember, .For, .TypeParam, .Bool, .Ident, .Type => true,
    else => false,
  };
}
