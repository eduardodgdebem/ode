// ---------------------------------------------------------------------------
// The AST.
//
// Nodes live in one growable arena and refer to each other by index, not by
// pointer: the arena moves when it grows, so a held pointer would dangle. An
// index of NO_NODE is the absent child.
//
// There are no sum types, so every node is the same struct with a kind tag.
// `a`, `b` and `c` are the fixed children and mean different things per kind;
// `items` is the variable-length child list that only some kinds use.
// ---------------------------------------------------------------------------

import { malloc, realloc } from "../support/libc";
import { Token } from "./token";
import { Type } from "../semantics/types";

export let NO_NODE: i32 = -1;

export enum NodeKind {
  Program,
  Block,
  VarDecl,
  Assign,
  If,
  While,
  Break,
  Continue,
  Fn,
  Extern,
  Struct,
  Field,
  Call,
  Return,
  ExprStmt,
  Binary,
  Unary,
  Cast,
  FieldAccess,
  Index,
  StructLit,
  FieldInit,
  Sizeof,
  Number,
  String,
  Char,
  Bool,
  Ident,
  Type,
  Params,
  Param,
  Args,
  // Stands in for a construct that did not parse.
  Error,
  Import,
  ImportName,
  MethodCall,
  Null,
  Enum,
  EnumMember,
  Match,
  Arm,
  // A function type, `fn(i32): bool`.
  FnType,
  // A call of a value rather than of a name: `table[i](x)`.
  CallValue,
  For,
  // `<T, U>` after a generic declaration's name, and one of its names.
  TypeParams,
  TypeParam,
  // The `<i64>` of a generic call, `max<i64>(a, b)`.
  // `test "name" { ... }`, laid out like a fn.
  Test,
  TypeArgs,
}

struct Node {
  kind: NodeKind,
  line: i32,
  column: i32,
  // A name, an operator's spelling, or a literal's decoded text.
  text: *i8,
  textLength: i64,
  // Fixed children, NO_NODE when absent:
  //   vardecl  a=type   b=expr
  //   assign   a=target b=expr
  //   if       a=cond   b=then   c=else
  //   while    a=cond   b=body
  //   fn       a=type   b=params c=body
  //   test     a=type   b=params c=body, all a void fn's, and its name
  //   extern   a=type   b=params
  //   field    a=type
  //   param    a=type
  //   finit    a=value
  //   call     a=args
  //   return   a=expr
  //   exprstmt a=expr
  //   binary   a=left   b=right
  //   unary    a=operand
  //   cast     a=expr   b=type
  //   field access a=object
  //   index    a=base   b=index
  //   sizeof   a=type
  //   importname a=alias, an ident, when the name is renamed with `as`
  //   methodcall a=receiver, or the struct's name b=args
  //   enummember a=value, when one is written
  //   match    a=subject, items=arms
  //   arm      a=body,    items=patterns, none for the `else` arm
  //   fntype   a=return type, items=parameter types
  //   callvalue a=callee b=args
  //   for      a=start  b=end    c=body, and the loop variable's name
  //
  // Generics: a generic struct or fn keeps its TypeParams node's index in
  // `extra`. A type node naming a generic carries its type arguments as
  // items -- `List<i32>` -- and so does the one a generic struct literal
  // keeps in `a`. A generic call keeps its arguments in a typeargs node, `b`.
  a: i32,
  b: i32,
  c: i32,
  // Pointer depth, for a type node. For an import, the module it loads, once
  // the driver has found it. For a match arm, 1 when it is the `else` arm.
  // For a parameter list, 1 when it ends in `...`.
  extra: i32,
  // Child indices, for program, block, struct, structlit, params, args and
  // import. A struct's items are its fields and then, mixed in, its methods.
  items: *i32,
  itemCount: i32,
  itemCapacity: i32,
  // The source file this node was parsed from, as an index into MODULES.
  module: i32,
  // Set on a top-level declaration written with `export`.
  exported: bool,
}

export struct Ast {
  nodes: *Node,
  count: i32,
  capacity: i32,
  // Every file is parsed into the one arena, so nodes are stamped with the
  // file being parsed as they are made.
  currentModule: i32,

  fn new(): *Ast {
    let ast: *Ast = malloc(sizeof(Ast)) as *Ast;
    ast.capacity = 256;
    ast.count = 0;
    ast.currentModule = 0;
    ast.nodes = malloc(sizeof(Node) * ast.capacity as i64) as *Node;

    return ast;
  }

  fn add(self: *Ast, kind: NodeKind, line: i32, column: i32): i32 {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.nodes = realloc(self.nodes as *i8,
                           sizeof(Node) * self.capacity as i64) as *Node;
    }

    let index: i32 = self.count;
    self.nodes[index].kind = kind;
    self.nodes[index].line = line;
    self.nodes[index].column = column;
    self.nodes[index].text = null;
    self.nodes[index].textLength = 0;
    self.nodes[index].a = NO_NODE;
    self.nodes[index].b = NO_NODE;
    self.nodes[index].c = NO_NODE;
    self.nodes[index].extra = 0;
    self.nodes[index].items = null;
    self.nodes[index].itemCount = 0;
    self.nodes[index].itemCapacity = 0;
    self.nodes[index].module = self.currentModule;
    self.nodes[index].exported = false;
    self.count = self.count + 1;

    return index;
  }

  // Copies a token's text onto a node, length included so a `'\0'` survives.
  fn setText(self: *Ast, index: i32, token: *Token): void {
    self.nodes[index].text = token.text;
    self.nodes[index].textLength = token.length;
  }

  fn addItem(self: *Ast, parent: i32, child: i32): void {
    if (self.nodes[parent].itemCount == self.nodes[parent].itemCapacity) {
      if (self.nodes[parent].itemCapacity == 0) {
        self.nodes[parent].itemCapacity = 4;
        self.nodes[parent].items =
            malloc(sizeof(i32) * 4) as *i32;
      } else {
        self.nodes[parent].itemCapacity = self.nodes[parent].itemCapacity * 2;
        self.nodes[parent].items =
            realloc(self.nodes[parent].items as *i8,
                    sizeof(i32) *
                        self.nodes[parent].itemCapacity as i64) as *i32;
      }
    }

    let count: i32 = self.nodes[parent].itemCount;
    self.nodes[parent].items[count] = child;
    self.nodes[parent].itemCount = count + 1;
  }
}

export fn nodeKindName(kind: NodeKind): *i8 {
  match (kind) {
    NodeKind.Program => { return "program"; }
    NodeKind.Block => { return "block"; }
    NodeKind.VarDecl => { return "vardecl"; }
    NodeKind.Assign => { return "assign"; }
    NodeKind.If => { return "if"; }
    NodeKind.While => { return "while"; }
    NodeKind.Break => { return "break"; }
    NodeKind.Continue => { return "continue"; }
    NodeKind.Fn => { return "fn"; }
    NodeKind.Extern => { return "extern"; }
    NodeKind.Struct => { return "struct"; }
    NodeKind.Field => { return "field"; }
    NodeKind.Call => { return "call"; }
    NodeKind.Return => { return "return"; }
    NodeKind.ExprStmt => { return "exprstmt"; }
    NodeKind.Binary => { return "binary"; }
    NodeKind.Unary => { return "unary"; }
    NodeKind.Cast => { return "cast"; }
    NodeKind.FieldAccess => { return "fieldaccess"; }
    NodeKind.Index => { return "index"; }
    NodeKind.StructLit => { return "structlit"; }
    NodeKind.FieldInit => { return "finit"; }
    NodeKind.Sizeof => { return "sizeof"; }
    NodeKind.Number => { return "number"; }
    NodeKind.String => { return "string"; }
    NodeKind.Char => { return "char"; }
    NodeKind.Bool => { return "bool"; }
    NodeKind.Ident => { return "ident"; }
    NodeKind.Type => { return "type"; }
    NodeKind.Params => { return "params"; }
    NodeKind.Param => { return "param"; }
    NodeKind.Args => { return "args"; }
    NodeKind.Test => { return "test"; }
    NodeKind.Error => { return "error"; }
    NodeKind.Import => { return "import"; }
    NodeKind.ImportName => { return "importname"; }
    NodeKind.MethodCall => { return "methodcall"; }
    NodeKind.Null => { return "null"; }
    NodeKind.Enum => { return "enum"; }
    NodeKind.EnumMember => { return "enummember"; }
    NodeKind.Match => { return "match"; }
    NodeKind.Arm => { return "arm"; }
    NodeKind.FnType => { return "fntype"; }
    NodeKind.CallValue => { return "callvalue"; }
    NodeKind.For => { return "for"; }
    NodeKind.TypeParams => { return "typeparams"; }
    NodeKind.TypeParam => { return "typeparam"; }
    NodeKind.TypeArgs => { return "typeargs"; }
  }

  return "?";
}

// True for the kinds whose text is worth printing in a dump.
export fn nodeCarriesText(kind: NodeKind): bool {
  if (kind == NodeKind.VarDecl || kind == NodeKind.Fn || kind == NodeKind.Extern) {
    return true;
  }
  if (kind == NodeKind.Struct || kind == NodeKind.Field || kind == NodeKind.Call) {
    return true;
  }
  if (kind == NodeKind.Binary || kind == NodeKind.Unary || kind == NodeKind.FieldAccess) {
    return true;
  }
  if (kind == NodeKind.StructLit || kind == NodeKind.FieldInit || kind == NodeKind.Param) {
    return true;
  }
  if (kind == NodeKind.Number || kind == NodeKind.String || kind == NodeKind.Char) {
    return true;
  }
  if (kind == NodeKind.Import || kind == NodeKind.ImportName || kind == NodeKind.MethodCall) {
    return true;
  }
  if (kind == NodeKind.Enum || kind == NodeKind.EnumMember ||
      kind == NodeKind.For || kind == NodeKind.TypeParam) {
    return true;
  }

  return kind == NodeKind.Bool || kind == NodeKind.Ident || kind == NodeKind.Type;
}
