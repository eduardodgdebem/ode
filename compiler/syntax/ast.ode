// ---------------------------------------------------------------------------
// The AST.
//
// Nodes live in one growable arena and refer to each other by index, not by
// pointer: the arena moves when it grows, so a held pointer would dangle. An
// index of NO_NODE is the absent child.
//
// What a node holds is its `syntax`: a union with a struct per kind that
// names each part -- a Binary's `left` and `right`, an If's `condition`,
// `then` and `otherwise` -- so a part is read as what it is, and a kind
// added to the union is an error at every match that does not handle it.
// The node itself keeps where it was written, the file it came from, and
// its kind.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { List } from "std/list";
import { alloc, grow } from "std/mem";
import { line } from "../driver/options";
import { Token } from "./token";
import { Type } from "../types/types";

export let NO_NODE: i32 = -1;

// ---------------------------------------------------------------------------
// Syntax: what a node holds, by kind.
// ---------------------------------------------------------------------------

export enum BinaryOp {
  Add,
  Subtract,
  Multiply,
  Divide,
  Remainder,
  Equal,
  NotEqual,
  Less,
  LessEqual,
  Greater,
  GreaterEqual,
  And,
  Or,
  BitAnd,
  BitOr,
  BitXor,
  ShiftLeft,
  ShiftRight,
  // `??`: the left side's value, or the right side when it has none.
  Coalesce,
}

export enum UnaryOp {
  Negate,
  Plus,
  Not,
  // `*p`
  Deref,
  // `&x`
  AddressOf,
}

// The program: every file's top level, one after the other.
export struct Program {
  items: *List<i32>,
}

export struct Block {
  items: *List<i32>,
}

// `let name: type = value;`
export struct VarDecl {
  name: *i8,
  type: i32,
  value: i32,
}

// `target = value;`. `a += b` is `a = a + b`.
export struct Assign {
  target: i32,
  value: i32,
}

export struct If {
  condition: i32,
  then: i32,
  // NO_NODE without an `else`.
  otherwise: i32,
}

export struct While {
  condition: i32,
  body: i32,
}

// `for (name in start..end) body`.
export struct For {
  name: *i8,
  start: i32,
  end: i32,
  body: i32,
}

export struct Break {}

// `defer statement;`: the statement, run as the block it is in is left.
export struct Defer {
  body: i32,
}

export struct Continue {}

export struct Return {
  // NO_NODE for `return;`.
  value: i32,
}

export struct ExprStmt {
  value: i32,
}

// A `fn`, or a `test`, which is a void function named by its string.
export struct Function {
  name: *i8,
  // The TypeParams of a generic, or NO_NODE.
  typeParams: i32,
  returnType: i32,
  params: i32,
  body: i32,
}

export struct Extern {
  name: *i8,
  returnType: i32,
  params: i32,
}

export struct StructDecl {
  name: *i8,
  // The TypeParams of a generic, or NO_NODE.
  typeParams: i32,
  // Its fields and, mixed in, its methods.
  members: *List<i32>,
}

export struct FieldDecl {
  name: *i8,
  type: i32,
}

export struct Params {
  list: *List<i32>,
  // Whether the list ends in `...`.
  variadic: bool,
}

export struct Param {
  name: *i8,
  // NO_NODE for a lambda's parameter left to its context.
  type: i32,
}

export struct EnumDecl {
  name: *i8,
  members: *List<i32>,
  // `error enum`.
  isError: bool,
}

export struct EnumMember {
  name: *i8,
  // The written value, or NO_NODE.
  value: i32,
}

export struct Import {
  path: *i8,
  names: *List<i32>,
  // The module it loads, once the driver has found it; -1 before.
  module: i32,
}

// One name an import brings in.
export struct ImportName {
  name: *i8,
  // An Ident: the name it is renamed to with `as`, or NO_NODE.
  alias: i32,
}

export struct TypeAlias {
  name: *i8,
  type: i32,
}

export struct Match {
  subject: i32,
  arms: *List<i32>,
  // Whether it is used as a value.
  isValue: bool,
}

export struct Arm {
  patterns: *List<i32>,
  body: i32,
  isElse: bool,
}

// `name(args)`, `name<T>(args)`.
export struct Call {
  name: *i8,
  args: i32,
  // A type node holding the type arguments of a generic call, or NO_NODE.
  typeArgs: i32,
}

// A call of a value rather than of a name: `table[i](x)`.
export struct CallValue {
  callee: i32,
  args: i32,
}

// `receiver.name(args)`. The receiver may be a struct's name, `Point.new()`,
// or a type, `List<i32>.new()`.
export struct MethodCall {
  receiver: i32,
  name: *i8,
  args: i32,
}

// `object.field`. With no object -- NO_NODE -- it is `.Red`, a member of the
// enum the context expects.
export struct FieldAccess {
  object: i32,
  field: *i8,
}

// `Name { field: value, ... }`.
export struct StructLit {
  name: *i8,
  // A generic's type node, `Pair<i32, bool>`, or NO_NODE.
  type: i32,
  fields: *List<i32>,
}

export struct FieldInit {
  name: *i8,
  value: i32,
}

export struct Args {
  items: *List<i32>,
}

// `(params): returnType => body`.
export struct Lambda {
  // NO_NODE when left to the context.
  returnType: i32,
  params: i32,
  // A Block; for a body written as an expression, one returning it.
  body: i32,
  // Whether the body was written as an expression.
  expressionBody: bool,
}

// `left op right`.
export struct Binary {
  op: BinaryOp,
  left: i32,
  right: i32,
}

// `op operand`.
export struct Unary {
  op: UnaryOp,
  operand: i32,
}

// `value as type`.
export struct Cast {
  value: i32,
  type: i32,
}

// `base[index]`.
export struct Index {
  base: i32,
  index: i32,
}

// `sizeof(type)`.
export struct Sizeof {
  type: i32,
}

// `try value`.
export struct Try {
  value: i32,
}

// `value is type`.
export struct Is {
  value: i32,
  type: i32,
}

// `value catch (name) block`.
export struct Catch {
  value: i32,
  name: *i8,
  block: i32,
}

// Literals keep their decoded text, and its length, so that a `'\0'` in
// one survives.
export struct NumberLit {
  text: *i8,
  length: i64,
}

export struct StringLit {
  text: *i8,
  length: i64,
}

export struct CharLit {
  text: *i8,
  length: i64,
}

export struct BoolLit {
  value: bool,
}

export struct NullLit {}

export struct Ident {
  name: *i8,
}

// A type as written: `i64`, `*Point`, `List<i32>`.
export struct TypeRef {
  name: *i8,
  // How many `*` are in front of it.
  depth: i32,
  // The type arguments of a generic, `List<i32>`; empty otherwise.
  args: *List<i32>,
}

// `(i32, bool) => i32`.
export struct FnTypeRef {
  params: *List<i32>,
  result: i32,
  depth: i32,
}

// `[]T`: a slice of T, a pointer and a length.
export struct SliceTypeRef {
  element: i32,
  depth: i32,
}

// `base[start..end]`: the slice of a pointer or of another slice from
// `start` up to, not including, `end`. Either may be NO_NODE -- `s[..n]`,
// `s[k..]` -- for the start or the end of what is sliced.
export struct Slicing {
  base: i32,
  start: i32,
  end: i32,
}

// `i64 | ParseError`.
export struct UnionTypeRef {
  members: *List<i32>,
}

// `<T, U>` after a generic declaration's name.
export struct TypeParams {
  names: *List<i32>,
}

export struct TypeParam {
  name: *i8,
}

export struct TypeArgs {
  types: *List<i32>,
}

// Stands in for a construct that did not parse.
export struct ErrorNode {}

export type Syntax = Program | Block | VarDecl | Assign | If | While | For | Break |
    Continue | Defer | Return | ExprStmt | Function | Extern | StructDecl | FieldDecl |
    Params | Param | EnumDecl | EnumMember | Import | ImportName | TypeAlias |
    Match | Arm | Call | CallValue | MethodCall | FieldAccess | StructLit |
    FieldInit | Args | Lambda | Binary | Unary | Cast | Index | Sizeof | Try |
    Is | Catch | NumberLit | StringLit | CharLit | BoolLit | NullLit | Ident |
    TypeRef | FnTypeRef | SliceTypeRef | Slicing | UnionTypeRef | TypeParams | TypeParam |
    TypeArgs |
    ErrorNode;

fn listOf(first: i32, second: i32): *List<i32> {
  let list: *List<i32> = List<i32>.new();
  list.push(first);
  list.push(second);
  return list;
}

fn joined(fixed: *List<i32>, items: *List<i32>): *List<i32> {
  for (index in 0..items.count) {
    fixed.push(items.at(index));
  }
  return fixed;
}

fn single(child: i32): *List<i32> {
  let list: *List<i32> = List<i32>.new();
  list.push(child);
  return list;
}

// Every child a node's syntax holds, in order -- its fixed parts first,
// NO_NODE where one is absent, then its list -- for the walks that visit
// every node without caring what each one is: cloning a generic, marking a
// subtree, dumping.
export fn syntaxChildren(syntax: Syntax): *List<i32> {
  return match (syntax) {
    Program => joined(List<i32>.new(), syntax.items),
    Block => joined(List<i32>.new(), syntax.items),
    VarDecl => listOf(syntax.type, syntax.value),
    Assign => listOf(syntax.target, syntax.value),
    If => joined(listOf(syntax.condition, syntax.then), single(syntax.otherwise)),
    While => listOf(syntax.condition, syntax.body),
    For => joined(listOf(syntax.start, syntax.end), single(syntax.body)),
    Return => single(syntax.value),
    Defer => single(syntax.body),
    ExprStmt => single(syntax.value),
    Function => joined(listOf(syntax.typeParams, syntax.returnType),
                       listOf(syntax.params, syntax.body)),
    Extern => listOf(syntax.returnType, syntax.params),
    StructDecl => joined(single(syntax.typeParams), syntax.members),
    FieldDecl => single(syntax.type),
    Params => joined(List<i32>.new(), syntax.list),
    Param => single(syntax.type),
    EnumDecl => joined(List<i32>.new(), syntax.members),
    EnumMember => single(syntax.value),
    Import => joined(List<i32>.new(), syntax.names),
    ImportName => single(syntax.alias),
    TypeAlias => single(syntax.type),
    Match => joined(single(syntax.subject), syntax.arms),
    Arm => joined(single(syntax.body), syntax.patterns),
    Call => listOf(syntax.args, syntax.typeArgs),
    CallValue => listOf(syntax.callee, syntax.args),
    MethodCall => listOf(syntax.receiver, syntax.args),
    FieldAccess => single(syntax.object),
    StructLit => joined(single(syntax.type), syntax.fields),
    FieldInit => single(syntax.value),
    Args => joined(List<i32>.new(), syntax.items),
    Lambda => joined(listOf(syntax.returnType, syntax.params), single(syntax.body)),
    Binary => listOf(syntax.left, syntax.right),
    Unary => single(syntax.operand),
    Cast => listOf(syntax.value, syntax.type),
    Index => listOf(syntax.base, syntax.index),
    Sizeof => single(syntax.type),
    Try => single(syntax.value),
    Is => listOf(syntax.value, syntax.type),
    Catch => listOf(syntax.value, syntax.block),
    TypeRef => joined(List<i32>.new(), syntax.args),
    FnTypeRef => joined(single(syntax.result), syntax.params),
    SliceTypeRef => single(syntax.element),
    Slicing => joined(listOf(syntax.base, syntax.start), single(syntax.end)),
    UnionTypeRef => joined(List<i32>.new(), syntax.members),
    TypeParams => joined(List<i32>.new(), syntax.names),
    TypeArgs => joined(List<i32>.new(), syntax.types),
    else => List<i32>.new(),
  };
}

// The children after the first `from`, as a list of their own.
fn rest(children: *List<i32>, from: i32): *List<i32> {
  let list: *List<i32> = List<i32>.new();
  for (index in from as i64..children.count) {
    list.push(children.at(index));
  }
  return list;
}

// `syntax` with its children replaced by `children`, given in the order
// syntaxChildren lists them. Its lists are new ones.
export fn withChildren(syntax: Syntax, children: *List<i32>): Syntax {
  return match (syntax) {
    Program => Program { items: rest(children, 0) },
    Block => Block { items: rest(children, 0) },
    VarDecl => VarDecl { name: syntax.name, type: children.at(0), value: children.at(1) },
    Assign => Assign { target: children.at(0), value: children.at(1) },
    If => If { condition: children.at(0), then: children.at(1), otherwise: children.at(2) },
    While => While { condition: children.at(0), body: children.at(1) },
    For => For { name: syntax.name, start: children.at(0), end: children.at(1),
                 body: children.at(2) },
    Return => Return { value: children.at(0) },
    Defer => Defer { body: children.at(0) },
    ExprStmt => ExprStmt { value: children.at(0) },
    Function => Function { name: syntax.name, typeParams: children.at(0),
                           returnType: children.at(1), params: children.at(2),
                           body: children.at(3) },
    Extern => Extern { name: syntax.name, returnType: children.at(0),
                       params: children.at(1) },
    StructDecl => StructDecl { name: syntax.name, typeParams: children.at(0),
                               members: rest(children, 1) },
    FieldDecl => FieldDecl { name: syntax.name, type: children.at(0) },
    Params => Params { list: rest(children, 0), variadic: syntax.variadic },
    Param => Param { name: syntax.name, type: children.at(0) },
    EnumDecl => EnumDecl { name: syntax.name, members: rest(children, 0),
                           isError: syntax.isError },
    EnumMember => EnumMember { name: syntax.name, value: children.at(0) },
    Import => Import { path: syntax.path, names: rest(children, 0), module: syntax.module },
    ImportName => ImportName { name: syntax.name, alias: children.at(0) },
    TypeAlias => TypeAlias { name: syntax.name, type: children.at(0) },
    Match => Match { subject: children.at(0), arms: rest(children, 1),
                     isValue: syntax.isValue },
    Arm => Arm { patterns: rest(children, 1), body: children.at(0), isElse: syntax.isElse },
    Call => Call { name: syntax.name, args: children.at(0), typeArgs: children.at(1) },
    CallValue => CallValue { callee: children.at(0), args: children.at(1) },
    MethodCall => MethodCall { receiver: children.at(0), name: syntax.name,
                               args: children.at(1) },
    FieldAccess => FieldAccess { object: children.at(0), field: syntax.field },
    StructLit => StructLit { name: syntax.name, type: children.at(0),
                             fields: rest(children, 1) },
    FieldInit => FieldInit { name: syntax.name, value: children.at(0) },
    Args => Args { items: rest(children, 0) },
    Lambda => Lambda { returnType: children.at(0), params: children.at(1),
                       body: children.at(2), expressionBody: syntax.expressionBody },
    Binary => Binary { op: syntax.op, left: children.at(0), right: children.at(1) },
    Unary => Unary { op: syntax.op, operand: children.at(0) },
    Cast => Cast { value: children.at(0), type: children.at(1) },
    Index => Index { base: children.at(0), index: children.at(1) },
    Sizeof => Sizeof { type: children.at(0) },
    Try => Try { value: children.at(0) },
    Is => Is { value: children.at(0), type: children.at(1) },
    Catch => Catch { value: children.at(0), name: syntax.name, block: children.at(1) },
    TypeRef => TypeRef { name: syntax.name, depth: syntax.depth, args: rest(children, 0) },
    FnTypeRef => FnTypeRef { params: rest(children, 1), result: children.at(0),
                             depth: syntax.depth },
    SliceTypeRef => SliceTypeRef { element: children.at(0), depth: syntax.depth },
    Slicing => Slicing { base: children.at(0), start: children.at(1), end: children.at(2) },
    UnionTypeRef => UnionTypeRef { members: rest(children, 0) },
    TypeParams => TypeParams { names: rest(children, 0) },
    TypeArgs => TypeArgs { types: rest(children, 0) },
    else => syntax,
  };
}

// The name a node has, for the kinds that have one -- a declaration's, a
// reference's, a literal's text -- or null.
export fn nodeName(ast: *Ast, node: i32): *i8 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    VarDecl => syntax.name,
    For => syntax.name,
    Function => syntax.name,
    Extern => syntax.name,
    StructDecl => syntax.name,
    FieldDecl => syntax.name,
    Param => syntax.name,
    EnumDecl => syntax.name,
    EnumMember => syntax.name,
    Import => syntax.path,
    ImportName => syntax.name,
    TypeAlias => syntax.name,
    Call => syntax.name,
    MethodCall => syntax.name,
    FieldAccess => syntax.field,
    StructLit => syntax.name,
    FieldInit => syntax.name,
    Catch => syntax.name,
    NumberLit => syntax.text,
    StringLit => syntax.text,
    CharLit => syntax.text,
    Ident => syntax.name,
    TypeRef => syntax.name,
    TypeParam => syntax.name,
    else => null,
  };
}

// Renames a node that has a name: linking gives declarations and references
// the names the IR knows them by.
export fn setNodeName(ast: *Ast, node: i32, name: *i8): void {
  let syntax: Syntax = ast.nodes[node].syntax;
  ast.nodes[node].syntax = match (syntax) {
    VarDecl => VarDecl { name: name, type: syntax.type, value: syntax.value },
    Function => Function { name: name, typeParams: syntax.typeParams,
                           returnType: syntax.returnType, params: syntax.params,
                           body: syntax.body },
    Extern => Extern { name: name, returnType: syntax.returnType, params: syntax.params },
    StructDecl => StructDecl { name: name, typeParams: syntax.typeParams,
                               members: syntax.members },
    EnumDecl => EnumDecl { name: name, members: syntax.members, isError: syntax.isError },
    TypeAlias => TypeAlias { name: name, type: syntax.type },
    Call => Call { name: name, args: syntax.args, typeArgs: syntax.typeArgs },
    MethodCall => MethodCall { receiver: syntax.receiver, name: name, args: syntax.args },
    StructLit => StructLit { name: name, type: syntax.type, fields: syntax.fields },
    Ident => Ident { name: name },
    TypeRef => TypeRef { name: name, depth: syntax.depth, args: syntax.args },
    else => {
      assert(false, "a node with no name to set");
      return;
    }
  };
}

// The list a node keeps its items in -- a block's statements, a call's
// arguments, a struct's members -- or an empty one, for a kind with none.
export fn nodeItems(ast: *Ast, node: i32): *List<i32> {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    Program => syntax.items,
    Block => syntax.items,
    StructDecl => syntax.members,
    Params => syntax.list,
    EnumDecl => syntax.members,
    Import => syntax.names,
    Match => syntax.arms,
    Arm => syntax.patterns,
    StructLit => syntax.fields,
    Args => syntax.items,
    TypeRef => syntax.args,
    FnTypeRef => syntax.params,
    UnionTypeRef => syntax.members,
    TypeParams => syntax.names,
    TypeArgs => syntax.types,
    else => List<i32>.new(),
  };
}

// How many items a node keeps, and the one at `index`, for the walks that
// count with an i32.
export fn itemCount(ast: *Ast, node: i32): i32 {
  return nodeItems(ast, node).count as i32;
}

export fn itemAt(ast: *Ast, node: i32, index: i32): i32 {
  return nodeItems(ast, node).at(index as i64);
}

// The length of a node's name or text -- a literal's, which a `'\0'` in it
// does not end -- or 0 for one with none.
export fn nodeTextLength(ast: *Ast, node: i32): i64 {
  let syntax: Syntax = ast.nodes[node].syntax;
  let text: *i8 = nodeName(ast, node);
  return match (syntax) {
    NumberLit => syntax.length,
    StringLit => syntax.length,
    CharLit => syntax.length,
    else => {
      if (text == null) {
        return 0;
      }
      return strlen(text);
    }
  };
}

// The module an import loads -- once the driver has found it -- or -1, for
// an import not yet found or a node that is no import.
export fn importModule(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Import) {
    return syntax.module;
  }
  return -1;
}

// Records the module an import loads.
export fn setImportModule(ast: *Ast, node: i32, module: i32): void {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Import) {
    ast.nodes[node].syntax = Import { path: syntax.path, names: syntax.names, module: module };
  }
}

// The type written for a declaration -- a variable, a parameter, a field, an
// alias -- or NO_NODE.
export fn typeNodeOf(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    VarDecl => syntax.type,
    Param => syntax.type,
    FieldDecl => syntax.type,
    TypeAlias => syntax.type,
    else => NO_NODE,
  };
}

// The return type a function, an extern or a lambda was declared with, or
// NO_NODE.
export fn returnTypeOf(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    Function => syntax.returnType,
    Extern => syntax.returnType,
    Lambda => syntax.returnType,
    else => NO_NODE,
  };
}

// The Params of a function, an extern or a lambda, or NO_NODE.
export fn paramsOf(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    Function => syntax.params,
    Extern => syntax.params,
    Lambda => syntax.params,
    else => NO_NODE,
  };
}

// A type node's pointer depth -- a TypeRef's or a FnTypeRef's -- or 0.
export fn typeDepth(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    TypeRef => syntax.depth,
    FnTypeRef => syntax.depth,
    SliceTypeRef => syntax.depth,
    else => 0,
  };
}

// A node's syntax as the kind it is known to be.
export fn binaryOf(ast: *Ast, node: i32): Binary {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Binary) {
    return syntax;
  }
  assert(false, "not a binary operator");
  return Binary { op: BinaryOp.Add, left: NO_NODE, right: NO_NODE };
}

export fn unaryOf(ast: *Ast, node: i32): Unary {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Unary) {
    return syntax;
  }
  assert(false, "not a unary operator");
  return Unary { op: UnaryOp.Plus, operand: NO_NODE };
}

export fn functionOf(ast: *Ast, node: i32): Function {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Function) {
    return syntax;
  }
  assert(false, "not a function");
  return Function { name: null, typeParams: NO_NODE, returnType: NO_NODE, params: NO_NODE,
                    body: NO_NODE };
}

export fn paramOf(ast: *Ast, node: i32): Param {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Param) {
    return syntax;
  }
  assert(false, "not a parameter");
  return Param { name: null, type: NO_NODE };
}

export fn armOf(ast: *Ast, node: i32): Arm {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Arm) {
    return syntax;
  }
  assert(false, "not an arm");
  return Arm { patterns: List<i32>.new(), body: NO_NODE, isElse: false };
}

export fn callOf(ast: *Ast, node: i32): Call {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Call) {
    return syntax;
  }
  assert(false, "not a call");
  return Call { name: null, args: NO_NODE, typeArgs: NO_NODE };
}

export fn varDeclOf(ast: *Ast, node: i32): VarDecl {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is VarDecl) {
    return syntax;
  }
  assert(false, "not a declaration");
  return VarDecl { name: null, type: NO_NODE, value: NO_NODE };
}

export fn matchOf(ast: *Ast, node: i32): Match {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Match) {
    return syntax;
  }
  assert(false, "not a match");
  return Match { subject: NO_NODE, arms: List<i32>.new(), isValue: false };
}

export fn methodCallOf(ast: *Ast, node: i32): MethodCall {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is MethodCall) {
    return syntax;
  }
  assert(false, "not a method call");
  return MethodCall { receiver: NO_NODE, name: null, args: NO_NODE };
}

export fn fieldInitOf(ast: *Ast, node: i32): FieldInit {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is FieldInit) {
    return syntax;
  }
  assert(false, "not a field initialiser");
  return FieldInit { name: null, value: NO_NODE };
}

export fn lambdaOf(ast: *Ast, node: i32): Lambda {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Lambda) {
    return syntax;
  }
  assert(false, "not a lambda");
  return Lambda { returnType: NO_NODE, params: NO_NODE, body: NO_NODE,
                  expressionBody: false };
}

export fn fieldAccessOf(ast: *Ast, node: i32): FieldAccess {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is FieldAccess) {
    return syntax;
  }
  assert(false, "not a field access");
  return FieldAccess { object: NO_NODE, field: null };
}

// The body of a function or a lambda.
export fn bodyOf(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  return match (syntax) {
    Function => syntax.body,
    Lambda => syntax.body,
    else => NO_NODE,
  };
}

export fn castOf(ast: *Ast, node: i32): Cast {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Cast) {
    return syntax;
  }
  assert(false, "not a cast");
  return Cast { value: NO_NODE, type: NO_NODE };
}

export fn isOf(ast: *Ast, node: i32): Is {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Is) {
    return syntax;
  }
  assert(false, "not an is");
  return Is { value: NO_NODE, type: NO_NODE };
}

export fn sizeofOf(ast: *Ast, node: i32): Sizeof {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Sizeof) {
    return syntax;
  }
  assert(false, "not a sizeof");
  return Sizeof { type: NO_NODE };
}

// The operand of `node` when it is a minus in front of something -- `-5`,
// `-x` -- and NO_NODE otherwise.
export fn negated(ast: *Ast, node: i32): i32 {
  let syntax: Syntax = ast.nodes[node].syntax;
  if (syntax is Unary) {
    if (syntax.op == UnaryOp.Negate) {
      return syntax.operand;
    }
  }
  return NO_NODE;
}

// How an operator is written, for what a diagnostic quotes.
export fn binaryOpText(op: BinaryOp): *i8 {
  return match (op) {
    .Add => "+",
    .Subtract => "-",
    .Multiply => "*",
    .Divide => "/",
    .Remainder => "%",
    .Equal => "==",
    .NotEqual => "!=",
    .Less => "<",
    .LessEqual => "<=",
    .Greater => ">",
    .GreaterEqual => ">=",
    .And => "&&",
    .Or => "||",
    .BitAnd => "&",
    .BitOr => "|",
    .BitXor => "^",
    .ShiftLeft => "<<",
    .ShiftRight => ">>",
    .Coalesce => "??",
  };
}

export fn unaryOpText(op: UnaryOp): *i8 {
  return match (op) {
    .Negate => "-",
    .Plus => "+",
    .Not => "!",
    .Deref => "*",
    .AddressOf => "&",
  };
}

export enum NodeKind {
  Program,
  Block,
  VarDecl,
  Assign,
  If,
  While,
  Break,
  Continue,
  Defer,
  Fn,
  Extern,
  Struct,
  Field,
  Call,
  Return,
  ExprStmt,
  Binary,
  Unary,
  Cast,
  FieldAccess,
  Index,
  StructLit,
  FieldInit,
  Sizeof,
  Number,
  String,
  Char,
  Bool,
  Ident,
  Type,
  Params,
  Param,
  Args,
  // Stands in for a construct that did not parse.
  Error,
  Import,
  ImportName,
  MethodCall,
  Null,
  Enum,
  EnumMember,
  Match,
  Arm,
  // A function type, `(i32) => bool`.
  FnType,
  // `type Shape = Circle | Rect;`
  TypeAlias,
  // A function written where it is used, `(x) => x * 2`.
  Lambda,
  // A call of a value rather than of a name: `table[i](x)`.
  CallValue,
  For,
  // `<T, U>` after a generic declaration's name, and one of its names.
  TypeParams,
  TypeParam,
  // `test "name" { ... }`.
  Test,
  // `i64 | ParseError`: a value, or one of the errors, as a type.
  UnionType,
  // `try value`: the value, or its error passed on.
  Try,
  // `value catch (e) { ... }`: the value, or the block run with its error.
  Catch,
  // `value is ParseError`: whether a union holds that error.
  Is,
  // The `<i64>` of a generic call, `max<i64>(a, b)`.
  TypeArgs,
  // `[]T`, and `base[start..end]`.
  SliceType,
  Slicing,
}

struct Node {
  kind: NodeKind,
  line: i32,
  column: i32,
  // The source file this node was parsed from, as an index into MODULES.
  module: i32,
  // Set on a top-level declaration written with `export`.
  exported: bool,
  // What the node holds; see Syntax.
  syntax: Syntax,
}

export struct Ast {
  nodes: *Node,
  count: i32,
  capacity: i32,
  // Every file is parsed into the one arena, so nodes are stamped with the
  // file being parsed as they are made.
  currentModule: i32,

  fn new(): *Ast {
    let ast: *Ast = alloc<Ast>(1);
    ast.capacity = 256;
    ast.count = 0;
    ast.currentModule = 0;
    ast.nodes = alloc<Node>(ast.capacity as i64);

    return ast;
  }

  // A new node of `kind`, holding `syntax`.
  fn add(self: *Ast, kind: NodeKind, line: i32, column: i32, syntax: Syntax): i32 {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.nodes = grow<Node>(self.nodes, self.capacity as i64);
    }

    let index: i32 = self.count;
    self.nodes[index].kind = kind;
    self.nodes[index].line = line;
    self.nodes[index].column = column;
    self.nodes[index].module = self.currentModule;
    self.nodes[index].exported = false;
    self.nodes[index].syntax = syntax;
    self.count = self.count + 1;

    return index;
  }

  // Adds `child` to the end of the list `parent` keeps its items in.
  fn addItem(self: *Ast, parent: i32, child: i32): void {
    nodeItems(self, parent).push(child);
  }
}

export fn nodeKindName(kind: NodeKind): *i8 {
  return match (kind) {
    .Program => "program",
    .Block => "block",
    .VarDecl => "vardecl",
    .Assign => "assign",
    .If => "if",
    .While => "while",
    .Break => "break",
    .Continue => "continue",
    .Defer => "defer",
    .Fn => "fn",
    .Extern => "extern",
    .Struct => "struct",
    .Field => "field",
    .Call => "call",
    .Return => "return",
    .ExprStmt => "exprstmt",
    .Binary => "binary",
    .Unary => "unary",
    .Cast => "cast",
    .FieldAccess => "fieldaccess",
    .Index => "index",
    .StructLit => "structlit",
    .FieldInit => "finit",
    .Sizeof => "sizeof",
    .Number => "number",
    .String => "string",
    .Char => "char",
    .Bool => "bool",
    .Ident => "ident",
    .Type => "type",
    .Params => "params",
    .Param => "param",
    .Args => "args",
    .UnionType => "uniontype",
    .Try => "try",
    .Catch => "catch",
    .Is => "is",
    .Test => "test",
    .Error => "error",
    .Import => "import",
    .ImportName => "importname",
    .MethodCall => "methodcall",
    .Null => "null",
    .Enum => "enum",
    .EnumMember => "enummember",
    .Match => "match",
    .Arm => "arm",
    .FnType => "fntype",
    .SliceType => "slicetype",
    .Slicing => "slicing",
    .Lambda => "lambda",
    .TypeAlias => "typealias",
    .CallValue => "callvalue",
    .For => "for",
    .TypeParams => "typeparams",
    .TypeParam => "typeparam",
    .TypeArgs => "typeargs",
  };
}
