// ---------------------------------------------------------------------------
// The parser: recursive descent, one node per construct, into the arena.
//
// This file holds the Parser itself -- the token cursor, `expect`, and error
// recovery -- and types. Expressions are in expressions.ode, statements and
// declarations in statements.ode.
// ---------------------------------------------------------------------------

import { malloc } from "../support/libc";
import { Buf } from "../support/text";
import { FAILED, report, fail } from "../support/diagnostics";
import { TokenKind, Token, TokenList } from "./token";
import { NodeKind, Ast } from "./ast";

export struct Parser {
  tokens: *TokenList,
  ast: *Ast,
  pos: i32,
  // False as soon as a block is opened: `fn`, `extern` and `struct` are
  // file-level constructs, and a body is not the file level.
  atTopLevel: bool,

  fn new(tokens: *TokenList, ast: *Ast): *Parser {
    let parser: *Parser = malloc(sizeof(Parser) as i64) as *Parser;
    parser.tokens = tokens;
    parser.ast = ast;
    parser.pos = 0;
    parser.atTopLevel = true;

    return parser;
  }

  fn current(self: *Parser): *Token {
    return self.tokens.at(self.pos);
  }

  fn peek(self: *Parser): *Token {
    return self.tokens.at(self.pos + 1);
  }

  fn kind(self: *Parser): TokenKind {
    return self.current().kind;
  }

  fn advance(self: *Parser): void {
    if (self.pos < self.tokens.count - 1) {
      self.pos = self.pos + 1;
    }
  }

  fn fail(self: *Parser, expected: *i8): void {
    let token: *Token = self.current();
    let message: *Buf = Buf.new();
    message.add("expected '");
    message.add(expected);
    message.add("' but got '");

    if (token.kind == TokenKind.End) {
      message.add("end of file");
    } else {
      message.addBytes(token.text, token.length);
    }

    message.push('\'');
    report(token.line, token.column, message.data);
  }

  fn errorNode(self: *Parser): i32 {
    let token: *Token = self.current();
    return self.ast.add(NodeKind.Error, token.line, token.column);
  }

  // Recovery is per statement: everything up to the next `;` or the start of
  // the next statement is discarded. A `{` is skipped whole, so a malformed
  // function header costs its body rather than turning it into a second round
  // of errors.
  fn synchronize(self: *Parser): void {
    let depth: i32 = 0;

    while (self.kind() != TokenKind.End) {
      let kind: TokenKind = self.kind();

      if (kind == TokenKind.LBrace) {
        depth = depth + 1;
        self.advance();
        continue;
      }

      if (kind == TokenKind.RBrace) {
        // At depth zero this closes the block being parsed, which is the
        // caller's to consume.
        if (depth == 0) {
          return;
        }
        depth = depth - 1;
        self.advance();
        if (depth == 0) {
          return;
        }
        continue;
      }

      if (depth == 0) {
        if (kind == TokenKind.Semicolon) {
          self.advance();
          return;
        }
        if (startsStatement(kind)) {
          return;
        }
      }

      self.advance();
    }
  }

  fn expect(self: *Parser, kind: TokenKind, name: *i8): *Token {
    // The offending token is left where it is. Consuming it would throw away
    // the very thing recovery needs to see -- a `}` swallowed here would leave
    // the parser inside a block that has already ended.
    if (self.kind() != kind) {
      self.fail(name);
      return self.current();
    }

    let token: *Token = self.current();
    self.advance();

    return token;
  }
}

// True for a token that can only begin a statement, which is where a
// recovering parser can pick the file back up.
export fn startsStatement(kind: TokenKind): bool {
  if (kind == TokenKind.Fn || kind == TokenKind.Extern || kind == TokenKind.Struct) {
    return true;
  }
  if (kind == TokenKind.Import || kind == TokenKind.Export) {
    return true;
  }
  if (kind == TokenKind.Enum || kind == TokenKind.Match ||
      kind == TokenKind.For) {
    return true;
  }
  if (kind == TokenKind.Let || kind == TokenKind.If || kind == TokenKind.While) {
    return true;
  }
  if (kind == TokenKind.Return || kind == TokenKind.Print) {
    return true;
  }

  return kind == TokenKind.Break || kind == TokenKind.Continue;
}

// ---------------------------------------------------------------------------
// Types.
// ---------------------------------------------------------------------------

// Type -> '*'* (BaseType | FnType)
export fn parseType(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let startLine: i32 = start.line;
  let startColumn: i32 = start.column;
  let depth: i32 = 0;

  while (parser.kind() == TokenKind.Star) {
    depth = depth + 1;
    parser.advance();
  }

  // FnType -> 'fn' '(' (Type (',' Type)*)? ')' ':' Type
  if (parser.kind() == TokenKind.Fn) {
    let node: i32 = parser.ast.add(NodeKind.FnType, startLine, startColumn);
    parser.ast.nodes[node].extra = depth;
    parser.advance();
    parser.expect(TokenKind.LParen, "(");

    if (parser.kind() != TokenKind.RParen) {
      while (true) {
        parser.ast.addItem(node, parseType(parser));
        if (parser.kind() != TokenKind.Comma || FAILED) {
          break;
        }
        parser.advance();
      }
    }

    parser.expect(TokenKind.RParen, ")");
    parser.expect(TokenKind.Colon, ":");
    parser.ast.nodes[node].a = parseType(parser);

    return node;
  }

  if (parser.kind() != TokenKind.Type && parser.kind() != TokenKind.Ident) {
    parser.fail("type");
    // Same reason: the token that is not a type is the one recovery reads.
    return parser.ast.add(NodeKind.Type, startLine, startColumn);
  }

  let name: *Token = parser.current();
  parser.advance();

  let node: i32 = parser.ast.add(NodeKind.Type, startLine, startColumn);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].extra = depth;

  return node;
}
