// ---------------------------------------------------------------------------
// The parser: recursive descent, one node per construct, into the arena.
//
// This file holds the Parser itself -- the token cursor, `expect`, and error
// recovery -- and types. Expressions are in expressions.ode, statements and
// declarations in statements.ode.
// ---------------------------------------------------------------------------

import { alloc } from "std/mem";
import { slice } from "std/text";
import { Problem, Facts } from "../diagnostics/problems";
import { FAILED, report, fail } from "../diagnostics/report";
import { NodeKind, Ast } from "./ast";
import { TokenKind, Token, TokenList } from "./token";

export struct Parser {
  tokens: *TokenList,
  ast: *Ast,
  pos: i32,
  // False as soon as a block is opened: `fn`, `extern` and `struct` are
  // file-level constructs, and a body is not the file level.
  atTopLevel: bool,

  fn new(tokens: *TokenList, ast: *Ast): *Parser {
    let parser: *Parser = alloc<Parser>(1);
    parser.tokens = tokens;
    parser.ast = ast;
    parser.pos = 0;
    parser.atTopLevel = true;

    return parser;
  }

  fn current(self: *Parser): *Token {
    return self.tokens.at(self.pos);
  }

  fn peek(self: *Parser): *Token {
    return self.tokens.at(self.pos + 1);
  }

  fn kind(self: *Parser): TokenKind {
    return self.current().kind;
  }

  fn advance(self: *Parser): void {
    if (self.pos < self.tokens.count - 1) {
      self.pos = self.pos + 1;
    }
  }

  fn fail(self: *Parser, expected: *i8): void {
    let token: *Token = self.current();
    let got: *i8 = "end of file";
    if (token.kind != TokenKind.End) {
      got = slice(token.text, 0, token.length);
    }
    report(Problem.UnexpectedToken, token.line, token.column,
           Facts.aboutTwo(expected, got));
  }

  fn errorNode(self: *Parser): i32 {
    let token: *Token = self.current();
    return self.ast.add(NodeKind.Error, token.line, token.column);
  }

  // Recovery is per statement: everything up to the next `;` or the start of
  // the next statement is discarded. A `{` is skipped whole, so a malformed
  // function header costs its body rather than turning it into a second round
  // of errors.
  fn synchronize(self: *Parser): void {
    let depth: i32 = 0;

    while (self.kind() != TokenKind.End) {
      let kind: TokenKind = self.kind();

      if (kind == TokenKind.LBrace) {
        depth = depth + 1;
        self.advance();
        continue;
      }

      if (kind == TokenKind.RBrace) {
        // At depth zero this closes the block being parsed, which is the
        // caller's to consume.
        if (depth == 0) {
          return;
        }
        depth = depth - 1;
        self.advance();
        if (depth == 0) {
          return;
        }
        continue;
      }

      if (depth == 0) {
        if (kind == TokenKind.Semicolon) {
          self.advance();
          return;
        }
        if (startsStatement(kind)) {
          return;
        }
      }

      self.advance();
    }
  }

  fn expect(self: *Parser, kind: TokenKind, name: *i8): *Token {
    // The offending token is left where it is. Consuming it would throw away
    // the very thing recovery needs to see -- a `}` swallowed here would leave
    // the parser inside a block that has already ended.
    if (self.kind() != kind) {
      self.fail(name);
      return self.current();
    }

    let token: *Token = self.current();
    self.advance();

    return token;
  }
}

// True for a token that can only begin a statement, which is where a
// recovering parser can pick the file back up.
export fn startsStatement(kind: TokenKind): bool {
  if (kind == TokenKind.Fn || kind == TokenKind.Extern || kind == TokenKind.Struct) {
    return true;
  }
  if (kind == TokenKind.Import || kind == TokenKind.Export) {
    return true;
  }
  if (kind == TokenKind.Enum || kind == TokenKind.Match ||
      kind == TokenKind.For) {
    return true;
  }
  if (kind == TokenKind.Let || kind == TokenKind.If || kind == TokenKind.While) {
    return true;
  }
  if (kind == TokenKind.Return) {
    return true;
  }

  return kind == TokenKind.Break || kind == TokenKind.Continue;
}

// ---------------------------------------------------------------------------
// Types.
// ---------------------------------------------------------------------------

// Type -> '*'* (BaseType | IDENT TypeArgs? | FnType | '(' FnType ')')
export fn parseType(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let startLine: i32 = start.line;
  let startColumn: i32 = start.column;
  let depth: i32 = 0;

  while (parser.kind() == TokenKind.Star) {
    depth = depth + 1;
    parser.advance();
  }

  if (parser.kind() == TokenKind.LParen) {
    return parseFnType(parser, depth, startLine, startColumn);
  }

  // `fn(i32): i32`, the way function types used to be written. It is
  // refused, but read all the same, so it costs one error rather than the
  // rest of the declaration.
  if (parser.kind() == TokenKind.Fn) {
    report(Problem.OldFunctionType, startLine, startColumn, Facts.none());
    let node: i32 = parser.ast.add(NodeKind.FnType, startLine, startColumn);
    parser.ast.nodes[node].extra = depth;
    parser.advance();
    parser.expect(TokenKind.LParen, "(");

    if (parser.kind() != TokenKind.RParen) {
      while (true) {
        parser.ast.addItem(node, parseType(parser));
        if (parser.kind() != TokenKind.Comma || FAILED) {
          break;
        }
        parser.advance();
      }
    }

    parser.expect(TokenKind.RParen, ")");
    parser.expect(TokenKind.Colon, ":");
    parser.ast.nodes[node].a = parseType(parser);

    return node;
  }

  if (parser.kind() != TokenKind.Type && parser.kind() != TokenKind.Ident) {
    parser.fail("type");
    // Same reason: the token that is not a type is the one recovery reads.
    return parser.ast.add(NodeKind.Type, startLine, startColumn);
  }

  let name: *Token = parser.current();
  parser.advance();

  let node: i32 = parser.ast.add(NodeKind.Type, startLine, startColumn);
  parser.ast.setText(node, name);
  parser.ast.nodes[node].extra = depth;

  // `List<i32>`: in a type, a `<` can only open type arguments.
  if (name.kind == TokenKind.Ident && parser.kind() == TokenKind.Lt) {
    parseTypeArgs(parser, node);
  }

  return node;
}

// FnType -> '(' (DeclaredType (',' DeclaredType)*)? ')' '=>' DeclaredType
//
// The result runs to the end of the type, as in TypeScript: `(i32) => i32 | E`
// is a function that can fail, and a union holding a function is written
// `((i32) => i32) | E`. A function type in parentheses with no `=>` after it
// is just that type, which is how a pointer to a function is written:
// `*((i32) => i32)`. Without them, `*(i32) => i32` could as well be a
// function taking a pointer, so it is refused rather than read one way.
fn parseFnType(parser: *Parser, depth: i32, line: i32, column: i32): i32 {
  let node: i32 = parser.ast.add(NodeKind.FnType, line, column);
  parser.ast.nodes[node].extra = depth;
  parser.expect(TokenKind.LParen, "(");

  if (parser.kind() != TokenKind.RParen) {
    while (true) {
      parser.ast.addItem(node, parseDeclaredType(parser));
      if (parser.kind() != TokenKind.Comma || FAILED) {
        break;
      }
      parser.advance();
    }
  }
  parser.expect(TokenKind.RParen, ")");

  if (parser.kind() != TokenKind.Arrow && parser.ast.nodes[node].itemCount == 1 &&
      !FAILED) {
    let inner: i32 = parser.ast.nodes[node].items[0];
    if (parser.ast.nodes[inner].kind == NodeKind.FnType) {
      parser.ast.nodes[inner].extra = parser.ast.nodes[inner].extra + depth;
      return inner;
    }
  }

  if (depth > 0 && parser.kind() == TokenKind.Arrow) {
    report(Problem.PointerToFunctionType, line, column, Facts.none());
  }
  parser.expect(TokenKind.Arrow, "=>");
  parser.ast.nodes[node].a = parseDeclaredType(parser);

  return node;
}

// DeclaredType -> Type ('|' Type)*
//
// Where a value is declared -- a variable, a parameter, a field, a return --
// its type may be a union: the value, or one of the errors after it. Not
// after `as`, where `|` stays the bitwise or it is in an expression.
export fn parseDeclaredType(parser: *Parser): i32 {
  let first: i32 = parseType(parser);
  if (parser.kind() != TokenKind.Pipe) {
    return first;
  }

  let node: i32 = parser.ast.add(NodeKind.UnionType,
                                 parser.ast.nodes[first].line,
                                 parser.ast.nodes[first].column);
  parser.ast.addItem(node, first);
  while (parser.kind() == TokenKind.Pipe && !FAILED) {
    parser.advance();
    parser.ast.addItem(node, parseType(parser));
  }
  return node;
}

// TypeArgs -> '<' Type (',' Type)* '>'
//
// The arguments become the items of `node`.
export fn parseTypeArgs(parser: *Parser, node: i32): void {
  parser.expect(TokenKind.Lt, "<");

  while (true) {
    parser.ast.addItem(node, parseType(parser));
    if (parser.kind() != TokenKind.Comma || FAILED) {
      break;
    }
    parser.advance();
  }

  expectCloseAngle(parser);
}

// The `>` closing type arguments or parameters. Nested ones end in `>>`,
// which lexes as a shift; that token is split, its first half taken here and
// its second left for the list around this one.
fn expectCloseAngle(parser: *Parser): void {
  if (parser.kind() == TokenKind.Shr) {
    let token: *Token = parser.current();
    token.kind = TokenKind.Gt;
    token.text = ">";
    token.length = 1;
    token.column = token.column + 1;
    return;
  }

  parser.expect(TokenKind.Gt, ">");
}

// TypeParams -> '<' IDENT (',' IDENT)* '>'
export fn parseTypeParams(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.TypeParams, start.line, start.column);
  parser.expect(TokenKind.Lt, "<");

  while (true) {
    let name: *Token = parser.expect(TokenKind.Ident, "type parameter");
    if (FAILED) {
      break;
    }
    let param: i32 = parser.ast.add(NodeKind.TypeParam, name.line, name.column);
    parser.ast.setText(param, name);
    parser.ast.addItem(node, param);

    if (parser.kind() != TokenKind.Comma) {
      break;
    }
    parser.advance();
  }

  expectCloseAngle(parser);

  return node;
}

// Whether the `<` after the name at the cursor opens type arguments --
// `List<i32>.new()`, `Pair<i32, bool> { ... }`, `max<i64>(a, b)` -- rather
// than a comparison. It does when what follows is a run of things that can
// be written in a type, closed by a `>` and followed by `.`, `{` or `(`.
// The same tokens could be two comparisons passed as arguments,
// `f(a < b, c > (d))`; as in C#, that reads as a generic call, and a
// comparison there is written in parentheses.
export fn looksLikeTypeArgs(parser: *Parser): bool {
  let index: i32 = parser.pos + 1;
  let depth: i32 = 0;

  while (true) {
    let kind: TokenKind = parser.tokens.at(index).kind;
    match (kind) {
      TokenKind.Lt => { depth = depth + 1; }
      TokenKind.Gt => { depth = depth - 1; }
      TokenKind.Shr => { depth = depth - 2; }
      TokenKind.Type, TokenKind.Ident, TokenKind.Star, TokenKind.Comma,
      TokenKind.LParen, TokenKind.RParen, TokenKind.Arrow, TokenKind.Pipe => {}
      else => {
        return false;
      }
    }
    index = index + 1;

    if (depth <= 0) {
      break;
    }
  }

  if (depth != 0) {
    return false;
  }

  let next: TokenKind = parser.tokens.at(index).kind;
  return next == TokenKind.Dot || next == TokenKind.LBrace ||
         next == TokenKind.LParen;
}
