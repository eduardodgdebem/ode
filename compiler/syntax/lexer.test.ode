// ---------------------------------------------------------------------------
// What the lexer rejects, and where. A file that does not lex is not parsed,
// so each of these finds the lexer's problems alone.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { problemsIn } from "../testkit/testkit";

test "a character no token starts with" {
  let found: *List<Diagnostic> = problemsIn("fn main(): i32 { return 1 @ 2; }");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedCharacter);
  assertEq(found.at(0).column, 27);
}

test "a string that never closes" {
  let found: *List<Diagnostic> = problemsIn("let s: *i8 = \"open");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnterminatedString);
  assertEq(found.at(0).column, 14);
}

test "a string ends with its line" {
  let found: *List<Diagnostic> = problemsIn(`
    let s: *i8 = "first
    line";
  `);
  // The second line lexes as written, so its stray quote opens a string of
  // its own, which also runs into the end of its line.
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.StringCrossesLine);
  assertEq(found.at(0).line, 1);
  assertEq(found.at(1).problem, Problem.StringCrossesLine);
  assertEq(found.at(1).line, 2);
}

test "a raw string that never closes" {
  let found: *List<Diagnostic> = problemsIn("let s: *i8 = `open");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnterminatedString);
}

test "a raw string cannot interpolate" {
  let found: *List<Diagnostic> = problemsIn("let s: *i8 = `total: ${count}`;");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.StringInterpolation);
  assertEq(found.at(0).column, 22);
}

test "escapes that mean nothing" {
  let found: *List<Diagnostic> = problemsIn("let s: *i8 = \"\\q\"; let t: *i8 = \"\\xZ1\";");
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.UnknownEscape);
  assertEq(found.at(1).problem, Problem.BadHexEscape);
}

test "a character literal holds one character" {
  let found: *List<Diagnostic> = problemsIn("let c: i8 = 'ab'; let d: i8 = '';");
  assertEq(found.count, 2);
  assertEq(found.at(0).problem, Problem.CharacterLiteralLength);
  assertEq(found.at(0).column, 13);
  assertEq(found.at(1).problem, Problem.CharacterLiteralLength);
}

test "every lexer problem in a file is reported in one run" {
  let found: *List<Diagnostic> = problemsIn(`
    fn main(): i32 {
      let a: *i8 = "bad \q escape";
      let b: i8 = 'xy';
      let c: i32 = 1 $ 2;
      return 0;
    }
  `);
  assertEq(found.count, 3);
  assertEq(found.at(0).problem, Problem.UnknownEscape);
  assertEq(found.at(0).line, 2);
  assertEq(found.at(1).problem, Problem.CharacterLiteralLength);
  assertEq(found.at(1).line, 3);
  assertEq(found.at(2).problem, Problem.UnexpectedCharacter);
  assertEq(found.at(2).line, 4);
}

test "a file that lexes cleanly but parses badly reports the parser's problem" {
  let found: *List<Diagnostic> = problemsIn("fn main(): i32 { return 0 }");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UnexpectedToken);
  assertEq(found.at(0).facts.other, "}");
}

test "hex, octal and binary literals lex as numbers" {
  let found: *List<Diagnostic> = problemsIn(`
    let A: i32 = 0x1F;
    let B: i32 = 0o17;
    let C: i32 = 0b101;
    let D: i32 = 0xfF;

    fn main(): i32 {
      return 0;
    }
  `);
  assertEq(found.count, 0);
}

test "a digit a literal's base does not have" {
  let found: *List<Diagnostic> = problemsIn(`
    let A: i32 = 0xZ1;
    let B: i32 = 0b2;
    let C: i32 = 0o8;
    let D: i32 = 0x;
  `);
  assertEq(found.count, 4);
  assertEq(found.at(0).problem, Problem.BadDigit);
  assertEq(found.at(0).facts.name, "0xZ1");
  assertEq(found.at(1).facts.name, "0b2");
  assertEq(found.at(2).facts.name, "0o8");
  assertEq(found.at(3).facts.name, "0x");
}
