// ---------------------------------------------------------------------------
// Dumps: `--dump-tokens`, `--dump-ast` and `--dump-types`.
//
// One line per token or node, with its position, so the output of a phase can
// be read when it misbehaves and diffed between two versions of the
// compiler.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Builder } from "std/text";
import { strlen } from "std/c";
import {
  NO_NODE, NodeKind, Ast, Binary, BoolLit, CharLit, NumberLit, StringLit, Syntax, Unary,
  binaryOpText, nodeKindName, nodeName, syntaxChildren, typeDepth, unaryOpText,
} from "./ast";
import { TokenKind, Token, TokenList, kindName } from "./token";
import { TypeKind, Type } from "../types/types";

// Text is escaped rather than written raw so that a literal newline or NUL
// inside a string cannot break the line-per-node format.
fn dumpEscaped(out: *Builder, text: *i8, length: i64): void {
  for (index in 0..length) {
    let character: i8 = text[index];

    if (character == '\\') {
      out.add("\\\\");
    } else if (character == '\n') {
      out.add("\\n");
    } else if (character == '\t') {
      out.add("\\t");
    } else if (character == '\r') {
      out.add("\\r");
    } else if (character == '\'') {
      out.add("\\'");
    } else if (character == 0) {
      out.add("\\0");
    } else {
      out.push(character);
    }
  }
}

export fn dumpTokens(list: *TokenList, out: *Builder): void {
  let index: i32 = 0;

  while (index < list.count) {
    let token: *Token = list.at(index);

    // The end token is the parser's sentinel, not part of the source.
    if (token.kind == TokenKind.End) {
      index = index + 1;
      continue;
    }

    out.addInt(token.line as i64);
    out.push(':');
    out.addInt(token.column as i64);
    out.push(' ');
    out.add(kindName(token.kind));

    // An operator's text is its own name, so printing both says nothing.
    if (token.kind == TokenKind.Ident || token.kind == TokenKind.Number ||
        token.kind == TokenKind.String || token.kind == TokenKind.Char ||
        token.kind == TokenKind.Bool || token.kind == TokenKind.Type) {
      out.add(" '");
      out.addBytes(token.text, token.length);
      out.push('\'');
    }

    out.push('\n');
    index = index + 1;
  }
}

// Children print in the order syntaxChildren gives them, so no kind needs a
// case of its own here.
//
// `types` is the analyzer's resolved-type table, or null to dump the tree on
// its own. A node the analyzer never typed prints without an annotation.
export fn dumpNode(ast: *Ast, types: *Type, index: i32, depth: i32,
                   out: *Builder): void {
  if (index == NO_NODE) {
    return;
  }

  for (level in 0..depth) {
    out.add("  ");
  }

  let kind: NodeKind = ast.nodes[index].kind;
  out.add(nodeKindName(kind));

  // A name, a literal's text, or an operator's spelling.
  let syntax: Syntax = ast.nodes[index].syntax;
  let length: i64 = match (syntax) {
    NumberLit => syntax.length,
    StringLit => syntax.length,
    CharLit => syntax.length,
    else => -1,
  };
  let spelled: *i8 = match (syntax) {
    Binary => binaryOpText(syntax.op),
    Unary => unaryOpText(syntax.op),
    else => nodeName(ast, index),
  };
  if (syntax is BoolLit) {
    spelled = "false";
    if (syntax.value) {
      spelled = "true";
    }
  }
  if (spelled != null) {
    if (length < 0) {
      length = strlen(spelled);
    }
    out.add(" '");
    dumpEscaped(out, spelled, length);
    out.push('\'');
  }

  if (ast.nodes[index].exported) {
    out.add(" export");
  }

  if (kind == NodeKind.Type) {
    out.add(" depth=");
    out.addInt(typeDepth(ast, index) as i64);
  }

  out.push(' ');
  out.addInt(ast.nodes[index].line as i64);
  out.push(':');
  out.addInt(ast.nodes[index].column as i64);

  if (types != null) {
    if (types[index].kind != TypeKind.None) {
      out.add(" : ");
      out.add(types[index].toText());
    }
  }

  out.push('\n');

  let children: *List<i32> = syntaxChildren(syntax);
  for (child in 0..children.count) {
    dumpNode(ast, types, children.at(child), depth + 1, out);
  }
}
