// ---------------------------------------------------------------------------
// Parsing expressions.
//
// One function per precedence level, lowest first: expr, logic-or, logic-and,
// bit-or, bit-xor, bit-and, equality, comparison, shift, term, factor, cast,
// unary, postfix, primary. The ordering is C's -- docs/grammar.md has the
// table -- so `a & b == c` is `a & (b == c)`.
// ---------------------------------------------------------------------------

import { equals } from "std/text";
import { FAILED } from "../diagnostics/report";
import { line } from "../driver/options";
import { List } from "std/list";
import {
  NO_NODE, NodeKind, Args, Binary, BinaryOp, Block, BoolLit, Call, CallValue, Cast,
  Catch, CharLit, ErrorNode, FieldAccess, FieldInit, Ident, Index, Is, Lambda, Slicing,
  MethodCall, NullLit, NumberLit, Param, Params, Return, Sizeof, StringLit, StructLit,
  Syntax, Try, TypeArgs, TypeRef, Unary, UnaryOp,
} from "./ast";
import { Parser, parseType, parseDeclaredType, parseTypeArgs, looksLikeTypeArgs } from "./parser";
import { parseBlock, parseMatch } from "./statements";
import { TokenKind, Token } from "./token";

// Expr -> Coalesce ('catch' '(' IDENT ')' Block)?
export fn parseExpr(parser: *Parser): i32 {
  let value: i32 = parseCoalesce(parser);
  if (parser.kind() != TokenKind.Catch) {
    return value;
  }

  let at: *Token = parser.current();
  parser.advance();
  parser.expect(TokenKind.LParen, "(");
  let name: *Token = parser.expect(TokenKind.Ident, "the error's name");
  parser.expect(TokenKind.RParen, ")");
  if (FAILED) {
    return value;
  }

  let node: i32 = parser.ast.add(NodeKind.Catch, at.line, at.column, ErrorNode {});
  let block: i32 = parseBlock(parser);
  parser.ast.nodes[node].syntax = Catch { value: value, name: name.text, block: block };
  return node;
}

// Coalesce -> LogicOr ('??' LogicOr)*
fn parseCoalesce(parser: *Parser): i32 {
  let left: i32 = parseLogicOr(parser);

  while (parser.kind() == TokenKind.Coalesce) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseLogicOr(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

// Every binary level has the same shape, so they share one helper: parse the
// tighter level, then fold while the current token is one of this level's
// operators. `isLevelOp` is what distinguishes them.
fn parseBinaryNode(parser: *Parser, left: i32, right: i32,
                   op: *Token): i32 {
  let node: i32 = parser.ast.add(NodeKind.Binary, op.line, op.column, ErrorNode {});
  parser.ast.nodes[node].syntax = Binary { op: binaryOpOf(op.kind), left: left,
                                           right: right };
  return node;
}

// The operator a token stands for between two operands. Only the tokens the
// binary levels fold on reach here.
export fn binaryOpOf(kind: TokenKind): BinaryOp {
  return match (kind) {
    .Plus => .Add,
    .Minus => .Subtract,
    .Star => .Multiply,
    .Slash => .Divide,
    .Percent => .Remainder,
    .Eq => .Equal,
    .Ne => .NotEqual,
    .Lt => .Less,
    .Le => .LessEqual,
    .Gt => .Greater,
    .Ge => .GreaterEqual,
    .AndAnd => .And,
    .OrOr => .Or,
    .Amp => .BitAnd,
    .Pipe => .BitOr,
    .Caret => .BitXor,
    .Shl => .ShiftLeft,
    .Shr => .ShiftRight,
    .Coalesce => .Coalesce,
    else => {
      assert(false, "a binary operator token without an operator");
      return .Add;
    }
  };
}

fn unaryOpOf(kind: TokenKind): UnaryOp {
  return match (kind) {
    .Minus => .Negate,
    .Plus => .Plus,
    .Not => .Not,
    .Star => .Deref,
    else => .AddressOf,
  };
}

fn parseLogicOr(parser: *Parser): i32 {
  let left: i32 = parseLogicAnd(parser);

  while (parser.kind() == TokenKind.OrOr) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseLogicAnd(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseLogicAnd(parser: *Parser): i32 {
  let left: i32 = parseBitOr(parser);

  while (parser.kind() == TokenKind.AndAnd) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseBitOr(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseBitOr(parser: *Parser): i32 {
  let left: i32 = parseBitXor(parser);

  while (parser.kind() == TokenKind.Pipe) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseBitXor(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseBitXor(parser: *Parser): i32 {
  let left: i32 = parseBitAnd(parser);

  while (parser.kind() == TokenKind.Caret) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseBitAnd(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

// The lexer has already split `&&` off as its own token, so an `&` reaching
// here is always the binary form.
fn parseBitAnd(parser: *Parser): i32 {
  let left: i32 = parseEquality(parser);

  while (parser.kind() == TokenKind.Amp) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseEquality(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseEquality(parser: *Parser): i32 {
  let left: i32 = parseComparison(parser);

  while (parser.kind() == TokenKind.Eq || parser.kind() == TokenKind.Ne) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseComparison(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseComparison(parser: *Parser): i32 {
  let left: i32 = parseShift(parser);

  // `value is ParseError`. `is` is not a keyword: here, after a value, it
  // can only be this.
  if (parser.kind() == TokenKind.Ident && equals(parser.current().text, "is")) {
    let at: *Token = parser.current();
    parser.advance();
    let node: i32 = parser.ast.add(NodeKind.Is, at.line, at.column, ErrorNode {});
    let type: i32 = parseType(parser);
    parser.ast.nodes[node].syntax = Is { value: left, type: type };
    return node;
  }

  while (parser.kind() == TokenKind.Gt || parser.kind() == TokenKind.Ge ||
         parser.kind() == TokenKind.Lt || parser.kind() == TokenKind.Le) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseShift(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseShift(parser: *Parser): i32 {
  let left: i32 = parseTerm(parser);

  while (parser.kind() == TokenKind.Shl || parser.kind() == TokenKind.Shr) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseTerm(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseTerm(parser: *Parser): i32 {
  let left: i32 = parseFactor(parser);

  while (parser.kind() == TokenKind.Plus || parser.kind() == TokenKind.Minus) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseFactor(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

fn parseFactor(parser: *Parser): i32 {
  let left: i32 = parseCast(parser);

  while (parser.kind() == TokenKind.Star || parser.kind() == TokenKind.Slash ||
         parser.kind() == TokenKind.Percent) {
    let op: *Token = parser.current();
    parser.advance();
    let right: i32 = parseCast(parser);
    left = parseBinaryNode(parser, left, right, op);
  }

  return left;
}

// Cast -> Unary ('as' Type)*
// Looser than unary, so `*p as i32` is `(*p) as i32`.
fn parseCast(parser: *Parser): i32 {
  let expr: i32 = parseUnary(parser);

  while (parser.kind() == TokenKind.As) {
    let op: *Token = parser.current();
    let line: i32 = op.line;
    let column: i32 = op.column;
    parser.advance();

    let type: i32 = parseType(parser);
    let node: i32 = parser.ast.add(NodeKind.Cast, line, column, ErrorNode {});
    parser.ast.nodes[node].syntax = Cast { value: expr, type: type };
    expr = node;
  }

  return expr;
}

// Unary -> ('-' | '+' | '!' | '*' | '&') Unary | Postfix
// `+` does nothing but is kept as a node so the analyzer can still reject a
// non-numeric operand.
fn parseUnary(parser: *Parser): i32 {
  let kind: TokenKind = parser.kind();

  if (kind == TokenKind.Try) {
    let at: *Token = parser.current();
    parser.advance();
    let node: i32 = parser.ast.add(NodeKind.Try, at.line, at.column, ErrorNode {});
    let value: i32 = parseUnary(parser);
    parser.ast.nodes[node].syntax = Try { value: value };
    return node;
  }

  if (kind == TokenKind.Minus || kind == TokenKind.Plus || kind == TokenKind.Not ||
      kind == TokenKind.Star || kind == TokenKind.Amp) {
    let op: *Token = parser.current();
    let line: i32 = op.line;
    let column: i32 = op.column;
    parser.advance();

    let operand: i32 = parseUnary(parser);
    let node: i32 = parser.ast.add(NodeKind.Unary, line, column, ErrorNode {});
    parser.ast.nodes[node].syntax = Unary { op: unaryOpOf(op.kind), operand: operand };

    return node;
  }

  return parsePostfix(parser);
}

// Postfix -> Primary ('.' IDENT | '[' Expr ']')*
// Binds tighter than unary, so `*p.next` is `*(p.next)`.
fn parsePostfix(parser: *Parser): i32 {
  let expr: i32 = parsePrimary(parser);

  while (true) {
    // A call of whatever the expression so far produced -- `table[i](x)`,
    // `make()(x)`. A call of a plain name was already parsed as one.
    if (parser.kind() == TokenKind.LParen) {
      let paren: *Token = parser.current();
      let line: i32 = paren.line;
      let column: i32 = paren.column;
      parser.advance();

      let args: i32 = parseArgList(parser);
      parser.expect(TokenKind.RParen, ")");
      if (FAILED) {
        return expr;
      }

      expr = parser.ast.add(NodeKind.CallValue, line, column,
                            CallValue { callee: expr, args: args });
      continue;
    }

    if (parser.kind() == TokenKind.Dot) {
      parser.advance();

      let field: *Token = parser.expect(TokenKind.Ident, "field name");
      if (FAILED) {
        return expr;
      }
      // Recorded at the member's name, which is what a diagnostic about it
      // underlines: `p.shift()` points at `shift`.
      let line: i32 = field.line;
      let column: i32 = field.column;

      // `value.name(...)` calls a method rather than reading a field. The
      // receiver may also be a struct's name, for `Point.new(...)`; which of
      // the two it is waits for the analyzer, since only it knows whether the
      // name is a variable.
      if (parser.kind() == TokenKind.LParen) {
        parser.advance();
        let args: i32 = parseArgList(parser);
        parser.expect(TokenKind.RParen, ")");
        if (FAILED) {
          return expr;
        }

        expr = parser.ast.add(NodeKind.MethodCall, line, column,
                              MethodCall { receiver: expr, name: field.text, args: args });
        continue;
      }

      expr = parser.ast.add(NodeKind.FieldAccess, line, column,
                            FieldAccess { object: expr, field: field.text });
      continue;
    }

    if (parser.kind() == TokenKind.LBracket) {
      let bracket: *Token = parser.current();
      let line: i32 = bracket.line;
      let column: i32 = bracket.column;
      parser.advance();

      // `base[start..end]`, either end left out for the start or the end of
      // what is sliced.
      let index: i32 = NO_NODE;
      if (parser.kind() != TokenKind.DotDot) {
        index = parseExpr(parser);
      }
      if (parser.kind() == TokenKind.DotDot && !FAILED) {
        parser.advance();
        let end: i32 = NO_NODE;
        if (parser.kind() != TokenKind.RBracket) {
          end = parseExpr(parser);
        }
        parser.expect(TokenKind.RBracket, "]");
        if (FAILED) {
          return expr;
        }
        let slicing: i32 = parser.ast.add(NodeKind.Slicing, line, column, ErrorNode {});
        parser.ast.nodes[slicing].syntax = Slicing { base: expr, start: index, end: end };
        expr = slicing;
        continue;
      }
      parser.expect(TokenKind.RBracket, "]");
      if (FAILED) {
        return expr;
      }

      let node: i32 = parser.ast.add(NodeKind.Index, line, column, ErrorNode {});
      parser.ast.nodes[node].syntax = Index { base: expr, index: index };
      expr = node;
      continue;
    }

    return expr;
  }

  return expr;
}

fn parseLiteral(parser: *Parser, kind: NodeKind): i32 {
  let token: *Token = parser.current();
  let syntax: Syntax = match (kind) {
    .Number => NumberLit { text: token.text, length: token.length },
    .String => StringLit { text: token.text, length: token.length },
    .Char => CharLit { text: token.text, length: token.length },
    .Bool => BoolLit { value: equals(token.text, "true") },
    .Null => NullLit {},
    else => Ident { name: token.text },
  };
  let node: i32 = parser.ast.add(kind, token.line, token.column, syntax);
  parser.advance();

  return node;
}

fn parsePrimary(parser: *Parser): i32 {
  let kind: TokenKind = parser.kind();

  if (kind == TokenKind.LParen && !parser.inPattern && looksLikeLambda(parser)) {
    return parseLambda(parser);
  }

  // `match` used as a value: `let name: *i8 = match (op) { ... };`.
  if (kind == TokenKind.Match) {
    // Its arms are expressions and blocks of their own, not a pattern.
    let wasInPattern: bool = parser.inPattern;
    parser.inPattern = false;
    let node: i32 = parseMatch(parser, true);
    parser.inPattern = wasInPattern;
    return node;
  }

  // `.Add`: a member of the enum the context expects, named without it.
  if (kind == TokenKind.Dot && parser.peek().kind == TokenKind.Ident) {
    let dot: *Token = parser.current();
    parser.advance();
    let member: *Token = parser.current();
    parser.advance();
    return parser.ast.add(NodeKind.FieldAccess, dot.line, dot.column,
                          FieldAccess { object: NO_NODE, field: member.text });
  }

  if (kind == TokenKind.LParen) {
    parser.advance();
    let expr: i32 = parseExpr(parser);
    parser.expect(TokenKind.RParen, ")");
    return expr;
  }

  match (kind) {
    .Number => { return parseLiteral(parser, NodeKind.Number); }
    .Bool => { return parseLiteral(parser, NodeKind.Bool); }
    .String => { return parseLiteral(parser, NodeKind.String); }
    .Char => { return parseLiteral(parser, NodeKind.Char); }
    .Sizeof => { return parseSizeOf(parser); }
    .Null => { return parseLiteral(parser, NodeKind.Null); }
    else => {}
  }

  if (kind == TokenKind.Ident && parser.peek().kind == TokenKind.Lt &&
      looksLikeTypeArgs(parser)) {
    return parseGenericPrimary(parser);
  }

  if (kind == TokenKind.Ident) {
    if (parser.peek().kind == TokenKind.LParen) {
      return parseFuncCall(parser);
    }
    // Nothing else in the grammar puts a block directly after an expression,
    // so `Name {` is unambiguously a struct literal.
    if (parser.peek().kind == TokenKind.LBrace) {
      return parseStructLiteral(parser);
    }
    return parseLiteral(parser, NodeKind.Ident);
  }

  parser.fail("number, string, character, boolean, identifier, or '('");
  return parser.errorNode();
}

// SizeOf -> 'sizeof' '(' Type ')'
fn parseSizeOf(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let line: i32 = start.line;
  let column: i32 = start.column;

  parser.expect(TokenKind.Sizeof, "sizeof");
  parser.expect(TokenKind.LParen, "(");
  let type: i32 = parseType(parser);
  parser.expect(TokenKind.RParen, ")");

  let node: i32 = parser.ast.add(NodeKind.Sizeof, line, column, ErrorNode {});
  parser.ast.nodes[node].syntax = Sizeof { type: type };

  return node;
}

fn parseFuncCall(parser: *Parser): i32 {
  let name: *Token = parser.current();
  let line: i32 = name.line;
  let column: i32 = name.column;
  parser.advance();

  parser.expect(TokenKind.LParen, "(");
  let args: i32 = parseArgList(parser);
  parser.expect(TokenKind.RParen, ")");

  return parser.ast.add(NodeKind.Call, line, column,
                        Call { name: name.text, args: args, typeArgs: NO_NODE });
}

fn parseArgList(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let node: i32 = parser.ast.add(NodeKind.Args, start.line, start.column,
                                 Args { items: List<i32>.new() });

  if (parser.kind() == TokenKind.RParen) {
    return node;
  }

  while (true) {
    parser.ast.addItem(node, parseExpr(parser));

    if (parser.kind() != TokenKind.Comma) {
      break;
    }
    parser.advance();
  }

  return node;
}

// StructLiteral -> IDENT '{' (IDENT ':' Expr ','?)* '}'
// `Name<args>` in an expression: a generic call, a generic struct literal,
// or the type in front of a static method call, `List<i32>.new()`.
fn parseGenericPrimary(parser: *Parser): i32 {
  let name: *Token = parser.current();
  let typeArgs: *List<i32> = List<i32>.new();
  let typeNode: i32 = parser.ast.add(NodeKind.Type, name.line, name.column,
                                     TypeRef { name: name.text, depth: 0, args: typeArgs });
  parser.advance();
  parseTypeArgs(parser, typeNode);

  if (parser.kind() == TokenKind.LParen) {
    // The arguments belong to a function, not to a type of that name.
    parser.ast.nodes[typeNode].kind = NodeKind.TypeArgs;
    parser.ast.nodes[typeNode].syntax = TypeArgs { types: typeArgs };
    parser.advance();
    let args: i32 = parseArgList(parser);
    parser.expect(TokenKind.RParen, ")");

    return parser.ast.add(NodeKind.Call, name.line, name.column,
                          Call { name: name.text, args: args, typeArgs: typeNode });
  }

  if (parser.kind() == TokenKind.LBrace) {
    return parseStructLiteralBody(parser, name, typeNode);
  }

  return typeNode;
}

fn parseStructLiteral(parser: *Parser): i32 {
  let name: *Token = parser.expect(TokenKind.Ident, "struct name");
  return parseStructLiteralBody(parser, name, NO_NODE);
}

// The `{ field: value, ... }` of a struct literal, for the struct `name`,
// whose type arguments are in `typeNode` when it is generic.
fn parseStructLiteralBody(parser: *Parser, name: *Token, typeNode: i32): i32 {
  let node: i32 = parser.ast.add(NodeKind.StructLit, name.line, name.column,
                                 StructLit { name: name.text, type: typeNode,
                                             fields: List<i32>.new() });

  parser.expect(TokenKind.LBrace, "{");

  while (parser.kind() != TokenKind.RBrace && parser.kind() != TokenKind.End) {
    let field: *Token = parser.expect(TokenKind.Ident, "field name");
    parser.expect(TokenKind.Colon, ":");

    let value: i32 = parseExpr(parser);
    parser.ast.addItem(node, parser.ast.add(NodeKind.FieldInit, field.line, field.column,
                                            FieldInit { name: field.text, value: value }));

    if (parser.kind() == TokenKind.Comma) {
      parser.advance();
    }
    // Without this the loop would sit on the token that failed, because a
    // failed `expect` does not consume anything.
    if (FAILED) {
      break;
    }
  }

  parser.expect(TokenKind.RBrace, "}");

  return node;
}

// Whether the `(` at the cursor opens a lambda rather than an expression in
// parentheses: it does when the `)` matching it is followed by `=>`, or by
// the `:` of a return type. Neither can follow a parenthesised expression.
fn looksLikeLambda(parser: *Parser): bool {
  let index: i32 = parser.pos;
  let depth: i32 = 0;

  while (true) {
    let kind: TokenKind = parser.tokens.at(index).kind;
    if (kind == TokenKind.End) {
      return false;
    }
    if (kind == TokenKind.LParen) {
      depth = depth + 1;
    }
    if (kind == TokenKind.RParen) {
      depth = depth - 1;
      if (depth == 0) {
        break;
      }
    }
    index = index + 1;
  }

  let next: TokenKind = parser.tokens.at(index + 1).kind;
  return next == TokenKind.Arrow || next == TokenKind.Colon;
}

// Lambda -> '(' (LambdaParam (',' LambdaParam)*)? ')' (':' DeclaredType)?
//           '=>' (Block | Expr)
// LambdaParam -> IDENT (':' DeclaredType)?
//
// The types left out are the ones the context gives: in
// `let f: (i32) => i32 = (x) => x * 2;`, `x` is an i32 and so is the
// result. The body runs as far as an expression would, so `(x) => x + 1`
// returns `x + 1`.
fn parseLambda(parser: *Parser): i32 {
  let start: *Token = parser.current();
  let params: i32 = parser.ast.add(NodeKind.Params, start.line, start.column,
                                   Params { list: List<i32>.new(), variadic: false });
  parser.expect(TokenKind.LParen, "(");

  if (parser.kind() != TokenKind.RParen) {
    while (true) {
      let name: *Token = parser.expect(TokenKind.Ident, "parameter name");
      if (FAILED) {
        break;
      }
      let type: i32 = NO_NODE;
      if (parser.kind() == TokenKind.Colon) {
        parser.advance();
        type = parseDeclaredType(parser);
      }
      parser.ast.addItem(params, parser.ast.add(NodeKind.Param, name.line, name.column,
                                                Param { name: name.text, type: type }));

      if (parser.kind() != TokenKind.Comma) {
        break;
      }
      parser.advance();
    }
  }
  parser.expect(TokenKind.RParen, ")");

  let returnType: i32 = NO_NODE;
  if (parser.kind() == TokenKind.Colon) {
    parser.advance();
    returnType = parseDeclaredType(parser);
  }
  parser.expect(TokenKind.Arrow, "=>");
  if (FAILED) {
    return parser.errorNode();
  }

  if (parser.kind() == TokenKind.LBrace) {
    let block: i32 = parseBlock(parser);
    return parser.ast.add(NodeKind.Lambda, start.line, start.column,
                          Lambda { returnType: returnType, params: params, body: block,
                                   expressionBody: false });
  }

  let at: *Token = parser.current();
  let value: i32 = parseExpr(parser);
  let returned: i32 = parser.ast.add(NodeKind.Return, at.line, at.column,
                                     Return { value: value });
  let statements: *List<i32> = List<i32>.new();
  statements.push(returned);
  let body: i32 = parser.ast.add(NodeKind.Block, at.line, at.column,
                                 Block { items: statements });

  return parser.ast.add(NodeKind.Lambda, start.line, start.column,
                        Lambda { returnType: returnType, params: params, body: body,
                                 expressionBody: true });
}
