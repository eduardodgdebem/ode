// ---------------------------------------------------------------------------
// Diagnostics: collecting what is wrong with a program.
//
// Ode has no exceptions, so a phase cannot unwind out of a failed construct
// the way it could with exceptions. Instead `FAILED` is raised, every function
// on the way out returns promptly, and the phase's statement loop clears it
// and moves to the next statement. While it is raised no further diagnostic
// is recorded, so one mistake produces one message.
//
// What is recorded is a Problem and its Facts, where it was found; render.ode
// prints them.
// ---------------------------------------------------------------------------

import { exit } from "std/c";
import { alloc } from "std/mem";
import { List } from "std/list";
import { Problem, Facts } from "./problems";
import { forgetSources, printDiagnostics } from "./render";
import { line } from "../driver/options";

// The file being worked on, which every diagnostic is reported against.
export let SOURCE_PATH: *i8 = "<none>";

// A problem, where it was found. Its words come from `describe`, when it is
// printed.
export struct Diagnostic {
  problem: Problem,
  facts: Facts,
  // The file being worked on when it was reported.
  path: *i8,
  line: i32,
  column: i32,
}

export struct Diagnostics {
  items: *List<Diagnostic>,
  // Everything reported, including any past the limit that was not kept.
  total: i32,

  fn new(): *Diagnostics {
    let bag: *Diagnostics = alloc<Diagnostics>(1);
    bag.items = List<Diagnostic>.new();
    bag.total = 0;
    return bag;
  }

  fn at(self: *Diagnostics, index: i32): Diagnostic {
    return self.items.at(index as i64);
  }

  fn count(self: *Diagnostics): i32 {
    return self.items.count as i32;
  }
}

// Past this many the list stops being useful and starts being noise.
let DIAG_LIMIT: i32 = 20;

export let DIAGS: *Diagnostics = null;
// Raised by the construct that failed, lowered by whatever recovers from it.
export let FAILED: bool = false;

export fn report(problem: Problem, line: i32, column: i32, facts: Facts): void {
  // The first message about a construct is the one worth keeping; anything
  // after it is the same mistake seen from further away.
  if (FAILED) {
    return;
  }
  FAILED = true;

  DIAGS.total = DIAGS.total + 1;
  if (DIAGS.count() >= DIAG_LIMIT) {
    return;
  }

  DIAGS.items.push(Diagnostic {
    problem: problem, facts: facts, path: SOURCE_PATH, line: line,
    column: column,
  });
}

export fn hasErrors(): bool {
  return DIAGS.total > 0;
}

// ---------------------------------------------------------------------------
// The source each file was read from, so that a diagnostic can show the line
// it is about.
// ---------------------------------------------------------------------------

// Forgets every source and diagnostic, for loading a program afresh.
export fn resetDiagnostics(): void {
  forgetSources();
  DIAGS = Diagnostics.new();
  FAILED = false;
}

fn failAt(problem: Problem, line: i32, column: i32, facts: Facts): void {
  DIAGS = Diagnostics.new();
  FAILED = false;
  report(problem, line, column, facts);
  printDiagnostics();
  exit(1);
}

export fn fail(problem: Problem): void {
  failAt(problem, 0, 0, Facts.none());
}

// A fault in the compiler itself, which no program should be able to cause.
export fn internalError(line: i32, column: i32, what: *i8): void {
  failAt(Problem.Internal, line, column, Facts.about(what));
}

test "a construct that failed reports once, until it is recovered from" {
  DIAGS = Diagnostics.new();
  FAILED = false;
  report(Problem.UndefinedVariable, 1, 1, Facts.about("a"));
  report(Problem.UndefinedVariable, 1, 5, Facts.about("b"));
  assertEq(DIAGS.total, 1);
  FAILED = false;
  report(Problem.UndefinedVariable, 2, 1, Facts.about("c"));
  assertEq(DIAGS.total, 2);
  assertEq(DIAGS.at(1).facts.name, "c");
}

test "past the limit, problems are counted but not kept" {
  DIAGS = Diagnostics.new();
  for (index in 0..25) {
    FAILED = false;
    report(Problem.NoMain, 0, 0, Facts.none());
  }
  assertEq(DIAGS.total, 25);
  assertEq(DIAGS.count(), 20);
  assert(hasErrors());
}
