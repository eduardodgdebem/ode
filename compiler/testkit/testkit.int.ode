// ---------------------------------------------------------------------------
// The test kit's slow half: programs built and run, and files on disk.
// ---------------------------------------------------------------------------

import { List } from "std/list";
import { Problem } from "../diagnostics/problems";
import { Diagnostic } from "../diagnostics/report";
import { problemsInFiles, Files, outputOf } from "./testkit";

test "a program is built and run" {
  assertEq(outputOf(`
    import { printf } from "std/c";

    fn main(): i32 {
      printf("%d\n", 6 * 7);
      return 3;
    }
  `), "42\nexit 3\n");
}

test "a program of several files" {
  let files: *Files = Files.new();
  files.add("lib.ode", "export fn seven(): i32 { return 7; }\n");
  files.add("main.ode", `
    import { seven } from "./lib";

    fn main(): i32 {
      return seven() + nope;
    }
  `);
  let found: *List<Diagnostic> = problemsInFiles(files, "main.ode");
  assertEq(found.count, 1);
  assertEq(found.at(0).problem, Problem.UndefinedVariable);
  assertEq(found.at(0).line, 4);
  files.release();
}
