root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Expected outputs are compared byte for byte; an editor must not tidy them.
[tests/**.{out,expected}]
insert_final_newline = unset
trim_trailing_whitespace = false

# Generated.
[{bootstrap/ode.ll,editors/tree-sitter-ode/src/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
