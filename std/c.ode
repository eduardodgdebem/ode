// ---------------------------------------------------------------------------
// The C library, declared once, so that a program imports what it uses
// rather than declaring each function itself:
//
//   import { printf, malloc } from "std/c";
//
// The types are the C ABI's, spelled in Ode: a `char *` is `*i8`; a
// `size_t`, an `ssize_t` and a `long` are `isize`, as wide as a pointer on
// every target Ode builds for; and a `FILE *` is `*i8` -- a handle never
// looked inside. These are
// thin: the rest of std is built on them, and is the friendlier way in.
// ---------------------------------------------------------------------------

// Memory.
export extern fn malloc(size: isize): *i8;
export extern fn calloc(count: isize, size: isize): *i8;
export extern fn realloc(block: *i8, size: isize): *i8;
export extern fn free(block: *i8): void;
export extern fn memcpy(to: *i8, from: *i8, count: isize): *i8;
export extern fn memmove(to: *i8, from: *i8, count: isize): *i8;
export extern fn memset(block: *i8, value: i32, count: isize): *i8;
export extern fn memcmp(a: *i8, b: *i8, count: isize): i32;

// Strings.
export extern fn strlen(text: *i8): isize;
export extern fn strnlen(text: *i8, limit: isize): isize;
export extern fn strcmp(a: *i8, b: *i8): i32;
export extern fn strncmp(a: *i8, b: *i8, count: isize): i32;
export extern fn strstr(text: *i8, part: *i8): *i8;
export extern fn strtol(text: *i8, end: **i8, base: i32): isize;
export extern fn strtod(text: *i8, end: **i8): f64;

// Formatted output.
export extern fn printf(format: *i8, ...): i32;
export extern fn dprintf(fd: i32, format: *i8, ...): i32;
export extern fn snprintf(buffer: *i8, size: isize, format: *i8, ...): i32;
export extern fn putchar(character: i32): i32;
export extern fn getchar(): i32;
export extern fn puts(text: *i8): i32;

// Files, through C's buffered streams.
export extern fn fopen(path: *i8, mode: *i8): *i8;
export extern fn fdopen(fd: i32, mode: *i8): *i8;
export extern fn fclose(stream: *i8): i32;
export extern fn fread(buffer: *i8, size: isize, count: isize, stream: *i8): isize;
export extern fn fwrite(buffer: *i8, size: isize, count: isize, stream: *i8): isize;
export extern fn fgetc(stream: *i8): i32;
export extern fn fputs(text: *i8, stream: *i8): i32;
export extern fn fflush(stream: *i8): i32;
export extern fn ferror(stream: *i8): i32;

// Files, unbuffered, by descriptor.
export extern fn write(fd: i32, buffer: *i8, count: isize): isize;
export extern fn read(fd: i32, buffer: *i8, count: isize): isize;

// The process.
export extern fn exit(code: i32): void;
export extern fn abort(): void;
export extern fn getenv(name: *i8): *i8;
