// ---------------------------------------------------------------------------
// Files, whole: read one into a string, or write a string out as one.
//
//   let source: *i8 = readFile("main.ode") catch (e) {
//     eprintln("cannot read main.ode");
//     return 1;
//   };
//
// Paths are relative to the directory the program runs in.
// ---------------------------------------------------------------------------

import { fopen, fclose, fread, fwrite, ferror, strlen } from "./c";
import { Builder } from "./text";
import { alloc, release } from "./mem";

extern fn access(path: *i8, mode: i32): i32;
extern fn unlink(path: *i8): i32;

export error enum FileError {
  // Nothing is there.
  NotFound,
  // Something is there, but cannot be read as a file: a directory, or one
  // the program may not read.
  CannotRead,
  // It cannot be written: its directory is missing, or may not be written.
  CannotWrite,
}

// The whole of the file at `path`. A file holding a NUL byte reads as text
// that ends there.
export fn readFile(path: *i8): *i8 | FileError {
  let stream: *i8 = fopen(path, "rb");
  if (stream == null) {
    return missingOr(path, FileError.CannotRead);
  }

  let out: *Builder = Builder.new();
  let chunk: *i8 = alloc<i8>(4096);
  let count: i64 = fread(chunk, 1, 4096, stream);
  while (count > 0) {
    out.addBytes(chunk, count);
    count = fread(chunk, 1, 4096, stream);
  }

  release<i8>(chunk);
  let failed: bool = ferror(stream) != 0;
  fclose(stream);
  if (failed) {
    release<i8>(out.take());
    return FileError.CannotRead;
  }
  return out.take();
}

// Replaces the file at `path` with `text`, making it if need be.
export fn writeFile(path: *i8, text: *i8): void | FileError {
  return put(path, text, "wb");
}

// Adds `text` to the end of the file at `path`, making it if need be.
export fn appendFile(path: *i8, text: *i8): void | FileError {
  return put(path, text, "ab");
}

fn put(path: *i8, text: *i8, mode: *i8): void | FileError {
  let stream: *i8 = fopen(path, mode);
  if (stream == null) {
    return FileError.CannotWrite;
  }
  let length: i64 = strlen(text);
  let written: i64 = fwrite(text, 1, length, stream);
  if (fclose(stream) != 0 || written != length) {
    return FileError.CannotWrite;
  }
  return;
}

export fn exists(path: *i8): bool {
  return access(path, 0) == 0;
}

export fn removeFile(path: *i8): void | FileError {
  if (unlink(path) != 0) {
    return missingOr(path, FileError.CannotWrite);
  }
  return;
}

// NotFound when nothing is at `path`, and `otherwise` when something is.
fn missingOr(path: *i8, otherwise: FileError): FileError {
  if (!exists(path)) {
    return FileError.NotFound;
  }
  return otherwise;
}

test "a file written is read back whole" {
  let path: *i8 = "ode-std-fs-test.txt";
  let line: *Builder = Builder.new();
  for (index in 0..2000) {
    line.add("0123456789");
  }
  let text: *i8 = line.take();

  assert(!(writeFile(path, text) is FileError));
  assert(exists(path));
  assertEq(strlen(readFile(path) ?? ""), 20000);

  assert(!(appendFile(path, "end") is FileError));
  assertEq(strlen(readFile(path) ?? ""), 20003);

  assert(!(removeFile(path) is FileError));
  assert(!exists(path));
}

test "what cannot be read says why" {
  assertEq(readFile("no-such-file.txt"), FileError.NotFound);
  assertEq(readFile("."), FileError.CannotRead);
}

test "what cannot be written or removed says why" {
  assertEq(writeFile("no-such-directory/file.txt", "text"), FileError.CannotWrite);
  assertEq(appendFile("no-such-directory/file.txt", "text"), FileError.CannotWrite);
  assertEq(removeFile("no-such-file.txt"), FileError.NotFound);
  assert(!exists("no-such-file.txt"));
}

test "an empty file reads as an empty string" {
  let path: *i8 = "ode-std-fs-empty.txt";
  assert(!(writeFile(path, "") is FileError));
  assertEq(readFile(path), "");
  removeFile(path) catch (e) {};
}
