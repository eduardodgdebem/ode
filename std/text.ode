// ---------------------------------------------------------------------------
// Text: NUL-terminated `*i8` strings, the kind C passes around, and a
// Builder for putting new ones together.
//
//   let out: *Builder = Builder.new();
//   out.add("total: ");
//   out.addInt(42);
//   let line: *i8 = out.take();
//
// Functions that make a string return a new one the caller owns; none of
// them change their arguments.
// ---------------------------------------------------------------------------

import { copyBytes, compareText, findText, textLength, textLengthUpTo } from "./heap";
import { alloc, grow, release } from "./mem";
import { List } from "./list";
import { strtod } from "./c";
import { ARCH, Arch } from "std/target";

export fn length(text: *i8): i64 {
  return textLength(text);
}

export fn equals(a: *i8, b: *i8): bool {
  return compareText(a, b, -1) == 0;
}

export fn startsWith(text: *i8, prefix: *i8): bool {
  return compareText(text, prefix, textLength(prefix)) == 0;
}

export fn endsWith(text: *i8, suffix: *i8): bool {
  let textBytes: i64 = textLength(text);
  let suffixBytes: i64 = textLength(suffix);
  if (suffixBytes > textBytes) {
    return false;
  }
  return compareText(text + textBytes - suffixBytes, suffix, -1) == 0;
}

// Where `part` first starts in `text`, or -1.
export fn indexOf(text: *i8, part: *i8): i64 {
  let found: *i8 = findText(text, part);
  if (found == null) {
    return -1;
  }
  return found - text;
}

export fn contains(text: *i8, part: *i8): bool {
  return findText(text, part) != null;
}

// The `count` bytes of `text` from `start`, as a string of their own. It
// stops the program when those bytes run past the end of the text -- found
// by looking at them alone, so slicing a little out of a long text costs no
// more than the slice.
export fn slice(text: *i8, start: i64, count: i64): *i8 {
  assert(start >= 0 && count >= 0 &&
         textLengthUpTo(text + start, count) == count,
         "slice out of range");
  let out: *i8 = alloc<i8>(count + 1);
  copyBytes(out, text + start, count);
  out[count] = '\0';
  return out;
}

export fn copy(text: *i8): *i8 {
  return slice(text, 0, textLength(text));
}

export fn fromInt(value: i64): *i8 {
  let out: *Builder = Builder.new();
  out.addInt(value);
  return out.take();
}

fn isSpaceByte(c: i8): bool {
  return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\x0b' || c == '\x0c';
}

// The bytes of `text`, before its NUL, as a slice of it -- not a copy.
export fn bytesOf(text: *i8): []i8 {
  return text[0..textLength(text)];
}

// `text` without the spaces, tabs and line breaks at either end.
export fn trim(text: *i8): *i8 {
  let start: i64 = 0;
  while (isSpaceByte(text[start])) {
    start = start + 1;
  }
  let end: i64 = textLength(text);
  while (end > start && isSpaceByte(text[end - 1])) {
    end = end - 1;
  }
  return slice(text, start, end - start);
}

// The parts of `text` between each `separator`, in order, empty ones
// included: split("a,,b", ",") is "a", "", "b". An empty separator gives
// `text` whole.
export fn split(text: *i8, separator: *i8): *List<*i8> {
  let parts: *List<*i8> = List<*i8>.new();
  let size: i64 = textLength(separator);
  if (size == 0) {
    parts.push(copy(text));
    return parts;
  }
  let rest: *i8 = text;
  let at: i64 = indexOf(rest, separator);
  while (at >= 0) {
    parts.push(slice(rest, 0, at));
    rest = rest + at + size;
    at = indexOf(rest, separator);
  }
  parts.push(copy(rest));
  return parts;
}

// The words of `text`: what is between runs of spaces, tabs and line
// breaks, none of them empty.
export fn words(text: *i8): *List<*i8> {
  let found: *List<*i8> = List<*i8>.new();
  let at: i64 = 0;
  while (text[at] != '\0') {
    while (isSpaceByte(text[at])) {
      at = at + 1;
    }
    let start: i64 = at;
    while (text[at] != '\0' && !isSpaceByte(text[at])) {
      at = at + 1;
    }
    if (at > start) {
      found.push(slice(text, start, at - start));
    }
  }
  return found;
}

fn lowerByte(c: i8): i8 {
  if (c >= 'A' && c <= 'Z') {
    return (c + 32) as i8;
  }
  return c;
}

fn upperByte(c: i8): i8 {
  if (c >= 'a' && c <= 'z') {
    return (c - 32) as i8;
  }
  return c;
}

// `text` with A to Z made lowercase; every other byte, UTF-8 included, is
// left as it is.
export fn toLower(text: *i8): *i8 {
  let out: *i8 = copy(text);
  let at: i64 = 0;
  while (out[at] != '\0') {
    out[at] = lowerByte(out[at]);
    at = at + 1;
  }
  return out;
}

// `text` with a to z made uppercase.
export fn toUpper(text: *i8): *i8 {
  let out: *i8 = copy(text);
  let at: i64 = 0;
  while (out[at] != '\0') {
    out[at] = upperByte(out[at]);
    at = at + 1;
  }
  return out;
}

// Whether `a` and `b` are the same text but for the case of A to Z.
export fn equalsIgnoringCase(a: *i8, b: *i8): bool {
  let at: i64 = 0;
  while (a[at] != '\0' && lowerByte(a[at]) == lowerByte(b[at])) {
    at = at + 1;
  }
  return lowerByte(a[at]) == lowerByte(b[at]);
}

// indexOf, but for the case of A to Z.
export fn indexOfIgnoringCase(text: *i8, part: *i8): i64 {
  let size: i64 = textLength(part);
  let at: i64 = 0;
  while (true) {
    let same: i64 = 0;
    while (same < size && text[at + same] != '\0' &&
           lowerByte(text[at + same]) == lowerByte(part[same])) {
      same = same + 1;
    }
    if (same == size) {
      return at;
    }
    if (text[at] == '\0') {
      return -1;
    }
    at = at + 1;
  }
  return -1;
}

export error enum ParseError {
  // There was nothing to read.
  Empty,
  // Something that is not a digit -- a space, a letter, a sign alone.
  NotANumber,
  // A number, but one too wide for an i64.
  OutOfRange,
}

// The decimal integer `text` holds: digits, after an optional sign, and
// nothing else.
export fn parseInt(text: *i8): i64 | ParseError {
  let index: i64 = 0;
  let negative: bool = text[0] == '-';
  if (negative || text[0] == '+') {
    index = 1;
  }
  if (text[0] == '\0') {
    return ParseError.Empty;
  }
  if (text[index] == '\0') {
    return ParseError.NotANumber;
  }

  // The magnitude, as a u64, may reach one past the largest i64 only when
  // it is negative.
  let limit: u64 = 9223372036854775807;
  if (negative) {
    limit = limit + 1;
  }

  let magnitude: u64 = 0;
  while (text[index] != '\0') {
    let digit: i8 = text[index];
    if (digit < '0' || digit > '9') {
      return ParseError.NotANumber;
    }
    let value: u64 = (digit - '0') as u64;
    if (magnitude > (limit - value) / 10) {
      return ParseError.OutOfRange;
    }
    magnitude = magnitude * 10 + value;
    index = index + 1;
  }

  if (negative) {
    return (0 - magnitude) as i64;
  }
  return magnitude as i64;
}

fn isDigitByte(c: i8): bool {
  return c >= '0' && c <= '9';
}

// The decimal number `text` holds: an optional sign, digits with an
// optional fraction -- `12`, `-0.5`, `.5`, `3.` -- and an optional exponent,
// `1e-3`, and nothing else. `OutOfRange` for one too large for an f64.
export fn parseFloat(text: *i8): f64 | ParseError {
  if (text[0] == '\0') {
    return ParseError.Empty;
  }
  let at: i64 = 0;
  if (text[at] == '-' || text[at] == '+') {
    at = at + 1;
  }
  let digits: i64 = 0;
  while (isDigitByte(text[at])) {
    at = at + 1;
    digits = digits + 1;
  }
  if (text[at] == '.') {
    at = at + 1;
    while (isDigitByte(text[at])) {
      at = at + 1;
      digits = digits + 1;
    }
  }
  if (digits == 0) {
    return ParseError.NotANumber;
  }
  if (text[at] == 'e' || text[at] == 'E') {
    at = at + 1;
    if (text[at] == '-' || text[at] == '+') {
      at = at + 1;
    }
    if (!isDigitByte(text[at])) {
      return ParseError.NotANumber;
    }
    while (isDigitByte(text[at])) {
      at = at + 1;
    }
  }
  if (text[at] != '\0') {
    return ParseError.NotANumber;
  }
  let value: f64 = match (ARCH) {
    .Wasm32 => decimalValue(text),
    else => strtod(text, null),
  };
  if (value - value != 0.0) {
    return ParseError.OutOfRange;
  }
  return value;
}

// What decimalValue reads a number of more digits than this by: the ones
// past it are past what an f64 can tell apart.
let SIGNIFICANT_DIGITS: i64 = 19;

// The value of text parseFloat has checked, where there is no C library to
// ask: the digits as an integer, then scaled by the power of ten the point
// and the exponent make. Within a unit or two of the last place, where C's
// strtod is exact.
fn decimalValue(text: *i8): f64 {
  let at: i64 = 0;
  let negative: bool = text[0] == '-';
  if (text[0] == '-' || text[0] == '+') {
    at = 1;
  }
  let mantissa: u64 = 0;
  let kept: i64 = 0;
  let scale: i64 = 0;
  let afterPoint: bool = false;
  while (isDigitByte(text[at]) || text[at] == '.') {
    if (text[at] == '.') {
      afterPoint = true;
    } else if (kept < SIGNIFICANT_DIGITS) {
      mantissa = mantissa * 10 + (text[at] - '0') as u64;
      kept = kept + 1;
      if (afterPoint) {
        scale = scale - 1;
      }
    } else if (!afterPoint) {
      scale = scale + 1;
    }
    at = at + 1;
  }
  if (text[at] == 'e' || text[at] == 'E') {
    at = at + 1;
    let sign: i64 = 1;
    if (text[at] == '-' || text[at] == '+') {
      if (text[at] == '-') {
        sign = -1;
      }
      at = at + 1;
    }
    let exponent: i64 = 0;
    while (isDigitByte(text[at]) && exponent < 100000) {
      exponent = exponent * 10 + (text[at] - '0') as i64;
      at = at + 1;
    }
    scale = scale + sign * exponent;
  }
  let value: f64 = mantissa as f64;
  while (scale > 0 && value - value == 0.0) {
    value = value * 10.0;
    scale = scale - 1;
  }
  while (scale < 0 && value != 0.0) {
    value = value / 10.0;
    scale = scale + 1;
  }
  if (negative) {
    return 0.0 - value;
  }
  return value;
}

export struct Builder {
  data: *i8,
  length: i64,
  capacity: i64,

  fn new(): *Builder {
    let out: *Builder = alloc<Builder>(1);
    out.capacity = 32;
    out.data = alloc<i8>(out.capacity);
    out.length = 0;
    out.data[0] = '\0';
    return out;
  }

  // Makes room for `extra` more bytes and the terminator.
  fn reserve(self: *Builder, extra: i64): void {
    if (self.length + extra + 1 <= self.capacity) {
      return;
    }
    while (self.length + extra + 1 > self.capacity) {
      self.capacity = self.capacity * 2;
    }
    self.data = grow<i8>(self.data, self.capacity);
  }

  fn addBytes(self: *Builder, bytes: *i8, count: i64): void {
    self.reserve(count);
    copyBytes(self.data + self.length, bytes, count);
    self.length = self.length + count;
    self.data[self.length] = '\0';
  }

  fn add(self: *Builder, text: *i8): void {
    self.addBytes(text, textLength(text));
  }

  fn push(self: *Builder, byte: i8): void {
    self.reserve(1);
    self.data[self.length] = byte;
    self.length = self.length + 1;
    self.data[self.length] = '\0';
  }

  fn addInt(self: *Builder, value: i64): void {
    if (value == 0) {
      self.push('0');
      return;
    }

    // Worked out as a u64, which holds the magnitude of every i64 --
    // including the most negative.
    let rest: u64 = value as u64;
    if (value < 0) {
      self.push('-');
      rest = 0 - rest;
    }

    let digits: *i8 = alloc<i8>(20);
    let count: i64 = 0;
    while (rest > 0) {
      digits[count] = ('0' + rest % 10) as i8;
      rest = rest / 10;
      count = count + 1;
    }
    while (count > 0) {
      count = count - 1;
      self.push(digits[count]);
    }
    release<i8>(digits);
  }

  // `value` in decimal, padded on the left with `fill` to at least `width`
  // characters: addPadded(7, 2, '0') adds "07", the way a clock wants it.
  // With '0' the sign goes before the zeros, so -7 is "-07".
  fn addPadded(self: *Builder, value: i64, width: i64, fill: i8): void {
    let digits: *Builder = Builder.new();
    if (value < 0 && fill == '0') {
      self.push('-');
      width = width - 1;
      digits.addInt(value);
      let magnitude: *i8 = digits.data + 1;
      for (index in textLength(magnitude)..width) {
        self.push('0');
      }
      self.add(magnitude);
    } else {
      digits.addInt(value);
      for (index in digits.length..width) {
        self.push(fill);
      }
      self.add(digits.data);
    }
    release<i8>(digits.take());
  }

  // `value` with `decimals` digits after the point, rounded half away from
  // zero: addFloat(3.14159, 2) adds "3.14", and with 0 there is no point.
  // NaN is "nan" and the infinities "inf" and "-inf". A magnitude past
  // 1e18 is written with an exponent, "1.50e21", since an i64 holds the
  // rest of the digits exactly and not those.
  fn addFloat(self: *Builder, value: f64, decimals: i64): void {
    if (value != value) {
      self.add("nan");
      return;
    }
    if (value < 0.0) {
      self.push('-');
      value = 0.0 - value;
    }
    if (value - value != 0.0) {
      self.add("inf");
      return;
    }
    if (decimals < 0) {
      decimals = 0;
    }
    if (decimals > 17) {
      decimals = 17;
    }
    let exponent: i64 = 0;
    if (value >= 1000000000000000000.0) {
      while (value >= 10.0) {
        value = value / 10.0;
        exponent = exponent + 1;
      }
    }
    let scale: u64 = 1;
    let shown: f64 = value;
    for (index in 0..decimals) {
      scale = scale * 10;
      shown = shown * 10.0;
    }
    // The point moves out of what a u64 can hold, so the digits after it go
    // first, rounded, and the whole part from what is left.
    if (shown >= 18000000000000000000.0) {
      let whole: u64 = value as u64;
      self.addUnsigned(whole);
    } else {
      let rounded: u64 = (shown + 0.5) as u64;
      self.addUnsigned(rounded / scale);
      if (decimals > 0) {
        self.push('.');
        let fraction: u64 = rounded % scale;
        let width: u64 = scale / 10;
        while (width > 1 && fraction < width) {
          self.push('0');
          width = width / 10;
        }
        if (fraction > 0 || decimals == 1) {
          self.addUnsigned(fraction);
        } else {
          self.push('0');
        }
      }
    }
    if (exponent > 0) {
      self.push('e');
      self.addInt(exponent);
    }
  }

  fn addUnsigned(self: *Builder, value: u64): void {
    let digits: *i8 = alloc<i8>(20);
    let count: i64 = 0;
    while (value > 0 || count == 0) {
      digits[count] = ('0' + value % 10) as i8;
      value = value / 10;
      count = count + 1;
    }
    while (count > 0) {
      count = count - 1;
      self.push(digits[count]);
    }
    release<i8>(digits);
  }

  // The string built so far, which the caller now owns; the builder itself is
  // freed.
  fn take(self: *Builder): *i8 {
    let text: *i8 = self.data;
    release<Builder>(self);
    return text;
  }
}

test "comparisons" {
  assert(equals("ode", "ode"));
  assert(!equals("ode", "odes"));
  assert(startsWith("compiler", "comp"));
  assert(!startsWith("co", "comp"));
  assert(endsWith("main.ode", ".ode"));
  assert(!endsWith("ode", "main.ode"));
  assertEq(indexOf("hello world", "world"), 6);
  assertEq(indexOf("hello", "z"), -1);
  assert(contains("hello", "ell"));
}

test "slices and copies are new strings" {
  assertEq(slice("hello world", 6, 5), "world");
  let original: *i8 = "abc";
  let copied: *i8 = copy(original);
  assertEq(copied, original);
  assert(copied != original);
}

test "numbers to text and back" {
  assertEq(fromInt(0), "0");
  assertEq(fromInt(-42), "-42");
  assertEq(fromInt(-9223372036854775807 - 1), "-9223372036854775808");
  assertEq(parseInt("1234"), 1234);
  assertEq(parseInt("-7"), -7);
  assertEq(parseInt("+5"), 5);
  assertEq(parseInt("9223372036854775807"), 9223372036854775807);
  assertEq(parseInt("-9223372036854775808"), -9223372036854775807 - 1);
}

test "parseInt says why text is not a number" {
  assertEq(parseInt(""), ParseError.Empty);
  assertEq(parseInt("12a"), ParseError.NotANumber);
  assertEq(parseInt("-"), ParseError.NotANumber);
  assertEq(parseInt("+"), ParseError.NotANumber);
  assertEq(parseInt(" 1"), ParseError.NotANumber);
  assertEq(parseInt("1 "), ParseError.NotANumber);
  assertEq(parseInt("9223372036854775808"), ParseError.OutOfRange);
  assertEq(parseInt("-9223372036854775809"), ParseError.OutOfRange);
  assertEq(parseInt("99999999999999999999999"), ParseError.OutOfRange);
  assertEq(parseInt("abc") ?? 0, 0);
}

test "comparisons that do not match" {
  assert(!equals("", "a"));
  assert(startsWith("anything", ""));
  assert(endsWith("anything", ""));
  assert(!endsWith("", "a"));
  assertEq(indexOf("", "a"), -1);
  assertEq(slice("abc", 3, 0), "");
}

test "a builder grows as text is added" {
  let out: *Builder = Builder.new();
  for (index in 0..100) {
    out.add("ab");
  }
  out.push('!');
  out.addInt(7);
  assertEq(out.length, 202);
  let text: *i8 = out.take();
  assertEq(slice(text, 196, 6), "abab!7");
}

test "numbers padded to a width" {
  let out: *Builder = Builder.new();
  out.addPadded(7, 2, '0');
  out.push(':');
  out.addPadded(5, 2, '0');
  out.push('|');
  out.addPadded(-7, 3, '0');
  out.push('|');
  out.addPadded(42, 5, ' ');
  out.push('|');
  out.addPadded(12345, 2, '0');
  assertEq(out.take(), "07:05|-07|   42|12345");
}

test "floats with a number of decimals" {
  let out: *Builder = Builder.new();
  out.addFloat(3.14159, 2);
  out.push(' ');
  out.addFloat(2.5, 0);
  out.push(' ');
  out.addFloat(-0.125, 3);
  out.push(' ');
  out.addFloat(1.005, 1);
  out.push(' ');
  out.addFloat(0.0, 2);
  out.push(' ');
  out.addFloat(10.0, 3);
  out.push(' ');
  out.addFloat(0.05, 2);
  assertEq(out.take(), "3.14 3 -0.125 1.0 0.00 10.000 0.05");

  let odd: *Builder = Builder.new();
  odd.addFloat(0.0 / 0.0, 2);
  odd.push(' ');
  odd.addFloat(1.0 / 0.0, 2);
  odd.push(' ');
  odd.addFloat(-1.0 / 0.0, 2);
  odd.push(' ');
  odd.addFloat(1500000000000000000000.0, 2);
  assertEq(odd.take(), "nan inf -inf 1.50e21");
}

test "trimming, splitting and words" {
  assertEq(trim("  hello world \n"), "hello world");
  assertEq(trim(" \t "), "");
  let parts: *List<*i8> = split("a,,b", ",");
  assertEq(parts.count, 3);
  assertEq(parts.at(0), "a");
  assertEq(parts.at(1), "");
  assertEq(parts.at(2), "b");
  assertEq(split("one", ", ").count, 1);
  assertEq(split("x => y => z", " => ").at(2), "z");
  let found: *List<*i8> = words("  pomo   on\toff ");
  assertEq(found.count, 3);
  assertEq(found.at(0), "pomo");
  assertEq(found.at(2), "off");
  assertEq(words("   ").count, 0);
}

test "case" {
  assertEq(toLower("Hello, ODE"), "hello, ode");
  assertEq(toUpper("Hello, ode"), "HELLO, ODE");
  assert(equalsIgnoringCase("Content-Length", "content-length"));
  assert(!equalsIgnoringCase("Host", "Hostname"));
  assertEq(indexOfIgnoringCase("Buy MILK today", "milk"), 4);
  assertEq(indexOfIgnoringCase("abc", "d"), -1);
  assertEq(indexOfIgnoringCase("abc", ""), 0);
}

test "parseFloat reads decimals, and says why not" {
  assert((parseFloat("2.5") ?? 0.0) == 2.5, "a fraction");
  assert((parseFloat("-0.125") ?? 0.0) == -0.125, "negative");
  assert((parseFloat(".5") ?? 0.0) == 0.5, "no whole part");
  assert((parseFloat("3.") ?? 0.0) == 3.0, "no fraction");
  assert((parseFloat("1e3") ?? 0.0) == 1000.0, "an exponent");
  assert((parseFloat("12") ?? 0.0) == 12.0, "an integer");
  assertEq(parseFloat(""), ParseError.Empty);
  assertEq(parseFloat("."), ParseError.NotANumber);
  assertEq(parseFloat("1.2.3"), ParseError.NotANumber);
  assertEq(parseFloat("1e"), ParseError.NotANumber);
  assertEq(parseFloat(" 1"), ParseError.NotANumber);
  assertEq(parseFloat("1e999"), ParseError.OutOfRange);
}

test "decimals are read without a C library too" {
  assert(decimalValue("2.5") == 2.5, "a fraction");
  assert(decimalValue("-1e3") == -1000.0, "an exponent");
  assert(decimalValue("0.001") == 0.001, "small");
  assert(decimalValue("123456789") == 123456789.0, "whole");
}

test "a string's bytes as a slice" {
  let bytes: []i8 = bytesOf("ode");
  assertEq(bytes.length, 3);
  assertEq(bytes[2], 'e');
  assertEq(bytesOf("").length, 0);
}

