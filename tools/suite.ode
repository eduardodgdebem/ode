// ---------------------------------------------------------------------------
// The regression suite: everything that needs the compiler as a program,
// which `ode build test` runs in this repository (see build.ode).
//
// Most of what the compiler does is tested in-process, by the tests written
// beside it in compiler/**/*.test.ode; this runs them, and the standard
// library's, through `ode test`. What it adds is what only the binary can
// show:
//
// - every examples/*.ode compiles, runs, and prints what
//   tests/examples/<name>.out says, so the examples cannot rot;
// - every tests/runner/*.ode, run through `ode test`, prints what its .out
//   says and exits as it does -- the test runner's own behaviour, failing
//   tests and crashes included;
// - the driver's flags do what they say.
//
// --update rewrites the expected files from what the compiler does now. Read
// the diff before committing it.
//
// Everything is compiled and run in a temporary directory, so the repository
// stays clean.
// ---------------------------------------------------------------------------

import { strlen } from "std/c";
import { alloc } from "std/mem";
import { exists, writeFile } from "std/fs";
import { Builder, equals, slice, endsWith, contains } from "std/text";
import { fail } from "../compiler/diagnostics/report";
import { line } from "../compiler/driver/options";
import {
  joinPath, withSuffix, parentDirectory, isExecutable, readBytes, writeBytes,
  sameBytes, makeDirectories, removeTree, listDirectory, splitLines,
  makeTempDirectory,
} from "../compiler/os/files";
import { STDOUT, writeBuilder, colour } from "../compiler/os/output";
import {
  TextList, StderrMode, runCommand, ran, setEnvironment, isTerminal, command,
} from "../compiler/os/process";
import { complain } from "../compiler/tool/build";

export struct TestOptions {
  filter: *i8,
  update: bool,
}

struct Suite {
  // The repository: where the examples and cases are.
  root: *i8,
  compiler: *i8,
  work: *i8,
  filter: *i8,
  update: bool,

  passed: i32,
  failed: i32,
  updated: i32,
  exampleCount: i32,
  unitCount: i32,
  failures: *TextList,

  // Terminal colours, or empty text when the output is not a terminal.
  dim: *i8,
  green: *i8,
  red: *i8,
  off: *i8,

  fn selected(self: *Suite, name: *i8): bool {
    return self.filter == null || contains(name, self.filter);
  }

  fn pass(self: *Suite, kind: *i8, name: *i8): void {
    self.passed = self.passed + 1;

    let line: *Builder = Builder.new();
    line.add(self.dim);
    line.add("  ");
    addPadded(line, kind, 10);
    line.push(' ');
    addPadded(line, name, 34);
    line.push(' ');
    line.add(self.green);
    line.add("ok");
    line.add(self.off);
    line.push('\n');
    writeBuilder(STDOUT, line);
  }

  fn fail(self: *Suite, kind: *i8, name: *i8, why: *i8): void {
    self.failed = self.failed + 1;

    let record: *Builder = Builder.new();
    record.add(kind);
    record.push('/');
    record.add(name);
    record.add(": ");
    record.add(why);
    self.failures.add(record.take());

    let line: *Builder = Builder.new();
    line.add("  ");
    addPadded(line, kind, 10);
    line.push(' ');
    addPadded(line, name, 34);
    line.push(' ');
    line.add(self.red);
    line.add("FAIL");
    line.add(self.off);
    line.add("  ");
    line.add(why);
    line.push('\n');
    writeBuilder(STDOUT, line);
  }

  // Compares what a case did against what it is expected to do, or records
  // it as the expectation under --update.
  fn check(self: *Suite, kind: *i8, name: *i8, expectedPath: *i8,
           actual: *Builder, missing: *i8, differs: *i8): void {
    // No expectation yet is what --update records one for.
    let expected: *Builder = readBytes(expectedPath) ?? null;

    if (self.update) {
      if (expected == null || !sameBytes(expected, actual)) {
        writeBytes(expectedPath, actual) catch (e) {
          self.fail(kind, name, "cannot record the expectation");
          return;
        };
        self.updated = self.updated + 1;
      }
      self.pass(kind, name);
      return;
    }

    if (expected == null) {
      self.fail(kind, name, missing);
      return;
    }

    if (sameBytes(expected, actual)) {
      self.pass(kind, name);
      return;
    }

    self.fail(kind, name, differs);

    let actualPath: *Builder = Builder.new();
    actualPath.add(self.work);
    actualPath.push('/');
    actualPath.add(kind);
    actualPath.push('-');
    actualPath.add(name);
    actualPath.add(".actual");
    // Only for showing a diff; without it, the failure still stands.
    writeBytes(actualPath.data, actual) catch (e) {};

    let diff: *TextList = TextList.new().add("diff").add("-u");
    diff.add("--label").add("expected").add(expectedPath);
    diff.add("--label").add("actual").add(actualPath.data);
    let output: *Builder = Builder.new();
    // diff exits 1 when the files differ, which is what it is shown for.
    runCommand(diff, null, output, StderrMode.Merge) ?? 0;
    writeIndented(output);
  }
}

fn addPadded(out: *Builder, text: *i8, width: i32): void {
  out.add(text);

  for (length in strlen(text) as i32..width) {
    out.push(' ');
  }
}

// Prints `text` with every line indented, the way a failure's detail is set
// off from the list.
fn writeIndented(text: *Builder): void {
  let lines: *TextList = splitLines(text);
  let out: *Builder = Builder.new();

  let index: i32 = 0;
  while (index < lines.size()) {
    out.add("    ");
    out.add(lines.at(index));
    out.push('\n');
    index = index + 1;
  }

  writeBuilder(STDOUT, out);
}

fn withoutExtension(name: *i8): *i8 {
  return slice(name, 0, strlen(name) - 4);
}

// ---------------------------------------------------------------------------
// The cases.
// ---------------------------------------------------------------------------

// Compiles `source`, runs what it builds, and compares what it prints against
// `expectedPath`. `kind` names the category: "example".
fn runProgramCase(suite: *Suite, kind: *i8, source: *i8, name: *i8,
                  expectedPath: *i8): void {
  suite.exampleCount = suite.exampleCount + 1;

  // Compiled with no flags and from inside the work directory, which is also
  // what pins down the default output paths.
  let compileOutput: *Builder = Builder.new();
  let compile: *TextList = TextList.new().add(suite.compiler).add(source);
  if (!ran(runCommand(compile, suite.work, compileOutput, StderrMode.Merge))) {
    suite.fail(kind, name, "compilation failed");
    writeIndented(compileOutput);
    return;
  }

  let actual: *Builder = Builder.new();
  let program: *TextList = TextList.new().add(joinPath(suite.work, name));
  let status: i32 = runCommand(program, null, actual, StderrMode.Discard) ?? -1;
  if (status != 0) {
    let why: *Builder = Builder.new();
    why.add("program exited with status ");
    why.addInt(status as i64);
    suite.fail(kind, name, why.data);
    return;
  }

  suite.check(kind, name, expectedPath, actual,
              "no expected output recorded (run with --update)",
              "stdout differs");
}

// A file of tests, run by `ode test`: what the runner printed and the status
// it ended with are what is checked.
fn runRunnerCase(suite: *Suite, source: *i8, name: *i8): void {
  suite.unitCount = suite.unitCount + 1;

  // Run by its bare name, so that a failure's location carries no absolute
  // path.
  let copyName: *Builder = Builder.new();
  copyName.add(name);
  copyName.add(".ode");
  let original: *Builder = readBytes(source) catch (e) {
    suite.fail("runner", name, "cannot read the case");
    return;
  };
  writeBytes(joinPath(suite.work, copyName.data), original) catch (e) {
    suite.fail("runner", name, "cannot copy the case to run it");
    return;
  };

  let actual: *Builder = Builder.new();
  let run: *TextList = TextList.new().add(suite.compiler).add("test");
  run.add(copyName.data);
  let status: i32 = runCommand(run, suite.work, actual, StderrMode.Merge) ?? -1;
  actual.add("exit ");
  actual.addInt(status as i64);
  actual.push('\n');

  suite.check("runner", name, withSuffix(withoutExtension(source), ".out"),
              actual, "no expected output recorded (run with --update)",
              "output differs");
}

// ---------------------------------------------------------------------------
// The driver flags have no expected-output file to record; they are checked
// against the files they are supposed to produce.
// ---------------------------------------------------------------------------

fn compileQuietly(suite: *Suite, command: *TextList): bool {
  return ran(runCommand(command, null, Builder.new(), StderrMode.Merge));
}

// Whether the program at `path` runs and prints exactly "0".
fn printsZero(path: *i8): bool {
  let output: *Builder = Builder.new();
  if (!ran(runCommand(TextList.new().add(path), null, output,
                 StderrMode.Discard))) {
    return false;
  }

  return equals(output.data, "0\n");
}

// A program that prints "0", which is what the driver checks build.
fn exampleOne(suite: *Suite): *i8 {
  return joinPath(suite.root, "tests/cli/prints_zero.ode");
}

fn checkOutputFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/nested/renamed");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  // By default the executable is all a build leaves.
  return isExecutable(out) && !exists(withSuffix(out, ".ll")) &&
         !exists(withSuffix(out, ".o")) && printsZero(out);
}

fn checkKeepIntermediatesFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/kept");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--keep-intermediates").add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  return isExecutable(out) && exists(withSuffix(out, ".ll")) &&
         exists(withSuffix(out, ".o"));
}

// A path holding a space and a shell metacharacter must survive the linker.
// There is no shell anywhere -- not here and not in the compiler -- but the
// check stays, because that is the property being relied on.
fn checkHostileOutputPath(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/a b $(touch pwned);/prog");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("-o").add(out).add(exampleOne(suite));
  if (!compileQuietly(suite, command)) {
    return false;
  }

  return isExecutable(out) && !exists(joinPath(suite.work, "pwned")) &&
         printsZero(out);
}

// -l reaches the linker: a library that exists links, and one that does not
// fails the build.
fn checkLinkFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/linked");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };

  let linked: *TextList = TextList.new().add(suite.compiler);
  linked.add("-lm").add("-o").add(out).add(exampleOne(suite));
  let missing: *TextList = TextList.new().add(suite.compiler);
  missing.add("-lode_no_such_library").add("-o").add(out).add(exampleOne(suite));

  return compileQuietly(suite, linked) && printsZero(out) &&
         !compileQuietly(suite, missing);
}

// Building for another machine works as far as the object file, which needs
// nothing of that machine's but clang's backend for it.
fn checkObjectForTarget(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/target/prog");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--target").add("aarch64-linux").add("--emit-object");
  command.add("-o").add(out).add(exampleOne(suite));
  let unknown: *TextList = TextList.new().add(suite.compiler);
  unknown.add("--target").add("x86_64-windows").add("--emit-object");
  unknown.add("-o").add(out).add(exampleOne(suite));

  return compileQuietly(suite, command) && exists(withSuffix(out, ".o")) &&
         !exists(out) && !exists(withSuffix(out, ".ll")) &&
         !compileQuietly(suite, unknown);
}

// `ode build` in a directory with a build.ode builds what it declares,
// reading the options it is given, into build/ beside it.
fn checkBuildFile(suite: *Suite): bool {
  let project: *i8 = joinPath(suite.work, "cli/project");
  makeDirectories(project) catch (e) {
    return false;
  };
  let source: *Builder = Builder.new();
  source.add("import { Build } from \"std/build\";\n\n");
  source.add("export fn build(b: *Build): void {\n");
  source.add("  b.executable(b.option(\"name\") ?? \"zero\", \"");
  source.add(exampleOne(suite));
  source.add("\");\n}\n");
  writeFile(joinPath(project, "build.ode"), source.take()) catch (e) {
    return false;
  };

  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("build").add("-Dname=renamed");
  if (!ran(runCommand(command, project, Builder.new(), StderrMode.Merge))) {
    return false;
  }
  return printsZero(joinPath(project, "build/renamed")) &&
         !exists(joinPath(project, "build/zero"));
}

// A Linux executable builds from anywhere, against the musl Ode bundles, and
// on x86_64 Linux it runs.
fn checkLinuxExecutable(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/linux/prog");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };
  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--target").add("x86_64-linux").add("-o").add(out);
  command.add(exampleOne(suite));
  if (!ran(runCommand(command, null, null, StderrMode.Inherit))) {
    return false;
  }

  let binary: *Builder = readBytes(out) catch (e) {
    return false;
  };
  if (binary.length < 4 || binary.data[0] != 127 || binary.data[1] != 'E' ||
      binary.data[2] != 'L' || binary.data[3] != 'F') {
    return false;
  }
  let host: *Builder = Builder.new();
  runCommand(TextList.new().add("uname").add("-sm"), null, host,
             StderrMode.Discard) ?? 1;
  if (equals(host.data, "Linux x86_64\n")) {
    return printsZero(out);
  }
  return true;
}

// A wasm module builds with no C library and no entry point, exporting
// what the entry file exports.
fn checkWasmModule(suite: *Suite): bool {
  let directory: *i8 = joinPath(suite.work, "cli/wasm");
  makeDirectories(directory) catch (e) {
    return false;
  };
  let source: *i8 = joinPath(directory, "add.ode");
  writeFile(source, "export fn add(a: i32, b: i32): i32 {\n  return a + b;\n}\n")
      catch (e) {
    return false;
  };
  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--target").add("wasm32").add(source);
  if (!ran(runCommand(command, directory, null, StderrMode.Inherit))) {
    return false;
  }

  let module: *Builder = readBytes(joinPath(directory, "add.wasm")) catch (e) {
    return false;
  };
  // `\0asm`, and somewhere after it the export's name.
  return module.length > 8 && module.data[0] == 0 && module.data[1] == 'a' &&
         module.data[2] == 's' && module.data[3] == 'm' &&
         holdsBytes(module, "add");
}

fn holdsBytes(data: *Builder, text: *i8): bool {
  let count: i64 = strlen(text);
  let start: i64 = 0;
  while (start + count <= data.length) {
    let index: i64 = 0;
    while (index < count && data.data[start + index] == text[index]) {
      index = index + 1;
    }
    if (index == count) {
      return true;
    }
    start = start + 1;
  }
  return false;
}

// --release builds the same program, optimised.
fn checkReleaseFlag(suite: *Suite): bool {
  let out: *i8 = joinPath(suite.work, "cli/release/prog");
  makeDirectories(parentDirectory(out)) catch (e) {
    return false;
  };
  let command: *TextList = TextList.new().add(suite.compiler);
  command.add("--release").add("-o").add(out).add(exampleOne(suite));
  return compileQuietly(suite, command) && printsZero(out);
}

fn checkNoInputFile(suite: *Suite): bool {
  return !compileQuietly(suite, TextList.new().add(suite.compiler));
}

// The compiler's own tests, written beside the code they test. They pass or
// fail as a whole; what each printed is shown only on a failure.
fn runCompilerTests(suite: *Suite): void {
  suite.unitCount = suite.unitCount + 1;

  let output: *Builder = Builder.new();
  let run: *TextList = TextList.new().add(suite.compiler).add("test");
  run.add(joinPath(suite.root, "compiler"));
  if (ran(runCommand(run, suite.work, output, StderrMode.Merge))) {
    suite.pass("tests", "compiler");
    return;
  }

  suite.fail("tests", "compiler", "a test of the compiler failed");
  writeIndented(output);
}

// The standard library's tests, all of them in one run.
fn runLibraryTests(suite: *Suite, source: *i8, name: *i8): void {
  suite.unitCount = suite.unitCount + 1;

  let output: *Builder = Builder.new();
  let run: *TextList = TextList.new().add(suite.compiler).add("test");
  run.add(source);
  if (ran(runCommand(run, suite.work, output, StderrMode.Merge))) {
    suite.pass("tests", name);
    return;
  }

  suite.fail("tests", name, "a test failed");
  writeIndented(output);
}

// A directory is not a source file to compile; to test, it needs one.
fn checkDirectoryInput(suite: *Suite): bool {
  let output: *Builder = Builder.new();
  let compile: *TextList = TextList.new().add(suite.compiler);
  compile.add(joinPath(suite.root, "compiler"));
  if ((runCommand(compile, suite.work, output, StderrMode.Merge) ?? -1) != 1 ||
      !contains(output.data, "cannot open input file")) {
    return false;
  }

  let empty: *i8 = joinPath(suite.work, "empty-directory");
  makeDirectories(empty) catch (e) {
    return false;
  };
  output = Builder.new();
  let test: *TextList = TextList.new().add(suite.compiler).add("test");
  test.add(empty);
  return (runCommand(test, suite.work, output, StderrMode.Merge) ?? -1) == 1 &&
         contains(output.data, "no .ode files to test here");
}

// `ode test` with no file, or one that is not there, says so and fails.
fn checkTestWithoutInput(suite: *Suite): bool {
  let output: *Builder = Builder.new();
  let bare: *TextList = TextList.new().add(suite.compiler).add("test");
  if ((runCommand(bare, suite.work, output, StderrMode.Merge) ?? -1) != 2 ||
      !contains(output.data, "usage:")) {
    return false;
  }

  output = Builder.new();
  let missing: *TextList = TextList.new().add(suite.compiler).add("test");
  missing.add("no-such-file.ode");
  return (runCommand(missing, suite.work, output, StderrMode.Merge) ?? -1) == 1 &&
         contains(output.data, "cannot open input file");
}

// A filter no test matches runs none, which is not a failure.
fn checkTestFilterMatchingNothing(suite: *Suite): bool {
  let output: *Builder = Builder.new();
  let run: *TextList = TextList.new().add(suite.compiler).add("test");
  run.add(joinPath(suite.root, "tests/runner/math.ode")).add("no test is named this");
  return ran(runCommand(run, suite.work, output, StderrMode.Merge)) &&
         contains(output.data, "0 passed; 0 failed; 5 filtered out");
}

fn runCli(suite: *Suite, name: *i8, passed: bool): void {
  if (passed) {
    suite.pass("cli", name);
  } else {
    suite.fail("cli", name, "check failed");
  }
}

// ---------------------------------------------------------------------------
// The command.
// ---------------------------------------------------------------------------

// Tests `compiler`, an `ode` binary, against the repository in `root`.
export fn commandTest(root: *i8, compiler: *i8, options: TestOptions): i32 {
  // The compiler under test may live anywhere, where it would not find the
  // repository's standard library on its own.
  setEnvironment("ODE_STD", joinPath(root, "std"));

  let work: *i8 = makeTempDirectory("ode-tests") catch (e) {
    complain("cannot create a temporary directory");
    return 1;
  };

  let suite: *Suite = alloc<Suite>(1);
  suite.root = root;
  suite.compiler = compiler;
  suite.work = work;
  suite.filter = options.filter;
  suite.update = options.update;
  suite.passed = 0;
  suite.failed = 0;
  suite.updated = 0;
  suite.exampleCount = 0;
  suite.unitCount = 0;
  suite.failures = TextList.new();
  suite.dim = "";
  suite.green = "";
  suite.red = "";
  suite.off = "";
  if (isTerminal(STDOUT)) {
    suite.dim = colour("2");
    suite.green = colour("32");
    suite.red = colour("31");
    suite.off = colour("0");
  }

  let examples: *i8 = joinPath(root, "examples");
  let expectedExamples: *i8 = joinPath(root, "tests/examples");
  makeDirectories(expectedExamples) catch (e) {
    complain("cannot make tests/examples");
    return 1;
  };
  let names: *TextList = listDirectory(examples);
  for (index in 0..names.size()) {
    let file: *i8 = names.at(index);
    if (endsWith(file, ".ode") && suite.selected(withoutExtension(file))) {
      let name: *i8 = withoutExtension(file);
      runProgramCase(suite, "example", joinPath(examples, file), name,
                     withSuffix(joinPath(expectedExamples, name), ".out"));
    }
  }

  let units: *i8 = joinPath(root, "tests/runner");
  names = listDirectory(units);
  for (index in 0..names.size()) {
    let file: *i8 = names.at(index);
    if (endsWith(file, ".ode") && suite.selected(withoutExtension(file))) {
      runRunnerCase(suite, joinPath(units, file), withoutExtension(file));
    }
  }

  if (suite.selected("compiler")) {
    runCompilerTests(suite);
  }

  if (suite.selected("std")) {
    runLibraryTests(suite, joinPath(root, "std"), "std");
  }

  if (suite.selected("output-flag")) {
    runCli(suite, "output-flag", checkOutputFlag(suite));
  }
  if (suite.selected("keep-intermediates-flag")) {
    runCli(suite, "keep-intermediates-flag", checkKeepIntermediatesFlag(suite));
  }
  if (suite.selected("hostile-output-path")) {
    runCli(suite, "hostile-output-path", checkHostileOutputPath(suite));
  }
  if (suite.selected("link-flag")) {
    runCli(suite, "link-flag", checkLinkFlag(suite));
  }
  if (suite.selected("object-for-target")) {
    runCli(suite, "object-for-target", checkObjectForTarget(suite));
  }
  if (suite.selected("linux-executable")) {
    runCli(suite, "linux-executable", checkLinuxExecutable(suite));
  }
  if (suite.selected("wasm-module")) {
    runCli(suite, "wasm-module", checkWasmModule(suite));
  }
  if (suite.selected("release-flag")) {
    runCli(suite, "release-flag", checkReleaseFlag(suite));
  }
  if (suite.selected("build-file")) {
    runCli(suite, "build-file", checkBuildFile(suite));
  }
  if (suite.selected("no-input-file")) {
    runCli(suite, "no-input-file", checkNoInputFile(suite));
  }
  if (suite.selected("directory-input")) {
    runCli(suite, "directory-input", checkDirectoryInput(suite));
  }
  if (suite.selected("test-without-input")) {
    runCli(suite, "test-without-input", checkTestWithoutInput(suite));
  }
  if (suite.selected("test-filter-matching-nothing")) {
    runCli(suite, "test-filter-matching-nothing",
           checkTestFilterMatchingNothing(suite));
  }

  removeTree(work);

  let summary: *Builder = Builder.new();
  summary.push('\n');
  if (suite.update) {
    summary.addInt(suite.exampleCount as i64);
    summary.add(" example, ");
    summary.addInt(suite.unitCount as i64);
    summary.add(" runner: ");
    summary.addInt(suite.updated as i64);
    summary.add(" expectation(s) rewritten\n");
  }

  if (suite.failed == 0) {
    summary.add(suite.green);
    summary.add("all ");
    summary.addInt(suite.passed as i64);
    summary.add(" checks passed");
    summary.add(suite.off);
    summary.add(" (");
    summary.addInt(suite.exampleCount as i64);
    summary.add(" example, ");
    summary.addInt(suite.unitCount as i64);
    summary.add(" runner and test runs)\n");
    writeBuilder(STDOUT, summary);
    return 0;
  }

  summary.add(suite.red);
  summary.addInt(suite.failed as i64);
  summary.add(" of ");
  summary.addInt((suite.passed + suite.failed) as i64);
  summary.add(" checks failed");
  summary.add(suite.off);
  summary.push('\n');

  let index: i32 = 0;
  while (index < suite.failures.size()) {
    summary.add("  ");
    summary.add(suite.failures.at(index));
    summary.push('\n');
    index = index + 1;
  }
  writeBuilder(STDOUT, summary);

  return 1;
}
