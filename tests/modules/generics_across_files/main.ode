// A generic declared in one file, instantiated in another with a struct that
// file declares, and called through an alias. lib.ode has a private Point of
// its own, which its generic must not confuse with this one.

import { Stack, peekOr as top } from "./lib";

struct Point {
  x: i32,
  y: i32,
}

fn main(): i32 {
  let points: *Stack<Point> = Stack<Point>.new();
  points.push(Point { x: 1, y: 2 });
  points.push(Point { x: 3, y: 4 });
  printf("%d\n", points.peek().y);
  printf("%d\n", top<i32>(Stack<i32>.new(), 42));
  printf("%d\n", points.origin().x);
  return 0;
}

extern fn printf(format: *i8, ...): i32;
