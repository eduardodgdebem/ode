extern fn malloc(size: i64): *i8;

struct Point {
  x: i32,
}

export struct Stack<T> {
  items: *T,
  count: i32,

  fn new(): *Stack<T> {
    let stack: *Stack<T> = malloc(sizeof(Stack<T>) as i64) as *Stack<T>;
    stack.items = malloc(sizeof(T) as i64 * 16 as i64) as *T;
    stack.count = 0;
    return stack;
  }

  fn push(self: *Stack<T>, item: T): void {
    self.items[self.count] = item;
    self.count = self.count + 1;
  }

  fn peek(self: *Stack<T>): T {
    return self.items[self.count - 1];
  }

  // This file's Point, whatever T is.
  fn origin(self: *Stack<T>): Point {
    return Point { x: 100 };
  }
}

export fn peekOr<T>(stack: *Stack<T>, fallback: T): T {
  if (stack.count == 0) {
    return fallback;
  }
  return stack.peek();
}
