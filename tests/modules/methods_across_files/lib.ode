struct Box {
  value: i32,

  fn get(self: Box): i32 {
    return self.value * 100;
  }
}

export struct Counter {
  total: i32,

  fn start(at: i32): Counter {
    return Counter { total: at };
  }

  fn add(self: *Counter, amount: i32): void {
    self.total = self.total + amount;
  }

  fn boxed(self: Counter): i32 {
    return Box { value: self.total }.get();
  }
}

export fn makeTally(): Counter {
  return Counter.start(3);
}
