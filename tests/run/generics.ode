// Generics: structs and functions with type parameters, made into one
// instance per distinct set of type arguments.

extern fn printf(format: *i8, ...): i32;

extern fn malloc(size: i64): *i8;
extern fn realloc(block: *i8, size: i64): *i8;

struct List<T> {
  items: *T,
  count: i32,
  capacity: i32,

  fn new(): *List<T> {
    let list: *List<T> = malloc(sizeof(List<T>) as i64) as *List<T>;
    list.capacity = 4;
    list.count = 0;
    list.items = malloc(sizeof(T) as i64 * 4 as i64) as *T;
    return list;
  }

  fn push(self: *List<T>, item: T): void {
    if (self.count == self.capacity) {
      self.capacity = self.capacity * 2;
      self.items = realloc(self.items as *i8,
                           sizeof(T) as i64 * self.capacity as i64) as *T;
    }
    self.items[self.count] = item;
    self.count = self.count + 1;
  }

  fn at(self: *List<T>, index: i32): T {
    return self.items[index];
  }
}

struct Pair<A, B> {
  first: A,
  second: B,
}

fn max<T>(a: T, b: T): T {
  if (a > b) {
    return a;
  }
  return b;
}

// Generic code calling generic code, with its own parameter as the argument.
fn sumOf<T>(list: *List<T>, zero: T): T {
  let total: T = zero;
  for (i in 0..list.count) {
    total = total + list.at(i);
  }
  return total;
}

fn swap<A, B>(pair: Pair<A, B>): Pair<B, A> {
  return Pair<B, A> { first: pair.second, second: pair.first };
}

fn main(): i32 {
  let numbers: *List<i32> = List<i32>.new();
  for (i in 0..10) {
    numbers.push(i * i);
  }
  printf("%d\n", numbers.at(9));
  printf("%d\n", numbers.count);

  let words: *List<*i8> = List<*i8>.new();
  words.push("hello");
  words.push("generics");
  printf("%s\n", words.at(1));

  let p: Pair<i32, bool> = Pair<i32, bool> { first: 7, second: true };
  printf("%d\n", p.first);
  printf("%d\n", p.second);

  let pairs: *List<Pair<i32, bool>> = List<Pair<i32, bool>>.new();
  pairs.push(p);
  printf("%d\n", pairs.at(0).first);

  printf("%d\n", sumOf<i32>(numbers, 0));

  let swapped: Pair<bool, i32> = swap<i32, bool>(p);
  printf("%d\n", swapped.second);

  printf("%d\n", max<i32>(3, 9));
  printf("%f\n", max<f64>(2.5 as f64, 1.5 as f64));
  return 0;
}
