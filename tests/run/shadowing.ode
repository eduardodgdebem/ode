// A name declared in a nested block is a new variable, and the outer one of
// the same name is untouched once the block ends. Parameters shadow the same
// way, and a `let` may read the variable it shadows in its own initialiser.

extern fn printf(format: *i8, ...): i32;

fn shadowParam(x: i32): i32 {
  {
    let x: i32 = 99;
    printf("%d\n", x);
  }

  return x;
}

fn shadowInLoop(n: i32): i32 {
  let total: i32 = 0;
  let i: i32 = 0;

  while (i < n) {
    let total: i32 = i * 100;
    printf("%d\n", total);
    i = i + 1;
  }

  return total;
}

fn readsWhatItShadows(x: i32): i32 {
  {
    let x: i32 = x + 1;
    printf("%d\n", x);
  }

  return x;
}

fn main(): i32 {
  let x: i32 = 1;

  {
    let x: i32 = 99;
    {
      let x: i32 = 7;
      printf("%d\n", x);
    }
    printf("%d\n", x);
  }

  printf("%d\n", x);

  if (true) {
    let x: bool = false;
    printf("%d\n", x);
  }

  printf("%d\n", x);
  printf("%d\n", shadowParam(1));
  printf("%d\n", shadowInLoop(3));
  printf("%d\n", readsWhatItShadows(41));

  return 0;
}
