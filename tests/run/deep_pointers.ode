// `.` follows however many pointers stand between it and the struct.

extern fn printf(format: *i8, ...): i32;

struct Point {
  x: i32,
  y: i32,

  fn sum(self: Point): i32 {
    return self.x + self.y;
  }

  fn shift(self: *Point, by: i32): void {
    self.x = self.x + by;
  }
}

fn main(): i32 {
  let point: Point = Point { x: 1, y: 2 };
  let one: *Point = &point;
  let two: **Point = &one;
  let three: ***Point = &two;

  printf("%d\n", two.x);
  printf("%d\n", three.y);

  three.x = 10;
  printf("%d\n", point.x);

  two.shift(5);
  printf("%d\n", point.x);
  printf("%d\n", three.sum());

  return 0;
}
