// A C function that takes `...` is declared with it, and called with any
// number of arguments after the ones it names.

extern fn printf(format: *i8, ...): i32;
extern fn snprintf(buffer: *i8, size: u64, format: *i8, ...): i32;
extern fn malloc(size: i64): *i8;

enum Shade { Light, Dark }

fn main(): i32 {
  let small: i8 = -5;
  let byte: u8 = 250;
  let half: f32 = 0.5;
  let wide: i64 = 9000000000;

  printf("plain\n");
  printf("%d %u %d %lld\n", small, byte, true, wide);
  printf("%.2f %.3f %s\n", half, 2.25, "text");
  printf("%d %c\n", Shade.Dark, 'x');

  let buffer: *i8 = malloc(32);
  let written: i32 = snprintf(buffer, 32, "%d-%d", 4, 2);
  printf("%s %d\n", buffer, written);

  return 0;
}
