// Taking addresses, reading and writing through pointers, and pointers to
// pointers.

extern fn printf(format: *i8, ...): i32;

fn increment(target: *i32): void {
  *target = *target + 1;
}

fn main(): i32 {
  let value: i32 = 41;
  let pointer: *i32 = &value;

  printf("%d\n", *pointer);

  // Writing through the pointer updates the variable it points at.
  *pointer = 100;
  printf("%d\n", value);

  increment(&value);
  printf("%d\n", value);

  let alias: **i32 = &pointer;
  printf("%d\n", **alias);

  return 0;
}
