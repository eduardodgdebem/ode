// Expressions used as statements, at the top level and inside a block, whose
// values are discarded; and a block's own scope.

extern fn printf(format: *i8, ...): i32;

(1+6);

fn main(): i32 {
  let num: i32 = 45;
  num = 46;

  {
    let x: i32 = 1;
    (x * num);
  }

  let a:i32 = 3;
  printf("%d\n", a);
}
