// A literal takes the type its context expects, so none of these needs `as`.

extern fn printf(format: *i8, ...): i32;

struct Pixel {
  red: u8,
  depth: i16,
  scale: f64,
}

fn widen(value: i64): i64 {
  return value * 1000000000 + 7;
}

fn half(value: f64): f64 {
  return value / 2;
}

fn main(): i32 {
  let small: i16 = -12;
  let big: i64 = 3000000000;
  let byte: u8 = 255;
  let letter: u8 = 'z';
  let ratio: f64 = 3;

  printf("%d\n", small);
  printf("%lld\n", big);
  printf("%u\n", byte);
  printf("%u\n", letter);
  printf("%f\n", ratio);

  // The other operand decides, from either side.
  printf("%lld\n", big + 1);
  printf("%lld\n", 2 * big);
  printf("%d\n", small < 0);
  printf("%d\n", byte == 255);
  printf("%lld\n", (big + 2) * 3 - 1);

  // So do parameters, returns, fields and assignments.
  printf("%lld\n", widen(5));
  printf("%f\n", half(5));
  let pixel: Pixel = Pixel { red: 200, depth: -3, scale: 1 };
  printf("%u\n", pixel.red);
  printf("%d\n", pixel.depth);
  printf("%f\n", pixel.scale);
  big = 1 << 40;
  printf("%lld\n", big);

  // A character is a number too.
  let code: i32 = 'A';
  let digit: i32 = 7;
  printf("%d\n", code);
  printf("%d\n", '0' + digit);
  let tab: u8 = '\t';
  printf("%u\n", tab);

  // With nothing to go by, a literal is still an i32: this wraps.
  let wrapped: i64 = (2147483647 + 1) as i64;
  printf("%lld\n", wrapped);

  // Casts still read wide literals as themselves.
  printf("%lld\n", -3000000000 as i64);
  printf("%f\n", 3000000000 as f64);

  return 0;
}
