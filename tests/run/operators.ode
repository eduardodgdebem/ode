// Remainder, the bitwise operators, the shifts, compound assignment and
// unary plus. Every print is annotated with the value it should produce.

extern fn printf(format: *i8, ...): i32;

extern fn malloc(size: i64): *i8;
extern fn free(block: *i8): void;

struct Counter { hits: i32, }

fn main(): i32 {
  // Remainder. `srem` takes the sign of the left operand, `urem` never
  // produces a negative result.
  printf("%d\n", 17 % 5);                // 2
  printf("%d\n", -17 % 5);               // -2
  printf("%u\n", 250 as u8 % 7 as u8);   // 5

  // Bitwise and / or / xor. 12 is 1100 and 10 is 1010.
  printf("%d\n", 12 & 10);               // 8
  printf("%d\n", 12 | 10);               // 14
  printf("%d\n", 12 ^ 10);               // 6

  printf("%d\n", 1 << 10);               // 1024
  printf("%d\n", -16 >> 2);              // -4

  // `>>` copies the sign bit on a signed type and shifts zeros in on an
  // unsigned one, so the same bit pattern gives two different answers.
  printf("%d\n", -1 >> 4);               // -1
  printf("%u\n", 255 as u8 >> 4 as u8);  // 15
  printf("%llu\n", -1 as i64 as u64 >> 60 as u64);  // 15

  // Precedence follows C: shifts bind looser than `+` and tighter than the
  // comparisons, and `&` `^` `|` sit between equality and `&&`.
  printf("%d\n", 2 + 3 << 2);            // 20, i.e. (2 + 3) << 2
  printf("%d\n", 1 << 2 == 4);           // 1, i.e. (1 << 2) == 4
  printf("%d\n", 12 & 10 | 3 ^ 1);       // 10, i.e. (12 & 10) | (3 ^ 1)

  // A lone `&` is still address-of in unary position, and `&&` is still
  // logical and.
  let n: i32 = 6;
  let p: *i32 = &n;
  printf("%d\n", *p & 3);                // 2
  printf("%d\n", n > 5 && n < 10);       // 1

  // Unary plus is a no-op on any numeric operand.
  printf("%d\n", +7);                    // 7
  printf("%d\n", +n);                    // 6
  printf("%f\n", +2.5);                  // 2.500000

  // Compound assignment on a plain variable.
  let a: i32 = 10;
  a += 5;
  printf("%d\n", a);                     // 15
  a -= 3;
  printf("%d\n", a);                     // 12
  a *= 4;
  printf("%d\n", a);                     // 48
  a /= 5;
  printf("%d\n", a);                     // 9
  a %= 4;
  printf("%d\n", a);                     // 1

  // ... and on every other lvalue form: `*p`, `s.field` and `v[i]`.
  *p += 4;
  printf("%d\n", n);                     // 10

  let counter: Counter = Counter { hits: 7 };
  counter.hits *= 6;
  printf("%d\n", counter.hits);          // 42

  let values: *i32 = malloc(sizeof(i32) as i64 * 3 as i64) as *i32;
  values[0] = 100;
  values[1] = 100;
  values[2] = 100;
  values[1] -= 58;
  values[2] %= 7;
  printf("%d\n", values[0]);             // 100
  printf("%d\n", values[1]);             // 42
  printf("%d\n", values[2]);             // 2
  free(values as *i8);

  return 0;
}
