// Fields of fields of a struct a call returned, which has no address of its
// own: each is read out of the value.

import { printf } from "std/c";

struct Inner {
  value: i32,

  fn doubled(self: Inner): i32 {
    return self.value * 2;
  }
}

struct Outer {
  inner: Inner,
  tag: i8,
}

fn make(value: i32): Outer {
  return Outer { inner: Inner { value: value }, tag: 'x' };
}

fn main(): i32 {
  printf("%d\n", make(21).inner.value);
  printf("%d\n", make(4).inner.doubled());
  let outer: Outer = make(5);
  printf("%d %c\n", outer.inner.value, outer.tag);
  return 0;
}
