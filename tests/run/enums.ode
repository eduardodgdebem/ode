// Enums: named integer constants with a type of their own.

extern fn printf(format: *i8, ...): i32;

enum Color { Red, Green, Blue }

// Values count up from the one before, or from a value written out.
enum Status {
  Ok,
  NotFound = 404,
  Gone,
  Negative = -3,
  AfterNegative,
}

struct Pixel {
  x: i32,
  color: Color,
}

let DEFAULT: Color = Color.Green;

fn next(color: Color): Color {
  if (color == Color.Red) {
    return Color.Green;
  }
  if (color == Color.Green) {
    return Color.Blue;
  }
  return Color.Red;
}

fn main(): i32 {
  let c: Color = Color.Red;
  printf("%d\n", c == Color.Red);
  printf("%d\n", c != Color.Blue);

  c = next(next(c));
  printf("%d\n", c == Color.Blue);
  printf("%d\n", c as i32);

  printf("%d\n", Status.Ok as i32);
  printf("%d\n", Status.NotFound as i32);
  printf("%d\n", Status.Gone as i32);
  printf("%d\n", Status.Negative as i32);
  printf("%d\n", Status.AfterNegative as i32);

  // An integer converts to an enum only when asked.
  let fromNumber: Color = 1 as Color;
  printf("%d\n", fromNumber == Color.Green);

  // In a struct, a global, and as a sizeof.
  let pixel: Pixel = Pixel { x: 3, color: DEFAULT };
  printf("%d\n", pixel.color == Color.Green);
  printf("%llu\n", sizeof(Color));
  printf("%llu\n", sizeof(Pixel));

  // Through a pointer.
  let p: *Pixel = &pixel;
  p.color = Color.Blue;
  printf("%d\n", pixel.color == Color.Blue);

  return 0;
}
