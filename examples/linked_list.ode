// Heap-allocated nodes that point at their own type: `alloc<Node>` to make
// one, a pointer field for the link, and `.` following that pointer without
// an explicit dereference.

import { printf } from "std/c";
import { alloc, release } from "std/mem";

struct Node {
  value: i32,
  next: *Node,
}

fn makeNode(value: i32): *Node {
  let node: *Node = alloc<Node>(1);
  node.value = value;
  node.next = null;

  return node;
}

fn push(head: *Node, value: i32): *Node {
  let node: *Node = makeNode(value);
  node.next = head;

  return node;
}

fn sum(head: *Node): i32 {
  let total: i32 = 0;
  let current: *Node = head;

  while (current != null) {
    total = total + current.value;
    current = current.next;
  }

  return total;
}

fn length(head: *Node): i32 {
  let count: i32 = 0;
  let current: *Node = head;

  while (current != null) {
    count = count + 1;
    current = current.next;
  }

  return count;
}

fn releaseAll(head: *Node): void {
  let current: *Node = head;

  while (current != null) {
    let next: *Node = current.next;
    release<Node>(current);
    current = next;
  }
}

fn main(): i32 {
  let list: *Node = makeNode(1);
  list = push(list, 2);
  list = push(list, 3);

  printf("%d\n", length(list));
  printf("%d\n", sum(list));

  // Chained through two pointers.
  printf("%d\n", list.value);
  printf("%d\n", list.next.value);
  printf("%d\n", list.next.next.value);

  releaseAll(list);
  return 0;
}
