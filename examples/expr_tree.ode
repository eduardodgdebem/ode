// An expression tree: one struct with a kind and every field any kind of node
// needs, which is how Ode represents a sum type until enums can carry data.
// The kind is an enum, and evaluating a node is a match on it, so a new kind
// of node is a compile error at every match that does not handle it yet.

extern fn malloc(size: i64): *i8;

enum Kind { Number, Add, Multiply }

struct Expr {
  kind: Kind,
  value: i32,
  left: *Expr,
  right: *Expr,
}

// A global is writable from anywhere, which is what makes it useful for
// counters and interning tables.
let allocations: i32 = 0;

fn newExpr(kind: Kind): *Expr {
  allocations = allocations + 1;

  let node: *Expr = malloc(sizeof(Expr)) as *Expr;
  node.kind = kind;
  node.value = 0;
  node.left = null;
  node.right = null;

  return node;
}

fn number(value: i32): *Expr {
  let node: *Expr = newExpr(Kind.Number);
  node.value = value;

  return node;
}

fn binary(kind: Kind, left: *Expr, right: *Expr): *Expr {
  let node: *Expr = newExpr(kind);
  node.left = left;
  node.right = right;

  return node;
}

fn eval(node: *Expr): i32 {
  match (node.kind) {
    Kind.Number => {
      return node.value;
    }
    Kind.Add => {
      return eval(node.left) + eval(node.right);
    }
    Kind.Multiply => {
      return eval(node.left) * eval(node.right);
    }
  }

  return 0;
}

fn main(): i32 {
  // (2 + 3) * 4
  let tree: *Expr = binary(Kind.Multiply,
                           binary(Kind.Add, number(2), number(3)),
                           number(4));

  print(eval(tree));
  print(allocations);
  print(sizeof(Expr));

  return 0;
}
