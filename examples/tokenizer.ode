// A miniature lexer, which is what `else if`, `break` and `continue` exist
// for: dispatching on a character without nesting one block per case, and
// steering a scan loop.

extern fn strlen(text: *i8): i64;

let KIND_NUMBER: i32 = 1;
let KIND_IDENT: i32 = 2;
let KIND_OPERATOR: i32 = 3;
let KIND_UNKNOWN: i32 = 4;

fn isDigit(c: i8): bool {
  return c >= '0' && c <= '9';
}

fn isAlpha(c: i8): bool {
  if (c >= 'a' && c <= 'z') {
    return true;
  }

  return c >= 'A' && c <= 'Z';
}

fn isSpace(c: i8): bool {
  return c == ' ' || c == '\t' || c == '\n';
}

fn isOperator(c: i8): bool {
  return c == '+' || c == '-' || c == '*' || c == '/' || c == '=';
}

fn classify(c: i8): i32 {
  if (isDigit(c)) {
    return KIND_NUMBER;
  } else if (isAlpha(c)) {
    return KIND_IDENT;
  } else if (isOperator(c)) {
    return KIND_OPERATOR;
  } else {
    return KIND_UNKNOWN;
  }
}

fn printKind(kind: i32): void {
  if (kind == KIND_NUMBER) {
    print("number");
    // A bare return, which only a void function may write.
    return;
  } else if (kind == KIND_IDENT) {
    print("ident");
    return;
  } else if (kind == KIND_OPERATOR) {
    print("operator");
    return;
  }

  print("unknown");
}

fn tokenize(source: *i8): i32 {
  let length: i64 = strlen(source);
  let i: i64 = 0 as i64;
  let count: i32 = 0;

  while (i < length) {
    let c: i8 = source[i];

    if (isSpace(c)) {
      i = i + 1 as i64;
      continue;
    }

    if (c == '#') {
      break;
    }

    let kind: i32 = classify(c);
    count = count + 1;
    printKind(kind);

    // Consume the whole run of this kind. Written as a chain rather than one
    // condition because `&&` does not short-circuit yet, so every operand
    // would be evaluated even past the end of the string.
    let scanning: bool = true;
    while (scanning) {
      if (i >= length) {
        scanning = false;
      } else if (isSpace(source[i])) {
        scanning = false;
      } else if (classify(source[i]) != kind) {
        scanning = false;
      } else {
        i = i + 1 as i64;
      }
    }
  }

  return count;
}

fn main(): i32 {
  print(tokenize("foo + 42 * bar # ignored"));

  return 0;
}
