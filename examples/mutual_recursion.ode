// `isEven` calls `isOdd`, which is declared after it. Before the compiler
// hoisted function signatures this program could not be compiled at all,
// which also ruled out writing a recursive-descent parser in Ode.

fn isEven(n: i32): bool {
  if (n == 0) {
    return true;
  }

  return isOdd(n - 1);
}

fn isOdd(n: i32): bool {
  if (n == 0) {
    return false;
  }

  return isEven(n - 1);
}

fn main(): i32 {
  print(isEven(10));
  print(isOdd(10));
  print(isEven(7));
  print(isOdd(7));

  return 0;
}
