// Modules: one file per module, TypeScript-style imports.
//
// A file's top-level names are its own unless it exports them, and another
// file sees them only by importing them by name. The files this one imports
// live in examples/modules/.

import { Vec2, vecAdd, vecScale, lengthSquared as len2 } from "./modules/geometry";
import { counterNext, counterValue } from "./modules/counter";

// geometry.ode has a private `helper` and counter.ode a private `Pair` of its
// own. Neither collides with these.
fn helper(): i32 {
  return 1;
}

struct Pair {
  left: i32,
  right: i32,
}

// Declared here and in counter.ode as well; the IR gets one declaration.
extern fn putchar(character: i32): i32;

fn main(): i32 {
  let a: Vec2 = Vec2 { x: 3, y: 4 };
  let b: Vec2 = vecAdd(a, Vec2 { x: 1, y: 1 });
  print(b.x);
  print(b.y);
  print(len2(a));
  print(vecScale(a, 2).y);

  let pair: Pair = Pair { left: helper(), right: 2 };
  print(pair.left + pair.right);

  counterNext();
  counterNext();
  print(counterNext());
  print(counterValue());

  putchar(79);
  putchar(75);
  putchar(10);

  return 0;
}
