// `&&` evaluates its right operand only when the left is true, and `||` only
// when the left is false. A counter incremented by the right operand makes
// that observable.

extern fn strlen(text: *i8): i64;

let calls: i32 = 0;

fn track(result: bool): bool {
  calls = calls + 1;

  return result;
}

fn main(): i32 {
  calls = 0;
  print(false && track(true));
  print(calls);

  calls = 0;
  print(true || track(true));
  print(calls);

  calls = 0;
  print(true && track(false));
  print(calls);

  calls = 0;
  print(false || track(true));
  print(calls);

  // Nesting: the outer && stops before the inner || runs at all.
  calls = 0;
  print(false && (track(true) || track(true)));
  print(calls);

  // The guard idiom this exists for: without short-circuiting, `text[i]`
  // would be read even once `i` has run past the end of the string.
  let text: *i8 = "abc";
  let length: i64 = strlen(text);
  let i: i64 = 0 as i64;
  let letters: i32 = 0;

  while (i < length && text[i] != '\0') {
    letters = letters + 1;
    i = i + 1 as i64;
  }
  print(letters);

  return 0;
}
