// ---------------------------------------------------------------------------
// Prelude: libc, memory, growable text, failure.
//
// Every other module of the compiler imports from this one. Declaration order
// does not matter: signatures, globals and struct names are all hoisted
// before any body is checked.
// ---------------------------------------------------------------------------

import { SOURCE_PATH } from "./main";

export extern fn malloc(size: i64): *i8;
export extern fn realloc(block: *i8, size: i64): *i8;
export extern fn free(block: *i8): void;
export extern fn memcpy(dest: *i8, source: *i8, count: i64): *i8;
export extern fn strlen(text: *i8): i64;
extern fn strcmp(a: *i8, b: *i8): i32;
extern fn write(fd: i32, buffer: *i8, count: i64): i64;
extern fn exit(code: i32): void;
export extern fn fopen(path: *i8, mode: *i8): *i8;
export extern fn fclose(stream: *i8): i32;
export extern fn fread(buffer: *i8, size: i64, count: i64, stream: *i8): i64;
export extern fn fwrite(buffer: *i8, size: i64, count: i64, stream: *i8): i64;
extern fn fseek(stream: *i8, offset: i64, whence: i32): i32;
extern fn ftell(stream: *i8): i64;
export extern fn remove(path: *i8): i32;

export let STDOUT: i32 = 1;
export let STDERR: i32 = 2;
let SEEK_SET: i32 = 0;
let SEEK_END: i32 = 2;

// Every null is written out per type, because there is no generic null and
// `.` will not follow an untyped pointer.
export fn nullText(): *i8 {
  return 0 as i64 as *i8;
}

export fn isNullText(pointer: *i8): bool {
  return pointer == nullText();
}

// ---------------------------------------------------------------------------
// Output. There is no variadic extern, so nothing here goes through printf.
// ---------------------------------------------------------------------------

export fn writeText(fd: i32, text: *i8): void {
  write(fd, text, strlen(text));
}

// Buffers are written by their own length, because strlen would stop at the
// first NUL and silently truncate anything holding a `'\0'`.
export fn writeBuf(fd: i32, buffer: *Buf): void {
  write(fd, buffer.data, buffer.length);
}

fn print2(a: *i8, b: *i8): void {
  writeText(STDOUT, a);
  writeText(STDOUT, b);
}

// ---------------------------------------------------------------------------
// Growable, NUL-terminated text. Every diagnostic and every line of emitted
// IR is built in one of these.
// ---------------------------------------------------------------------------

export struct Buf {
  data: *i8,
  length: i64,
  capacity: i64,

  fn new(): *Buf {
    let buffer: *Buf = malloc(sizeof(Buf) as i64) as *Buf;
    buffer.capacity = 64 as i64;
    buffer.length = 0 as i64;
    buffer.data = malloc(buffer.capacity);
    buffer.data[0] = 0 as i8;

    return buffer;
  }

  fn reserve(self: *Buf, extra: i64): void {
    // One spare byte is always kept for the terminator.
    let needed: i64 = self.length + extra + 1 as i64;

    if (needed <= self.capacity) {
      return;
    }

    while (self.capacity < needed) {
      self.capacity = self.capacity * 2 as i64;
    }

    self.data = realloc(self.data, self.capacity);
  }

  fn push(self: *Buf, character: i8): void {
    self.reserve(1 as i64);
    self.data[self.length] = character;
    self.length = self.length + 1 as i64;
    self.data[self.length] = 0 as i8;
  }

  // Appends a known number of bytes, which is the only way to carry text that
  // contains a NUL -- a `'\0'` literal, or a string with one written into it.
  fn addBytes(self: *Buf, text: *i8, count: i64): void {
    self.reserve(count);
    memcpy(self.data + self.length, text, count);
    self.length = self.length + count;
    self.data[self.length] = 0 as i8;
  }

  fn add(self: *Buf, text: *i8): void {
    self.addBytes(text, strlen(text));
  }

  // Decimal, written out by hand because printf cannot be declared.
  fn addInt(self: *Buf, value: i64): void {
    if (value == 0 as i64) {
      self.push('0');
      return;
    }

    let rest: i64 = value;
    if (rest < 0 as i64) {
      self.push('-');
      rest = 0 as i64 - rest;
    }

    // At most 20 digits fit in an i64, and they come out backwards.
    let digits: *i8 = malloc(24 as i64);
    let count: i32 = 0;

    while (rest > 0 as i64) {
      digits[count] = ('0' as i64 + rest % 10 as i64) as i8;
      rest = rest / 10 as i64;
      count = count + 1;
    }

    while (count > 0) {
      count = count - 1;
      self.push(digits[count]);
    }

    free(digits);
  }

  fn free(self: *Buf): void {
    free(self.data);
    free(self as *i8);
  }

  // Detaches the text so it outlives the buffer.
  fn take(self: *Buf): *i8 {
    let text: *i8 = self.data;
    free(self as *i8);

    return text;
  }
}

export fn nullBuf(): *Buf {
  return 0 as i64 as *Buf;
}

// ---------------------------------------------------------------------------
// Text helpers.
// ---------------------------------------------------------------------------

export fn textEquals(a: *i8, b: *i8): bool {
  return strcmp(a, b) == 0;
}

export fn textCopy(text: *i8): *i8 {
  let count: i64 = strlen(text);
  let copy: *i8 = malloc(count + 1 as i64);
  memcpy(copy, text, count);
  copy[count] = 0 as i8;

  return copy;
}

export fn textSlice(text: *i8, start: i64, count: i64): *i8 {
  let copy: *i8 = malloc(count + 1 as i64);
  memcpy(copy, text + start, count);
  copy[count] = 0 as i8;

  return copy;
}

export fn intToText(value: i64): *i8 {
  let buffer: *Buf = Buf.new();
  buffer.addInt(value);

  return buffer.take();
}

// ---------------------------------------------------------------------------
// Diagnostics.
//
// Ode has no exceptions, so a phase cannot unwind out of a failed construct
// the way the C++ compiler does. Instead `FAILED` is raised, every function
// on the way out returns promptly, and the phase's statement loop clears it
// and moves to the next statement. While it is raised no further diagnostic
// is recorded, so one mistake produces one message.
// ---------------------------------------------------------------------------

struct Diagnostic {
  // The file being worked on when it was reported.
  path: *i8,
  message: *i8,
  line: i32,
  column: i32,
}

export struct Diagnostics {
  items: *Diagnostic,
  count: i32,
  capacity: i32,
  // Everything reported, including any past the limit that was not kept.
  total: i32,

  fn new(): *Diagnostics {
    let bag: *Diagnostics = malloc(sizeof(Diagnostics) as i64) as *Diagnostics;
    bag.capacity = DIAG_LIMIT;
    bag.count = 0;
    bag.total = 0;
    bag.items =
        malloc(sizeof(Diagnostic) as i64 * bag.capacity as i64) as *Diagnostic;

    return bag;
  }
}

// Past this many the list stops being useful and starts being noise.
let DIAG_LIMIT: i32 = 20;

export let DIAGS: *Diagnostics = 0 as i64 as *Diagnostics;
// Raised by the construct that failed, lowered by whatever recovers from it.
export let FAILED: bool = false;

export fn report(line: i32, column: i32, message: *i8): void {
  // The first message about a construct is the one worth keeping; anything
  // after it is the same mistake seen from further away.
  if (FAILED) {
    return;
  }
  FAILED = true;

  DIAGS.total = DIAGS.total + 1;
  if (DIAGS.count >= DIAGS.capacity) {
    return;
  }

  DIAGS.items[DIAGS.count].path = SOURCE_PATH;
  DIAGS.items[DIAGS.count].message = message;
  DIAGS.items[DIAGS.count].line = line;
  DIAGS.items[DIAGS.count].column = column;
  DIAGS.count = DIAGS.count + 1;
}

export fn hasErrors(): bool {
  return DIAGS.total > 0;
}

// Prints everything recorded, in the same shape the C++ compiler uses.
export fn printDiagnostics(): void {
  let out: *Buf = Buf.new();
  let index: i32 = 0;

  while (index < DIAGS.count) {
    out.add(DIAGS.items[index].path);

    // A line of 0 means the position is unknown, which whole-program checks
    // report; those name the file alone.
    if (DIAGS.items[index].line > 0) {
      out.push(':');
      out.addInt(DIAGS.items[index].line as i64);
      out.push(':');
      out.addInt(DIAGS.items[index].column as i64);
    }

    out.add(": error: ");
    out.add(DIAGS.items[index].message);
    out.push('\n');
    index = index + 1;
  }

  // A single error reads better on its own; a count is only worth printing
  // once there is more than one thing to count.
  if (DIAGS.total > DIAGS.count) {
    out.addInt(DIAGS.total as i64);
    out.add(" errors generated, showing the first ");
    out.addInt(DIAGS.count as i64);
    out.add(".\n");
  } else if (DIAGS.total > 1) {
    out.addInt(DIAGS.total as i64);
    out.add(" errors generated.\n");
  }

  writeBuf(STDERR, out);
}

// ---------------------------------------------------------------------------
// Fatal failure, for the phases that do not recover: the lexer, and anything
// that has already been type-checked by the time codegen sees it.
// ---------------------------------------------------------------------------

export fn failAt(line: i32, column: i32, message: *i8): void {
  // A line of 0 means the position is unknown, which whole-program checks
  // report; those name the file alone rather than pointing at 0:0.
  if (line <= 0) {
    fail(message);
    return;
  }

  let out: *Buf = Buf.new();
  out.add(SOURCE_PATH);
  out.push(':');
  out.addInt(line as i64);
  out.push(':');
  out.addInt(column as i64);
  out.add(": error: ");
  out.add(message);
  out.push('\n');

  writeText(STDERR, out.data);
  exit(1);
}

export fn fail(message: *i8): void {
  let out: *Buf = Buf.new();
  out.add(SOURCE_PATH);
  out.add(": error: ");
  out.add(message);
  out.push('\n');

  writeText(STDERR, out.data);
  exit(1);
}

// ---------------------------------------------------------------------------
// Files.
// ---------------------------------------------------------------------------

export fn readFile(path: *i8): *i8 {
  let stream: *i8 = fopen(path, "r");
  if (isNullText(stream)) {
    return nullText();
  }

  fseek(stream, 0 as i64, SEEK_END);
  let size: i64 = ftell(stream);
  fseek(stream, 0 as i64, SEEK_SET);

  let text: *i8 = malloc(size + 1 as i64);
  let count: i64 = fread(text, 1 as i64, size, stream);
  fclose(stream);
  text[count] = 0 as i8;

  return text;
}

export fn writeFile(path: *i8, text: *i8): bool {
  let stream: *i8 = fopen(path, "w");
  if (isNullText(stream)) {
    return false;
  }

  let count: i64 = strlen(text);
  let written: i64 = fwrite(text, 1 as i64, count, stream);
  fclose(stream);

  return written == count;
}
