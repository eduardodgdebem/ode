// ---------------------------------------------------------------------------
// Prelude: libc, memory, growable text, failure.
//
// Ode has no modules, so the compiler is one file. These sources are kept
// apart for reading and concatenated by selfhost/build.sh in name order.
// Declaration order does not matter: signatures, globals and struct names are
// all hoisted before any body is checked.
// ---------------------------------------------------------------------------

extern fn malloc(size: i64): *i8;
extern fn realloc(block: *i8, size: i64): *i8;
extern fn free(block: *i8): void;
extern fn memcpy(dest: *i8, source: *i8, count: i64): *i8;
extern fn strlen(text: *i8): i64;
extern fn strcmp(a: *i8, b: *i8): i32;
extern fn write(fd: i32, buffer: *i8, count: i64): i64;
extern fn exit(code: i32): void;
extern fn fopen(path: *i8, mode: *i8): *i8;
extern fn fclose(stream: *i8): i32;
extern fn fread(buffer: *i8, size: i64, count: i64, stream: *i8): i64;
extern fn fwrite(buffer: *i8, size: i64, count: i64, stream: *i8): i64;
extern fn fseek(stream: *i8, offset: i64, whence: i32): i32;
extern fn ftell(stream: *i8): i64;
extern fn remove(path: *i8): i32;
extern fn fork(): i32;
extern fn execvp(file: *i8, argv: **i8): i32;
extern fn waitpid(pid: i32, status: *i32, options: i32): i32;
extern fn _exit(code: i32): void;

let STDOUT: i32 = 1;
let STDERR: i32 = 2;
let SEEK_SET: i32 = 0;
let SEEK_END: i32 = 2;

// Every null is written out per type, because there is no generic null and
// `.` will not follow an untyped pointer.
fn nullText(): *i8 {
  return 0 as i64 as *i8;
}

fn isNullText(pointer: *i8): bool {
  return pointer == nullText();
}

// ---------------------------------------------------------------------------
// Output. There is no variadic extern, so nothing here goes through printf.
// ---------------------------------------------------------------------------

fn writeText(fd: i32, text: *i8): void {
  write(fd, text, strlen(text));
}

// Buffers are written by their own length, because strlen would stop at the
// first NUL and silently truncate anything holding a `'\0'`.
fn writeBuf(fd: i32, buffer: *Buf): void {
  write(fd, buffer.data, buffer.length);
}

fn print2(a: *i8, b: *i8): void {
  writeText(STDOUT, a);
  writeText(STDOUT, b);
}

// ---------------------------------------------------------------------------
// Growable, NUL-terminated text. Every diagnostic and every line of emitted
// IR is built in one of these.
// ---------------------------------------------------------------------------

struct Buf {
  data: *i8,
  length: i64,
  capacity: i64,
}

fn nullBuf(): *Buf {
  return 0 as i64 as *Buf;
}

fn bufNew(): *Buf {
  let buffer: *Buf = malloc(sizeof(Buf) as i64) as *Buf;
  buffer.capacity = 64 as i64;
  buffer.length = 0 as i64;
  buffer.data = malloc(buffer.capacity);
  buffer.data[0] = 0 as i8;

  return buffer;
}

fn bufReserve(buffer: *Buf, extra: i64): void {
  // One spare byte is always kept for the terminator.
  let needed: i64 = buffer.length + extra + 1 as i64;

  if (needed <= buffer.capacity) {
    return;
  }

  while (buffer.capacity < needed) {
    buffer.capacity = buffer.capacity * 2 as i64;
  }

  buffer.data = realloc(buffer.data, buffer.capacity);
}

fn bufPush(buffer: *Buf, character: i8): void {
  bufReserve(buffer, 1 as i64);
  buffer.data[buffer.length] = character;
  buffer.length = buffer.length + 1 as i64;
  buffer.data[buffer.length] = 0 as i8;
}

// Appends a known number of bytes, which is the only way to carry text that
// contains a NUL -- a `'\0'` literal, or a string with one written into it.
fn bufAddBytes(buffer: *Buf, text: *i8, count: i64): void {
  bufReserve(buffer, count);
  memcpy(buffer.data + buffer.length, text, count);
  buffer.length = buffer.length + count;
  buffer.data[buffer.length] = 0 as i8;
}

fn bufAdd(buffer: *Buf, text: *i8): void {
  bufAddBytes(buffer, text, strlen(text));
}

// Decimal, written out by hand because printf cannot be declared.
fn bufAddInt(buffer: *Buf, value: i64): void {
  if (value == 0 as i64) {
    bufPush(buffer, '0');
    return;
  }

  let rest: i64 = value;
  if (rest < 0 as i64) {
    bufPush(buffer, '-');
    rest = 0 as i64 - rest;
  }

  // At most 20 digits fit in an i64, and they come out backwards.
  let digits: *i8 = malloc(24 as i64);
  let count: i32 = 0;

  while (rest > 0 as i64) {
    digits[count] = ('0' as i64 + rest % 10 as i64) as i8;
    rest = rest / 10 as i64;
    count = count + 1;
  }

  while (count > 0) {
    count = count - 1;
    bufPush(buffer, digits[count]);
  }

  free(digits);
}

fn bufFree(buffer: *Buf): void {
  free(buffer.data);
  free(buffer as *i8);
}

// Detaches the text so it outlives the buffer.
fn bufTake(buffer: *Buf): *i8 {
  let text: *i8 = buffer.data;
  free(buffer as *i8);

  return text;
}

// ---------------------------------------------------------------------------
// Text helpers.
// ---------------------------------------------------------------------------

fn textEquals(a: *i8, b: *i8): bool {
  return strcmp(a, b) == 0;
}

fn textCopy(text: *i8): *i8 {
  let count: i64 = strlen(text);
  let copy: *i8 = malloc(count + 1 as i64);
  memcpy(copy, text, count);
  copy[count] = 0 as i8;

  return copy;
}

fn textSlice(text: *i8, start: i64, count: i64): *i8 {
  let copy: *i8 = malloc(count + 1 as i64);
  memcpy(copy, text + start, count);
  copy[count] = 0 as i8;

  return copy;
}

fn intToText(value: i64): *i8 {
  let buffer: *Buf = bufNew();
  bufAddInt(buffer, value);

  return bufTake(buffer);
}

// ---------------------------------------------------------------------------
// Diagnostics.
//
// Ode has no exceptions, so a phase cannot unwind out of a failed construct
// the way the C++ compiler does. Instead `FAILED` is raised, every function
// on the way out returns promptly, and the phase's statement loop clears it
// and moves to the next statement. While it is raised no further diagnostic
// is recorded, so one mistake produces one message.
// ---------------------------------------------------------------------------

struct Diagnostic {
  // The file being worked on when it was reported.
  path: *i8,
  message: *i8,
  line: i32,
  column: i32,
}

struct Diagnostics {
  items: *Diagnostic,
  count: i32,
  capacity: i32,
  // Everything reported, including any past the limit that was not kept.
  total: i32,
}

// Past this many the list stops being useful and starts being noise.
let DIAG_LIMIT: i32 = 20;

let DIAGS: *Diagnostics = 0 as i64 as *Diagnostics;
// Raised by the construct that failed, lowered by whatever recovers from it.
let FAILED: bool = false;

fn diagnosticsNew(): *Diagnostics {
  let bag: *Diagnostics = malloc(sizeof(Diagnostics) as i64) as *Diagnostics;
  bag.capacity = DIAG_LIMIT;
  bag.count = 0;
  bag.total = 0;
  bag.items =
      malloc(sizeof(Diagnostic) as i64 * bag.capacity as i64) as *Diagnostic;

  return bag;
}

fn report(line: i32, column: i32, message: *i8): void {
  // The first message about a construct is the one worth keeping; anything
  // after it is the same mistake seen from further away.
  if (FAILED) {
    return;
  }
  FAILED = true;

  DIAGS.total = DIAGS.total + 1;
  if (DIAGS.count >= DIAGS.capacity) {
    return;
  }

  DIAGS.items[DIAGS.count].path = SOURCE_PATH;
  DIAGS.items[DIAGS.count].message = message;
  DIAGS.items[DIAGS.count].line = line;
  DIAGS.items[DIAGS.count].column = column;
  DIAGS.count = DIAGS.count + 1;
}

fn hasErrors(): bool {
  return DIAGS.total > 0;
}

// Prints everything recorded, in the same shape the C++ compiler uses.
fn printDiagnostics(): void {
  let out: *Buf = bufNew();
  let index: i32 = 0;

  while (index < DIAGS.count) {
    bufAdd(out, DIAGS.items[index].path);

    // A line of 0 means the position is unknown, which whole-program checks
    // report; those name the file alone.
    if (DIAGS.items[index].line > 0) {
      bufPush(out, ':');
      bufAddInt(out, DIAGS.items[index].line as i64);
      bufPush(out, ':');
      bufAddInt(out, DIAGS.items[index].column as i64);
    }

    bufAdd(out, ": error: ");
    bufAdd(out, DIAGS.items[index].message);
    bufPush(out, '\n');
    index = index + 1;
  }

  // A single error reads better on its own; a count is only worth printing
  // once there is more than one thing to count.
  if (DIAGS.total > DIAGS.count) {
    bufAddInt(out, DIAGS.total as i64);
    bufAdd(out, " errors generated, showing the first ");
    bufAddInt(out, DIAGS.count as i64);
    bufAdd(out, ".\n");
  } else if (DIAGS.total > 1) {
    bufAddInt(out, DIAGS.total as i64);
    bufAdd(out, " errors generated.\n");
  }

  writeBuf(STDERR, out);
}

// ---------------------------------------------------------------------------
// Fatal failure, for the phases that do not recover: the lexer, and anything
// that has already been type-checked by the time codegen sees it.
// ---------------------------------------------------------------------------

fn failAt(line: i32, column: i32, message: *i8): void {
  // A line of 0 means the position is unknown, which whole-program checks
  // report; those name the file alone rather than pointing at 0:0.
  if (line <= 0) {
    fail(message);
    return;
  }

  let out: *Buf = bufNew();
  bufAdd(out, SOURCE_PATH);
  bufPush(out, ':');
  bufAddInt(out, line as i64);
  bufPush(out, ':');
  bufAddInt(out, column as i64);
  bufAdd(out, ": error: ");
  bufAdd(out, message);
  bufPush(out, '\n');

  writeText(STDERR, out.data);
  exit(1);
}

fn fail(message: *i8): void {
  let out: *Buf = bufNew();
  bufAdd(out, SOURCE_PATH);
  bufAdd(out, ": error: ");
  bufAdd(out, message);
  bufPush(out, '\n');

  writeText(STDERR, out.data);
  exit(1);
}

// ---------------------------------------------------------------------------
// Running another program.
//
// `system` would hand the command to a shell, which would then need every
// path quoted against spaces and metacharacters. Handing execvp an argument
// vector removes the shell, and with it the quoting: each argument arrives
// exactly as written.
// ---------------------------------------------------------------------------

// Returns the exit status, or -1 if the process could not be run or died on
// a signal.
fn runProgram(argv: **i8): i32 {
  let pid: i32 = fork();

  if (pid == 0) {
    execvp(argv[0], argv);
    // Only reached when exec failed. The child must not return into the
    // parent's code, and must not flush the parent's buffers on the way out.
    _exit(127);
  }

  if (pid < 0) {
    return -1;
  }

  let status: *i32 = malloc(sizeof(i32) as i64) as *i32;
  waitpid(pid, status, 0);

  // WIFEXITED and WEXITSTATUS are macros in C, so they are written out here.
  if ((*status & 127) != 0) {
    return -1;
  }

  return (*status >> 8) & 255;
}

// ---------------------------------------------------------------------------
// Files.
// ---------------------------------------------------------------------------

fn readFile(path: *i8): *i8 {
  let stream: *i8 = fopen(path, "r");
  if (isNullText(stream)) {
    return nullText();
  }

  fseek(stream, 0 as i64, SEEK_END);
  let size: i64 = ftell(stream);
  fseek(stream, 0 as i64, SEEK_SET);

  let text: *i8 = malloc(size + 1 as i64);
  let count: i64 = fread(text, 1 as i64, size, stream);
  fclose(stream);
  text[count] = 0 as i8;

  return text;
}

fn writeFile(path: *i8, text: *i8): bool {
  let stream: *i8 = fopen(path, "w");
  if (isNullText(stream)) {
    return false;
  }

  let count: i64 = strlen(text);
  let written: i64 = fwrite(text, 1 as i64, count, stream);
  fclose(stream);

  return written == count;
}
