// ---------------------------------------------------------------------------
// Driver.
//
// The phases the port has reached, behind the same flags the C++ compiler
// uses, so the two can be compared. Compiling is not wired up yet: the
// analyzer and the IR emitter are what come next.
// ---------------------------------------------------------------------------

let SOURCE_PATH: *i8 = "<none>";

let USAGE: *i8 = "usage: ode1 [--dump-tokens | --dump-ast] <input.ode>\n";

fn main(argc: i32, argv: **i8): i32 {
  let wantTokens: bool = false;
  let wantAst: bool = false;
  let path: *i8 = nullText();

  let index: i32 = 1;
  while (index < argc) {
    let argument: *i8 = argv[index];

    if (textEquals(argument, "--dump-tokens")) {
      wantTokens = true;
    } else if (textEquals(argument, "--dump-ast")) {
      wantAst = true;
    } else if (argument[0] == '-') {
      writeText(STDERR, USAGE);
      return 2;
    } else {
      path = argument;
    }

    index = index + 1;
  }

  if (isNullText(path)) {
    writeText(STDERR, USAGE);
    return 2;
  }

  SOURCE_PATH = path;

  let source: *i8 = readFile(path);
  if (isNullText(source)) {
    fail("cannot open input file");
  }

  let tokens: *TokenList = tokenize(source);
  let out: *Buf = bufNew();

  if (wantTokens) {
    dumpTokens(tokens, out);
    writeBuf(STDOUT, out);
    return 0;
  }

  let ast: *Ast = astNew();
  let parser: *Parser = parserNew(tokens, ast);
  let root: i32 = parseProgram(parser);

  if (wantAst) {
    dumpNode(ast, root, 0, out);
    writeBuf(STDOUT, out);
    return 0;
  }

  // Nothing else is wired up yet, so parsing cleanly is the whole result.
  return 0;
}
