// ---------------------------------------------------------------------------
// Driver.
//
// Reads a file, runs the phases, writes textual LLVM IR, and links it with
// clang. The dump flags exist so selfhost/difftest.sh can compare each phase
// against the C++ compiler.
// ---------------------------------------------------------------------------

import {
  malloc, strlen, remove, STDOUT, STDERR, nullText, isNullText, writeText,
  writeBuf, Buf, textEquals, textSlice, Diagnostics, DIAGS, FAILED, report,
  hasErrors, printDiagnostics, fail, runProgram, readFile, writeFile,
} from "./prelude";
import { TokenList } from "./token";
import { tokenize } from "./lexer";
import { NK_PROGRAM, NK_IMPORT, Ast } from "./ast";
import { Parser } from "./parser";
import { parseModuleInto } from "./parser_stmt";
import {
  realpath, moduleAdd, moduleFind, modulePath, resolveImportPath,
} from "./modules";
import { Analyzer, analyzerNew, analyze } from "./analyzer";
import { Emitter, emitterNew, genProgram } from "./ir";
import { dumpTokens, nullTypes, dumpNode } from "./dump";

export let SOURCE_PATH: *i8 = "<none>";

// Ode has no adjacent string literal concatenation, so this is one line.
let USAGE: *i8 = "usage: ode [-o <path>] [--no-intermediates] [--emit-llvm] [--dump-tokens | --dump-ast | --dump-types] <input.ode>\n";

// `path` without its directory and extension, which is what a bare `ode1
// foo.ode` names its output.
export fn stemOf(path: *i8): *i8 {
  let length: i64 = strlen(path);
  let start: i64 = 0 as i64;
  let end: i64 = length;

  let index: i64 = 0 as i64;
  while (index < length) {
    if (path[index] == '/') {
      start = index + 1 as i64;
    }
    if (path[index] == '.') {
      end = index;
    }
    index = index + 1 as i64;
  }

  if (end <= start) {
    end = length;
  }

  return textSlice(path, start, end - start);
}

// Reads, lexes and parses one file onto the end of `program`. The lexer stops
// the compile at its first error, so a file that cannot be lexed ends the run
// here.
fn loadModule(ast: *Ast, program: i32, path: *i8, real: *i8,
              source: *i8): i32 {
  let module: i32 = moduleAdd(path, real);
  SOURCE_PATH = path;

  let tokens: *TokenList = tokenize(source);
  ast.currentModule = module;
  parseModuleInto(Parser.new(tokens, ast), program);

  return module;
}

// Finds the file an import names, loading it the first time any file asks.
fn loadImport(ast: *Ast, program: i32, item: i32): void {
  let importer: *i8 = modulePath(ast.nodes[item].module);
  let path: *i8 = resolveImportPath(importer, ast.nodes[item].text);
  let real: *i8 = realpath(path, nullText());
  let source: *i8 = nullText();

  if (!isNullText(real)) {
    let loaded: i32 = moduleFind(real);
    if (loaded >= 0) {
      ast.nodes[item].extra = loaded;
      return;
    }
    source = readFile(path);
  }

  if (isNullText(source)) {
    let message: *Buf = Buf.new();
    message.add("cannot find module '");
    message.add(ast.nodes[item].text);
    message.push('\'');
    SOURCE_PATH = importer;
    report(ast.nodes[item].line, ast.nodes[item].column, message.data);
    FAILED = false;
    return;
  }

  ast.nodes[item].extra = loadModule(ast, program, path, real, source);
}

fn withSuffix(base: *i8, suffix: *i8): *i8 {
  let out: *Buf = Buf.new();
  out.add(base);
  out.add(suffix);

  return out.take();
}

fn main(argc: i32, argv: **i8): i32 {
  let wantTokens: bool = false;
  let wantAst: bool = false;
  let wantTypes: bool = false;
  let emitOnly: bool = false;
  let keepIntermediates: bool = true;
  let path: *i8 = nullText();
  let output: *i8 = nullText();

  let index: i32 = 1;
  while (index < argc) {
    let argument: *i8 = argv[index];

    if (textEquals(argument, "--dump-tokens")) {
      wantTokens = true;
    } else if (textEquals(argument, "--dump-ast")) {
      wantAst = true;
    } else if (textEquals(argument, "--dump-types")) {
      wantTypes = true;
    } else if (textEquals(argument, "--emit-llvm")) {
      emitOnly = true;
    } else if (textEquals(argument, "--no-intermediates")) {
      keepIntermediates = false;
    } else if (textEquals(argument, "-o")) {
      index = index + 1;
      if (index >= argc) {
        writeText(STDERR, USAGE);
        return 2;
      }
      output = argv[index];
    } else if (argument[0] == '-') {
      writeText(STDERR, USAGE);
      return 2;
    } else {
      path = argument;
    }

    index = index + 1;
  }

  if (isNullText(path)) {
    writeText(STDERR, USAGE);
    return 2;
  }

  SOURCE_PATH = path;
  DIAGS = Diagnostics.new();

  let source: *i8 = readFile(path);
  if (isNullText(source)) {
    fail("cannot open input file");
  }

  let tokens: *TokenList = tokenize(source);
  let out: *Buf = Buf.new();

  if (wantTokens) {
    dumpTokens(tokens, out);
    writeBuf(STDOUT, out);
    return 0;
  }

  let ast: *Ast = Ast.new();
  let root: i32 = ast.add(NK_PROGRAM, 0, 0);

  let real: *i8 = realpath(path, nullText());
  if (isNullText(real)) {
    real = path;
  }
  moduleAdd(path, real);
  parseModuleInto(Parser.new(tokens, ast), root);

  // Imports are followed breadth first. A loaded file's declarations land on
  // the end of the program's list, so walking the list to its end reaches
  // every file's imports, and a file loaded twice is found by its real path.
  let item: i32 = 0;
  while (item < ast.nodes[root].itemCount) {
    let statement: i32 = ast.nodes[root].items[item];
    if (ast.nodes[statement].kind == NK_IMPORT) {
      loadImport(ast, root, statement);
    }
    item = item + 1;
  }
  SOURCE_PATH = path;

  // A tree with a hole in it says nothing trustworthy about types, so the
  // syntax errors are reported on their own rather than alongside whatever
  // the analyzer would invent from the wreckage.
  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  if (wantAst) {
    dumpNode(ast, nullTypes(), root, 0, out);
    writeBuf(STDOUT, out);
    return 0;
  }

  let an: *Analyzer = analyzerNew(ast);
  analyze(an, root);

  if (hasErrors()) {
    printDiagnostics();
    return 1;
  }

  if (wantTypes) {
    dumpNode(ast, an.types, root, 0, out);
    writeBuf(STDOUT, out);
    return 0;
  }

  let emitter: *Emitter = emitterNew(ast, an);
  let module: *i8 = genProgram(emitter, root);

  if (emitOnly) {
    writeText(STDOUT, module);
    return 0;
  }

  if (isNullText(output)) {
    output = stemOf(path);
  }

  // The intermediates hang off the executable rather than the input, so that
  // -o keeps a whole build in one directory.
  let irPath: *i8 = withSuffix(output, ".ll");
  if (!writeFile(irPath, module)) {
    fail("cannot write the LLVM IR");
  }

  let objectPath: *i8 = withSuffix(output, ".o");

  // Assembling and linking are two runs of clang, which is what leaves a `.o`
  // beside the `.ll` -- the two things worth looking at when codegen
  // misbehaves.
  let assemble: **i8 = malloc(sizeof(*i8) as i64 * 7 as i64) as **i8;
  assemble[0] = "clang";
  assemble[1] = "-c";
  assemble[2] = irPath;
  assemble[3] = "-o";
  assemble[4] = objectPath;
  assemble[5] = "-Wno-override-module";
  assemble[6] = 0 as i64 as *i8;

  if (runProgram(assemble) != 0) {
    fail("assembling failed");
  }

  let link: **i8 = malloc(sizeof(*i8) as i64 * 5 as i64) as **i8;
  link[0] = "clang";
  link[1] = objectPath;
  link[2] = "-o";
  link[3] = output;
  link[4] = 0 as i64 as *i8;

  if (runProgram(link) != 0) {
    fail("linking failed");
  }

  if (!keepIntermediates) {
    remove(irPath);
    remove(objectPath);
  }

  return 0;
}
