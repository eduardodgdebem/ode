// ---------------------------------------------------------------------------
// The IR emitter: textual LLVM IR, handed to clang.
//
// The C++ compiler builds IR through the LLVM API; this one writes the text.
// That means the two cannot be compared byte for byte -- LLVM's printer picks
// its own formatting and numbering -- so codegen is checked by behaviour
// instead: compile every example, run it, and diff against the output the C++
// compiler's binary produces.
//
// Temporaries and labels are named (%t0, L0) rather than numbered, because
// LLVM requires unnamed values to run 0, 1, 2... with no gaps, counting the
// parameters. Naming them sidesteps the rule entirely.
// ---------------------------------------------------------------------------

import {
  malloc, realloc, strlen, nullText, Buf, textEquals, intToText, failAt,
} from "./prelude";
import {
  NO_NODE, NK_BLOCK, NK_VARDECL, NK_ASSIGN, NK_IF, NK_WHILE, NK_BREAK,
  NK_CONTINUE, NK_FN, NK_EXTERN, NK_STRUCT, NK_CALL, NK_RETURN, NK_PRINT,
  NK_EXPRSTMT, NK_BINARY, NK_UNARY, NK_CAST, NK_FIELDACCESS, NK_INDEX,
  NK_STRUCTLIT, NK_SIZEOF, NK_NUMBER, NK_STRING, NK_CHAR, NK_BOOL, NK_IDENT,
  NK_METHODCALL, Ast,
} from "./ast";
import {
  TY_I8, TY_U8, TY_I16, TY_U16, TY_I32, TY_U32, TY_I64, TY_U64, TY_F32, TY_F64,
  TY_BOOL, TY_VOID, TY_STRUCT, Type,
} from "./type";
import { NameSet } from "./modules";
import {
  Analyzer, analyzerParseType, textHasDot, RECV_NONE, RECV_ADDRESS, RECV_LOAD,
} from "./analyzer";

struct Local {
  name: *i8,
  // The alloca holding it, as a register name.
  reg: *i8,
  type: Type,
}

export struct Emitter {
  ast: *Ast,
  an: *Analyzer,
  // Struct bodies, string constants, globals and declarations.
  head: *Buf,
  // Function definitions.
  body: *Buf,
  nextTemp: i32,
  nextLabel: i32,
  nextString: i32,
  // Whether the block being written already ended in a terminator, so that
  // anything after a `return` opens a new block instead of emitting into a
  // closed one.
  terminated: bool,

  locals: *Local,
  localCount: i32,
  localCapacity: i32,
  scopeStarts: *i32,
  scopeCount: i32,
  scopeCapacity: i32,

  // `continue` goes to the condition, `break` to the block after the loop.
  loopContinue: **i8,
  loopBreak: **i8,
  loopCount: i32,
  loopCapacity: i32,
}

export fn emitterNew(ast: *Ast, an: *Analyzer): *Emitter {
  let e: *Emitter = malloc(sizeof(Emitter) as i64) as *Emitter;
  e.ast = ast;
  e.an = an;
  e.head = Buf.new();
  e.body = Buf.new();
  e.nextTemp = 0;
  e.nextLabel = 0;
  e.nextString = 0;
  e.terminated = false;

  e.localCapacity = 64;
  e.localCount = 0;
  e.locals = malloc(sizeof(Local) as i64 * e.localCapacity as i64) as *Local;
  e.scopeCapacity = 32;
  e.scopeCount = 0;
  e.scopeStarts = malloc(sizeof(i32) as i64 * e.scopeCapacity as i64) as *i32;

  e.loopCapacity = 16;
  e.loopCount = 0;
  e.loopContinue = malloc(sizeof(*i8) as i64 * e.loopCapacity as i64) as **i8;
  e.loopBreak = malloc(sizeof(*i8) as i64 * e.loopCapacity as i64) as **i8;

  return e;
}

// ---------------------------------------------------------------------------
// Names and lines.
// ---------------------------------------------------------------------------

fn freshTemp(e: *Emitter): *i8 {
  let name: *Buf = Buf.new();
  name.add("%t");
  name.addInt(e.nextTemp as i64);
  e.nextTemp = e.nextTemp + 1;

  return name.take();
}

fn freshLabel(e: *Emitter): *i8 {
  let name: *Buf = Buf.new();
  name.add("L");
  name.addInt(e.nextLabel as i64);
  e.nextLabel = e.nextLabel + 1;

  return name.take();
}

fn emitLine(e: *Emitter, text: *i8): void {
  e.body.add("  ");
  e.body.add(text);
  e.body.push('\n');
}

fn emitLabel(e: *Emitter, label: *i8): void {
  e.body.add(label);
  e.body.add(":\n");
  e.terminated = false;
}

fn emitBranch(e: *Emitter, label: *i8): void {
  if (e.terminated) {
    return;
  }

  let line: *Buf = Buf.new();
  line.add("br label %");
  line.add(label);
  emitLine(e, line.data);
  e.terminated = true;
}

fn emitCondBranch(e: *Emitter, condition: *i8, whenTrue: *i8,
                  whenFalse: *i8): void {
  if (e.terminated) {
    return;
  }

  let line: *Buf = Buf.new();
  line.add("br i1 ");
  line.add(condition);
  line.add(", label %");
  line.add(whenTrue);
  line.add(", label %");
  line.add(whenFalse);
  emitLine(e, line.data);
  e.terminated = true;
}

// ---------------------------------------------------------------------------
// Types, sizes and alignment.
//
// The sizes have to agree with what LLVM computes for the target, because
// `sizeof` and pointer arithmetic are built on them. These are the rules LLVM
// uses for a non-packed struct: every field starts at its own alignment, and
// the whole is rounded up to the widest field's.
// ---------------------------------------------------------------------------

fn llvmTypeName(type: Type): *i8 {
  // Pointers are opaque in modern LLVM, so every depth is the same `ptr`.
  if (type.isPointer()) {
    return "ptr";
  }

  if (type.kind == TY_STRUCT) {
    let name: *Buf = Buf.new();
    name.push('%');
    name.add(type.structName);
    return name.take();
  }

  if (type.kind == TY_I8 || type.kind == TY_U8) { return "i8"; }
  if (type.kind == TY_I16 || type.kind == TY_U16) { return "i16"; }
  if (type.kind == TY_I32 || type.kind == TY_U32) { return "i32"; }
  if (type.kind == TY_I64 || type.kind == TY_U64) { return "i64"; }
  if (type.kind == TY_F32) { return "float"; }
  if (type.kind == TY_F64) { return "double"; }
  if (type.kind == TY_BOOL) { return "i1"; }
  if (type.kind == TY_VOID) { return "void"; }

  return "void";
}

fn alignOfType(e: *Emitter, type: Type): i32 {
  if (type.isPointer()) {
    return 8;
  }

  if (type.kind == TY_STRUCT) {
    let structIndex: i32 = e.an.structs.indexOf(type.structName);
    let widest: i32 = 1;
    let index: i32 = 0;

    while (index < e.an.structs.items[structIndex].count) {
      let fieldAlign: i32 =
          alignOfType(e, e.an.structs.items[structIndex].fields[index].type);
      if (fieldAlign > widest) {
        widest = fieldAlign;
      }
      index = index + 1;
    }

    return widest;
  }

  if (type.kind == TY_BOOL) { return 1; }

  let bits: i32 = type.bitWidth();
  if (bits == 0) {
    return 1;
  }

  return bits / 8;
}

fn alignUp(value: i32, alignment: i32): i32 {
  let remainder: i32 = value % alignment;
  if (remainder == 0) {
    return value;
  }

  return value + alignment - remainder;
}

fn sizeOfType(e: *Emitter, type: Type): i32 {
  if (type.isPointer()) {
    return 8;
  }

  if (type.kind == TY_STRUCT) {
    let structIndex: i32 = e.an.structs.indexOf(type.structName);
    let offset: i32 = 0;
    let index: i32 = 0;

    while (index < e.an.structs.items[structIndex].count) {
      let fieldType: Type = e.an.structs.items[structIndex].fields[index].type;
      offset = alignUp(offset, alignOfType(e, fieldType));
      offset = offset + sizeOfType(e, fieldType);
      index = index + 1;
    }

    return alignUp(offset, alignOfType(e, type));
  }

  // An i1 occupies a whole byte once it is stored.
  if (type.kind == TY_BOOL) { return 1; }
  if (type.kind == TY_VOID) { return 0; }

  return type.bitWidth() / 8;
}

fn zeroValue(type: Type): *i8 {
  if (type.isPointer()) { return "null"; }
  if (type.kind == TY_STRUCT) { return "zeroinitializer"; }
  if (type.kind == TY_BOOL) { return "false"; }
  if (type.kind == TY_F32 || type.kind == TY_F64) { return "0.0"; }

  return "0";
}

// ---------------------------------------------------------------------------
// Locals.
// ---------------------------------------------------------------------------

fn emitterEnterScope(e: *Emitter): void {
  if (e.scopeCount == e.scopeCapacity) {
    e.scopeCapacity = e.scopeCapacity * 2;
    e.scopeStarts = realloc(e.scopeStarts as *i8,
                            sizeof(i32) as i64 * e.scopeCapacity as i64) as *i32;
  }

  e.scopeStarts[e.scopeCount] = e.localCount;
  e.scopeCount = e.scopeCount + 1;
}

fn emitterExitScope(e: *Emitter): void {
  e.scopeCount = e.scopeCount - 1;
  e.localCount = e.scopeStarts[e.scopeCount];
}

fn declareLocal(e: *Emitter, name: *i8, reg: *i8, type: Type): void {
  if (e.localCount == e.localCapacity) {
    e.localCapacity = e.localCapacity * 2;
    e.locals = realloc(e.locals as *i8,
                       sizeof(Local) as i64 * e.localCapacity as i64) as *Local;
  }

  e.locals[e.localCount].name = name;
  e.locals[e.localCount].reg = reg;
  e.locals[e.localCount].type = type;
  e.localCount = e.localCount + 1;
}

// Innermost first, so a shadowed name resolves to the slot the analyzer
// type-checked it against. A miss means the name is a top-level global, which
// goes by the IR name the analyzer resolved it to.
fn variableAddress(e: *Emitter, node: i32): *i8 {
  let name: *i8 = e.ast.nodes[node].text;
  let index: i32 = e.localCount - 1;

  while (index >= 0) {
    if (textEquals(e.locals[index].name, name)) {
      return e.locals[index].reg;
    }
    index = index - 1;
  }

  let global: *Buf = Buf.new();
  global.push('@');
  global.add(e.an.linkNames[node]);

  return global.take();
}

// ---------------------------------------------------------------------------
// Constants.
// ---------------------------------------------------------------------------

// One byte of an LLVM string constant. Anything outside plain printable ASCII
// is written as \XX, and so are the quote and the backslash.
fn emitIRByte(out: *Buf, value: i8): void {
  let code: i32 = value as i32;
  if (code < 0) {
    code = code + 256;
  }

  if (code >= 32 && code < 127 && value != '"' && value != '\\') {
    out.push(value);
    return;
  }

  out.push('\\');
  out.push(hexDigit(code / 16));
  out.push(hexDigit(code % 16));
}

fn hexDigit(value: i32): i8 {
  if (value < 10) {
    return ('0' as i32 + value) as i8;
  }

  return ('A' as i32 + value - 10) as i8;
}

// Adds a private constant for a string literal and returns its name.
fn internString(e: *Emitter, text: *i8, length: i64): *i8 {
  let name: *Buf = Buf.new();
  name.add("@.str.");
  name.addInt(e.nextString as i64);
  e.nextString = e.nextString + 1;
  let symbol: *i8 = name.take();

  e.head.add(symbol);
  e.head.add(" = private unnamed_addr constant [");
  e.head.addInt(length + 1 as i64);
  e.head.add(" x i8] c\"");

  let index: i64 = 0 as i64;
  while (index < length) {
    emitIRByte(e.head, text[index]);
    index = index + 1 as i64;
  }

  e.head.add("\\00\"\n");

  return symbol;
}

// ---------------------------------------------------------------------------
// Expressions.
// ---------------------------------------------------------------------------

fn typeOfNode(e: *Emitter, node: i32): Type {
  return e.an.types[node];
}

// Emits `%t = <op>` and returns the temporary.
fn emitAssign(e: *Emitter, instruction: *i8): *i8 {
  let temp: *i8 = freshTemp(e);
  let line: *Buf = Buf.new();
  line.add(temp);
  line.add(" = ");
  line.add(instruction);
  emitLine(e, line.data);

  return temp;
}

fn emitLoad(e: *Emitter, type: Type, address: *i8): *i8 {
  let line: *Buf = Buf.new();
  line.add("load ");
  line.add(llvmTypeName(type));
  line.add(", ptr ");
  line.add(address);

  return emitAssign(e, line.data);
}

fn emitStore(e: *Emitter, type: Type, value: *i8, address: *i8): void {
  let line: *Buf = Buf.new();
  line.add("store ");
  line.add(llvmTypeName(type));
  line.push(' ');
  line.add(value);
  line.add(", ptr ");
  line.add(address);
  emitLine(e, line.data);
}

fn emitCast(e: *Emitter, value: *i8, from: Type, to: Type): *i8 {
  if (from.equals(to)) {
    return value;
  }

  let target: *i8 = llvmTypeName(to);
  let source: *i8 = llvmTypeName(from);

  // Opaque pointers: pointer to pointer is not a conversion at all.
  if (from.isPointer() && to.isPointer()) {
    return value;
  }

  let opcode: *i8 = nullText();

  if (from.isPointer() && to.isInteger()) {
    opcode = "ptrtoint";
  } else if (from.isInteger() && to.isPointer()) {
    opcode = "inttoptr";
  } else if (from.isBool()) {
    // An i1 always widens without sign extension.
    opcode = "zext";
  } else if (to.isBool()) {
    let line: *Buf = Buf.new();
    line.add("icmp ne ");
    line.add(source);
    line.push(' ');
    line.add(value);
    line.add(", ");
    line.add(zeroValue(from));
    return emitAssign(e, line.data);
  } else if (from.isInteger() && to.isInteger()) {
    if (to.bitWidth() == from.bitWidth()) {
      return value;
    }
    if (to.bitWidth() < from.bitWidth()) {
      opcode = "trunc";
    } else if (from.isSigned()) {
      opcode = "sext";
    } else {
      opcode = "zext";
    }
  } else if (from.isInteger() && to.isFloat()) {
    if (from.isSigned()) {
      opcode = "sitofp";
    } else {
      opcode = "uitofp";
    }
  } else if (from.isFloat() && to.isInteger()) {
    if (to.isSigned()) {
      opcode = "fptosi";
    } else {
      opcode = "fptoui";
    }
  } else if (from.isFloat() && to.isFloat()) {
    // f32 and f64 are distinct LLVM types, so this is a real conversion.
    if (to.bitWidth() > from.bitWidth()) {
      opcode = "fpext";
    } else {
      opcode = "fptrunc";
    }
  } else {
    failAt(0, 0, "cannot cast in codegen");
  }

  let line: *Buf = Buf.new();
  line.add(opcode);
  line.push(' ');
  line.add(source);
  line.push(' ');
  line.add(value);
  line.add(" to ");
  line.add(target);

  return emitAssign(e, line.data);
}

fn isAddressable(e: *Emitter, node: i32): bool {
  let kind: i32 = e.ast.nodes[node].kind;

  if (kind == NK_IDENT || kind == NK_FIELDACCESS || kind == NK_INDEX) {
    return true;
  }
  if (kind == NK_UNARY) {
    return textEquals(e.ast.nodes[node].text, "*");
  }

  return false;
}

fn genAddress(e: *Emitter, node: i32): *i8 {
  let kind: i32 = e.ast.nodes[node].kind;

  if (kind == NK_IDENT) {
    return variableAddress(e, node);
  }

  if (kind == NK_FIELDACCESS) {
    let object: i32 = e.ast.nodes[node].a;
    let objectType: Type = typeOfNode(e, object);

    // `p.field` follows one level of pointer automatically, so the base is
    // either the pointer's value or the address of a struct variable.
    let base: *i8 = nullText();
    let structType: Type = objectType;
    if (objectType.isPointer()) {
      base = genExpr(e, object);
      structType = objectType.pointee();
    } else {
      base = genAddress(e, object);
    }

    let structIndex: i32 = e.an.structs.indexOf(structType.structName);
    let fieldIndex: i32 =
        e.an.structs.fieldIndex(structIndex, e.ast.nodes[node].text);

    let line: *Buf = Buf.new();
    line.add("getelementptr inbounds ");
    line.add(llvmTypeName(structType));
    line.add(", ptr ");
    line.add(base);
    line.add(", i32 0, i32 ");
    line.addInt(fieldIndex as i64);

    return emitAssign(e, line.data);
  }

  if (kind == NK_INDEX) {
    let base: i32 = e.ast.nodes[node].a;
    let baseType: Type = typeOfNode(e, base);
    let pointer: *i8 = genExpr(e, base);

    let indexNode: i32 = e.ast.nodes[node].b;
    let offset: *i8 = emitCast(e, genExpr(e, indexNode),
                               typeOfNode(e, indexNode), Type.make(TY_I64, 0));

    let line: *Buf = Buf.new();
    line.add("getelementptr inbounds ");
    line.add(llvmTypeName(baseType.pointee()));
    line.add(", ptr ");
    line.add(pointer);
    line.add(", i64 ");
    line.add(offset);

    return emitAssign(e, line.data);
  }

  // For `*p` the address to read or write is simply the value of `p`.
  if (kind == NK_UNARY) {
    return genExpr(e, e.ast.nodes[node].a);
  }

  failAt(e.ast.nodes[node].line, e.ast.nodes[node].column,
         "expression does not denote an addressable location");
  return nullText();
}

// `&&` and `||` evaluate their right operand only when the left does not
// already decide the result, so they branch rather than emitting a bitwise
// instruction.
fn genShortCircuit(e: *Emitter, node: i32): *i8 {
  let isAnd: bool = textEquals(e.ast.nodes[node].text, "&&");

  let slot: *i8 = emitAssign(e, "alloca i1");
  let left: *i8 = genExpr(e, e.ast.nodes[node].a);
  emitStore(e, Type.make(TY_BOOL, 0), left, slot);

  let rightLabel: *i8 = freshLabel(e);
  let doneLabel: *i8 = freshLabel(e);

  if (isAnd) {
    emitCondBranch(e, left, rightLabel, doneLabel);
  } else {
    emitCondBranch(e, left, doneLabel, rightLabel);
  }

  emitLabel(e, rightLabel);
  let right: *i8 = genExpr(e, e.ast.nodes[node].b);
  emitStore(e, Type.make(TY_BOOL, 0), right, slot);
  emitBranch(e, doneLabel);

  emitLabel(e, doneLabel);

  return emitLoad(e, Type.make(TY_BOOL, 0), slot);
}

fn genPointerArithmetic(e: *Emitter, node: i32, left: *i8, right: *i8,
                        leftType: Type, rightType: Type): *i8 {
  let i64Type: Type = Type.make(TY_I64, 0);

  // p - q: a byte distance scaled down to a count of elements.
  if (leftType.isPointer() && rightType.isPointer()) {
    let leftInt: *i8 = emitCast(e, left, leftType, i64Type);
    let rightInt: *i8 = emitCast(e, right, rightType, i64Type);

    let subtraction: *Buf = Buf.new();
    subtraction.add("sub i64 ");
    subtraction.add(leftInt);
    subtraction.add(", ");
    subtraction.add(rightInt);
    let difference: *i8 = emitAssign(e, subtraction.data);

    let elementSize: i32 = sizeOfType(e, leftType.pointee());
    if (elementSize <= 1) {
      return difference;
    }

    let division: *Buf = Buf.new();
    division.add("sdiv i64 ");
    division.add(difference);
    division.add(", ");
    division.addInt(elementSize as i64);

    return emitAssign(e, division.data);
  }

  let pointer: *i8 = left;
  let offset: *i8 = right;
  let pointerType: Type = leftType;
  let offsetType: Type = rightType;

  if (!leftType.isPointer()) {
    pointer = right;
    offset = left;
    pointerType = rightType;
    offsetType = leftType;
  }

  // GEP indices are pointer-sized, so widen or narrow the offset to match.
  offset = emitCast(e, offset, offsetType, i64Type);

  // `p - i` is `p + (-i)`.
  if (textEquals(e.ast.nodes[node].text, "-")) {
    let negation: *Buf = Buf.new();
    negation.add("sub i64 0, ");
    negation.add(offset);
    offset = emitAssign(e, negation.data);
  }

  let line: *Buf = Buf.new();
  line.add("getelementptr inbounds ");
  line.add(llvmTypeName(pointerType.pointee()));
  line.add(", ptr ");
  line.add(pointer);
  line.add(", i64 ");
  line.add(offset);

  return emitAssign(e, line.data);
}

// The instruction for a binary operator, given the operand type. Integer
// division, remainder and the comparisons all differ by signedness, and the
// float forms are different opcodes again.
fn binaryOpcode(op: *i8, type: Type): *i8 {
  let float: bool = type.isFloat();
  let signed: bool = type.isSigned();

  if (textEquals(op, "+")) { if (float) { return "fadd"; } return "add"; }
  if (textEquals(op, "-")) { if (float) { return "fsub"; } return "sub"; }
  if (textEquals(op, "*")) { if (float) { return "fmul"; } return "mul"; }
  if (textEquals(op, "/")) {
    if (float) { return "fdiv"; }
    if (signed) { return "sdiv"; }
    return "udiv";
  }
  if (textEquals(op, "%")) {
    if (signed) { return "srem"; }
    return "urem";
  }
  if (textEquals(op, "&")) { return "and"; }
  if (textEquals(op, "|")) { return "or"; }
  if (textEquals(op, "^")) { return "xor"; }
  if (textEquals(op, "<<")) { return "shl"; }
  if (textEquals(op, ">>")) {
    if (signed) { return "ashr"; }
    return "lshr";
  }

  // The comparisons. A pointer compares as an unsigned integer.
  if (textEquals(op, "==")) { if (float) { return "fcmp oeq"; } return "icmp eq"; }
  if (textEquals(op, "!=")) { if (float) { return "fcmp one"; } return "icmp ne"; }

  if (textEquals(op, "<")) {
    if (float) { return "fcmp olt"; }
    if (signed) { return "icmp slt"; }
    return "icmp ult";
  }
  if (textEquals(op, "<=")) {
    if (float) { return "fcmp ole"; }
    if (signed) { return "icmp sle"; }
    return "icmp ule";
  }
  if (textEquals(op, ">")) {
    if (float) { return "fcmp ogt"; }
    if (signed) { return "icmp sgt"; }
    return "icmp ugt";
  }
  if (textEquals(op, ">=")) {
    if (float) { return "fcmp oge"; }
    if (signed) { return "icmp sge"; }
    return "icmp uge";
  }

  return "add";
}

fn genBinary(e: *Emitter, node: i32): *i8 {
  let op: *i8 = e.ast.nodes[node].text;

  if (textEquals(op, "&&") || textEquals(op, "||")) {
    return genShortCircuit(e, node);
  }

  let leftNode: i32 = e.ast.nodes[node].a;
  let rightNode: i32 = e.ast.nodes[node].b;
  let leftType: Type = typeOfNode(e, leftNode);
  let rightType: Type = typeOfNode(e, rightNode);

  let left: *i8 = genExpr(e, leftNode);
  let right: *i8 = genExpr(e, rightNode);

  if (leftType.isPointer() || rightType.isPointer()) {
    // A comparison of two pointers is an ordinary icmp; everything else is
    // pointer arithmetic.
    if (!textEquals(op, "==") && !textEquals(op, "!=") &&
        !textEquals(op, "<") && !textEquals(op, "<=") &&
        !textEquals(op, ">") && !textEquals(op, ">=")) {
      return genPointerArithmetic(e, node, left, right, leftType, rightType);
    }
  }

  let line: *Buf = Buf.new();
  line.add(binaryOpcode(op, leftType));
  line.push(' ');
  line.add(llvmTypeName(leftType));
  line.push(' ');
  line.add(left);
  line.add(", ");
  line.add(right);

  return emitAssign(e, line.data);
}

fn genUnary(e: *Emitter, node: i32): *i8 {
  let op: *i8 = e.ast.nodes[node].text;
  let operand: i32 = e.ast.nodes[node].a;

  if (textEquals(op, "&")) {
    return genAddress(e, operand);
  }

  if (textEquals(op, "*")) {
    return emitLoad(e, typeOfNode(e, node), genExpr(e, operand));
  }

  let operandType: Type = typeOfNode(e, operand);
  let value: *i8 = genExpr(e, operand);

  if (textEquals(op, "+")) {
    return value;
  }

  if (textEquals(op, "-")) {
    let line: *Buf = Buf.new();
    if (operandType.isFloat()) {
      line.add("fneg ");
      line.add(llvmTypeName(operandType));
      line.push(' ');
      line.add(value);
    } else {
      line.add("sub ");
      line.add(llvmTypeName(operandType));
      line.add(" 0, ");
      line.add(value);
    }
    return emitAssign(e, line.data);
  }

  // Logical NOT on an i1 is a flip against true.
  let line: *Buf = Buf.new();
  line.add("xor i1 ");
  line.add(value);
  line.add(", true");

  return emitAssign(e, line.data);
}

// The callee's signature is read off the analyzer's types rather than looked
// up again: the call's own type is the return type, and every argument was
// required to have exactly its parameter's type.
fn genCall(e: *Emitter, node: i32): *i8 {
  return genCallWith(e, node, e.ast.nodes[node].a, "", "");
}

// A method call is a call with the receiver, when there is one, put in front
// of the arguments as `self`.
fn genMethodCall(e: *Emitter, node: i32): *i8 {
  let mode: i8 = e.an.receivers[node];
  if (mode == RECV_NONE) {
    return genCallWith(e, node, e.ast.nodes[node].b, "", "");
  }

  let object: i32 = e.ast.nodes[node].a;
  let objectType: Type = typeOfNode(e, object);

  if (mode == RECV_ADDRESS) {
    return genCallWith(e, node, e.ast.nodes[node].b, "ptr",
                       genAddress(e, object));
  }

  if (mode == RECV_LOAD) {
    let pointee: Type = objectType.pointee();
    let value: *i8 = emitLoad(e, pointee, genExpr(e, object));
    return genCallWith(e, node, e.ast.nodes[node].b, llvmTypeName(pointee),
                       value);
  }

  return genCallWith(e, node, e.ast.nodes[node].b, llvmTypeName(objectType),
                     genExpr(e, object));
}

// Writes the call `node` resolved to, passing `args`, preceded by `first` of
// type `firstType` when that is not empty.
fn genCallWith(e: *Emitter, node: i32, args: i32, firstType: *i8,
               first: *i8): *i8 {
  let returnType: Type = typeOfNode(e, node);

  let argCount: i32 = 0;
  if (args != NO_NODE) {
    argCount = e.ast.nodes[args].itemCount;
  }

  // Every argument is evaluated before the call is written, because each one
  // may emit instructions of its own.
  let values: **i8 = malloc(sizeof(*i8) as i64 * (argCount + 1) as i64) as **i8;
  let index: i32 = 0;
  while (index < argCount) {
    values[index] = genExpr(e, e.ast.nodes[args].items[index]);
    index = index + 1;
  }

  let line: *Buf = Buf.new();
  line.add("call ");
  line.add(llvmTypeName(returnType));
  line.add(" @");
  line.add(e.an.linkNames[node]);
  line.push('(');

  let hasFirst: bool = strlen(firstType) > 0 as i64;
  if (hasFirst) {
    line.add(firstType);
    line.push(' ');
    line.add(first);
  }

  index = 0;
  while (index < argCount) {
    if (index > 0 || hasFirst) {
      line.add(", ");
    }
    line.add(llvmTypeName(typeOfNode(e, e.ast.nodes[args].items[index])));
    line.push(' ');
    line.add(values[index]);
    index = index + 1;
  }
  line.push(')');

  // A void call has no value to name.
  if (returnType.isVoid()) {
    emitLine(e, line.data);
    return "";
  }

  return emitAssign(e, line.data);
}

fn genStructLiteral(e: *Emitter, node: i32): *i8 {
  let name: *i8 = e.ast.nodes[node].text;
  let type: Type = Type.ofStruct(name, 0);
  let structIndex: i32 = e.an.structs.indexOf(name);
  let typeName: *i8 = llvmTypeName(type);

  // Built up field by field from `undef`, which needs no storage.
  let current: *i8 = "undef";
  let index: i32 = 0;

  while (index < e.ast.nodes[node].itemCount) {
    let init: i32 = e.ast.nodes[node].items[index];
    let fieldIndex: i32 =
        e.an.structs.fieldIndex(structIndex, e.ast.nodes[init].text);
    let fieldType: Type =
        e.an.structs.items[structIndex].fields[fieldIndex].type;
    let value: *i8 = genExpr(e, e.ast.nodes[init].a);

    let line: *Buf = Buf.new();
    line.add("insertvalue ");
    line.add(typeName);
    line.push(' ');
    line.add(current);
    line.add(", ");
    line.add(llvmTypeName(fieldType));
    line.push(' ');
    line.add(value);
    line.add(", ");
    line.addInt(fieldIndex as i64);

    current = emitAssign(e, line.data);
    index = index + 1;
  }

  return current;
}

// A float literal is written in LLVM's hexadecimal form only when it has to
// be; plain decimal text round-trips for everything the language can express.
fn genNumberLiteral(e: *Emitter, node: i32): *i8 {
  let type: Type = typeOfNode(e, node);
  let text: *i8 = e.ast.nodes[node].text;

  if (type.isFloat()) {
    // LLVM wants a decimal point in a floating literal.
    if (!textHasDot(text, strlen(text))) {
      let out: *Buf = Buf.new();
      out.add(text);
      out.add(".0");
      return out.take();
    }
    return text;
  }

  return text;
}

fn genExpr(e: *Emitter, node: i32): *i8 {
  let kind: i32 = e.ast.nodes[node].kind;

  if (kind == NK_NUMBER) { return genNumberLiteral(e, node); }

  if (kind == NK_BOOL) {
    if (textEquals(e.ast.nodes[node].text, "true")) {
      return "true";
    }
    return "false";
  }

  if (kind == NK_CHAR) {
    let value: i32 = e.ast.nodes[node].text[0] as i32;
    if (value < 0) {
      value = value + 256;
    }
    // An i8 is signed, so a byte above 127 is written as its negative form.
    if (value > 127) {
      value = value - 256;
    }
    return intToText(value as i64);
  }

  if (kind == NK_STRING) {
    return internString(e, e.ast.nodes[node].text,
                        e.ast.nodes[node].textLength);
  }

  if (kind == NK_IDENT) {
    return emitLoad(e, typeOfNode(e, node),
                    variableAddress(e, node));
  }

  if (kind == NK_BINARY) { return genBinary(e, node); }
  if (kind == NK_UNARY) { return genUnary(e, node); }
  if (kind == NK_CALL) { return genCall(e, node); }
  if (kind == NK_METHODCALL) { return genMethodCall(e, node); }
  if (kind == NK_STRUCTLIT) { return genStructLiteral(e, node); }

  if (kind == NK_CAST) {
    let from: Type = typeOfNode(e, e.ast.nodes[node].a);
    let to: Type = typeOfNode(e, node);
    return emitCast(e, genExpr(e, e.ast.nodes[node].a), from, to);
  }

  if (kind == NK_SIZEOF) {
    let type: Type = analyzerParseType(e.an, e.ast.nodes[node].a);
    return intToText(sizeOfType(e, type) as i64);
  }

  if (kind == NK_FIELDACCESS) {
    let object: i32 = e.ast.nodes[node].a;
    let objectType: Type = typeOfNode(e, object);

    // A struct with no storage -- a call result, say -- cannot be GEPed into,
    // so the field is read straight out of the aggregate value.
    if (!objectType.isPointer() && !isAddressable(e, object)) {
      let structIndex: i32 = e.an.structs.indexOf(objectType.structName);
      let fieldIndex: i32 =
          e.an.structs.fieldIndex(structIndex, e.ast.nodes[node].text);

      let line: *Buf = Buf.new();
      line.add("extractvalue ");
      line.add(llvmTypeName(objectType));
      line.push(' ');
      line.add(genExpr(e, object));
      line.add(", ");
      line.addInt(fieldIndex as i64);

      return emitAssign(e, line.data);
    }

    return emitLoad(e, typeOfNode(e, node), genAddress(e, node));
  }

  if (kind == NK_INDEX) {
    return emitLoad(e, typeOfNode(e, node), genAddress(e, node));
  }

  failAt(e.ast.nodes[node].line, e.ast.nodes[node].column,
         "unsupported expression in code generation");
  return nullText();
}

// ---------------------------------------------------------------------------
// Statements.
// ---------------------------------------------------------------------------

// The printf format for a value of this type, and whether the argument needs
// the default promotions a variadic call performs.
fn printFormat(type: Type): *i8 {
  if (type.isPointer()) {
    // `*i8` is Ode's string type, so it prints as text. Any other pointer
    // prints as an address.
    if (type.kind == TY_I8 && type.pointerDepth == 1) {
      return "%s\n";
    }
    return "%p\n";
  }

  if (type.kind == TY_BOOL || type.kind == TY_I8 || type.kind == TY_I16 ||
      type.kind == TY_I32) {
    return "%d\n";
  }
  if (type.kind == TY_U8 || type.kind == TY_U16 || type.kind == TY_U32) {
    return "%u\n";
  }
  if (type.kind == TY_I64) { return "%lld\n"; }
  if (type.kind == TY_U64) { return "%llu\n"; }
  if (type.kind == TY_F32 || type.kind == TY_F64) { return "%f\n"; }

  failAt(0, 0, "unsupported type for print statement");
  return "";
}

fn genPrint(e: *Emitter, node: i32): void {
  let expr: i32 = e.ast.nodes[node].a;
  let type: Type = typeOfNode(e, expr);
  let format: *i8 = printFormat(type);
  let value: *i8 = genExpr(e, expr);

  // The default argument promotions a variadic call performs: anything
  // narrower than an int widens to i32, and an f32 widens to double.
  let argType: Type = type;
  if (!type.isPointer()) {
    if (type.isBool() || (type.isInteger() && type.bitWidth() < 32)) {
      argType = Type.make(TY_I32, 0);
      value = emitCast(e, value, type, argType);
    } else if (type.kind == TY_F32) {
      argType = Type.make(TY_F64, 0);
      value = emitCast(e, value, type, argType);
    }
  }

  let formatSymbol: *i8 = internString(e, format, strlen(format));

  let line: *Buf = Buf.new();
  line.add("call i32 (ptr, ...) @printf(ptr ");
  line.add(formatSymbol);
  line.add(", ");
  line.add(llvmTypeName(argType));
  line.push(' ');
  line.add(value);
  line.push(')');

  emitAssign(e, line.data);
}

fn genStatement(e: *Emitter, node: i32): void {
  let kind: i32 = e.ast.nodes[node].kind;

  // A struct declaration produced its type up front, and a nested function
  // declaration is not reachable here.
  if (kind == NK_STRUCT || kind == NK_EXTERN) {
    return;
  }

  if (kind == NK_BLOCK) {
    emitterEnterScope(e);
    let index: i32 = 0;
    while (index < e.ast.nodes[node].itemCount) {
      genStatement(e, e.ast.nodes[node].items[index]);
      index = index + 1;
    }
    emitterExitScope(e);
    return;
  }

  if (kind == NK_VARDECL) {
    let type: Type = analyzerParseType(e.an, e.ast.nodes[node].a);
    let value: *i8 = genExpr(e, e.ast.nodes[node].b);

    let allocation: *Buf = Buf.new();
    allocation.add("alloca ");
    allocation.add(llvmTypeName(type));
    let slot: *i8 = emitAssign(e, allocation.data);

    emitStore(e, type, value, slot);
    // Bound after the initialiser, so `let x = x + 1;` reads the outer x.
    declareLocal(e, e.ast.nodes[node].text, slot, type);
    return;
  }

  if (kind == NK_ASSIGN) {
    let target: i32 = e.ast.nodes[node].a;
    let type: Type = typeOfNode(e, target);
    let value: *i8 = genExpr(e, e.ast.nodes[node].b);
    emitStore(e, type, value, genAddress(e, target));
    return;
  }

  if (kind == NK_EXPRSTMT) {
    genExpr(e, e.ast.nodes[node].a);
    return;
  }

  if (kind == NK_PRINT) {
    genPrint(e, node);
    return;
  }

  if (kind == NK_RETURN) {
    if (e.ast.nodes[node].a == NO_NODE) {
      emitLine(e, "ret void");
    } else {
      let type: Type = typeOfNode(e, e.ast.nodes[node].a);
      let value: *i8 = genExpr(e, e.ast.nodes[node].a);

      let line: *Buf = Buf.new();
      line.add("ret ");
      line.add(llvmTypeName(type));
      line.push(' ');
      line.add(value);
      emitLine(e, line.data);
    }
    e.terminated = true;
    return;
  }

  if (kind == NK_IF) {
    let condition: *i8 = genExpr(e, e.ast.nodes[node].a);
    let thenLabel: *i8 = freshLabel(e);
    let elseLabel: *i8 = freshLabel(e);
    let doneLabel: *i8 = freshLabel(e);

    if (e.ast.nodes[node].c == NO_NODE) {
      emitCondBranch(e, condition, thenLabel, doneLabel);
    } else {
      emitCondBranch(e, condition, thenLabel, elseLabel);
    }

    emitLabel(e, thenLabel);
    genStatement(e, e.ast.nodes[node].b);
    emitBranch(e, doneLabel);

    if (e.ast.nodes[node].c != NO_NODE) {
      emitLabel(e, elseLabel);
      genStatement(e, e.ast.nodes[node].c);
      emitBranch(e, doneLabel);
    }

    emitLabel(e, doneLabel);
    return;
  }

  if (kind == NK_WHILE) {
    let condLabel: *i8 = freshLabel(e);
    let bodyLabel: *i8 = freshLabel(e);
    let doneLabel: *i8 = freshLabel(e);

    emitBranch(e, condLabel);
    emitLabel(e, condLabel);
    let condition: *i8 = genExpr(e, e.ast.nodes[node].a);
    emitCondBranch(e, condition, bodyLabel, doneLabel);

    if (e.loopCount == e.loopCapacity) {
      e.loopCapacity = e.loopCapacity * 2;
      e.loopContinue = realloc(e.loopContinue as *i8,
                               sizeof(*i8) as i64 * e.loopCapacity as i64) as **i8;
      e.loopBreak = realloc(e.loopBreak as *i8,
                            sizeof(*i8) as i64 * e.loopCapacity as i64) as **i8;
    }
    e.loopContinue[e.loopCount] = condLabel;
    e.loopBreak[e.loopCount] = doneLabel;
    e.loopCount = e.loopCount + 1;

    emitLabel(e, bodyLabel);
    genStatement(e, e.ast.nodes[node].b);
    emitBranch(e, condLabel);

    e.loopCount = e.loopCount - 1;
    emitLabel(e, doneLabel);
    return;
  }

  if (kind == NK_BREAK) {
    emitBranch(e, e.loopBreak[e.loopCount - 1]);
    // Anything written after this needs a block of its own to live in.
    emitLabel(e, freshLabel(e));
    return;
  }

  if (kind == NK_CONTINUE) {
    emitBranch(e, e.loopContinue[e.loopCount - 1]);
    emitLabel(e, freshLabel(e));
    return;
  }

  failAt(e.ast.nodes[node].line, e.ast.nodes[node].column,
         "unsupported statement in code generation");
}

// ---------------------------------------------------------------------------
// Functions and the module.
// ---------------------------------------------------------------------------

fn emitSignature(e: *Emitter, out: *Buf, node: i32, keyword: *i8): void {
  let returnType: Type = analyzerParseType(e.an, e.ast.nodes[node].a);

  out.add(keyword);
  out.push(' ');
  out.add(llvmTypeName(returnType));
  out.add(" @");
  out.add(e.an.linkNames[node]);
  out.push('(');

  let params: i32 = e.ast.nodes[node].b;
  let count: i32 = 0;
  if (params != NO_NODE) {
    count = e.ast.nodes[params].itemCount;
  }

  let index: i32 = 0;
  while (index < count) {
    if (index > 0) {
      out.add(", ");
    }

    let param: i32 = e.ast.nodes[params].items[index];
    out.add(llvmTypeName(analyzerParseType(e.an, e.ast.nodes[param].a)));

    // A declaration names no parameters; a definition needs them to store.
    if (textEquals(keyword, "define")) {
      out.add(" %p");
      out.addInt(index as i64);
    }

    index = index + 1;
  }

  out.push(')');
}

fn genFunction(e: *Emitter, node: i32): void {
  let returnType: Type = analyzerParseType(e.an, e.ast.nodes[node].a);

  e.nextTemp = 0;
  e.nextLabel = 0;
  e.terminated = false;

  emitSignature(e, e.body, node, "define");
  e.body.add(" {\nentry:\n");

  emitterEnterScope(e);

  // Each parameter gets a slot of its own, so it can be assigned like any
  // other local.
  let params: i32 = e.ast.nodes[node].b;
  if (params != NO_NODE) {
    let index: i32 = 0;
    while (index < e.ast.nodes[params].itemCount) {
      let param: i32 = e.ast.nodes[params].items[index];
      let type: Type = analyzerParseType(e.an, e.ast.nodes[param].a);

      let allocation: *Buf = Buf.new();
      allocation.add("alloca ");
      allocation.add(llvmTypeName(type));
      let slot: *i8 = emitAssign(e, allocation.data);

      let incoming: *Buf = Buf.new();
      incoming.add("%p");
      incoming.addInt(index as i64);
      emitStore(e, type, incoming.data, slot);

      declareLocal(e, e.ast.nodes[param].text, slot, type);
      index = index + 1;
    }
  }

  genStatement(e, e.ast.nodes[node].c);

  // Falling off the end of a function is allowed and yields a zero value.
  if (!e.terminated) {
    if (returnType.isVoid()) {
      emitLine(e, "ret void");
    } else {
      let line: *Buf = Buf.new();
      line.add("ret ");
      line.add(llvmTypeName(returnType));
      line.push(' ');
      line.add(zeroValue(returnType));
      emitLine(e, line.data);
    }
  }

  emitterExitScope(e);
  e.body.add("}\n\n");
}

// A global's initialiser becomes an LLVM constant initialiser, so it is
// folded here rather than being computed at run time.
fn genConstant(e: *Emitter, node: i32, type: Type): *i8 {
  let kind: i32 = e.ast.nodes[node].kind;

  if (kind == NK_STRING) {
    return internString(e, e.ast.nodes[node].text,
                        e.ast.nodes[node].textLength);
  }
  if (kind == NK_CAST) {
    return genConstant(e, e.ast.nodes[node].a, type);
  }
  if (kind == NK_UNARY) {
    let inner: *i8 = genConstant(e, e.ast.nodes[node].a, type);
    let out: *Buf = Buf.new();
    out.push('-');
    out.add(inner);
    return out.take();
  }
  if (kind == NK_SIZEOF) {
    return intToText(sizeOfType(e, analyzerParseType(e.an,
                                                     e.ast.nodes[node].a)) as i64);
  }
  if (kind == NK_BOOL) {
    if (textEquals(e.ast.nodes[node].text, "true")) {
      return "true";
    }
    return "false";
  }
  if (kind == NK_CHAR) {
    let value: i32 = e.ast.nodes[node].text[0] as i32;
    if (value < 0) {
      value = value + 256;
    }
    if (value > 127) {
      value = value - 256;
    }
    return intToText(value as i64);
  }

  // A pointer-typed global cannot be initialised from a bare integer: LLVM
  // wants `null` for zero, and an inttoptr for anything else. This is the one
  // place a constant's spelling depends on the type it is being stored into.
  if (type.isPointer()) {
    let text: *i8 = genNumberLiteral(e, node);

    if (textEquals(text, "0")) {
      return "null";
    }

    let out: *Buf = Buf.new();
    out.add("inttoptr (i64 ");
    out.add(text);
    out.add(" to ptr)");

    return out.take();
  }

  return genNumberLiteral(e, node);
}

fn genGlobal(e: *Emitter, node: i32): void {
  let type: Type = analyzerParseType(e.an, e.ast.nodes[node].a);

  // The string constant, if any, has to be emitted before the global that
  // points at it.
  let value: *i8 = genConstant(e, e.ast.nodes[node].b, type);

  e.head.push('@');
  e.head.add(e.an.linkNames[node]);
  e.head.add(" = global ");
  e.head.add(llvmTypeName(type));
  e.head.push(' ');
  e.head.add(value);
  e.head.push('\n');
}

export fn genProgram(e: *Emitter, program: i32): *i8 {
  let count: i32 = e.ast.nodes[program].itemCount;

  // Named struct types come first, so a function signature can mention one.
  let index: i32 = 0;
  while (index < e.an.structs.count) {
    e.head.push('%');
    e.head.add(e.an.structs.items[index].name);
    e.head.add(" = type { ");

    let field: i32 = 0;
    while (field < e.an.structs.items[index].count) {
      if (field > 0) {
        e.head.add(", ");
      }
      e.head.add(llvmTypeName(e.an.structs.items[index].fields[field].type));
      field = field + 1;
    }

    e.head.add(" }\n");
    index = index + 1;
  }

  e.head.add("declare i32 @printf(ptr, ...)\n");

  // Several files may declare one extern, and LLVM takes one declaration.
  let declared: *NameSet = NameSet.new();
  index = 0;
  while (index < count) {
    let statement: i32 = e.ast.nodes[program].items[index];
    if (e.ast.nodes[statement].kind == NK_EXTERN &&
        !declared.has(e.an.linkNames[statement])) {
      declared.add(e.an.linkNames[statement]);
      emitSignature(e, e.head, statement, "declare");
      e.head.push('\n');
    }
    index = index + 1;
  }

  index = 0;
  while (index < count) {
    let statement: i32 = e.ast.nodes[program].items[index];
    if (e.ast.nodes[statement].kind == NK_VARDECL) {
      genGlobal(e, statement);
    }
    index = index + 1;
  }

  index = 0;
  while (index < count) {
    let statement: i32 = e.ast.nodes[program].items[index];
    if (e.ast.nodes[statement].kind == NK_FN) {
      genFunction(e, statement);
    }

    // A struct's methods are functions like any other once named.
    if (e.ast.nodes[statement].kind == NK_STRUCT) {
      let member: i32 = 0;
      while (member < e.ast.nodes[statement].itemCount) {
        let method: i32 = e.ast.nodes[statement].items[member];
        if (e.ast.nodes[method].kind == NK_FN) {
          genFunction(e, method);
        }
        member = member + 1;
      }
    }
    index = index + 1;
  }

  let module: *Buf = Buf.new();
  module.addBytes(e.head.data, e.head.length);
  module.push('\n');
  module.addBytes(e.body.data, e.body.length);

  return module.take();
}
